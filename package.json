{
  "name": "deadlock-wiki",
  "private": true,
  "type": "module",
  "description": "Deadlock 日本語データベース型リファレンス + ビルドツール",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "parse": "node --experimental-strip-types src/parsers/main.ts",
    "gen:updates": "node --experimental-strip-types tools/gen-updates.mjs",
    "audit:matchup": "node --experimental-strip-types tools/audit-matchup.mjs",
    "fetch:stats": "node tools/fetch-stats.mjs",
    "gen:thumbs": "node tools/gen-thumbs.mjs",
    "typecheck": "tsc --noEmit",
    "predev": "node tools/gen-thumbs.mjs",
    "dev": "astro dev",
    "prebuild": "node tools/gen-thumbs.mjs",
    "build": "astro build",
    "postbuild": "node tools/gen-fonts.mjs",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.2",
    "subset-font": "^2.9.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "astro": "^7.3.1"
  }
}
