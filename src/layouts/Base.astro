---
import "../styles/global.css";
import { heroesFile } from "../lib/data.ts";

interface Crumb {
  name: string;
  /** サイトルートからの絶対パス（例: /heroes/） */
  path: string;
}
interface Props {
  title: string;
  description?: string;
  /** OGP タイプ。トップは website、詳細ページは article 相当 */
  ogType?: string;
  /** パンくず（構造化データにも使う）。先頭に「トップ」は自動で付く */
  breadcrumbs?: Crumb[];
}
const { title, description, ogType = "website", breadcrumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { href: `${base}/heroes/`, label: "ヒーロー" },
  { href: `${base}/items/`, label: "アイテム" },
  { href: `${base}/build/`, label: "ビルド" },
];
const path = Astro.url.pathname;

const SITE_NAME = "DEADLOCK-JP DB";
const SITE = Astro.site ?? new URL("https://deadlock-jp.github.io");
const canonical = new URL(path, SITE).href;
const fullTitle = `${title} | ${SITE_NAME}`;
const desc =
  description ??
  "Valve『Deadlock（デッドロック）』のヒーロー・アイテム・スキルの数値を日本語で引ける非公式データベース。";
const isHome = path === "/" || path === base + "/";

/* 構造化データ（SEO / 生成AI検索対策）。値はサイトの事実のみ。 */
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    alternateName: "Deadlock 日本語データベース",
    url: SITE.href,
    inLanguage: "ja",
    description:
      "Deadlock（デッドロック）のヒーロー・アイテム・スキルの数値を日本語で引けるデータベースとビルドシミュレーター。数値はゲームの生データから自動生成した非公式ファンサイト。",
    about: {
      "@type": "VideoGame",
      name: "Deadlock",
      alternateName: "デッドロック",
      publisher: { "@type": "Organization", name: "Valve Corporation" },
    },
    isFamilyFriendly: true,
  },
];
const crumbs: Crumb[] = [{ name: "トップ", path: "/" }, ...breadcrumbs];
if (crumbs.length > 1) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.path, SITE).href,
    })),
  });
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    {/* Open Graph / Twitter（SNS・チャット・生成AIのプレビュー用） */}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={isHome ? "website" : ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />

    {/* ゲーム内表記に合わせて Noto Sans JP を使う。数字用に等幅も1書体だけ入れる */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="wordmark" href={`${base}/`}>
          <span class="mark" aria-hidden="true"></span>
          <span class="name">DEADLOCK-JP</span>
          <span class="sub">DB</span>
        </a>
        <nav>
          {
            nav.map((n) => (
              <a href={n.href} class:list={[{ current: path.startsWith(n.href) }]}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>
          データ出典: GameTracking-Deadlock (コミット
          <code>{heroesFile.upstreamCommit.slice(0, 12)}</code>)。数値はゲームの生データから自動抽出しています。
        </p>
        <p class="muted">
          本サイトはファンによる非公式サイトで、Valve Corporation とは関係がなく、許諾も受けていません。
          『Deadlock』および本サイトが表示するデータ・画像・テキストの著作権は
          Valve Corporation に帰属します。
          <a href={`${base}/about/`}>このサイトについて</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        /*
         * 追従ヘッダー。本文(.site-main)も z-index:1 を持っており、
         * 同じ重なり順だと後ろにあるDOMが上に描かれてヘッダーに重なる。
         * ヘッダー側を明示的に上に置く。
         */
        z-index: 20;
        border-bottom: 1px solid var(--c-border);
        /* backdrop-filter が効かない環境でも本文が透けないよう、少し濃くする */
        background: rgb(17 22 26 / 0.92);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
      }
      .inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 var(--sp-5);
      }
      .site-header .inner {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: var(--sp-6);
        min-height: 58px;
      }
      .wordmark {
        display: flex;
        flex: 0 0 auto;
        align-items: baseline;
        gap: var(--sp-2);
        color: var(--c-text-strong);
        white-space: nowrap;
      }
      .wordmark:hover {
        text-decoration: none;
      }
      /* サムネイルのロゴ(円+スポーク)を簡略化した記号。flex で潰れて縦長にならないよう固定 */
      .mark {
        flex: 0 0 auto;
        width: 15px;
        height: 15px;
        border: 2px solid var(--c-accent);
        border-radius: 50%;
        position: relative;
        align-self: center;
        box-shadow: 0 0 10px rgb(63 191 143 / 0.45);
      }
      .mark::after {
        content: "";
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: var(--c-accent);
      }
      .name {
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.14em;
        white-space: nowrap;
      }
      .sub {
        font-size: 13px;
        font-weight: 700;
        color: var(--c-accent);
        letter-spacing: 0.1em;
        white-space: nowrap;
      }
      nav {
        display: flex;
        /* 縮む(=足りなければ横スクロール)が、伸びはしない。デスクトップの見た目は据え置き */
        flex: 0 1 auto;
        min-width: 0;
        gap: var(--sp-5);
        font-size: 14px;
        /* 収まらないときは折り返さず横スクロール */
        overflow-x: auto;
        scrollbar-width: none;
      }
      nav::-webkit-scrollbar {
        display: none;
      }
      nav a {
        flex: 0 0 auto;
        white-space: nowrap;
        color: var(--c-text-muted);
        padding: 4px 0;
        border-bottom: 2px solid transparent;
      }
      nav a:hover {
        color: var(--c-text);
        text-decoration: none;
      }
      nav a.current {
        color: var(--c-accent);
        border-bottom-color: var(--c-accent);
      }
      .site-main {
        position: relative;
        z-index: 1;
        max-width: 1120px;
        margin: 0 auto;
        padding: var(--sp-6) var(--sp-5) var(--sp-7);
      }
      .site-footer {
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--c-border);
        margin-top: var(--sp-7);
        padding: var(--sp-5) 0;
        font-size: 12px;
        color: var(--c-text-muted);
      }
      .site-footer p {
        margin: 0 0 var(--sp-1);
      }
      .site-footer .muted {
        color: var(--c-text-faint);
      }
      @media (max-width: 640px) {
        .inner {
          padding: 0 var(--sp-4);
        }
        .site-header .inner {
          gap: var(--sp-3);
        }
        .name {
          font-size: 14px;
          letter-spacing: 0.06em;
        }
        .sub {
          font-size: 11px;
        }
        nav {
          gap: var(--sp-3);
          font-size: 12px;
        }
      }
    </style>
  </body>
</html>
