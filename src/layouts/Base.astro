---
import "../styles/global.css";
import { heroesFile } from "../lib/data.ts";
import { SUPPORT_LINKS } from "../lib/links.ts";
/* カンパ先の文言だけは言語ごと(ほかのリンクはサービス名なので共通) */
const SUPPORT_LINK_HREF = SUPPORT_LINKS[0]?.href;
import { X_HANDLE, CF_BEACON_TOKEN, GOOGLE_SITE_VERIFICATION } from "../lib/site.ts";

interface Crumb {
  name: string;
  /** サイトルートからの絶対パス（例: /heroes/） */
  path: string;
}
interface Props {
  title: string;
  description?: string;
  /** OGP タイプ。トップは website、詳細ページは article 相当 */
  ogType?: string;
  /** パンくず（構造化データにも使う）。先頭に「トップ」は自動で付く。path はその言語版のパス */
  breadcrumbs?: Crumb[];
  /** 日付を持つページ(アップデートごとのページ)。ISO の日付。構造化データに出す */
  datePublished?: string;
  /**
   * そのページ固有のプレビュー画像。サイトルートからの絶対パス
   * (例 /images/heroes/card16x9/inferno.webp)。省略するとサイト共通の ogp.jpg。
   * 実寸を持つ画像だけを渡すこと(幅・高さを偽ると X 側でカードが崩れる)。
   */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /**
   * X のカード種別。既定は横長の summary_large_image。
   * アイテムやスキルのアイコンのような小さい正方形の絵は summary を指定する
   * (大カードは最低 300x157 を要求するので、小さい絵だと出ない)。
   */
  twitterCard?: "summary" | "summary_large_image";
  /** 検索避け。運用用の非公開ページ(SNSカード生成など)で使う */
  noindex?: boolean;
  /** そのページ固有の構造化データ(用語集の DefinedTermSet など)。サイト共通のものの後ろに足す */
  extraJsonLd?: Record<string, unknown>[];
}
const {
  title,
  description,
  ogType = "website",
  breadcrumbs = [],
  datePublished,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  twitterCard = "summary_large_image",
  noindex = false,
  extraJsonLd = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, currentLang, langPath, splitLangPath, LANG_META, alternatesFor, isIndexed, isLocalizedPath, isJaOnlyFrom, BUILT_LANGS } =
  Astro.locals.i18n;
const lang = currentLang();
const langMeta = LANG_META[lang];
const T = L();
const nav = [
  { href: `${base}${langPath("/heroes/")}`, label: T.nav.heroes, jaOnly: false },
  { href: `${base}${langPath("/items/")}`, label: T.nav.items, jaOnly: false },
  { href: `${base}${langPath("/build/")}`, label: T.nav.build, jaOnly: false },
  { href: `${base}${langPath("/mechanics/")}`, label: T.nav.mechanics, jaOnly: isJaOnlyFrom("/mechanics/") },
  { href: `${base}${langPath("/patch-notes/")}`, label: T.nav.patchNotes, jaOnly: isJaOnlyFrom("/patch-notes/") },
];
const path = Astro.url.pathname;
/** 言語の接頭辞を外したパス(どの言語版でも同じページなら同じ値) */
const pagePath = splitLangPath(path).path;

/*
 * 言語切り替え。多言語版があるページは同じページの各言語版へ、日本語のみのページは
 * 各言語のトップへ(その言語の辞書で「このページは日本語のみ」を添える)。
 * 国旗は public/images/flags/ の SVG(Windows は国旗の絵文字を表示できないため)。
 */
const pageIsLocalized = isLocalizedPath(pagePath);
const langOptions = BUILT_LANGS.map((l) => ({
  lang: l,
  meta: LANG_META[l],
  href: `${base}${pageIsLocalized || l === "ja" ? langPath(pagePath, l) : langPath("/", l)}`,
  /** 日本語のみのページで、その言語を選ぶとトップへ移る */
  note: !pageIsLocalized && l !== "ja" ? L(l).langSwitch.jaOnlyPage : null,
  current: l === lang,
}));

const SITE_NAME = "DEADLOCK-JP DB";
/* ドメインは astro.config.mjs の site が唯一の出どころ(ここに直書きしない) */
const SITE = Astro.site ?? new URL(import.meta.env.SITE);
const canonical = new URL(path, SITE).href;
/* SNSプレビュー画像は絶対URLでないと読まれない。ページ固有の指定が無ければ共通の絵 */
const ogImageUrl = new URL(ogImage ?? `${base}/images/ogp.jpg`, SITE).href;
const ogSize = ogImage
  ? { w: ogImageWidth, h: ogImageHeight }
  : { w: 1200, h: 630 };
const isHome = pagePath === "/" || pagePath === base + "/";
/* トップは「トップ | DEADLOCK-JP DB」と重複するので、サイト名だけにする */
const fullTitle = isHome ? SITE_NAME : `${title} | ${SITE_NAME}`;
const desc = description ?? T.site.description;
/*
 * 検索に出していない言語のページは noindex にする(リンクはたどらせる)。
 * noindex を明示したページ(運用用の非公開ページ)は従来どおり nofollow も付ける。
 */
const robots = noindex
  ? "noindex, nofollow"
  : isIndexed(lang)
    ? "index, follow, max-image-preview:large"
    : "noindex, follow";
/*
 * hreflang。検索に出す言語版が2つ以上あるページだけ(src/i18n/seo.ts)。
 * 検索に出さない言語のページ(noindex)には出さない。出すと自分を含まない組を名乗ることになる
 */
const alternates = noindex || !isIndexed(lang) ? [] : alternatesFor(pagePath);

/* 構造化データ（SEO / 生成AI検索対策）。値はサイトの事実のみ。 */
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    alternateName: T.site.ldAlternateName,
    url: new URL(langPath("/"), SITE).href,
    inLanguage: langMeta.htmlLang,
    description: T.site.ldDescription,
    about: {
      "@type": "VideoGame",
      name: "Deadlock",
      ...(T.site.gameAltName ? { alternateName: T.site.gameAltName } : {}),
      publisher: { "@type": "Organization", name: "Valve Corporation" },
    },
    isFamilyFriendly: true,
  },
];
/*
 * 日付を持つページ(アップデートごとのページ)は Article として日付を明示する。
 * 「いつの更新か」がページの本質なので、検索側にもそこを伝える。
 */
if (datePublished) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    datePublished,
    dateModified: datePublished,
    inLanguage: langMeta.htmlLang,
    mainEntityOfPage: canonical,
    description,
    isAccessibleForFree: true,
  });
}
const crumbs: Crumb[] = [{ name: T.site.crumbTop, path: langPath("/") }, ...breadcrumbs];
if (crumbs.length > 1) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.path, SITE).href,
    })),
  });
}
jsonLd.push(...extraJsonLd);
---

<!doctype html>
<html lang={langMeta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* JS が動く環境の印。スマホのヘッダーは、これがあるときだけメニューを ≡ に畳む(無ければ横並びのまま) */}
    <script is:inline>document.documentElement.classList.add("js")</script>
    {/*
      スマホの背景の静止画(global.css の .dlbg)を先に読み始める。CSS を読み終えてからだと、
      それまで背景が真っ暗なままになる。横向きのタブレット等で使う横長の絵は対象外(出す端末が少ない)
    */}
    <link rel="preload" as="image" href={`${base}/images/bg/bg-tall.webp`} type="image/webp" media="(max-width: 820px)" fetchpriority="high" />
    {/* ページ固有の先読み(ビルドページのデータの JSON など) */}
    <slot name="head" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE).href} />
    ))}
    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}

    {/* ファビコン。ico は 16/32/48 同梱 */}
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon-180.png`} />

    {/* Open Graph / Twitter（SNS・チャット・生成AIのプレビュー用） */}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={langMeta.ogLocale} />
    <meta property="og:type" content={isHome ? "website" : ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {/* Discord・Xなどに貼ったときのプレビュー画像 */}
    <meta property="og:image" content={ogImageUrl} />
    {ogSize.w && <meta property="og:image:width" content={String(ogSize.w)} />}
    {ogSize.h && <meta property="og:image:height" content={String(ogSize.h)} />}
    <meta property="og:image:alt" content={ogImage ? title : `${SITE_NAME} — ${T.site.ogAlt}`} />
    <meta name="twitter:card" content={twitterCard} />
    {X_HANDLE && <meta name="twitter:site" content={X_HANDLE} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />

    {/* ゲーム内表記に合わせて Noto Sans JP を使う。数字用に等幅も1書体だけ入れる。
        Cinzel はトップページの見出し専用(背景演出「Halftone Press」の書体)。
        日本語・英語のページは、サイトで使う文字だけに絞ったフォントを自前で配信する(tools/gen-fonts.mjs が
        ビルドの後に dist/fonts/ に作る)。本文の 400 の基本ファイルは先に読み始める(ファイル名はビルド後に差し替わる)。
        韓国語・簡体字中国語のページは、これまでどおり Google Fonts */}
    {!langMeta.font && (
      <>
        <link rel="preload" href={`${base}/fonts/__FONT_PRELOAD_NOTO400__`} as="font" type="font/woff2" crossorigin />
        <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
      </>
    )}
    {langMeta.font && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=Cinzel:wght@700&display=swap"
        />
      </>
    )}
    {/* 韓国語・簡体字中国語のページだけ、その言語の Noto Sans を足して先頭に置く */}
    {langMeta.font && (
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${langMeta.font.replace(/ /g, "+")}:wght@400;500;700&display=swap`}
      />
    )}
    {langMeta.font && (
      <style
        is:inline
        set:html={`html[lang="${langMeta.htmlLang}"]{--font-sans:"${langMeta.font}","Noto Sans JP","Segoe UI",sans-serif}`}
      />
    )}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)}
    />

    {/*
      アクセス解析(Cloudflare Web Analytics)。Cookieを使わず個人を追跡しないので
      同意バナーは要らない。トークンが空のあいだはタグ自体を出さない。
      defer なので表示速度には影響しない。
    */}
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
      />
    )}
  </head>
  <body>
    <div id="dlbg" class="dlbg" aria-hidden="true"></div>

    <header class="site-header">
      <div class="inner">
        <a class="wordmark" href={`${base}/`}>
          <span class="mark" aria-hidden="true"></span>
          <span class="name">DEADLOCK-JP</span>
          <span class="sub">DB</span>
        </a>
        <nav id="sitenav">
          {
            nav.map((n) => (
              <a href={n.href} class:list={[{ current: path.startsWith(n.href) }]}>
                {n.label}
                {n.jaOnly && <span class="jaonly">{T.jaOnly}</span>}
              </a>
            ))
          }
        </nav>
        <div class="langsw" id="langsw">
          <button
            type="button"
            class="langbtn"
            id="langbtn"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="langmenu"
            aria-label={T.langSwitch.label}
          >
            <img src={`${base}/images/flags/${langMeta.flag}.svg`} alt="" width="20" height="14" />
            <span class="langname">{langMeta.nativeName}</span>
            <span class="caret" aria-hidden="true"></span>
          </button>
          <ul class="langmenu" id="langmenu" hidden>
            {langOptions.map((o) => (
              <li>
                <a
                  href={o.href}
                  hreflang={o.meta.htmlLang}
                  lang={o.meta.htmlLang}
                  aria-current={o.current ? "true" : undefined}
                  data-samepage={o.note ? undefined : ""}
                >
                  <img src={`${base}/images/flags/${o.meta.flag}.svg`} alt="" width="20" height="14" />
                  <span class="lm-body">
                    <span class="lm-name">{o.meta.nativeName}</span>
                    {o.note && <span class="lm-note">{o.note}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        {/* スマホ・タブレットでメニューを開くボタン(≡)。PC と JS が無い環境では出さない */}
        <button
          type="button"
          class="menubtn"
          id="menubtn"
          aria-expanded="false"
          aria-controls="sitenav"
          aria-label={T.nav.menu}
        >
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>{T.footer.sourceBefore}<code>{heroesFile.upstreamCommit}</code>{T.footer.sourceAfter}</p>
        <p class="muted">{T.footer.disclaimer}<a href={`${base}/about/`}>{T.footer.about}</a>{isJaOnlyFrom("/about/") && <span class="jaonly">{T.jaOnly}</span>}</p>
        {/*
          カンパ先だけを権利表示より下に置き、目立たせない。
          X・Twitch・Discord は /about/ の最下部にまとめている。
        */}
        <p class="links">
          {SUPPORT_LINKS.map((l) => (
            <a href={l.href} rel="noopener" target="_blank">
              <span class="ico" set:html={l.icon} />
              {l.href === SUPPORT_LINK_HREF ? T.footer.support : l.label}
            </a>
          ))}
        </p>
      </div>
    </footer>

    <script is:inline>
      // 言語切り替えメニュー。ボタンで開閉し、キーボード(↓↑・Home/End・Esc)と外側クリックに対応する
      (() => {
        const btn = document.getElementById("langbtn");
        const menu = document.getElementById("langmenu");
        if (!btn || !menu) return;
        const items = () => [...menu.querySelectorAll("a")];
        const open = (focusFirst) => {
          // 同じページの別言語版へは、ビルドの共有URLなどのハッシュを引き継ぐ
          for (const a of menu.querySelectorAll("a[data-samepage]")) {
            a.href = a.href.split("#")[0] + location.hash;
          }
          menu.hidden = false;
          btn.setAttribute("aria-expanded", "true");
          document.dispatchEvent(new CustomEvent("headermenu", { detail: "lang" }));
          if (focusFirst) (menu.querySelector('a[aria-current="true"]') ?? items()[0])?.focus();
        };
        const close = (focusBtn) => {
          menu.hidden = true;
          btn.setAttribute("aria-expanded", "false");
          if (focusBtn) btn.focus();
        };
        btn.addEventListener("click", () => (menu.hidden ? open(false) : close(false)));
        btn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            open(true);
          } else if (e.key === "Escape") {
            close(false);
          }
        });
        menu.addEventListener("keydown", (e) => {
          const list = items();
          const i = list.indexOf(document.activeElement);
          if (e.key === "ArrowDown") {
            e.preventDefault();
            list[(i + 1) % list.length].focus();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            list[(i - 1 + list.length) % list.length].focus();
          } else if (e.key === "Home") {
            e.preventDefault();
            list[0].focus();
          } else if (e.key === "End") {
            e.preventDefault();
            list[list.length - 1].focus();
          } else if (e.key === "Escape") {
            e.preventDefault();
            close(true);
          } else if (e.key === "Tab") {
            close(false);
          }
        });
        document.addEventListener("click", (e) => {
          if (!menu.hidden && !document.getElementById("langsw").contains(e.target)) close(false);
        });
        document.addEventListener("headermenu", (e) => {
          if (e.detail !== "lang" && !menu.hidden) close(false);
        });
      })();

      /*
       * スマホ・タブレット(860px 以下)のメニュー(≡)。ヘッダーのすぐ下に全幅で開く。
       * 閉じるのは ≡ をもう一度 / 外側のタップ / Esc / 項目を選んだとき / フォーカスがメニューの外へ出たとき。
       * 開いたら最初の項目へ、≡ や Esc で閉じたら ≡ へフォーカスを移す。言語メニューとは同時に開かない
       */
      (() => {
        const btn = document.getElementById("menubtn");
        const nav = document.getElementById("sitenav");
        if (!btn || !nav) return;
        const isOpen = () => nav.classList.contains("open");
        const open = () => {
          nav.classList.add("open");
          btn.setAttribute("aria-expanded", "true");
          document.dispatchEvent(new CustomEvent("headermenu", { detail: "nav" }));
          nav.querySelector("a")?.focus();
        };
        const close = (focusBtn) => {
          if (!isOpen()) return;
          nav.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
          if (focusBtn) btn.focus();
        };
        btn.addEventListener("click", () => (isOpen() ? close(true) : open()));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            e.preventDefault();
            close(true);
          }
        });
        nav.addEventListener("click", (e) => {
          if (e.target.closest("a")) close(false);
        });
        nav.addEventListener("focusout", (e) => {
          if (e.relatedTarget && !nav.contains(e.relatedTarget) && e.relatedTarget !== btn) close(false);
        });
        document.addEventListener("click", (e) => {
          if (isOpen() && !nav.contains(e.target) && !btn.contains(e.target)) close(false);
        });
        document.addEventListener("headermenu", (e) => {
          if (e.detail !== "nav") close(false);
        });
        // PC の幅に戻ったら閉じた状態にする(開いたまま幅を広げても横並びに戻るように)
        matchMedia("(max-width: 860px)").addEventListener("change", (e) => {
          if (!e.matches) close(false);
        });
      })();
    </script>
    <script is:inline define:vars={{ bgScript: `${base}/js/deadlock-bg.js` }}>
      (() => {
        const el = document.getElementById("dlbg");
        if (!el) return;
        /*
         * スマホ・タッチ操作が主の端末・「視差効果を減らす」が有効な環境は、背景のアニメーションを使わず
         * 静止画にする(global.css の .dlbg)。スクリプト自体を読み込まない。条件は global.css と同じにしておくこと
         */
        if (matchMedia("(max-width: 820px), (pointer: coarse), (prefers-reduced-motion: reduce)").matches) return;
        const s = document.createElement("script");
        s.src = bgScript;
        s.onload = () => {
          if (!window.DeadlockBG) return;
          // UI全体のリンク色(--c-accent)ではなく、暗いキャンバス上で見えるよう
          // 明るくした背景専用のアクセント(--c-bg-accent)を使う
          const accent = getComputedStyle(document.documentElement)
            .getPropertyValue("--c-bg-accent")
            .trim();
          window.DeadlockBG.mount(el, { accent: accent || undefined, glow: 0.5 });
        };
        document.body.append(s);
      })();
    </script>

    <style>
      .site-header {
        /*
         * 追従ヘッダー。本文(.site-main)も z-index:1 を持っており、
         * 同じ重なり順だと後ろにあるDOMが上に描かれてヘッダーに重なる。
         * ヘッダー側を明示的に上に置く。
         */
        z-index: 20;
        border-bottom: 1px solid var(--c-glass-border-strong);
        background: var(--c-glass-header);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
      }
      /* backdrop-filter 非対応環境向けのフォールバック。背景キャンバスが
         透けない代わりに、ヘッダーの読みやすさを確保する */
      @supports not (backdrop-filter: blur(1px)) {
        .site-header {
          background: rgb(17 22 26 / 0.96);
        }
      }
      /*
       * スマホ(背景を静止画にする条件と同じ)では、ぼかしをやめる。色は tokens.css で不透明にしてある。
       * スクロールのたびに後ろをぼかし直すのが、iPhone の Safari では重かった
       */
      @media (max-width: 820px), (pointer: coarse), (prefers-reduced-motion: reduce) {
        .site-header {
          backdrop-filter: none;
          -webkit-backdrop-filter: none;
        }
      }
      .inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 var(--sp-5);
      }
      .site-header .inner {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: var(--sp-6);
        min-height: 58px;
      }
      .wordmark {
        display: flex;
        flex: 0 0 auto;
        align-items: baseline;
        gap: var(--sp-2);
        color: var(--c-text-strong);
        white-space: nowrap;
      }
      .wordmark:hover {
        text-decoration: none;
      }
      /* サムネイルのロゴ(円+スポーク)を簡略化した記号。flex で潰れて縦長にならないよう固定 */
      .mark {
        flex: 0 0 auto;
        width: 15px;
        height: 15px;
        border: 2px solid var(--c-accent);
        border-radius: 50%;
        position: relative;
        align-self: center;
        box-shadow: 0 0 10px rgb(63 191 143 / 0.45);
      }
      .mark::after {
        content: "";
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: var(--c-accent);
      }
      .name {
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.14em;
        white-space: nowrap;
      }
      .sub {
        font-size: 13px;
        font-weight: 700;
        color: var(--c-accent);
        letter-spacing: 0.1em;
        white-space: nowrap;
      }
      nav {
        display: flex;
        /* 縮む(=足りなければ横スクロール)が、伸びはしない。デスクトップの見た目は据え置き */
        flex: 0 1 auto;
        min-width: 0;
        gap: var(--sp-5);
        font-size: 14px;
        /* 収まらないときは折り返さず横スクロール */
        overflow-x: auto;
        scrollbar-width: none;
      }
      nav::-webkit-scrollbar {
        display: none;
      }
      nav a {
        flex: 0 0 auto;
        white-space: nowrap;
        color: var(--c-text-muted);
        padding: 4px 0;
        border-bottom: 2px solid transparent;
      }
      nav a:hover {
        color: var(--c-text);
        text-decoration: none;
      }
      nav a.current {
        color: var(--c-accent);
        border-bottom-color: var(--c-accent);
      }
      /* 日本語版にしか無いページへのリンク・日本語のままの補足メモに添える印(日本語版では出さない) */
      :global(.jaonly) {
        display: inline-block;
        margin-left: 5px;
        padding: 0 4px;
        border: 1px solid var(--c-border-strong);
        border-radius: 3px;
        font-size: 9.5px;
        font-weight: 400;
        line-height: 1.5;
        letter-spacing: 0;
        text-transform: none;
        color: var(--c-text-faint);
        vertical-align: 1px;
        white-space: nowrap;
      }

      /* ---- 言語切り替え(右上) ---- */
      .langsw {
        position: relative;
        flex: 0 0 auto;
        margin-left: auto;
      }
      .langbtn {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 8px;
        border: 1px solid var(--c-border-strong);
        border-radius: var(--radius);
        background: var(--c-surface);
        color: var(--c-text);
        font: inherit;
        font-size: 12.5px;
        cursor: pointer;
      }
      .langbtn:hover,
      .langbtn[aria-expanded="true"] {
        border-color: var(--c-accent-dim);
        color: var(--c-text-strong);
      }
      .langbtn:focus-visible,
      .langmenu a:focus-visible {
        outline: 2px solid var(--c-accent);
        outline-offset: 1px;
      }
      .langsw img {
        display: block;
        width: 20px;
        height: 14px;
        border-radius: 2px;
        box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18);
        object-fit: cover;
      }
      .caret {
        width: 0;
        height: 0;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 5px solid currentColor;
        opacity: 0.7;
      }
      .langbtn[aria-expanded="true"] .caret {
        transform: rotate(180deg);
      }
      .langmenu {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        z-index: 50;
        min-width: 190px;
        max-width: min(280px, calc(100vw - 24px));
        margin: 0;
        padding: 4px;
        list-style: none;
        background: var(--c-surface);
        border: 1px solid var(--c-border-strong);
        border-radius: var(--radius);
        box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
      }
      .langmenu[hidden] {
        display: none;
      }
      .langmenu a {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 7px 10px;
        border-radius: calc(var(--radius) - 2px);
        color: var(--c-text);
        font-size: 13px;
        text-decoration: none;
      }
      .langmenu a img {
        margin-top: 2px;
        flex: 0 0 auto;
      }
      .langmenu a:hover {
        background: var(--c-surface-2);
        color: var(--c-text-strong);
      }
      .langmenu a[aria-current="true"] {
        color: var(--c-accent);
      }
      .lm-body {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }
      .lm-note {
        font-size: 11px;
        color: var(--c-text-faint);
        line-height: 1.4;
      }
      .site-main {
        position: relative;
        /*
         * フッター(z-index:1)より上に置く。本文とフッターが同じ重なり順だと、
         * 後ろにあるフッターが本文の内側を丸ごと覆い、ホバーカード(position:fixed・
         * z-index:40)がページ最下部でフッターの裏に隠れる。カードは .site-main の
         * 内側にあるので、カード側の z-index をいくつ上げてもここで頭打ちになる。
         */
        z-index: 2;
        max-width: 1120px;
        margin: 0 auto;
        padding: var(--sp-6) var(--sp-5) var(--sp-7);
      }
      .site-footer {
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--c-border);
        margin-top: var(--sp-7);
        padding: var(--sp-5) 0;
        font-size: 12px;
        color: var(--c-text-muted);
      }
      .site-footer p {
        margin: 0 0 var(--sp-1);
      }
      .site-footer .muted {
        color: var(--c-text-faint);
      }
      /* 運営者のリンク。権利表示より控えめに、横並びで小さく置く */
      .site-footer .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-1) var(--sp-4);
        margin-top: var(--sp-3);
      }
      .site-footer .links a {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--c-text-faint);
        font-size: 11px;
      }
      .site-footer .links a:hover {
        color: var(--c-accent);
      }
      .site-footer .links .ico {
        display: inline-flex;
        line-height: 0;
      }
      /* ---- スマホ・タブレットのメニュー(≡)。PC と JS が無い環境では出さない ---- */
      .menubtn {
        display: none;
      }
      /*
       * 860px 以下ではメニューの5項目が1行に収まらない(実測: 英語 830px・日本語 800px で溢れる)。
       * JS がある環境では ≡ に畳み、開いたらヘッダーのすぐ下に全幅で出す
       */
      @media (max-width: 860px) {
        :global(.js) .site-header .inner {
          gap: var(--sp-3);
        }
        :global(.js) .menubtn {
          display: flex;
          flex: 0 0 auto;
          align-items: center;
          justify-content: center;
          width: 40px;
          height: 40px;
          margin-right: -6px;
          padding: 0;
          border: 1px solid transparent;
          border-radius: var(--radius);
          background: none;
          color: var(--c-text);
          cursor: pointer;
        }
        :global(.js) .menubtn:hover,
        :global(.js) .menubtn[aria-expanded="true"] {
          color: var(--c-text-strong);
          border-color: var(--c-border-strong);
        }
        .menubtn:focus-visible,
        :global(.js) nav a:focus-visible {
          outline: 2px solid var(--c-accent);
          outline-offset: -2px;
        }
        .bars {
          position: relative;
          display: block;
          width: 20px;
          height: 14px;
        }
        .bars i {
          position: absolute;
          left: 0;
          width: 100%;
          height: 2px;
          border-radius: 1px;
          background: currentColor;
          transition: transform 0.15s ease, opacity 0.15s ease;
        }
        .bars i:nth-child(1) { top: 0; }
        .bars i:nth-child(2) { top: 6px; }
        .bars i:nth-child(3) { top: 12px; }
        /* 開いているあいだは × */
        .menubtn[aria-expanded="true"] .bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
        .menubtn[aria-expanded="true"] .bars i:nth-child(2) { opacity: 0; }
        .menubtn[aria-expanded="true"] .bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
        @media (prefers-reduced-motion: reduce) {
          .bars i { transition: none; }
        }
        :global(.js) nav {
          display: none;
        }
        :global(.js) nav.open {
          display: flex;
          flex-direction: column;
          gap: 0;
          position: absolute;
          left: 0;
          right: 0;
          top: 100%;
          overflow: visible;
          padding: var(--sp-1) 0 var(--sp-2);
          font-size: 15px;
          background: var(--c-surface);
          border-bottom: 1px solid var(--c-glass-border-strong);
          box-shadow: 0 12px 28px rgb(0 0 0 / 0.5);
        }
        :global(.js) nav.open a {
          display: flex;
          align-items: center;
          min-height: 48px;
          padding: 0 var(--sp-5);
          border-bottom: none;
          color: var(--c-text);
        }
        :global(.js) nav.open a + a {
          border-top: 1px solid var(--c-border);
        }
        :global(.js) nav.open a:hover {
          background: var(--c-surface-2);
        }
        :global(.js) nav.open a.current {
          color: var(--c-accent);
          background: var(--c-accent-bg);
        }
      }
      @media (max-width: 640px) {
        .inner {
          padding: 0 var(--sp-4);
        }
        .site-header .inner {
          gap: var(--sp-3);
        }
        .name {
          font-size: 14px;
          letter-spacing: 0.06em;
        }
        .sub {
          font-size: 11px;
        }
        nav {
          gap: var(--sp-3);
          font-size: 12px;
        }
        /* スマホは国旗とつまみだけにして右上に収める */
        .langname {
          display: none;
        }
        .langbtn {
          padding: 0 6px;
          gap: 4px;
        }
      }
    </style>
  </body>
</html>
