---
/**
 * ヒーローの正方形アイコン(一覧カード用)。
 *
 * heroes.json の images.iconSmall を image-manifest で実ファイルに解決して表示する。
 * 実画像が無ければ頭文字のプレースホルダを描く(ItemIcon / AbilityIcon と同じ方針)。
 * 詳細ページ上部の大きい肖像は HeroRender.astro を使う。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import { resolveImagePath } from "../parsers/image-manifest.ts";

interface Props {
  name: string;
  /** file://{images}/heroes/*.psd 形式 */
  image: string | null;
  /** 一辺(px) */
  size?: number;
}
const { name, image, size = 56 } = Astro.props;

let src: string | null = null;
if (image) {
  const resolved = resolveImagePath(image);
  if (resolved && existsSync(join(process.cwd(), resolved.outPath))) {
    src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${resolved.outPath.replace(/^public\//, "")}`;
  }
}

/** プレースホルダ用の頭文字。日本語名は先頭1文字を使う */
const initial = /^[\x20-\x7e]+$/.test(name)
  ? name
      .split(/[\s'-]+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? "")
      .join("")
  : name.slice(0, 1);
---

<span class="portrait" style={`--size: ${size}px`} title={name}>
  {
    src ? (
      <img src={src} alt="" loading="lazy" />
    ) : (
      <span class="ph" aria-hidden="true">
        {initial}
      </span>
    )
  }
</span>

<style>
  .portrait {
    display: block;
    overflow: hidden;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    line-height: 0;
    width: var(--size);
    height: var(--size);
    flex: 0 0 auto;
    border-radius: 6px;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-weight: 700;
    line-height: 1;
    color: var(--c-accent);
    background:
      repeating-linear-gradient(135deg, transparent 0 6px, rgb(255 255 255 / 0.02) 6px 12px),
      var(--c-surface-2);
    font-size: calc(var(--size) * 0.36);
  }
</style>
