---
/**
 * ソウル(ゲーム内通貨)のアイコン。
 *
 * ゲーム本体にも panorama/images/hud/icons/icon_soul.vsvg があるが、
 * 今回抽出した393枚には含まれていない(データ側が参照していないため)。
 * ここでは当サイトで描いた図形を使っている。ゲームのアイコンそのものではない。
 *
 * 色は --c-soul(水色)。currentColor を使うので、親の色を継げば追従する。
 */
interface Props {
  size?: number;
}
const { size = 13 } = Astro.props;
---

<svg
  class="soul"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M8 1.2 12.4 5v6L8 14.8 3.6 11V5Z"
    fill="currentColor"
    opacity="0.22"
  />
  <path
    d="M8 1.2 12.4 5v6L8 14.8 3.6 11V5Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linejoin="round"
  />
  <path d="M8 4.6 10.4 6.4v3.2L8 11.4 5.6 9.6V6.4Z" fill="currentColor" />
</svg>

<style>
  .soul {
    display: inline-block;
    vertical-align: -0.12em;
    flex: 0 0 auto;
  }
</style>
