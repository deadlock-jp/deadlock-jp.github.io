---
/** 強化/弱体/リワークを一目で示す簡易アイコン。配色は AdjustmentHistory.astro と共通。 */
export interface Props {
  kind: "buff" | "nerf" | "rework";
}
const { kind } = Astro.props;

const PATHS: Record<Props["kind"], string> = {
  buff: '<path d="M8 3.2 13.4 11.6H2.6Z"/>',
  nerf: '<path d="M8 12.8 2.6 4.4h10.8Z"/>',
  rework:
    '<path d="M2 5.2h9.4L9 3M14 10.8H4.6L7 13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<svg class:list={["adjicon", kind]} viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" set:html={PATHS[kind]} />

<style>
  .adjicon { flex: none; vertical-align: -1px; }
  .adjicon.buff { color: var(--c-vitality); }
  .adjicon.nerf { color: var(--c-weapon); }
  .adjicon.rework { color: var(--c-spirit); }
</style>
