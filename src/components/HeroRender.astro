---
/**
 * ヒーロー詳細ページ上部の肖像。
 *
 * ゲーム本体の <英語表示名>_Render.png を幅760のWebPに縮小したものを
 * public/images/heroes/render/<herokey>.webp に置いてある(tools/hero-images.mjs)。
 * 帯状に切り出す。object-fit: cover + object-position で、顔が入る位置(上から約2割)
 * を見せる。無ければ何も出さない。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
  /** heroes.json の key (hero_inferno など) */
  heroKey: string;
}
const { name, heroKey } = Astro.props;
const key = heroKey.replace(/^hero_/, "");
const rel = `images/heroes/render/${key}.webp`;
const src = existsSync(join(process.cwd(), "public", rel))
  ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${rel}`
  : null;
---

{
  src && (
    <div class="hrender" role="img" aria-label={name}>
      <img src={src} alt="" />
    </div>
  )
}

<style>
  .hrender {
    width: 100%;
    /* 帯。横幅に対して高さを決める(830px幅で ≒ 300px) */
    aspect-ratio: 25 / 9;
    max-height: 340px;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 80% at 50% 0%, rgb(63 191 143 / 0.1), transparent 70%),
      var(--c-surface-2);
    margin-bottom: var(--sp-3);
  }
  .hrender img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 元絵はほぼ正方形。ヒーローごとに構図が違うので、頭が概ね入る上寄りで固定 */
    object-position: center 12%;
    display: block;
  }
</style>
