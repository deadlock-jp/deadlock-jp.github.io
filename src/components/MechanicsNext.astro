---
/** 攻略情報の各ページの末尾に置く「次に読む」(行き先は src/lib/mechanicsPages.ts の MECH_NEXT) */
import { MECH_PAGES, MECH_NEXT } from "../lib/mechanicsPages.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pagePath = Astro.url.pathname.slice(base.length);
const next = (MECH_NEXT[pagePath] ?? []).flatMap((p) => MECH_PAGES.filter((m) => m.path === p));
---

{next.length > 0 && (
  <nav class="mechnext" aria-label="次に読む">
    <h2>次に読む</h2>
    <ul>
      {next.map((m) => (
        <li>
          <a href={`${base}${m.path}`}>
            <b>{m.title}</b>
            <span>{m.body}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .mechnext { margin-top: var(--sp-5); }
  .mechnext h2 { font-size: 15px; margin: 0 0 var(--sp-2); }
  .mechnext ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: var(--sp-2); }
  .mechnext a {
    display: flex; flex-direction: column; gap: 2px; height: 100%; padding: var(--sp-2) var(--sp-3);
    background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); color: inherit;
  }
  .mechnext a:hover { border-color: var(--c-accent-dim); text-decoration: none; }
  .mechnext a:hover b { color: var(--c-accent); }
  .mechnext b { font-size: 14px; color: var(--c-text-strong); }
  .mechnext span { font-size: 12.5px; color: var(--c-text-muted); }
</style>
