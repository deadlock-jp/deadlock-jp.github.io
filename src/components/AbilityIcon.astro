---
/**
 * スキルアイコン。
 *
 * abilities.json の image(file://{images}/... 形式)を image-manifest.json で
 * 実ファイルのパスに変換して表示する。実画像が無ければ同じ寸法の
 * プレースホルダを描く(ItemIcon と同じ方針)。
 *
 * アイテムと違って画像は角丸の枠に収めるだけで、ティア表記やバッジは付けない。
 * ゲーム内でもスキルアイコンにはそれらが乗らない。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import { resolveImagePath } from "../parsers/image-manifest.ts";
import { smallImage } from "../lib/thumbs.ts";

interface Props {
  name: string;
  /** abilities.json の image。file://{images}/... 形式 */
  image: string | null;
  /** アイコンの一辺(px) */
  size?: number;
  /** 枠と文字の色に使うCSS変数名。既定はアクセント色 */
  cssVar?: string;
}
const { name, image, size = 44, cssVar = "accent" } = Astro.props;

// 実画像の有無をビルド時に判定する
let src: string | null = null;
if (image) {
  const resolved = resolveImagePath(image);
  if (resolved && existsSync(join(process.cwd(), resolved.outPath))) {
    // 小さく出すので、縮小版(src/lib/thumbs.ts)があればそちら
    src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${smallImage(resolved.outPath, size)}`;
  }
}

/** プレースホルダ用の頭文字 */
const initials = name
  .split(/[\s'・-]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");
---

<span
  class="aicon"
  style={`--cat: var(--c-${cssVar}); --cat-bg: var(--c-${cssVar}-bg); --size: ${size}px`}
  title={name}
>
  {
    src ? (
      <img src={src} alt="" width={size} height={size} loading="lazy" />
    ) : (
      <span class="ph" aria-hidden="true">
        {initials}
      </span>
    )
  }
</span>

<style>
  .aicon {
    display: inline-block;
    width: var(--size);
    height: var(--size);
    flex: 0 0 auto;
    border-radius: 6px;
    border: 1px solid var(--cat);
    background: var(--cat-bg);
    overflow: hidden;
    line-height: 0;
  }
  .aicon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: calc(var(--size) * 0.34);
    font-weight: 700;
    line-height: 1;
    color: var(--cat);
    background:
      repeating-linear-gradient(135deg, transparent 0 6px, rgb(255 255 255 / 0.02) 6px 12px),
      var(--c-surface-2);
  }
</style>
