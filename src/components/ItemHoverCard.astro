---
/**
 * アイテムのマウスオーバー詳細カード(ビルド画面・アイテム一覧・トップで共用)。
 *
 * `[data-itemcard="<itemId>"]` を持つ要素に自動でホバー/フォーカスを張る。
 * データは全アイテムぶんを別ファイル(/hover/items.json。src/lib/hoverData.ts)にし、必要になってから読む。
 * 中身は JS 組み立てなので CSS は :global。
 */
const { L, term } = Astro.locals.i18n;
/** データの URL(言語ごと)。中身は src/lib/hoverData.ts、配るのは src/pages/hover/[kind].json.ts */
const dataUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}${Astro.locals.i18n.LANG_META[Astro.locals.i18n.currentLang()].prefix}/hover/items.json`;
/** カード内の文言。{n} は数値の差し込み位置 */
const c = L().itemCard;
const T = {
  tier: L().common.tier("{n}"),
  cost: c.cost,
  slotCost: c.slotCost,
  passives: c.passives,
  conditional: c.conditional,
  components: term("componentsOf"),
  usedIn: term("upgradesTo"),
  sep: L().common.listSep,
  dot: L().common.dot,
  /** 効果の分類名(バッジの title)と記号。EffectBadges.astro と同じ */
  effCat: L().effects.categories,
  effGlyph: { control: "■", weaken: "▼", protect: "◆", counter: "↺" },
};
---

<div class="hovercard" id="hovercard" role="tooltip" hidden></div>

<script is:inline define:vars={{ dataUrl, T }}>
  (() => {
    const card = document.getElementById("hovercard");
    if (!card) return;
    /*
     * データ(src/lib/hoverData.ts)は別ファイル。マウスのある広い画面だけ、手が空いたときに先に読んでおく。
     * 読み終わる前にカードを出そうとしたら、読み終わってから(まだ同じ所にマウスがあれば)出す
     */
    let details = null;
    let loading = null;
    let waiting = null;
    const load = () =>
      (loading ??= fetch(dataUrl)
        .then((r) => (r.ok ? r.json() : {}))
        .catch(() => ({}))
        .then((d) => (details = d)));
    if (matchMedia("(min-width: 1001px) and (hover: hover)").matches) {
      (window.requestIdleCallback || ((f) => setTimeout(f, 1500)))(() => load());
    }
    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    const fmt = (n) => Number(n).toLocaleString("en-US");

    const rows = (list, cls) =>
      list.length
        ? `<ul class="${cls}">${list
            .map((r) => `<li><span class="l">${esc(r.label)}</span><span class="v">${esc(r.value)}</span></li>`)
            .join("")}</ul>`
        : "";

    function show(id, anchor) {
      if (!details) {
        waiting = anchor;
        load().then(() => waiting === anchor && show(id, anchor));
        return;
      }
      const it = details[id];
      if (!it) return;
      card.style.setProperty("--cat", `var(--c-${it.cssVar})`);
      card.style.setProperty("--cat-bg", `var(--c-${it.cssVar}-bg)`);
      card.innerHTML =
        `<div class="hc-head"><span class="hc-name">${esc(it.name)}</span>` +
        `${it.badge ? `<span class="hc-badge">${esc(it.badge)}</span>` : ""}</div>` +
        `<div class="hc-meta">${esc(it.slotLabel)}${T.dot}${esc(T.tier.replace("{n}", it.tier))}${T.dot}` +
        `<span class="hc-soul">${esc(T.cost.replace("{n}", fmt(it.cost)))}</span>${T.dot}${esc(T.slotCost.replace("{n}", it.slotCost))}</div>` +
        (it.effects && it.effects.length
          ? `<div class="hc-eff">${it.effects
              .map((e) => `<span class="hce hce-${e.c}" title="${esc(T.effCat[e.c])}"><i>${T.effGlyph[e.c]}</i>${esc(e.n)}${e.v ? ` <b>${esc(e.v)}</b>` : ""}</span>`)
              .join("")}</div>`
          : "") +
        (it.desc ? `<p class="hc-desc">${esc(it.desc)}</p>` : "") +
        (it.passives.length ? `<div class="hc-sec">${esc(T.passives)}</div>${rows(it.passives, "hc-rows")}` : "") +
        (it.conditional.length ? `<div class="hc-sec">${esc(T.conditional)}</div>${rows(it.conditional, "hc-rows")}` : "") +
        (it.components.length ? `<div class="hc-rel">${esc(T.components)}: ${esc(it.components.join(T.sep))}</div>` : "") +
        (it.usedIn.length ? `<div class="hc-rel">${esc(T.usedIn)}: ${esc(it.usedIn.join(T.sep))}</div>` : "");
      card.hidden = false;

      const place = () => {
        const M = 8;
        const r = anchor.getBoundingClientRect();
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        const vw = document.documentElement.clientWidth;
        const vh = document.documentElement.clientHeight;
        let left = r.right + 10;
        if (left + cw > vw - M) left = r.left - cw - 10;
        left = Math.max(M, Math.min(left, vw - cw - M));
        let top = Math.min(r.top - 4, vh - ch - M);
        top = Math.max(M, top);
        card.style.left = left + "px";
        card.style.top = top + "px";
      };
      place();
      requestAnimationFrame(place);
    }
    const hide = () => {
      waiting = null;
      card.hidden = true;
    };

    function wire(root) {
      const scope = root || document;
      for (const a of scope.querySelectorAll("[data-itemcard]")) {
        if (a.dataset.icWired) continue;
        a.dataset.icWired = "1";
        const id = a.dataset.itemcard;
        a.addEventListener("mouseenter", () => show(id, a));
        a.addEventListener("focus", () => show(id, a));
        a.addEventListener("mouseleave", hide);
        a.addEventListener("blur", hide);
      }
    }

    window.itemHoverCard = { show, hide, wire };
    wire();
    window.addEventListener("scroll", hide, { passive: true });
  })();
</script>

<style>
  .hovercard {
    position: fixed;
    z-index: 40;
    width: 280px;
    max-height: calc(100vh - 16px);
    overflow: auto;
    background: var(--c-surface);
    border: 1px solid var(--cat, var(--c-accent));
    border-left: 3px solid var(--cat, var(--c-accent));
    border-radius: var(--radius);
    padding: var(--sp-3);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }
  .hovercard :global(.hc-head) { display: flex; align-items: center; gap: var(--sp-2); }
  .hovercard :global(.hc-name) { font-weight: 700; color: var(--c-text-strong); font-size: 14px; }
  .hovercard :global(.hc-badge) {
    font-size: 9px; font-weight: 700; letter-spacing: .06em; padding: 0 4px; border-radius: 2px;
    color: var(--c-bg); background: var(--cat, var(--c-accent));
  }
  .hovercard :global(.hc-meta) {
    font-size: 11px; color: var(--cat, var(--c-accent)); margin-top: 2px; font-family: var(--font-mono);
  }
  .hovercard :global(.hc-soul) { color: var(--c-soul); }
  /* 状態異常・効果(EffectBadges.astro と同じ色分け) */
  .hovercard :global(.hc-eff) { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 6px; }
  .hovercard :global(.hce) {
    --eb: var(--c-accent); display: inline-flex; align-items: baseline; gap: 3px;
    font-size: 10.5px; padding: 0 6px; border: 1px solid var(--eb); border-radius: 999px; color: var(--c-text-strong);
  }
  .hovercard :global(.hce i) { font-style: normal; font-size: 8px; color: var(--eb); }
  .hovercard :global(.hce b) { font-weight: 400; font-family: var(--font-mono); color: var(--c-text-muted); }
  .hovercard :global(.hce-control) { --eb: var(--c-nerf); border-radius: 3px; }
  .hovercard :global(.hce-weaken) { --eb: var(--c-weapon); border-style: dashed; }
  .hovercard :global(.hce-protect) { --eb: var(--c-buff); }
  .hovercard :global(.hc-desc) { font-size: 12px; color: var(--c-text); line-height: 1.6; margin: var(--sp-2) 0 0; }
  .hovercard :global(.hc-sec) {
    font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--c-text-muted); margin-top: var(--sp-3);
  }
  .hovercard :global(.hc-rows) { list-style: none; padding: 0; margin: 2px 0 0; }
  .hovercard :global(.hc-rows li) {
    display: flex; justify-content: space-between; gap: var(--sp-3);
    font-size: 11px; padding: 2px 0; border-bottom: 1px solid var(--c-border);
  }
  .hovercard :global(.hc-rows .l) { color: var(--c-text-muted); }
  .hovercard :global(.hc-rows .v) { font-family: var(--font-mono); color: var(--c-text-strong); }
  .hovercard :global(.hc-rel) { font-size: 11px; color: var(--c-text-muted); margin-top: var(--sp-2); }

  @media (max-width: 1000px) {
    .hovercard { display: none; }
  }
</style>
