---
/**
 * スキルカードの数値行につく小さい装飾アイコン。
 *
 * ゲーム本編は項目ごと(ダメージ／継続時間／クールダウン等)に専用アイコンを出すが、
 * その画像はゲームのコンパイル済みコード側に組み込まれておりデータからは
 * 抽出できなかった(architecture.html参照)。ここでは意味の近い簡易SVGで代用する。
 * 種別(kind)は src/lib/skillcard.ts の StatIconKind /
 * ICON_BY_CSS_CLASS(ゲーム側の m_strCSSClass 分類)から来る。
 */
import { STAT_ICON_PATHS, type StatIconKind } from "../lib/skillcard.ts";

export interface Props {
  kind: StatIconKind | null;
}
const { kind } = Astro.props;

const path = kind ? STAT_ICON_PATHS[kind] : null;
---

{
  path && (
    <svg class="staticon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" set:html={path} />
  )
}

<style>
  .staticon { flex: none; opacity: 0.75; vertical-align: -1px; }
</style>
