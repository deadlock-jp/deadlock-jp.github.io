---
/**
 * スキルアイコンのマウスオーバー詳細カード(ヒーロー一覧カードで使用)。
 *
 * 中身はヒーロー詳細ページの SkillCard.astro とほぼ同じ見た目(ヘッダー+メタバッジ+
 * 主要タイル+副次行+AP強化)。ただしこちらは1つの共有DOMをJSで使い回すポップアップ
 * なので、SkillCard.astro のようにAstroコンポーネントとしては描けず、HTML文字列を
 * 組み立てる(ItemHoverCard.astro / HeroHoverCard.astro と同じ方式)。
 * アイコン画像だけは build/index.astro と同じ「隠しプールから clone」方式にして、
 * AbilityIcon.astro の画像解決ロジックをここで重複させない。
 *
 * `[data-abilitycard="<abilityKey>"]` を持つ要素に自動でホバー/フォーカスを張る。
 */
import { STAT_ICON_PATHS, type CardRow, type DamageRow, type UpgradeTier } from "../lib/skillcard.ts";

export interface AbilityHoverDetail {
  name: string;
  isUlt: boolean;
  isPassive: boolean;
  meta: CardRow[];
  desc: string;
  tiles: DamageRow[];
  secondaryRows: CardRow[];
  upgrades: UpgradeTier[];
  notes: string[];
}

interface Props {
  /** abilityKey → AbilityHoverDetail */
  details: Record<string, AbilityHoverDetail>;
}
const { details } = Astro.props;
---

<div class="hovercard" id="abilityhovercard" role="tooltip" hidden></div>

<script is:inline define:vars={{ details, iconPaths: STAT_ICON_PATHS }}>
  (() => {
    const card = document.getElementById("abilityhovercard");
    if (!card) return;
    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

    const icon = (kind) => (kind && iconPaths[kind] ? `<svg class="hi" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">${iconPaths[kind]}</svg>` : "");

    /** "25秒" のような値文字列を、末尾の unit ぶんだけ切り離す */
    const splitUnit = (value, unit) => (unit && value.endsWith(unit) ? [value.slice(0, -unit.length), unit] : [value, ""]);

    function metaRow(m) {
      const [num, unit] = splitUnit(m.value, m.unit);
      return `<li>${icon(m.icon)}${esc(m.label)}<span class="mv">${esc(num)}${unit ? `<small class="mu">${esc(unit)}</small>` : ""}</span></li>`;
    }
    function tile(row) {
      const [num, unit] = splitUnit(row.value, row.unit);
      return (
        `<div class="tile${row.scale !== null ? " scaled" : ""}">` +
        (row.scale !== null ? `<span class="tscale">${icon("spirit")}×${Math.round(row.scale * 100) / 100}</span>` : "") +
        `<div class="tval">${esc(num)}${unit ? `<span class="tu">${esc(unit)}</span>` : ""}</div>` +
        `<div class="tlabel">${esc(row.label)}</div></div>`
      );
    }
    function secondaryRow(row) {
      const [num, unit] = splitUnit(row.value, row.unit);
      return `<span class="srow"><span class="l">${esc(row.label)}</span><span class="v">${esc(num)}${unit ? `<small class="su">${esc(unit)}</small>` : ""}</span></span>`;
    }
    function upgradeCell(tier) {
      const body = tier.description
        ? esc(tier.description)
        : tier.rows.map((r) => `<span class="upart">${esc(r.label)} <b>${esc(r.value)}</b></span>`).join("");
      return (
        `<div class="ucell"><span class="uap">${icon("ap")}${tier.ap}<small>AP</small></span>` +
        `<span class="ubody">${body}</span></div>`
      );
    }

    function show(key, anchor) {
      const d = details[key];
      if (!d) return;
      const iconSrc = document.querySelector(`.hcicon-src[data-ability="${CSS.escape(key)}"] .aicon`);

      card.className = "hovercard" + (d.isUlt ? " ult" : "");
      card.innerHTML =
        `<div class="hc-head">` +
        `<span class="hc-icon">${iconSrc ? iconSrc.outerHTML : ""}</span>` +
        `<div class="hc-title"><span class="snamerow"><span class="hc-name">${esc(d.name)}</span>` +
        (d.isUlt ? `<span class="tag ult-tag">アルティメット</span>` : "") +
        (d.isPassive ? `<span class="tag passive-tag">パッシブ</span>` : "") +
        `</span>` +
        (d.meta.length ? `<ul class="smeta">${d.meta.map(metaRow).join("")}</ul>` : "") +
        `</div></div>` +
        `<p class="sdesc">${esc(d.desc)}</p>` +
        (d.tiles.length ? `<div class="stiles">${d.tiles.map(tile).join("")}</div>` : "") +
        (d.secondaryRows.length ? `<div class="ssecondary">${d.secondaryRows.map(secondaryRow).join("")}</div>` : "") +
        (d.upgrades.length ? `<div class="supg">${d.upgrades.map(upgradeCell).join("")}</div>` : "") +
        (d.notes.length
          ? `<div class="snotes"><span class="nt">メモ</span><ul>${d.notes.map((n) => `<li>${esc(n)}</li>`).join("")}</ul></div>`
          : "");
      card.hidden = false;

      const place = () => {
        const M = 8;
        const r = anchor.getBoundingClientRect();
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        const vw = document.documentElement.clientWidth;
        const vh = document.documentElement.clientHeight;
        let left = r.right + 10;
        if (left + cw > vw - M) left = r.left - cw - 10;
        left = Math.max(M, Math.min(left, vw - cw - M));
        let top = Math.min(r.top - 4, vh - ch - M);
        top = Math.max(M, top);
        card.style.left = left + "px";
        card.style.top = top + "px";
      };
      place();
      requestAnimationFrame(place);
    }
    const hide = () => (card.hidden = true);

    function wire(root) {
      const scope = root || document;
      for (const a of scope.querySelectorAll("[data-abilitycard]")) {
        if (a.dataset.ahcWired) continue;
        a.dataset.ahcWired = "1";
        const key = a.dataset.abilitycard;
        a.addEventListener("mouseenter", () => show(key, a));
        a.addEventListener("focus", () => show(key, a));
        a.addEventListener("mouseleave", hide);
        a.addEventListener("blur", hide);
      }
    }

    window.abilityHoverCard = { show, hide, wire };
    wire();
    window.addEventListener("scroll", hide, { passive: true });
  })();
</script>

<style>
  .hovercard {
    position: fixed;
    z-index: 40;
    width: 360px;
    max-height: calc(100vh - 16px);
    overflow: auto;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 2px solid var(--c-accent-dim);
    border-radius: var(--radius-lg);
    padding: var(--sp-3);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }
  .hovercard.ult { border-top-color: var(--c-spirit); }

  .hovercard :global(.hc-head) { display: flex; align-items: flex-start; gap: var(--sp-2); }
  .hovercard :global(.hc-icon) { flex: none; line-height: 0; }
  .hovercard :global(.hc-title) { min-width: 0; flex: 1; }
  .hovercard :global(.snamerow) { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2); }
  .hovercard :global(.hc-name) { font-size: 15px; font-weight: 700; color: var(--c-text-strong); line-height: 1.3; }
  .hovercard :global(.tag) { padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; }
  .hovercard :global(.ult-tag) { color: var(--c-spirit); background: var(--c-spirit-bg); border: 1px solid var(--c-spirit); }
  .hovercard :global(.passive-tag) { color: var(--c-text-muted); background: var(--c-surface-2); border: 1px solid var(--c-border-strong); }

  .hovercard :global(.smeta) { list-style: none; padding: 0; margin: var(--sp-2) 0 0; display: flex; flex-wrap: wrap; gap: 5px; }
  .hovercard :global(.smeta li) {
    display: inline-flex; align-items: center; gap: 4px;
    background: var(--c-surface-2); border: 1px solid var(--c-border); border-radius: var(--radius);
    padding: 2px 6px; font-size: 10px; color: var(--c-text-muted); white-space: nowrap;
  }
  .hovercard :global(.smeta .mv) { font-family: var(--font-mono); font-size: 11px; color: var(--c-text-strong); }
  .hovercard :global(.smeta .mu) { font-size: 9px; color: var(--c-text-muted); margin-left: 1px; }
  .hovercard :global(.hi) { flex: none; opacity: 0.75; }

  .hovercard :global(.sdesc) { font-size: 12px; line-height: 1.65; color: var(--c-text-muted); margin: var(--sp-2) 0 0; }

  .hovercard :global(.stiles) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--sp-2); }
  .hovercard :global(.tile) {
    position: relative; flex: 1 1 96px; min-width: 0; text-align: center;
    padding: 8px 6px 6px; border-radius: var(--radius); background: var(--c-surface-2); border: 1px solid var(--c-border);
  }
  .hovercard :global(.tile.scaled) { background: var(--c-spirit-bg); border-color: var(--c-spirit); }
  .hovercard :global(.tscale) {
    position: absolute; top: 3px; right: 4px; display: inline-flex; align-items: center; gap: 1px;
    font-family: var(--font-mono); font-size: 9px; color: var(--c-spirit);
  }
  .hovercard :global(.tval) { font-family: var(--font-mono); font-size: 19px; font-weight: 700; color: var(--c-text-strong); line-height: 1.1; }
  .hovercard :global(.tu) { font-size: 12px; color: var(--c-text-muted); margin-left: 1px; }
  .hovercard :global(.tlabel) { margin-top: 3px; font-size: 10px; color: var(--c-text-muted); }

  .hovercard :global(.ssecondary) {
    margin-top: var(--sp-2); padding: 6px var(--sp-2); border-radius: var(--radius);
    background: var(--c-surface-2); border: 1px solid var(--c-border);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 3px var(--sp-3);
  }
  .hovercard :global(.srow) { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-2); font-size: 11px; color: var(--c-text-muted); }
  .hovercard :global(.srow .v) { font-family: var(--font-mono); font-size: 12px; color: var(--c-text); white-space: nowrap; }
  .hovercard :global(.srow .su) { font-size: 9px; color: var(--c-text-muted); margin-left: 1px; }

  .hovercard :global(.supg) { margin-top: var(--sp-2); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .hovercard :global(.ucell) { display: flex; flex-direction: column; border: 1px solid var(--c-border); border-radius: var(--radius); overflow: hidden; }
  .hovercard :global(.uap) {
    display: flex; align-items: center; justify-content: center; gap: 2px; padding: 3px;
    background: var(--c-accent-bg); border-bottom: 1px solid var(--c-border);
    font-family: var(--font-mono); font-size: 10px; color: var(--c-accent);
  }
  .hovercard.ult :global(.uap) { background: var(--c-spirit-bg); color: var(--c-spirit); }
  .hovercard :global(.uap small) { font-size: 8px; opacity: 0.8; }
  .hovercard :global(.ubody) { flex: 1; padding: 5px 5px 7px; font-size: 10.5px; line-height: 1.45; color: var(--c-text); text-align: center; }
  .hovercard :global(.ubody b) { font-family: var(--font-mono); color: var(--c-text-strong); }
  .hovercard :global(.upart:not(:last-child)::after) { content: "、"; color: var(--c-text-muted); }

  .hovercard :global(.snotes) { margin-top: var(--sp-2); padding-top: var(--sp-2); border-top: 1px dashed var(--c-border); }
  .hovercard :global(.snotes .nt) { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-faint); }
  .hovercard :global(.snotes ul) { margin: 2px 0 0; padding-left: 1.1em; font-size: 11px; color: var(--c-text-muted); line-height: 1.6; }

  @media (max-width: 1000px) {
    .hovercard { display: none; }
  }
</style>
