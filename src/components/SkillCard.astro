---
/**
 * スキル1つぶんのカード本体。
 * ヒーロー詳細ページのスキル一覧と、スキル単体の詳細ページ(/abilities/<実ID>/)の
 * 両方から使う共通コンポーネント。見た目・データ源は完全に同じにする。
 *
 * 見た目はゲーム本編のスキルUIに寄せた情報密度の高いカード(2026-09、デザイン
 * ハンドオフ「Deadlock スキルカード UI 改善」を反映)。主要な数値を大きなタイルで、
 * それ以外は薄い帯の一覧で出す。どの数値をタイルにするかは、データの並び順で
 * ダメージ→効果の先頭から機械的に埋める(スキルごとの意味判断はしない)。
 */
import type { Ability } from "../types/ability.ts";
import type { SkillCard as SkillCardData } from "../lib/skillcard.ts";
import { t, describe } from "../lib/data.ts";
import AbilityIcon from "./AbilityIcon.astro";
import StatIcon from "./StatIcon.astro";

export interface Props {
  abilityKey: string;
  ab: Ability;
  card: SkillCardData;
  notes: string[];
  /** {s:hero_name} 解決用のヒーロー表示名 */
  heroName: string;
  /** 指定するとスキル名がこのURLへのリンクになる(ヒーローページ→スキル詳細への導線) */
  href?: string;
}
const { abilityKey, ab, card, notes, heroName, href } = Astro.props;
const isUlt = ab.kind === "Ultimate";
const isPassive = !isUlt && ab.activation === "PASSIVE";
const name = t(abilityKey, abilityKey);

/** "25秒" のような値文字列を、末尾の unit ぶんだけ切り離して {num, unit} にする */
function splitUnit(value: string, unit: string): { num: string; unit: string } {
  return unit && value.endsWith(unit) ? { num: value.slice(0, -unit.length), unit } : { num: value, unit: "" };
}
/** スピリット係数の表示用丸め(内部の浮動小数誤差を出さない。値そのものは変えない) */
const fmtScale = (n: number) => (Math.round(n * 100) / 100).toString();
---

<article class:list={["skill", { ult: isUlt }]}>
  <header class="shead">
    <AbilityIcon name={name} image={ab.image} size={48} cssVar={isUlt ? "spirit" : "accent"} />
    <div class="stitle">
      <div class="snamerow">
        {href ? <a href={href}>{name}</a> : <span class="sname-plain">{name}</span>}
        {isUlt && <span class="tag ult-tag">アルティメット</span>}
        {isPassive && <span class="tag passive-tag">パッシブ</span>}
      </div>
      {card.meta.length > 0 && (
        <ul class="smeta">
          {card.meta.map((m) => {
            const sp = splitUnit(m.value, m.unit);
            return (
              <li>
                <StatIcon kind={m.icon} />
                {m.label}
                <span class="mv">
                  {sp.num}
                  {sp.unit && <small class="mu">{sp.unit}</small>}
                </span>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </header>

  <p class="sdesc">{describe(`${abilityKey}_desc`, ab.properties, "（説明なし）", { hero_name: heroName })}</p>

  {card.tiles.length > 0 && (
    <div class="stiles">
      {card.tiles.map((row) => {
        const sp = splitUnit(row.value, row.unit);
        return (
          <div class:list={["tile", { scaled: row.scale }]}>
            {row.scale !== null && (
              <span class="tscale">
                <StatIcon kind="spirit" />×{fmtScale(row.scale)}
              </span>
            )}
            <div class="tval">
              {sp.num}
              {sp.unit && <span class="tu">{sp.unit}</span>}
            </div>
            <div class="tlabel">{row.label}</div>
          </div>
        );
      })}
    </div>
  )}

  {card.secondaryRows.length > 0 && (
    <div class="ssecondary">
      {card.secondaryRows.map((row) => {
        const sp = splitUnit(row.value, row.unit);
        return (
          <span class="srow">
            <span class="l">{row.label}</span>
            <span class="v">
              {sp.num}
              {sp.unit && <small class="su">{sp.unit}</small>}
            </span>
          </span>
        );
      })}
    </div>
  )}

  {card.upgrades.length > 0 && (
    <div class="supg">
      {card.upgrades.map((tier) => (
        <div class="ucell">
          <span class="uap">
            <StatIcon kind="ap" />
            {tier.ap}
            <small>AP</small>
          </span>
          <span class="ubody">
            {tier.description ? (
              tier.description
            ) : (
              tier.rows.map((r) => (
                <span class="upart">
                  {r.label} <b>{r.value}</b>
                </span>
              ))
            )}
          </span>
        </div>
      ))}
    </div>
  )}

  {notes.length > 0 && (
    <div class="snotes">
      <span class="nt">メモ</span>
      <ul>
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}
</article>

<style>
  .skill {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 2px solid var(--c-accent-dim);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
  }
  .skill.ult { border-top-color: var(--c-spirit); }

  .shead { display: flex; align-items: flex-start; gap: var(--sp-3); }
  .stitle { min-width: 0; flex: 1; }
  .snamerow { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2); }
  .snamerow a, .sname-plain {
    font-size: 17px; font-weight: 700; color: var(--c-text-strong); line-height: 1.3;
    text-decoration: none;
  }
  .snamerow a:hover { text-decoration: underline; }
  .tag {
    padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em;
  }
  .ult-tag { color: var(--c-spirit); background: var(--c-spirit-bg); border: 1px solid var(--c-spirit); }
  .passive-tag { color: var(--c-text-muted); background: var(--c-surface-2); border: 1px solid var(--c-border-strong); }

  .smeta {
    list-style: none; padding: 0; margin: var(--sp-2) 0 0;
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .smeta li {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--c-surface-2); border: 1px solid var(--c-border);
    border-radius: var(--radius); padding: 3px 8px;
    font-size: 11px; color: var(--c-text-muted); white-space: nowrap;
  }
  .smeta .mv { font-family: var(--font-mono); font-size: 12px; color: var(--c-text-strong); }
  .smeta .mu { font-size: 10px; color: var(--c-text-muted); margin-left: 1px; }

  .sdesc { font-size: 13px; line-height: 1.75; color: var(--c-text-muted); margin: 0; text-wrap: pretty; }

  /* ---- 主要ステータス タイル ---- */
  .stiles { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .tile {
    position: relative; flex: 1 1 120px; min-width: 0; text-align: center;
    padding: var(--sp-3) var(--sp-2) var(--sp-2);
    border-radius: var(--radius); background: var(--c-surface-2); border: 1px solid var(--c-border);
  }
  .tile.scaled { background: var(--c-spirit-bg); border-color: var(--c-spirit); }
  .tscale {
    position: absolute; top: 5px; right: 6px;
    display: inline-flex; align-items: center; gap: 2px;
    font-family: var(--font-mono); font-size: 10px; color: var(--c-spirit);
  }
  .tval { font-family: var(--font-mono); font-size: 24px; font-weight: 700; color: var(--c-text-strong); line-height: 1.1; }
  .tu { font-size: 14px; color: var(--c-text-muted); margin-left: 1px; }
  .tlabel { margin-top: 4px; font-size: 12px; color: var(--c-text-muted); }

  /* ---- 副次ステータス行(タイルにするほどではない値) ---- */
  .ssecondary {
    padding: var(--sp-2) var(--sp-3); border-radius: var(--radius);
    background: var(--c-surface-2); border: 1px solid var(--c-border);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 4px var(--sp-4);
  }
  .srow { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-2); font-size: 12px; color: var(--c-text-muted); }
  .srow .v { font-family: var(--font-mono); font-size: 13px; color: var(--c-text); white-space: nowrap; }
  .srow .su { font-size: 10px; color: var(--c-text-muted); margin-left: 1px; }

  /* ---- AP強化 3列(下端に固定) ---- */
  .supg { margin-top: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2); }
  .ucell {
    display: flex; flex-direction: column; border: 1px solid var(--c-border);
    border-radius: var(--radius); overflow: hidden;
  }
  .uap {
    display: flex; align-items: center; justify-content: center; gap: 3px;
    padding: 4px; background: var(--c-accent-bg); border-bottom: 1px solid var(--c-border);
    font-family: var(--font-mono); font-size: 11px; color: var(--c-accent);
  }
  .skill.ult .uap { background: var(--c-spirit-bg); color: var(--c-spirit); }
  .uap small { font-size: 9px; opacity: 0.8; }
  .ubody {
    flex: 1; padding: var(--sp-2) var(--sp-2) 10px;
    font-size: 12px; line-height: 1.5; color: var(--c-text); text-align: center; text-wrap: pretty;
  }
  .ubody b { font-family: var(--font-mono); color: var(--c-text-strong); }
  .upart:not(:last-child)::after { content: "、"; color: var(--c-text-muted); }

  .snotes { padding-top: var(--sp-3); border-top: 1px dashed var(--c-border); }
  .snotes .nt { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-faint); }
  .snotes ul { margin: var(--sp-1) 0 0; padding-left: 1.2em; font-size: 12px; color: var(--c-text-muted); line-height: 1.7; }

  @media (max-width: 420px) {
    .stiles { flex-wrap: wrap; }
    .tile { flex-basis: calc(50% - var(--sp-2)); }
  }
</style>
