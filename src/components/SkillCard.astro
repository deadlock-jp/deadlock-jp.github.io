---
/**
 * スキル1つぶんのカード本体。
 * ヒーロー詳細ページのスキル一覧と、スキル単体の詳細ページ(/abilities/<実ID>/)の
 * 両方から使う共通コンポーネント。見た目・データ源は完全に同じにする。
 */
import type { Ability } from "../types/ability.ts";
import type { SkillCard as SkillCardData, CardRow } from "../lib/skillcard.ts";
import { t, describe } from "../lib/data.ts";
import AbilityIcon from "./AbilityIcon.astro";
import StatIcon from "./StatIcon.astro";

export interface Props {
  abilityKey: string;
  ab: Ability;
  card: SkillCardData;
  notes: string[];
  /** {s:hero_name} 解決用のヒーロー表示名 */
  heroName: string;
  /** 指定するとスキル名がこのURLへのリンクになる(ヒーローページ→スキル詳細への導線) */
  href?: string;
}
const { abilityKey, ab, card, notes, heroName, href } = Astro.props;
const isUlt = ab.kind === "Ultimate";
const isPassive = ab.activation === "PASSIVE";
const name = t(abilityKey, abilityKey);

/** "-35%" "25秒" のような整形済み文字列を、数値部と単位部に分けて単位だけ弱く出す */
function splitValue(value: string): [string, string] {
  const m = /^([+\-−]?[\d.]+)(.*)$/s.exec(value);
  return m ? [m[1], m[2]] : [value, ""];
}

/** ダメージタイル + 主要ステータスタイル(見た目は同じ)をまとめて描く */
type Tile = CardRow & { scale?: number | null };
const tiles: Tile[] = [...card.damage, ...card.primaryEffects];
---

<article class:list={["skill", { ult: isUlt, passive: isPassive }]}>
  <header class="shead">
    <AbilityIcon name={name} image={ab.image} size={48} cssVar={isUlt ? "spirit" : "neutral"} />
    <div class="stitle">
      <span class="sname">
        {href ? <a href={href}>{name}</a> : name}
        {isUlt && <span class="tag tag--ult">アルティメット</span>}
        {!isUlt && isPassive && <span class="tag tag--passive">パッシブ</span>}
      </span>
      {card.meta.length > 0 && (
        <ul class="smeta">
          {card.meta.map((m) => {
            const [num, unit] = splitValue(m.value);
            return (
              <li>
                <StatIcon kind={m.icon} />
                <span class="mk">{m.label}</span>
                <span class="mv">
                  {num}
                  {unit && <span class="unit">{unit}</span>}
                </span>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </header>

  <p class="sdesc">{describe(`${abilityKey}_desc`, ab.properties, "（説明なし）", { hero_name: heroName })}</p>

  {tiles.length > 0 && (
    <div class="stiles">
      {tiles.map((row) => (
        <div class:list={["stile", { scaled: row.scale != null }]}>
          {row.scale != null && (
            <span class="stile-scale">
              <StatIcon kind="spirit" />×{row.scale}
            </span>
          )}
          <div class="stile-val">{splitValue(row.value)[0]}<span class="unit">{splitValue(row.value)[1]}</span></div>
          <div class="stile-label">{row.label}</div>
        </div>
      ))}
    </div>
  )}

  {card.secondaryEffects.length > 0 && (
    <dl class="sband">
      {card.secondaryEffects.map((row) => {
        const [num, unit] = splitValue(row.value);
        return (
          <div class="sbrow">
            <dt>{row.label}</dt>
            <dd>
              {num}
              {unit && <span class="unit">{unit}</span>}
            </dd>
          </div>
        );
      })}
    </dl>
  )}

  {card.upgrades.length > 0 && (
    <div class="supg">
      {card.upgrades.map((tier) => (
        <div class="ap-cell">
          <span class="ap-head">
            <StatIcon kind="ap" />
            {tier.ap}<small>AP</small>
          </span>
          <span class="ap-body">
            {tier.description
              ? tier.description
              : tier.rows.map((r, i) => (
                  <>
                    {i > 0 && "、"}
                    {r.label} <b>{r.value}</b>
                  </>
                ))}
          </span>
        </div>
      ))}
    </div>
  )}

  {notes.length > 0 && (
    <div class="snotes">
      <span class="nt">メモ</span>
      <ul>
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}
</article>

<style>
  .skill {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 2px solid var(--c-accent);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
    box-sizing: border-box;
  }
  .skill.passive { border-top-color: var(--c-border); }
  .skill.ult { border-top-color: var(--c-spirit); }

  .shead { display: flex; align-items: flex-start; gap: var(--sp-3); }
  .stitle { min-width: 0; flex: 1; }
  .sname { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2); font-weight: 700; color: var(--c-text-strong); font-size: 17px; }
  .sname a { color: inherit; text-decoration: none; }
  .sname a:hover { text-decoration: underline; }
  .tag {
    padding: 1px 6px; border-radius: 3px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.04em;
  }
  .tag--ult { color: var(--c-spirit); background: var(--c-spirit-bg); border: 1px solid var(--c-spirit); }
  .tag--passive { color: var(--c-text-muted); background: var(--c-surface-2); border: 1px solid var(--c-border-strong); }

  .smeta {
    list-style: none; padding: 0; margin: var(--sp-2) 0 0;
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .smeta li {
    display: inline-flex; gap: 5px; align-items: center;
    background: var(--c-surface-2); border: 1px solid var(--c-border);
    border-radius: var(--radius); padding: 3px 8px; font-size: 11px; white-space: nowrap;
  }
  .smeta .mk { color: var(--c-text-muted); }
  .smeta .mv { font-family: var(--font-mono); font-size: 12px; color: var(--c-text-strong); }
  .smeta .mv .unit { font-size: 10px; color: var(--c-text-muted); }

  .sdesc { font-size: 13px; line-height: 1.75; color: var(--c-text-muted); margin: 0; text-wrap: pretty; }

  .stiles { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .stile {
    position: relative; flex: 1 1 130px; min-width: 0; text-align: center;
    padding: 12px 10px 10px; border-radius: var(--radius); box-sizing: border-box;
    background: var(--c-surface-2); border: 1px solid var(--c-border);
  }
  .stile.scaled { background: var(--c-spirit-bg); border-color: rgb(181 139 230 / 0.5); }
  .stile-scale {
    position: absolute; top: 5px; right: 6px;
    display: inline-flex; align-items: center; gap: 2px;
    font-family: var(--font-mono); font-size: 10px; color: var(--c-spirit);
  }
  .stile-val { font-family: var(--font-mono); font-size: 26px; font-weight: 700; color: var(--c-text-strong); line-height: 1.1; }
  .stile-val .unit { font-size: 15px; font-weight: 400; color: var(--c-text-muted); }
  .stile-label { margin-top: 4px; font-size: 12px; color: var(--c-text-muted); }

  .sband {
    margin: 0; padding: 10px 12px; border-radius: var(--radius);
    background: var(--c-surface-2); border: 1px solid var(--c-border);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 4px 16px;
  }
  .sbrow { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .sbrow dt { margin: 0; font-size: 12px; color: var(--c-text-muted); }
  .sbrow dd { margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--c-text-strong); white-space: nowrap; }
  .sbrow dd .unit { font-size: 10px; color: var(--c-text-muted); }

  .supg {
    margin-top: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2);
  }
  .ap-cell {
    display: flex; flex-direction: column;
    border: 1px solid var(--c-border); border-radius: var(--radius); overflow: hidden;
  }
  .ap-head {
    display: flex; align-items: center; justify-content: center; gap: 3px;
    padding: 4px; background: var(--c-accent-bg); border-bottom: 1px solid var(--c-border);
    font-family: var(--font-mono); font-size: 11px; color: var(--c-accent);
  }
  .skill.ult .ap-head { background: var(--c-spirit-bg); color: var(--c-spirit); }
  .ap-head small { font-size: 9px; opacity: 0.8; }
  .ap-body {
    flex: 1; padding: 8px 8px 10px; font-size: 12px; line-height: 1.5;
    color: var(--c-text); text-align: center; text-wrap: pretty;
  }
  .ap-body b { font-family: var(--font-mono); color: var(--c-text-strong); }

  .snotes { padding-top: var(--sp-3); border-top: 1px dashed var(--c-border); }
  .snotes .nt {
    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-faint);
  }
  .snotes ul { margin: var(--sp-1) 0 0; padding-left: 1.2em; font-size: 12px; color: var(--c-text-muted); line-height: 1.7; }
</style>
