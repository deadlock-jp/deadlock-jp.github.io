---
/**
 * ファーミング用のマップ(マップとファーム /mechanics/farm/ の冒頭)。
 *
 * 背景はゲームのミニマップ画像を「地面が灰色」に描き直したもの(src/parsers/minimapImage.ts)。
 * レーン・建造物・キャンプ・箱は data/snapshots/<版>/map.json の配置
 * (maps/dl_midtown.vpk の default_ents から自動抽出。src/parsers/map.ts)。
 *
 * 見た目はゲーム内のミニマップに合わせる: 自チームを南(アンバー)側として、
 * 自陣のレーン・建造物はレーンの色、中央から先の敵陣は赤。
 * 位置はサーバー側で % に直して描き、クライアントの JS は拡大・移動と表示の切り替えだけを行う。
 * 拡大は地図の要素そのものの大きさを変える(CSS の scale で拡大すると点がぼやけるため)。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { MapFile } from "../types/map.ts";
import { clock, duration } from "../lib/matchFlow.ts";
import { loadMap, mapView, mapRenovating, campInfo, campHauntText, campCard, breakableLabel, markerIcon, isTunnelBreakable as isTunnel } from "../lib/mapView.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loaded = loadMap();
const renovating = mapRenovating();
const map = loaded?.map ?? null;
const economy = loaded?.economy;
const view = loaded ? mapView(loaded.map, loaded.economy) : null;
const pos = view?.pos ?? (() => "");

const camps = campInfo();
const src = (outPath: string | undefined | null): string | null =>
  outPath && existsSync(join(process.cwd(), outPath)) ? `${base}/${outPath.replace(/^public\//, "")}` : null;
const bgBase = src(map?.images.base?.outPath);
const bgTunnels = src(map?.images.tunnels?.outPath);

/** 箱の出現グループ → 初回出現と再出現(economy.json の breakableSpawnTimes) */
const groupTime = (g: number) => {
  const t = economy?.breakableSpawnTimes[g];
  return t ? `${clock(t.initialSpawnTime)}〜、${duration(t.respawnInterval)}ごと` : "";
};

const CAMP_LAYERS = [
  { key: "weak", label: "小キャンプ" },
  { key: "medium", label: "中キャンプ" },
  { key: "strong", label: "大キャンプ" },
  { key: "vaults", label: "罪人の供物" },
] as const;

const count = (pred: (x: MapFile["breakables"][number]) => boolean) => map?.breakables.filter(pred).length ?? 0;

const structures = view?.structures ?? [];
const markers = view?.markers ?? [];
const laneLines = view?.laneLines ?? [];
const structureColor = view?.structureColor ?? (() => "");

/** 目印の種類 → 表示の切り替え(layers の key) */
const MARKER_LAYER: Record<string, string> = {
  shop: "facility",
  teleporter: "facility",
  broker: "broker",
  snack: "snack",
};
const markerLayer = (kind: string) => MARKER_LAYER[kind] ?? "marker";
const markerCount = (layer: string) => markers.filter((l) => markerLayer(l.kind) === layer).length;

const layers = map
  ? [
      ...CAMP_LAYERS.map((l) => ({
        key: l.key,
        label: l.label,
        icon: camps[l.key]?.icon ? `${base}/${camps[l.key]!.icon}` : null,
        count: map.camps.filter((c) => c.type === l.key).length,
        on: true,
      })),
      { key: "crate", label: "箱（ソウル）", icon: null, count: count((b) => b.kind === "crate" && !isTunnel(b)), on: false },
      { key: "statue", label: "黄金像（パワーアップ）", icon: null, count: count((b) => b.kind === "statue" && !isTunnel(b)), on: false },
      // 地下に潜れるヒーローだけが入れるトンネルの箱(src/parsers/map.ts の TUNNEL_BREAKABLE_GROUP)
      ...(count(isTunnel) > 0
        ? [{ key: "tunnel", label: "地下トンネルの箱", icon: null, count: count(isTunnel), on: false }]
        : []),
      { key: "tough", label: "頑丈な箱", icon: null, count: count((b) => b.kind === "tough"), on: false },
      { key: "snack", label: "ヒーリングスナック", icon: markerIcon("snack") ? `${base}/${markerIcon("snack")}` : null, count: markerCount("snack"), on: false },
      { key: "marker", label: "橋バフ・裂け目・壺・鐘楼", icon: null, count: markerCount("marker"), on: true },
      { key: "facility", label: "商店・テレポーター", icon: markerIcon("shop") ? `${base}/${markerIcon("shop")}` : null, count: markerCount("facility"), on: true },
      ...(markerCount("broker") > 0
        ? [{ key: "broker", label: "ブローカー（期間限定）", icon: markerIcon("broker") ? `${base}/${markerIcon("broker")}` : null, count: markerCount("broker"), on: true }]
        : []),
    ]
  : [];

/** 箱の識別番号(味方陣営の分だけ)。1つでもあれば「箱の番号」の切り替えを出す */
const hasLabels = !!map?.breakables.some((b) => breakableLabel(b));

type Camp = MapFile["camps"][number];
/** 「中程度の中立モンスター（3体）」。罪人の供物(スロット)は「台」。体数が分からないキャンプは体数を省く */
const campTitle = (c: Camp) =>
  `${camps[c.type]?.label ?? c.type}${c.units > 0 ? `（${c.units}${c.type === "vaults" ? "台" : "体"}）` : ""}`;
const campTiming = (c: Camp) =>
  `${clock((camps[c.type]?.initialSpawnMinutes ?? 0) * 60)}〜、${duration((camps[c.type]?.respawnMinutes ?? 0) * 60)}ごと`;

const STRUCTURE_LABEL: Record<string, string> = {
  patron: "パトロン",
  shrine: "シュライン",
  baseGuardian: "ベース・ガーディアン",
  walker: "ウォーカー",
  guardian: "ガーディアン",
};
const MARKER_LABEL: Record<string, string> = {
  powerup: "橋バフ",
  rift: "不安定な裂け目",
  urnReturn: "魂の壺の返還地点",
  midboss: "ミッド・ボス",
  bell: "鐘楼の鐘（鳴らすとソウル。鐘の音がマップ全体に響く）",
  shop: "商店",
  teleporter: "テレポーター",
  broker: "ブローカーの店（期間限定。来ている間だけ）",
  snack: "ヒーリングスナック",
};
---

{renovating && (
  <p class="fm-wip">マップ改修（2026年9月29日）に対応中です。新しいマップの配置は準備ができしだい掲載します。</p>
)}

{map && bgBase && (
  <div class="farmmap" data-farmmap data-view="ground">
    <div class="fm-controls">
      <div class="fm-view" role="group" aria-label="表示する階層">
        <button type="button" class="on" data-view-btn="ground">地上</button>
        {bgTunnels && <button type="button" data-view-btn="tunnels">地下（共用）</button>}
      </div>
      <div class="fm-layers">
        {layers.map((l) => (
          <label class:list={["fm-chip", `lay-${l.key}`]}>
            <input type="checkbox" data-layer={l.key} checked={l.on} />
            {l.icon ? <img src={l.icon} alt="" /> : <i class="sw" />}
            {l.label}
            <small>{l.count}</small>
          </label>
        ))}
        {hasLabels && (
          <label class="fm-chip lay-labels">
            <input type="checkbox" data-labels />
            <i class="sw" />
            箱の番号
          </label>
        )}
      </div>
    </div>

    <div class="fm-stage" data-hide={layers.filter((l) => !l.on).map((l) => l.key).join(" ")}>
      <div class="fm-zoom" aria-label="地図の拡大縮小">
        <button type="button" data-zoom="in" aria-label="拡大">＋</button>
        <button type="button" data-zoom="out" aria-label="縮小">−</button>
        <button type="button" data-zoom="reset" aria-label="全体を表示">⤢</button>
      </div>
      <div class="fm-world">
        <img class="fm-bg ground" src={bgBase} alt="マップ" loading="lazy" draggable="false" />
        {bgTunnels && <img class="fm-bg tunnels" src={bgTunnels} alt="共用地下のマップ" loading="lazy" draggable="false" />}

        {laneLines.length > 0 && (
          <svg class="fm-lanes" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            {laneLines.map((l) => <polyline points={l.points} stroke={l.color} />)}
          </svg>
        )}

        {structures.map((l) => (
          <span
            class:list={["mk", "st", `st-${l.kind}`]}
            style={`${pos(l)};--c:${structureColor(l)}`}
            title={`${l.team === "sapphire" ? "敵の" : "味方の"}${STRUCTURE_LABEL[l.kind] ?? l.kind}`}
          />
        ))}

        {map.breakables.map((b) => {
          const label = breakableLabel(b);
          return (
            <span
              class:list={["mk", `mk-${b.kind}`, isTunnel(b) ? "tunnelonly" : b.underground ? "under" : "above"]}
              data-layer={isTunnel(b) ? "tunnel" : b.kind}
              style={pos(b)}
              title={`${label ? `${label} ` : ""}${isTunnel(b) ? "地下トンネルの" : ""}${b.kind === "crate" ? "箱（ソウル）" : b.kind === "tough" ? "頑丈な箱（近接強攻撃で壊す）" : "黄金像"}：${groupTime(b.group)}`}
            >
              {label && <b class="bl">{label}</b>}
            </span>
          );
        })}
        {map.camps.map((c, i) => (
          <span
            class:list={["mk", "mk-camp", `camp-${c.type}`, c.underground ? "under" : "above"]}
            data-layer={c.type}
            data-camp={i}
            style={pos(c)}
            aria-label={`${campTitle(c)}：${campTiming(c)}${campHauntText(c) ? `／${campHauntText(c)}` : ""}`}
            role="button"
          >
            {camps[c.type]?.icon && <img src={`${base}/${camps[c.type]!.icon}`} alt="" draggable="false" />}
          </span>
        ))}
        {markers.map((l) => {
          const icon = l.kind === "midboss" ? camps.midboss?.icon ?? null : markerIcon(l.kind);
          return (
            <span
              class:list={["mk", "mk-lm", `lm-${l.kind}`, icon && "has-icon", l.kind === "midboss" ? "both" : l.underground ? "under" : "above"]}
              data-layer={markerLayer(l.kind)}
              style={pos(l)}
              title={MARKER_LABEL[l.kind] ?? l.kind}
            >
              {icon && <img src={`${base}/${icon}`} alt="" draggable="false" />}
            </span>
          );
        })}
      </div>
    </div>
    <p class="fm-info" aria-live="polite"></p>
    <div class="fm-hover" hidden></div>
    <div class="fm-detail" aria-live="polite" hidden></div>

    {/* キャンプごとのカード。ホバーでは短い版を地図の上に、クリックでは詳しい版を地図の下に出す */}
    {map.camps.map((c, i) => {
      const card = campCard(c);
      const title = campTitle(c);
      const icon = camps[c.type]?.icon ? `${base}/${camps[c.type]!.icon}` : null;
      return (
        <>
          <template data-camp-card={i}>
            <div class="cc">
              {card.pictures.length > 0 && (
                <div class="cc-pics">{card.pictures.slice(0, 3).map((p) => <img src={`${base}/${p}`} alt="" />)}</div>
              )}
              <div class="cc-body">
                <b class="cc-title">{icon && <img src={icon} alt="" />}{title}</b>
                <span class="cc-time">{campTiming(c)}</span>
                {card.rows.length > 0 && <span class="cc-units">{card.rows.map((r) => `${r.name} ×${r.count}`).join("、")}</span>}
                {card.totalGold !== null && <span class="cc-gold"><b>{card.totalGold}</b> ソウル</span>}
              </div>
            </div>
          </template>
          <template data-camp-detail={i}>
            <div class="cd">
              <div class="cd-head">
                <b class="cc-title">{icon && <img src={icon} alt="" />}{title}</b>
                <span class="cc-time">{campTiming(c)}</span>
                <button type="button" class="cd-close" aria-label="閉じる">×</button>
              </div>
              {card.rows.length > 0 && (
                <ul class="cd-rows">
                  {card.rows.map((r) => (
                    <li>
                      {r.icon ? <img src={`${base}/${r.icon}`} alt="" /> : <i />}
                      <span class="cd-name">{r.name}<small>×{r.count}</small></span>
                      <span class="cd-stat"><small>HP</small>{r.maxHealth ?? "—"}</span>
                      <span class="cd-stat"><small>ソウル</small>{r.gold ?? "—"}</span>
                    </li>
                  ))}
                </ul>
              )}
              {card.totalGold !== null && (
                <p class="cd-total">
                  {c.type === "vaults" ? "1回あたり" : "キャンプ全体"} <b>{card.totalGold}</b> ソウル
                  {card.growthPct !== null && <small>（試合開始時の値。毎分 +{card.growthPct}%）</small>}
                </p>
              )}
            </div>
          </template>
        </>
      );
    })}
  </div>
)}

<script is:inline>
  (() => {
    for (const root of document.querySelectorAll("[data-farmmap]")) {
      const stage = root.querySelector(".fm-stage");
      const hidden = new Set((stage.dataset.hide || "").split(" ").filter(Boolean));
      const apply = () => (stage.dataset.hide = [...hidden].join(" "));
      /*
       * ?show=weak,medium のように種類を指定して開いたときは、その種類だけを表示する
       * (オブジェクトのページから「この種類の場所」を開く用)。show= が空なら建造物だけ
       */
      const show = new URLSearchParams(location.search).get("show");
      if (show !== null) {
        const keep = new Set(show.split(",").filter(Boolean));
        for (const cb of root.querySelectorAll("input[data-layer]")) {
          cb.checked = keep.has(cb.dataset.layer);
          if (cb.checked) hidden.delete(cb.dataset.layer);
          else hidden.add(cb.dataset.layer);
        }
        apply();
      }
      for (const cb of root.querySelectorAll("input[data-layer]")) {
        cb.addEventListener("change", () => {
          if (cb.checked) hidden.delete(cb.dataset.layer);
          else hidden.add(cb.dataset.layer);
          apply();
        });
      }
      // 箱の番号: 出すときは箱と黄金像も表示する(番号だけ出ても意味が無いので)
      root.querySelector("input[data-labels]")?.addEventListener("change", (e) => {
        stage.classList.toggle("labels", e.target.checked);
        if (e.target.checked) {
          for (const k of ["crate", "statue", "tough"]) {
            hidden.delete(k);
            const cb = root.querySelector(`input[data-layer="${k}"]`);
            if (cb) cb.checked = true;
          }
          apply();
        }
      });

      // ---- 拡大縮小・移動(ホイール / ドラッグ / 2本指) ----
      // 地図の要素そのものの幅・高さを変える。点は % で置いてあるので、大きさを保ったまま位置だけ広がる
      const world = stage.querySelector(".fm-world");
      const info = root.querySelector(".fm-info");
      const MAX = 6;
      let scale = 1, tx = 0, ty = 0;
      const size = () => stage.clientWidth;
      const render = () => {
        const w = size();
        tx = Math.min(0, Math.max(w - w * scale, tx));
        ty = Math.min(0, Math.max(w - w * scale, ty));
        world.style.left = `${tx}px`;
        world.style.top = `${ty}px`;
        world.style.width = world.style.height = `${w * scale}px`;
        stage.classList.toggle("zoomed", scale > 1.01);
      };
      // (px, py) = ステージ内の座標を中心に factor 倍する
      const zoomAt = (px, py, factor) => {
        const next = Math.min(MAX, Math.max(1, scale * factor));
        const k = next / scale;
        tx = px - (px - tx) * k;
        ty = py - (py - ty) * k;
        scale = next;
        render();
      };
      const local = (e) => {
        const r = stage.getBoundingClientRect();
        return [e.clientX - r.left, e.clientY - r.top];
      };
      stage.addEventListener("wheel", (e) => {
        e.preventDefault();
        const [x, y] = local(e);
        zoomAt(x, y, Math.exp(-e.deltaY * 0.0015));
      }, { passive: false });

      const pointers = new Map();
      let pinch = null;
      let moved = 0;
      stage.addEventListener("pointerdown", (e) => {
        if (e.target.closest(".fm-zoom")) return;
        stage.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, local(e));
        moved = 0;
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinch = { dist: Math.hypot(a[0] - b[0], a[1] - b[1]) };
        }
      });
      stage.addEventListener("pointermove", (e) => {
        if (!pointers.has(e.pointerId)) return;
        const prev = pointers.get(e.pointerId);
        const cur = local(e);
        pointers.set(e.pointerId, cur);
        if (pointers.size === 2 && pinch) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a[0] - b[0], a[1] - b[1]);
          zoomAt((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, dist / pinch.dist);
          pinch.dist = dist;
          moved += 10;
        } else if (pointers.size === 1) {
          tx += cur[0] - prev[0];
          ty += cur[1] - prev[1];
          moved += Math.abs(cur[0] - prev[0]) + Math.abs(cur[1] - prev[1]);
          render();
        }
      });
      const end = (e) => {
        pointers.delete(e.pointerId);
        if (pointers.size < 2) pinch = null;
      };
      // ---- キャンプのカード: ホバーで短い版を地図の上に、タップ(クリック)で詳しい版を地図の下に ----
      const hover = root.querySelector(".fm-hover");
      const detail = root.querySelector(".fm-detail");
      const fill = (box, sel) => {
        const tpl = root.querySelector(sel);
        box.replaceChildren(tpl ? tpl.content.cloneNode(true) : "");
      };
      const showHover = (mk) => {
        fill(hover, `template[data-camp-card="${mk.dataset.camp}"]`);
        hover.hidden = false;
        const r = root.getBoundingClientRect();
        const m = mk.getBoundingClientRect();
        const w = hover.offsetWidth, h = hover.offsetHeight;
        // 点の右上に出す。はみ出すなら左・下へ回す
        let x = m.right - r.left + 10;
        if (x + w > r.width) x = m.left - r.left - w - 10;
        let y = m.top - r.top - h - 6;
        if (y < 0) y = m.bottom - r.top + 6;
        hover.style.left = `${Math.max(0, x)}px`;
        hover.style.top = `${y}px`;
      };
      const hideHover = () => (hover.hidden = true);
      let selected = null;
      const showDetail = (mk) => {
        if (selected) selected.classList.remove("sel");
        selected = mk;
        mk.classList.add("sel");
        fill(detail, `template[data-camp-detail="${mk.dataset.camp}"]`);
        detail.hidden = false;
        detail.querySelector(".cd-close")?.addEventListener("click", () => {
          detail.hidden = true;
          mk.classList.remove("sel");
          selected = null;
        });
      };
      stage.addEventListener("pointerover", (e) => {
        if (e.pointerType !== "mouse" || pointers.size) return;
        const mk = e.target.closest(".mk-camp");
        if (mk) showHover(mk);
      });
      stage.addEventListener("pointerout", (e) => {
        if (e.target.closest(".mk-camp") && !e.relatedTarget?.closest?.(".mk-camp")) hideHover();
      });

      stage.addEventListener("pointerup", (e) => {
        // ほとんど動かさずに離したらタップとみなす。キャンプは詳細カード、それ以外は点の名前を出す
        if (moved < 6 && pointers.size === 1) {
          const mk = document.elementFromPoint(e.clientX, e.clientY)?.closest(".mk");
          if (mk?.dataset.camp !== undefined) {
            showDetail(mk);
            info.textContent = "";
          } else {
            info.textContent = mk ? mk.getAttribute("title") : "";
          }
        }
        end(e);
      });
      stage.addEventListener("pointerdown", hideHover);
      stage.addEventListener("pointercancel", end);
      for (const b of root.querySelectorAll("[data-zoom]")) {
        b.addEventListener("click", () => {
          const c = size() / 2;
          if (b.dataset.zoom === "in") zoomAt(c, c, 1.6);
          else if (b.dataset.zoom === "out") zoomAt(c, c, 1 / 1.6);
          else { scale = 1; tx = 0; ty = 0; render(); }
        });
      }
      window.addEventListener("resize", render);
      render();

      for (const btn of root.querySelectorAll("[data-view-btn]")) {
        btn.addEventListener("click", () => {
          root.dataset.view = btn.dataset.viewBtn;
          for (const b of root.querySelectorAll("[data-view-btn]")) b.classList.toggle("on", b === btn);
          // 地下に切り替えたら箱を表示する(地下で見たいのはほぼ箱なので)
          if (btn.dataset.viewBtn !== "ground") {
            for (const k of ["crate", "statue", "tough"]) {
              hidden.delete(k);
              const cb = root.querySelector(`input[data-layer="${k}"]`);
              if (cb) cb.checked = true;
            }
            apply();
          }
        });
      }
    }
  })();
</script>

<style>
  .fm-wip {
    padding: var(--sp-5) var(--sp-4);
    background: rgb(0 0 0 / 0.35);
    color: var(--c-text-muted);
    text-align: center;
  }
  .farmmap { margin: var(--sp-3) 0 var(--sp-4); }
  .fm-controls { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-3); align-items: center; margin-bottom: var(--sp-2); }
  .fm-view { display: flex; }
  .fm-view button {
    font: inherit; font-size: 12px; padding: 4px 12px; cursor: pointer;
    background: var(--c-surface); color: var(--c-text-muted); border: 1px solid var(--c-border);
  }
  .fm-view button:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .fm-view button:last-child { border-radius: 0 var(--radius) var(--radius) 0; margin-left: -1px; }
  .fm-view button.on { color: var(--c-accent); border-color: var(--c-accent-dim); background: var(--c-accent-bg); position: relative; }
  .fm-layers { display: flex; flex-wrap: wrap; gap: 6px; }
  .fm-chip {
    display: inline-flex; align-items: center; gap: 5px; cursor: pointer; user-select: none;
    font-size: 12px; padding: 3px 9px; border: 1px solid var(--c-border); border-radius: 999px;
    background: var(--c-surface); color: var(--c-text-muted);
  }
  .fm-chip input { display: none; }
