---
/**
 * ファーミング用のマップ(試合の流れ /mechanics/match/ のファーミング節)。
 *
 * 背景はゲームのミニマップ画像を「地面が灰色」に描き直したもの(src/parsers/minimapImage.ts)。
 * レーン・建造物・キャンプ・箱は data/snapshots/<版>/map.json の配置
 * (maps/dl_midtown.vpk の default_ents から自動抽出。src/parsers/map.ts)。
 *
 * 見た目はゲーム内のミニマップに合わせる: 自チームを南(アンバー)側として、
 * 自陣のレーン・建造物はレーンの色、中央から先の敵陣は赤。
 * 位置はサーバー側で % に直して描き、クライアントの JS は拡大・移動と表示の切り替えだけを行う。
 * 拡大は地図の要素そのものの大きさを変える(CSS の scale で拡大すると点がぼやけるため)。
 */
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import type { MapFile, MapLandmark } from "../types/map.ts";
import { campSpawnTimes } from "../lib/objects.ts";
import { clock, duration, TUNNEL_BREAKABLE_GROUP } from "../lib/matchFlow.ts";
import type { EconomyFile } from "../types/economy.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const DATA_DIR = join(process.cwd(), "data");
const version = JSON.parse(readFileSync(join(DATA_DIR, "latest.json"), "utf8")).version as string;
const mapPath = join(DATA_DIR, "snapshots", version, "map.json");
const map: MapFile | null = existsSync(mapPath) ? (JSON.parse(readFileSync(mapPath, "utf8")) as MapFile) : null;
const economy = JSON.parse(readFileSync(join(DATA_DIR, "snapshots", version, "economy.json"), "utf8")) as EconomyFile;

const camps = Object.fromEntries(campSpawnTimes().map((c) => [c.key, c]));
const src = (outPath: string | undefined | null): string | null =>
  outPath && existsSync(join(process.cwd(), outPath)) ? `${base}/${outPath.replace(/^public\//, "")}` : null;
const bgBase = src(map?.images.base?.outPath);
const bgTunnels = src(map?.images.tunnels?.outPath);
const bgHidden = src(map?.images.hiddenTunnels?.outPath);

/** ゲーム座標 → 地図上の割合(0〜1) */
const frac = (p: { x: number; y: number }) => {
  const { minX, minY, maxX, maxY } = map!.bounds;
  return { u: (p.x - minX) / (maxX - minX), v: (maxY - p.y) / (maxY - minY) };
};
const pos = (p: { x: number; y: number }) => {
  const { u, v } = frac(p);
  return `left:${(u * 100).toFixed(2)}%;top:${(v * 100).toFixed(2)}%`;
};

/** 敵陣の色(ゲームのミニマップで敵側のレーン・建造物に使われる赤) */
const ENEMY = "#d9553a";
/** 自陣のパトロン・シュラインの色(ゲームでは白っぽく描かれる) */
const OWN_BASE = "#e6ddc8";
const laneColor = (lane: number | null) => {
  const c = lane !== null ? economy.lanes[lane]?.color : null;
  return c && (c[0] || c[1] || c[2]) ? `rgb(${c[0]} ${c[1]} ${c[2]})` : OWN_BASE;
};

/** 箱の出現グループ → 初回出現と再出現(economy.json の breakableSpawnTimes) */
const groupTime = (g: number) => {
  const t = economy.breakableSpawnTimes[g];
  return t ? `${clock(t.initialSpawnTime)}〜、${duration(t.respawnInterval)}ごと` : "";
};

const CAMP_LAYERS = [
  { key: "weak", label: "小キャンプ" },
  { key: "medium", label: "中キャンプ" },
  { key: "strong", label: "大キャンプ" },
  { key: "vaults", label: "罪人の生贄" },
] as const;

/** 地下トンネル(3人専用)の箱。グループの対応は src/lib/matchFlow.ts の TUNNEL_BREAKABLE_GROUP */
const isTunnel = (b: MapFile["breakables"][number]) => b.group === TUNNEL_BREAKABLE_GROUP;
const count = (pred: (x: MapFile["breakables"][number]) => boolean) => map?.breakables.filter(pred).length ?? 0;

/** 建造物(レーンの上に並ぶもの)と、それ以外の目印 */
const STRUCTURES = new Set(["patron", "shrine", "baseGuardian", "walker", "guardian"]);
const structures = (map?.landmarks ?? []).filter((l) => STRUCTURES.has(l.kind));
const markers = (map?.landmarks ?? []).filter((l) => !STRUCTURES.has(l.kind));

const layers = map
  ? [
      ...CAMP_LAYERS.map((l) => ({
        key: l.key,
        label: l.label,
        icon: camps[l.key]?.icon ? `${base}/${camps[l.key]!.icon}` : null,
        count: map.camps.filter((c) => c.type === l.key).length,
        on: true,
      })),
      { key: "crate", label: "箱（ソウル）", icon: null, count: count((b) => b.kind === "crate" && !isTunnel(b)), on: false },
      { key: "statue", label: "黄金像（パワーアップ）", icon: null, count: count((b) => b.kind === "statue" && !isTunnel(b)), on: false },
      { key: "tunnel", label: "地下トンネルの箱と入口（3人専用）", icon: null, count: count(isTunnel), on: false },
      { key: "marker", label: "橋バフ・裂け目・壺", icon: null, count: markers.length, on: true },
    ]
  : [];

/**
 * レーンの線。自陣側(南)はレーンの色、中央(y=0)を越えた先は敵陣として赤で描く。
 * 経路は南の拠点から北の拠点へ向かっているので、最初に y が 0 以上になった点で分ける。
 */
const laneLines = (map?.lanes ?? []).flatMap((l) => {
  const toStr = (pts: { x: number; y: number }[]) =>
    pts.map((p) => { const { u, v } = frac(p); return `${(u * 1000).toFixed(1)},${(v * 1000).toFixed(1)}`; }).join(" ");
  const cut = l.points.findIndex((p) => p.y >= 0);
  const own = cut < 0 ? l.points : l.points.slice(0, cut + 1);
  const enemy = cut < 0 ? [] : l.points.slice(cut);
  return [
    { key: `${l.lane}-own`, color: laneColor(l.lane), points: toStr(own) },
    ...(enemy.length > 1 ? [{ key: `${l.lane}-enemy`, color: ENEMY, points: toStr(enemy) }] : []),
  ];
});

const STRUCTURE_LABEL: Record<string, string> = {
  patron: "パトロン",
  shrine: "シュライン",
  baseGuardian: "ベース・ガーディアン",
  walker: "ウォーカー",
  guardian: "ガーディアン",
};
const MARKER_LABEL: Record<string, string> = {
  powerup: "橋バフ",
  rift: "不安定な裂け目",
  urnReturn: "魂の壺の返還地点",
  midboss: "ミッド・ボス",
};
const structureColor = (l: MapLandmark) =>
  l.team === "sapphire" ? ENEMY : l.kind === "patron" || l.kind === "shrine" ? OWN_BASE : laneColor(l.lane);
---

{map && bgBase && (
  <div class="farmmap" data-farmmap data-view="ground">
    <div class="fm-controls">
      <div class="fm-view" role="group" aria-label="表示する階層">
        <button type="button" class="on" data-view-btn="ground">地上</button>
        {bgTunnels && <button type="button" data-view-btn="tunnels">地下（共用）</button>}
        {bgHidden && <button type="button" data-view-btn="hidden">地下トンネル（3人専用）</button>}
      </div>
      <div class="fm-layers">
        {layers.map((l) => (
          <label class:list={["fm-chip", `lay-${l.key}`]}>
            <input type="checkbox" data-layer={l.key} checked={l.on} />
            {l.icon ? <img src={l.icon} alt="" /> : <i class="sw" />}
            {l.label}
            <small>{l.count}</small>
          </label>
        ))}
      </div>
    </div>

    <div class="fm-stage" data-hide={layers.filter((l) => !l.on).map((l) => l.key).join(" ")}>
      <div class="fm-zoom" aria-label="地図の拡大縮小">
        <button type="button" data-zoom="in" aria-label="拡大">＋</button>
        <button type="button" data-zoom="out" aria-label="縮小">−</button>
        <button type="button" data-zoom="reset" aria-label="全体を表示">⤢</button>
      </div>
      <div class="fm-world">
        <img class="fm-bg ground" src={bgBase} alt="マップ" loading="lazy" draggable="false" />
        {bgTunnels && <img class="fm-bg tunnels" src={bgTunnels} alt="共用地下のマップ" loading="lazy" draggable="false" />}
        {bgHidden && <img class="fm-bg hiddentn" src={bgHidden} alt="地下トンネル（3人専用）の範囲" loading="lazy" draggable="false" />}

        {laneLines.length > 0 && (
          <svg class="fm-lanes" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            {laneLines.map((l) => <polyline points={l.points} stroke={l.color} />)}
          </svg>
        )}

        {structures.map((l) => (
          <span
            class:list={["mk", "st", `st-${l.kind}`]}
            style={`${pos(l)};--c:${structureColor(l)}`}
            title={`${l.team === "sapphire" ? "敵の" : "味方の"}${STRUCTURE_LABEL[l.kind] ?? l.kind}`}
          />
        ))}

        {map.breakables.map((b) => (
          <span
            class:list={["mk", `mk-${b.kind}`, isTunnel(b) ? "tunnelonly" : b.underground ? "under" : "above"]}
            data-layer={isTunnel(b) ? "tunnel" : b.kind}
            style={pos(b)}
            title={`${isTunnel(b) ? "地下トンネル（3人専用）の" : ""}${b.kind === "crate" ? "箱（ソウル）" : "黄金像"}：${groupTime(b.group)}`}
          />
        ))}
        {(map.tunnelEntrances ?? []).map((e) => (
          <span
            class:list={["mk", "ent", `ent-${e.from}`, "above"]}
            data-layer="tunnel"
            style={pos(e)}
            title={e.from === "midboss" ? "地下トンネルの入口（ミッド・ボスの部屋から）" : "地下トンネルの入口（地上から）"}
          />
        ))}
        {map.camps.map((c) => (
          <span
            class:list={["mk", "mk-camp", `camp-${c.type}`, c.underground ? "under" : "above"]}
            data-layer={c.type}
            style={pos(c)}
            title={`${camps[c.type]?.label ?? c.type}（${c.units}体）：${clock((camps[c.type]?.initialSpawnMinutes ?? 0) * 60)}〜、${duration((camps[c.type]?.respawnMinutes ?? 0) * 60)}ごと`}
          >
            {camps[c.type]?.icon && <img src={`${base}/${camps[c.type]!.icon}`} alt="" draggable="false" />}
          </span>
        ))}
        {markers.map((l) => (
          <span
            class:list={["mk", "mk-lm", `lm-${l.kind}`, l.kind === "midboss" ? "both" : l.underground ? "under" : "above"]}
            data-layer="marker"
            style={pos(l)}
            title={MARKER_LABEL[l.kind] ?? l.kind}
          >
            {l.kind === "midboss" && camps.midboss?.icon && <img src={`${base}/${camps.midboss.icon}`} alt="" draggable="false" />}
          </span>
        ))}
      </div>
    </div>
    <p class="fm-info" aria-live="polite"></p>
    <p class="fm-note">
      ホイール（スマホは2本指）で拡大、ドラッグで移動できます。点にカーソルを合わせるかタップすると、名前と出現時刻が出ます。
      自チームを南（下）側として、中央から先の敵陣のレーンと建造物を赤で表しています。
      紫の点は地下トンネル（3人専用）の箱で、ミニマップの絵には描かれていない場所です。
      「地下トンネル（3人専用）」の紫の範囲は、地形の当たり判定とトンネルの箱の位置から推定したもので、形はおおよそです。
      白縁の丸は地上からの入口、金縁の丸はミッド・ボスの部屋からの入口です（小さい姿でだけ通れる壁の位置）。
    </p>
  </div>
)}

<script is:inline>
  (() => {
    for (const root of document.querySelectorAll("[data-farmmap]")) {
      const stage = root.querySelector(".fm-stage");
      const hidden = new Set((stage.dataset.hide || "").split(" ").filter(Boolean));
      const apply = () => (stage.dataset.hide = [...hidden].join(" "));
      for (const cb of root.querySelectorAll("input[data-layer]")) {
        cb.addEventListener("change", () => {
          if (cb.checked) hidden.delete(cb.dataset.layer);
          else hidden.add(cb.dataset.layer);
          apply();
        });
      }

      // ---- 拡大縮小・移動(ホイール / ドラッグ / 2本指) ----
      // 地図の要素そのものの幅・高さを変える。点は % で置いてあるので、大きさを保ったまま位置だけ広がる
      const world = stage.querySelector(".fm-world");
      const info = root.querySelector(".fm-info");
      const MAX = 6;
      let scale = 1, tx = 0, ty = 0;
      const size = () => stage.clientWidth;
      const render = () => {
        const w = size();
        tx = Math.min(0, Math.max(w - w * scale, tx));
        ty = Math.min(0, Math.max(w - w * scale, ty));
        world.style.left = `${tx}px`;
        world.style.top = `${ty}px`;
        world.style.width = world.style.height = `${w * scale}px`;
        stage.classList.toggle("zoomed", scale > 1.01);
      };
      // (px, py) = ステージ内の座標を中心に factor 倍する
      const zoomAt = (px, py, factor) => {
        const next = Math.min(MAX, Math.max(1, scale * factor));
        const k = next / scale;
        tx = px - (px - tx) * k;
        ty = py - (py - ty) * k;
        scale = next;
        render();
      };
      const local = (e) => {
        const r = stage.getBoundingClientRect();
        return [e.clientX - r.left, e.clientY - r.top];
      };
      stage.addEventListener("wheel", (e) => {
        e.preventDefault();
        const [x, y] = local(e);
        zoomAt(x, y, Math.exp(-e.deltaY * 0.0015));
      }, { passive: false });

      const pointers = new Map();
      let pinch = null;
      let moved = 0;
      stage.addEventListener("pointerdown", (e) => {
        if (e.target.closest(".fm-zoom")) return;
        stage.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, local(e));
        moved = 0;
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinch = { dist: Math.hypot(a[0] - b[0], a[1] - b[1]) };
        }
      });
      stage.addEventListener("pointermove", (e) => {
        if (!pointers.has(e.pointerId)) return;
        const prev = pointers.get(e.pointerId);
        const cur = local(e);
        pointers.set(e.pointerId, cur);
        if (pointers.size === 2 && pinch) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a[0] - b[0], a[1] - b[1]);
          zoomAt((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, dist / pinch.dist);
          pinch.dist = dist;
          moved += 10;
        } else if (pointers.size === 1) {
          tx += cur[0] - prev[0];
          ty += cur[1] - prev[1];
          moved += Math.abs(cur[0] - prev[0]) + Math.abs(cur[1] - prev[1]);
          render();
        }
      });
      const end = (e) => {
        pointers.delete(e.pointerId);
        if (pointers.size < 2) pinch = null;
      };
      stage.addEventListener("pointerup", (e) => {
        // ほとんど動かさずに離したらタップとみなし、点の情報を出す
        if (moved < 6 && pointers.size === 1) {
          const mk = document.elementFromPoint(e.clientX, e.clientY)?.closest(".mk");
          info.textContent = mk ? mk.getAttribute("title") : "";
        }
        end(e);
      });
      stage.addEventListener("pointercancel", end);
      for (const b of root.querySelectorAll("[data-zoom]")) {
        b.addEventListener("click", () => {
          const c = size() / 2;
          if (b.dataset.zoom === "in") zoomAt(c, c, 1.6);
          else if (b.dataset.zoom === "out") zoomAt(c, c, 1 / 1.6);
          else { scale = 1; tx = 0; ty = 0; render(); }
        });
      }
      window.addEventListener("resize", render);
      render();

      for (const btn of root.querySelectorAll("[data-view-btn]")) {
        btn.addEventListener("click", () => {
          root.dataset.view = btn.dataset.viewBtn;
          for (const b of root.querySelectorAll("[data-view-btn]")) b.classList.toggle("on", b === btn);
          // 地下に切り替えたら箱を表示する(地下で見たいのはほぼ箱なので)
          if (btn.dataset.viewBtn !== "ground") {
            for (const k of btn.dataset.viewBtn === "hidden" ? ["tunnel"] : ["crate", "statue"]) {
              hidden.delete(k);
              const cb = root.querySelector(`input[data-layer="${k}"]`);
              if (cb) cb.checked = true;
            }
            apply();
          }
        });
      }
    }
  })();
</script>

<style>
  .farmmap { margin: var(--sp-3) 0 var(--sp-4); }
  .fm-controls { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-3); align-items: center; margin-bottom: var(--sp-2); }
  .fm-view { display: flex; }
  .fm-view button {
    font: inherit; font-size: 12px; padding: 4px 12px; cursor: pointer;
    background: var(--c-surface); color: var(--c-text-muted); border: 1px solid var(--c-border);
  }
  .fm-view button:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .fm-view button:last-child { border-radius: 0 var(--radius) var(--radius) 0; margin-left: -1px; }
  .fm-view button.on { color: var(--c-accent); border-color: var(--c-accent-dim); background: var(--c-accent-bg); position: relative; }
  .fm-layers { display: flex; flex-wrap: wrap; gap: 6px; }
  .fm-chip {
    display: inline-flex; align-items: center; gap: 5px; cursor: pointer; user-select: none;
    font-size: 12px; padding: 3px 9px; border: 1px solid var(--c-border); border-radius: 999px;
    background: var(--c-surface); color: var(--c-text-muted);
  }
  .fm-chip input { display: none; }
  .fm-chip:has(input:checked) { color: var(--c-text-strong); border-color: var(--c-border-strong); background: var(--c-surface-2); }
  .fm-chip:not(:has(input:checked)) { opacity: 0.55; }
  .fm-chip img { width: 14px; height: 14px; }
  .fm-chip small { font-family: var(--font-mono); font-size: 10px; color: var(--c-text-faint); }
  .fm-chip .sw { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .lay-crate .sw { background: var(--c-soul); }
  .lay-statue .sw { background: #e8b93a; border-radius: 2px; transform: rotate(45deg); }
  .lay-tunnel .sw { background: var(--c-spirit); }
  .lay-marker .sw { background: none; border: 2px solid var(--c-accent); }

  /* 円の外は透明(地図の画像自体が円で、外側は透過している) */
  .fm-stage {
    position: relative; width: 100%; max-width: 720px; aspect-ratio: 1; margin: 0 auto;
    overflow: hidden; touch-action: none; cursor: grab; user-select: none;
  }
  .fm-stage.zoomed { border-radius: var(--radius); outline: 1px solid var(--c-border); }
  .fm-stage:active { cursor: grabbing; }
  .fm-world { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
  .fm-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .fm-bg.tunnels { display: none; }
  [data-view="tunnels"] .fm-bg.ground { display: none; }
  [data-view="tunnels"] .fm-bg.tunnels { display: block; }
  /* 専用トンネル: 地上の絵を暗くして、推定したトンネルの範囲(紫)と、そこにある箱だけを出す */
  .fm-bg.hiddentn { display: none; }
  [data-view="hidden"] .fm-bg.hiddentn { display: block; }
  [data-view="hidden"] .fm-bg.ground { filter: brightness(0.55); }
  [data-view="hidden"] .fm-lanes, [data-view="hidden"] .st { opacity: 0.35; }
  [data-view="hidden"] .mk:not(.tunnelonly):not(.st):not(.ent) { display: none; }
  [data-view="hidden"] .mk.ent { display: block; }
  .fm-lanes { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .fm-lanes polyline { fill: none; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  [data-view="tunnels"] .fm-lanes, [data-view="tunnels"] .st { opacity: 0.25; }

  .fm-zoom { position: absolute; right: 8px; top: 8px; z-index: 2; display: flex; flex-direction: column; gap: 4px; }
  .fm-zoom button {
    width: 32px; height: 32px; font: inherit; font-size: 16px; line-height: 1; cursor: pointer;
    background: rgb(12 17 22 / 0.85); color: var(--c-text-strong); border: 1px solid var(--c-border-strong); border-radius: var(--radius);
  }
  .fm-zoom button:hover { border-color: var(--c-accent); color: var(--c-accent); }

  .mk { position: absolute; transform: translate(-50%, -50%); line-height: 0; cursor: pointer; }
  /* 地上表示では地下の点を、地下表示では地上の点を隠す(ミッド・ボスは両方に出す) */
  [data-view="ground"] .mk.under { display: none; }
  [data-view="tunnels"] .mk.above { display: none; }
  .fm-stage[data-hide~="weak"] [data-layer="weak"],
  .fm-stage[data-hide~="medium"] [data-layer="medium"],
  .fm-stage[data-hide~="strong"] [data-layer="strong"],
  .fm-stage[data-hide~="vaults"] [data-layer="vaults"],
  .fm-stage[data-hide~="crate"] [data-layer="crate"],
  .fm-stage[data-hide~="statue"] [data-layer="statue"],
  .fm-stage[data-hide~="marker"] [data-layer="marker"],
  .fm-stage[data-hide~="tunnel"] [data-layer="tunnel"] { display: none; }

  /* 建造物: ゲームのミニマップと同じ菱形。色は --c(自陣=レーン色 / 敵陣=赤) */
  .st { width: 14px; height: 14px; background: var(--c); transform: translate(-50%, -50%) rotate(45deg); box-shadow: 0 0 0 1.5px rgb(0 0 0 / 0.7); }
  .st-patron { width: 26px; height: 26px; }
