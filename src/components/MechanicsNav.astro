---
/** 攻略情報の各ページの上部に置く共通のサブメニュー。今いるページを強調し、スマホでは折り返す */
import { MECH_PAGES } from "../lib/mechanicsPages.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pagePath = Astro.url.pathname.slice(base.length);
---

<nav class="mechnav" aria-label="攻略情報">
  {MECH_PAGES.map((m) => (
    <a href={`${base}${m.path}`} aria-current={m.path === pagePath ? "page" : undefined}>{m.label}</a>
  ))}
</nav>

<style>
  .mechnav { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 var(--sp-4); }
  .mechnav a {
    font-size: 12.5px; padding: 5px 12px; border-radius: 999px; white-space: nowrap;
    border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text-muted);
  }
  .mechnav a:hover { color: var(--c-accent); border-color: var(--c-accent-dim); text-decoration: none; }
  .mechnav a[aria-current="page"] { color: var(--c-accent); border-color: var(--c-accent-dim); background: var(--c-accent-bg); font-weight: 600; }
</style>
