---
/**
 * 「売ることが前提のアイテム」の印(アイテムページの ItemSales.astro と、ヒーローページの HeroSales.astro で共用)。
 * 対象は items.json の allowGlobalSell(ゲームの設定でショップの外でも売れるもの)。
 */
interface Props {
  /** 行の中に置く小さい印 */
  small?: boolean;
}
const { small = false } = Astro.props;
const label = Astro.locals.i18n.L().stats.sales.sellFirst;
---

<span class:list={["sf", { small }]}>{label}</span>

<style>
  .sf {
    display: inline-block; font-size: 11.5px; line-height: 1.5; padding: 1px 8px; border-radius: 999px; white-space: nowrap;
    color: var(--c-text-strong); background: rgb(217 89 38 / 0.18); border: 1px solid rgb(217 89 38 / 0.55);
  }
  .sf.small { font-size: 10px; padding: 0 6px; }
</style>
