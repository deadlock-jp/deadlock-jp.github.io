---
/**
 * ヒーロー詳細ページの「強みと対策」。
 *
 * 出したものには必ず根拠（実数と全体の中での順位）を添える。
 * 手動タグ由来の行は実数の代わりに「手動タグ」と出して、機械判定と見分けが付くようにする。
 * 該当しなかった対策は出さない（出さなかった理由も書かない）。
 */
import ItemIcon from "./ItemIcon.astro";
import { t, souls, type PopularItemRow } from "../lib/data.ts";
import type { HeroMatchup } from "../lib/matchup.ts";

interface Props {
  matchup: HeroMatchup;
  base: string;
  /**
   * ヒーローページの「人気のアイテム」(相性の前に出す)。ティアごとの採用率上位。
   * tiers が null ならこの期間の統計がまだ無い
   */
  popular?: {
    title: string;
    period: string;
    matches: number;
    tiers: { tier: number; price: number; rows: PopularItemRow[] }[] | null;
  };
}
const { matchup, base, popular } = Astro.props;
const { strengths, noStandout, shares, counters } = matchup;
const { L, langPath, isJaOnlyFrom } = Astro.locals.i18n;
const T = L();
const M = L().matchup;
const S = L().stats;
/** 0.1% 刻みの整数 → "50.3%" */
const pct = (permille: number) => `${(permille / 10).toFixed(1)}%`;
---

{popular && (
  <section class="popular">
    <h2>{popular.title}</h2>
    <p class="pp-meta">{popular.period} / {S.matches(popular.matches.toLocaleString("en-US"))}</p>
    {popular.tiers ? (
      <>
        <p class="pp-lead">{S.popularLead}</p>
        <div class="pp-tiers">
          {popular.tiers.map((g) => (
            <div class="pp-tier">
              <h3>{T.common.tier(g.tier)}<span class="pp-price">{souls(g.price)}</span></h3>
              <ol>
                {g.rows.map((r) => (
                  <li>
                    <a class="pp-item" href={`${base}${langPath(`/items/${r.item.id}/`)}`}>
                      <ItemIcon
                        name={t(r.item.nameToken, r.item.id)}
                        slotType={r.item.slotType}
                        tier={r.item.tier}
                        shopIcon={r.item.shopIcon}
                        activation={r.item.activation}
                        isImbue={r.item.isImbue}
                        size={32}
                      />
                      <span class="pp-name">{t(r.item.nameToken, r.item.id)}</span>
                    </a>
                    <span class="pp-bar" aria-hidden="true"><i style={`width:${Math.min(100, r.pick / 10)}%`}></i></span>
                    <span class="pp-pick" title={S.pickRate}>{pct(r.pick)}</span>
                    <span class="pp-win">
                      {S.winRate} {pct(r.win)}
                      {r.low && <b class="pp-low">{S.lowSample}</b>}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
        <p class="pp-note">{S.winNote} {S.source}</p>
      </>
    ) : (
      <p class="pp-note">{S.noData}</p>
    )}
  </section>
)}

<section class="matchup">
  <h2>{M.title}</h2>

  <div class="head">
    <h3>{M.features}</h3>
    <span>{noStandout ? M.noStandout : M.standout}</span>
  </div>
  <ul class="chips">
    {strengths.map((s) => (
      <li>
        <span class="lb">{s.label}</span>
        <span class="vl">{s.value}</span>
        <span class="pc">{M.topPercent(s.topPercent)}</span>
      </li>
    ))}
  </ul>

  {shares.length > 0 && (
    <ul class="chips shares">
      {shares.map((s, i) => (
        <li>
          {i === 0 && <span class="lb">{M.sharesLabel}</span>}
          <span class="vl">{s.label} {s.percent}%</span>
          <span class="pc">{M.topPercent(s.topPercent)}</span>
        </li>
      ))}
    </ul>
  )}

  {counters.length > 0 && (
    <>
      <div class="head">
        <h3>{M.counters}</h3>
        <span>{M.countersNote}</span>
      </div>
      <div class="rules">
        {counters.map((c) => (
          <div class="rule">
            <p class="rhead">
              <b>{c.title}</b>
              <span class="why">
                {M.why}{c.why}
                {c.evidence && <em> — {c.evidence}</em>}
                {c.manual && <em class="manual"> — {M.manualTag}</em>}
              </span>
            </p>
            <ul class="items">
              {c.items.map((mi) => (
                <li>
                  <a href={`${base}${langPath(`/items/${mi.item.id}/`)}`} data-itemcard={mi.item.id}>
                    <ItemIcon
                      name={t(mi.item.nameToken, mi.item.id)}
                      slotType={mi.item.slotType}
                      tier={mi.item.tier}
                      shopIcon={mi.item.shopIcon}
                      activation={mi.item.activation}
                      isImbue={mi.item.isImbue}
                      size={30}
                    />
                  </a>
                  <span class="inm">
                    <a href={`${base}${langPath(`/items/${mi.item.id}/`)}`}>{t(mi.item.nameToken, mi.item.id)}</a>
                    <small>{mi.note ?? M.manualTag}</small>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </>
  )}

  <p class="foot">
    {M.foot}
    <a href={`${base}/about/`}>{M.method}{isJaOnlyFrom("/about/") && <span class="jaonly">{T.jaOnly}</span>}</a>
  </p>
</section>

<style>
  /* 人気のアイテム(ヒーローページ)。主役は採用率(太字の数値とバー)、勝率は小さく */
  .popular { margin-top: var(--sp-5); }
  .popular h2 { margin-bottom: var(--sp-1); }
  .pp-meta { margin: 0 0 var(--sp-2); font-size: 12px; color: var(--c-text-muted); }
  .pp-lead { margin: 0 0 var(--sp-3); font-size: 13px; color: var(--c-text); }
  .pp-tiers { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--sp-3); }
  .pp-tier { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: var(--sp-2) var(--sp-3); }
  .pp-tier h3 {
    display: flex; align-items: baseline; gap: 8px; margin: 0 0 6px; padding: 0; border: none;
    font-size: 13px; color: var(--c-text-strong);
  }
  .pp-price { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--c-soul); }
  .pp-tier ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pp-tier li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "item pick" "bar bar" "win win";
    gap: 2px 8px; align-items: center;
  }
  .pp-item { grid-area: item; display: flex; align-items: center; gap: 8px; min-width: 0; color: var(--c-text-strong); text-decoration: none; }
  .pp-item:hover .pp-name { text-decoration: underline; }
  .pp-name { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pp-pick { grid-area: pick; font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--c-text-strong); }
  .pp-bar { grid-area: bar; height: 4px; border-radius: 2px; background: var(--c-surface-3); overflow: hidden; }
  .pp-bar i { display: block; height: 100%; background: var(--c-accent); }
  .pp-win { grid-area: win; font-size: 11px; color: var(--c-text-faint); font-family: var(--font-mono); }
  .pp-low {
    margin-left: 6px; padding: 0 4px; border-radius: 3px; font-weight: 600; font-family: inherit;
    border: 1px solid var(--c-border-strong); color: var(--c-text-muted);
  }
  .pp-note { margin: var(--sp-3) 0 0; font-size: 12px; color: var(--c-text-faint); line-height: 1.7; }

  .matchup {
    margin-top: var(--sp-5);
  }
  .matchup h2 {
    margin-bottom: var(--sp-3);
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    border-bottom: 1px solid var(--c-border);
    padding-bottom: 6px;
    margin-bottom: var(--sp-3);
  }
  .head h3 {
    margin: 0;
    font-size: 15px;
    color: var(--c-text-strong);
    border: none;
    padding: 0;
  }
  .head span {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-text-faint);
    text-align: right;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 var(--sp-4);
    padding: 0;
  }
  .chips li {
    display: flex;
    align-items: baseline;
    gap: 7px;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 12px;
  }
  .chips .lb {
    color: var(--c-text-muted);
  }
  .chips .vl {
    font-family: var(--font-mono);
    color: var(--c-text-strong);
    font-weight: 500;
  }
  .chips .pc {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-accent);
  }
  .shares .pc {
    color: var(--c-text-faint);
  }

  .rules {
    display: flex;
    flex-direction: column;
  }
  .rule {
    border-top: 1px solid var(--c-border);
    padding: var(--sp-3) 0;
  }
  .rule:first-child {
    border-top: none;
    padding-top: 0;
  }
  .rhead {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin: 0 0 var(--sp-2);
  }
  .rhead b {
    font-size: 13px;
    color: var(--c-text-strong);
  }
  .why {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-text-faint);
    /* 根拠はスキル名まで入って長くなる。折り返して縮む側にする */
    flex: 1 1 260px;
    min-width: 0;
    line-height: 1.7;
  }
  .why em {
    font-style: normal;
    color: var(--c-soul);
  }
  .why em.manual {
    color: var(--c-spirit);
  }

  .items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .items li {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    border-radius: 5px;
    padding: 5px 10px 5px 5px;
  }
  .items li > a {
    display: block;
    line-height: 0;
    border-radius: 4px;
  }
  .items li > a:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  .inm {
    font-size: 12px;
    line-height: 1.4;
    min-width: 0;
  }
  .inm a {
    color: var(--c-text);
    text-decoration: none;
  }
  .inm a:hover {
    color: var(--c-accent);
  }
  .inm small {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--c-text-faint);
  }

  .foot {
    margin: var(--sp-4) 0 0;
    font-size: 11px;
    color: var(--c-text-faint);
  }
</style>
