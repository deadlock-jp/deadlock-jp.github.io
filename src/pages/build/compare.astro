---
/**
 * ビルドのバージョン間比較。/build/ で組んだビルド(ヒーロー+アイテム)を、
 * 2つのスナップショットバージョン(OLDER/NEWEST)それぞれの数値で評価し、
 * 武器・生命力・スピリットのステータスを並べて見せる。
 *
 * データは data/snapshots/ にある全バージョンぶんをこのページに埋め込み、
 * OLDER/NEWEST の選択はクライアント側で完結させる(ページ遷移なしで切り替え可能)。
 * 数値の計算式(maxHealth/weaponDamage/spiritPower)は /build/ の
 * src/pages/build/index.astro と同じもの。どちらかを直したらもう片方も直すこと。
 */
import Base from "../../layouts/Base.astro";
import { t, modifierLabel, SLOT_META, releasedHeroes } from "../../lib/data.ts";
import { weaponRows, weaponHeadline, weaponName, vitalityRows, spiritRows } from "../../lib/gamestats.ts";
import { listSnapshotVersions, loadVersionedSnapshot } from "../../lib/versionedData.ts";
import { COST_BONUS_TARGET } from "../../types/hero.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const versions = listSnapshotVersions(); // 新しい順

/** 1バージョンぶんのヒーロー・アイテムを、比較に要る数値だけの軽量な形にする */
function buildVersionPayload(version: string) {
  const snap = loadVersionedSnapshot(version);
  const abilityOf = (key: string) => snap.abilitiesFile.abilities[key];

  const heroes = Object.fromEntries(
    Object.values(snap.heroesFile.heroes)
      .filter((h) => h.released)
      .map((h) => {
        const weaponSlot = h.abilities.find((a) => a.slot === "Weapon_Primary");
        const weapon = weaponSlot ? (abilityOf(weaponSlot.abilityKey)?.weapon ?? null) : null;
        return [
          h.id,
          {
            levels: h.levels.map((l) => ({
              level: l.level,
              requiredGold: l.requiredGold,
              up: l.useStandardUpgrade,
            })),
            costBonuses: h.costBonuses,
            weaponHead: weaponHeadline(weapon),
            weaponName: weaponName(h),
            rows: {
              WeaponMod: weaponRows(h, weapon),
              Armor: vitalityRows(h),
              Tech: spiritRows(h),
            },
            calc: {
              baseHealth: h.startingStats.EMaxHealth ?? 0,
              healthPerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_HEALTH_FROM_LEVEL ?? 0,
              techPowerPerBoon: h.levelUpBonuses.MODIFIER_VALUE_TECH_POWER ?? 0,
              bulletDamage: weapon?.bulletDamage ?? null,
              bulletDamagePerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_BULLET_DAMAGE_FROM_LEVEL ?? 0,
              cycleTime: weapon?.cycleTime ?? null,
              bulletsPerShot: weapon?.bulletsPerShot ?? 1,
            },
          },
        ];
      }),
  );

  const items = Object.fromEntries(
    Object.values(snap.itemsFile.items)
      .filter((i) => i.inShop)
      .map((i) => [
        i.id,
        {
          cost: i.cost,
          slot: i.slotType,
          mods: i.passiveProperties
            .map((n) => i.properties[n])
            .filter((p) => p?.providedType && p.value !== null)
            .map((p) => ({ type: p!.providedType!, value: p!.value! })),
        },
      ]),
  );

  return { heroes, items };
}

const versionPayloads = Object.fromEntries(versions.map((v) => [v, buildVersionPayload(v)]));

// ヒーロー名・アイテム名はラベルなので、どのバージョンで見ても最新版の表記でよい
const heroNames = Object.fromEntries(releasedHeroes().map((h) => [h.id, t(h.nameToken, h.key)]));
const allItemIds = new Set<string>();
for (const v of versions) for (const id of Object.keys(versionPayloads[v].items)) allItemIds.add(id);
const itemNames = Object.fromEntries([...allItemIds].map((id) => [id, t(id, id)]));

// 合計ステータスの内訳ラベル(MODIFIER_VALUE_* → 日本語)。全バージョンの型を集める
const allModTypes = new Set<string>();
for (const v of versions) {
  for (const it of Object.values(versionPayloads[v].items)) {
    for (const m of it.mods) allModTypes.add(m.type);
  }
}
for (const c of Object.values(COST_BONUS_TARGET)) allModTypes.add(c.valueType);
const labels = Object.fromEntries([...allModTypes].map((type) => [type, modifierLabel(type)]));

const metaDesc = "Deadlock（デッドロック）のビルドを、パッチ間の数値差分で比較する。";
---

<Base title="ビルド比較" description={metaDesc}>
  <div class="head">
    <h1>ビルド比較</h1>
    <a class="back" id="backlink" href={`${base}/build/`}>← ビルドに戻る</a>
  </div>

  <p class="lead" id="nobuild" hidden>
    比較するビルドがありません。<a href={`${base}/build/`}>ビルドシミュレーター</a>
    でヒーローとアイテムを選んでから、このページへの導線を使ってください。
  </p>

  <div id="app" hidden>
    <div class="ctx" id="ctx"></div>

    <div class="verpick">
      <label>OLDER <select id="older"></select></label>
      <label>NEWEST <select id="newer"></select></label>
    </div>

    <p class="missingnote" id="missingnote" hidden>
      ⚠ 一部のアイテムは OLDER 側のバージョンに存在しません(未実装または削除済み)。
      該当アイテムはグレーアウトし、合計値には含めていません。
    </p>

    <div class="boxes" id="boxes"></div>

    <p class="caveat">
      表示しているのはクライアント側のデータです。サーバー側だけで調整された変更は、
      ここには反映されないことがあります。
    </p>
  </div>

  <script
    is:inline
    define:vars={{
      versionPayloads,
      versions,
      heroNames,
      itemNames,
      labels,
      costBonusTarget: COST_BONUS_TARGET,
      slotMeta: SLOT_META,
    }}
  >
    (() => {
      const $ = (id) => document.getElementById(id);
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      const fmt = (n) => Math.round(n * 100) / 100;

      // ---- URL(#h=<heroId>&i=<item,item,...>)は /build/ と同じ形式 ----
      const p = new URLSearchParams(location.hash.replace(/^#/, ""));
      const heroId = p.get("h") ? Number(p.get("h")) : null;
      const picked = (p.get("i") ?? "").split(",").filter(Boolean);
      $("backlink").href = $("backlink").href.split("#")[0] + (location.hash || "");

      if (heroId === null || !heroNames[heroId]) {
        $("nobuild").hidden = false;
        return;
      }
      $("app").hidden = false;

      // ---- 計算(src/pages/build/index.astro と同じ式。直したら両方直す) ----
      const LOWER_IS_BETTER_LABELS = new Set(["リロード時間", "スタミナクールダウン"]);

      function boonCount(h, level) {
        let n = 0;
        for (const l of h?.levels ?? []) if (l.level > 1 && l.level <= level && l.up !== false) n++;
        return n;
      }
      function costBonusStep(h, slot, invested) {
        const table = h?.costBonuses?.[slot];
        if (!table?.length) return null;
        let step = null;
        for (const row of table) if (invested >= row.goldThreshold) step = row;
        return step;
      }
      function sumMods(payload, types) {
        const want = Array.isArray(types) ? types : [types];
        let v = 0;
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) if (want.includes(m.type)) v += m.value;
        return v;
      }
      function catCost(payload) {
        const c = { WeaponMod: 0, Armor: 0, Tech: 0 };
        for (const id of picked) {
          const it = payload.items[id];
          if (it && it.slot in c) c[it.slot] += it.cost;
        }
        return c;
      }
      function levelForSouls(h, spent) {
        let current = h?.levels?.length ? h.levels[0].level : 1;
        for (const l of h?.levels ?? []) {
          if (spent >= l.requiredGold) current = l.level;
          else break;
        }
        return current;
      }
      function spiritPower(payload, h, cost, level) {
        if (!h) return 0;
        const type = costBonusTarget.Tech.valueType;
        let v = boonCount(h, level) * h.calc.techPowerPerBoon;
        v += costBonusStep(h, "Tech", cost.Tech)?.bonus ?? 0;
        v += sumMods(payload, type);
        return v;
      }
      function maxHealth(payload, h, cost, level) {
        if (!h) return null;
        const boon = boonCount(h, level) * h.calc.healthPerBoon;
        const pct =
          (costBonusStep(h, "Armor", cost.Armor)?.bonus ?? 0) +
          sumMods(payload, ["MODIFIER_VALUE_BASE_HEALTH_PERCENT", "MODIFIER_VALUE_HEALTH_MAX_PERCENT"]);
        const flat = sumMods(payload, "MODIFIER_VALUE_HEALTH_MAX");
        return (h.calc.baseHealth + boon) * (1 + pct / 100) + flat;
      }
      function weaponDamage(payload, h, cost, level) {
        if (!h || h.calc.bulletDamage === null) return { perBullet: null, dps: null };
        const boon = boonCount(h, level) * h.calc.bulletDamagePerBoon;
        const pct =
          (costBonusStep(h, "WeaponMod", cost.WeaponMod)?.bonus ?? 0) +
          sumMods(payload, "MODIFIER_VALUE_WEAPON_DAMAGE_INCREASE");
        const perBullet = (h.calc.bulletDamage + boon) * (1 + pct / 100);
        const dps = h.calc.cycleTime ? (perBullet / h.calc.cycleTime) * (h.calc.bulletsPerShot || 1) : null;
        return { perBullet, dps };
      }
      function statsTotal(payload, cost) {
        const total = new Map();
        const add = (type, v) => total.set(type, (total.get(type) ?? 0) + v);
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) add(m.type, m.value);
        for (const slot of ["WeaponMod", "Armor", "Tech"]) {
          const step = costBonusStep(payload.heroes[heroId], slot, cost[slot]);
          if (step) add(costBonusTarget[slot].valueType, step.bonus);
        }
        return total;
      }

      /** 1バージョンぶんの全部入り結果 */
      function evaluate(version) {
        const payload = versionPayloads[version];
        const h = payload.heroes[heroId] ?? null;
        const cost = catCost(payload);
        const spent = cost.WeaponMod + cost.Armor + cost.Tech;
        const level = h ? levelForSouls(h, spent) : 1;
        const mh = h ? maxHealth(payload, h, cost, level) : null;
        const wd = h ? weaponDamage(payload, h, cost, level) : { perBullet: null, dps: null };
        const sp = h ? spiritPower(payload, h, cost, level) : 0;
        const missing = picked.filter((id) => !payload.items[id]);
        const rows = { WeaponMod: [], Armor: [], Tech: [] };
        if (h) {
          for (const slot of ["WeaponMod", "Armor", "Tech"]) {
            rows[slot] = h.rows[slot].map((r) => {
              let value = r.value;
              if (slot === "Armor" && r.label === "最大HP") value = String(Math.round(mh));
              if (slot === "WeaponMod" && r.label === "弾薬ダメージ" && wd.perBullet !== null)
                value = String(Math.round(wd.perBullet * 10) / 10);
              return { label: r.label, value };
            });
          }
        }
        return {
          version,
          hero: h,
          level,
          missing,
          dps: wd.dps !== null ? Math.round(wd.dps) : (h?.weaponHead ? Number(h.weaponHead.dps) : null),
          maxHealth: mh,
          spiritPower: sp,
          rows,
          totals: statsTotal(payload, cost),
        };
      }

      // ---- 表示 ----
      /** "6.4m" のような単位付き文字列でも先頭の数値だけ見て向きを判定する */
      function numOf(v) {
        if (v === null || v === undefined) return null;
        const n = typeof v === "number" ? v : Number.parseFloat(String(v));
        return Number.isNaN(n) ? null : n;
      }
      function deltaMark(label, before, after) {
        const b = numOf(before);
        const a = numOf(after);
        if (b === null || a === null || b === a) return "";
        const lowerBetter = LOWER_IS_BETTER_LABELS.has(label);
        const up = a > b;
        const good = lowerBetter ? !up : up;
        const arrow = up ? "▲" : "▼";
        return `<span class="delta ${good ? "good" : "bad"}">${arrow}</span>`;
      }
      const disp = (v) => (v === null || v === undefined ? "—" : typeof v === "number" ? fmt(v) : v);
      function statLine(label, before, after) {
        return (
          `<li><span class="l">${esc(label)}</span>` +
          `<span class="vo">${esc(disp(before))}</span>` +
          `<span class="vn">${deltaMark(label, before, after)}${esc(disp(after))}</span></li>`
        );
      }

      function renderCtx() {
        const itemsHtml = picked.length
          ? picked.map((id) => `<li>${esc(itemNames[id] ?? id)}</li>`).join("")
          : '<li class="empty">アイテムなし</li>';
        $("ctx").innerHTML =
          `<div class="ctxhero"><b>${esc(heroNames[heroId])}</b></div>` +
          `<ul class="ctxitems">${itemsHtml}</ul>`;
      }

      function renderBoxes(older, newer) {
        $("missingnote").hidden = newer.missing.length === 0 && older.missing.length === 0;

        const headline = [
          statLine("DPS", older.dps, newer.dps),
          statLine("最大HP", older.maxHealth != null ? Math.round(older.maxHealth) : null, newer.maxHealth != null ? Math.round(newer.maxHealth) : null),
          statLine("スピリットパワー", older.spiritPower, newer.spiritPower),
          statLine("レベル", older.level, newer.level),
        ].join("");

        const box = (slot) => {
          const oRows = older.rows[slot] ?? [];
          const nRows = newer.rows[slot] ?? [];
          const byLabel = new Map(oRows.map((r) => [r.label, r.value]));
          const lines = nRows.map((r) => statLine(r.label, byLabel.get(r.label) ?? null, r.value)).join("");
          return (
            `<section class="box"><h3>${esc(slotMeta[slot].label)}ステータス</h3>` +
            `<ul class="rows head"><li><span class="l"></span><span class="vo">OLDER</span><span class="vn">NEWEST</span></li></ul>` +
            `<ul class="rows">${lines}</ul></section>`
          );
        };

        const totalsBox = () => {
          const keys = new Set([...older.totals.keys(), ...newer.totals.keys()]);
          const lines = [...keys]
            .map((k) => {
              const label = labels[k] ?? k.replace("MODIFIER_VALUE_", "");
              const ov = older.totals.get(k) ?? 0;
              const nv = newer.totals.get(k) ?? 0;
              if (ov === 0 && nv === 0) return "";
              return statLine(label, ov, nv);
            })
            .filter(Boolean)
            .join("");
          return `<section class="box"><h3>合計ステータス(常時パッシブ+購入ボーナス)</h3>` +
            `<ul class="rows head"><li><span class="l"></span><span class="vo">OLDER</span><span class="vn">NEWEST</span></li></ul>` +
            `<ul class="rows">${lines || '<li class="empty"><span class="l">—</span></li>'}</ul></section>`;
        };

        $("boxes").innerHTML =
          `<section class="box headline"><h3>概要</h3>` +
          `<ul class="rows head"><li><span class="l"></span><span class="vo">OLDER</span><span class="vn">NEWEST</span></li></ul>` +
          `<ul class="rows">${headline}</ul></section>` +
          box("WeaponMod") +
          box("Armor") +
          box("Tech") +
          totalsBox();
      }

      function populateSelect(el, selected) {
        el.innerHTML = versions.map((v) => `<option value="${v}"${v === selected ? " selected" : ""}>${v}</option>`).join("");
      }

      function refresh() {
        const older = evaluate($("older").value);
        const newer = evaluate($("newer").value);
        renderBoxes(older, newer);
      }

      populateSelect($("older"), versions[1] ?? versions[0]);
      populateSelect($("newer"), versions[0]);
      $("older").addEventListener("change", refresh);
      $("newer").addEventListener("change", refresh);

      renderCtx();
      refresh();
    })();
  </script>

  <style>
    .head { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
    .back { font-size: 13px; }
    .lead { max-width: 62ch; color: var(--c-text-muted); }

    .ctx {
      display: flex; align-items: baseline; gap: var(--sp-4); flex-wrap: wrap;
      margin: var(--sp-3) 0; padding: var(--sp-2) var(--sp-3);
      background: var(--c-surface-2); border-radius: var(--radius);
    }
    .ctxhero { font-size: 14px; }
    .ctxitems { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; }
    .ctxitems li {
      font-size: 12px; color: var(--c-text-muted);
      border: 1px solid var(--c-border); border-radius: 3px; padding: 1px 6px;
    }
    .ctxitems .empty { border: none; padding: 0; }

    .verpick { display: flex; gap: var(--sp-5); margin: var(--sp-3) 0; font-size: 13px; }
    .verpick select { margin-left: var(--sp-2); }

    .missingnote {
      font-size: 12px; color: var(--c-weapon); border-left: 3px solid var(--c-weapon);
      padding-left: var(--sp-2); max-width: 62ch;
    }

    .boxes { display: grid; gap: var(--sp-3); margin-top: var(--sp-3); }
    .box {
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-radius: var(--radius); padding: var(--sp-3) var(--sp-4);
    }
    .box h3 { margin: 0 0 var(--sp-2); font-size: 13px; color: var(--c-text-muted); }
    .box.headline { border-left: 3px solid var(--c-accent); }

    .rows { list-style: none; padding: 0; margin: 0; }
    .rows li {
      display: grid; grid-template-columns: minmax(0, 1fr) 90px 90px;
      gap: var(--sp-2); align-items: baseline; padding: 4px 0;
      border-bottom: 1px solid var(--c-border); font-size: 13px;
    }
    .rows.head li { border-bottom: 2px solid var(--c-border-strong); padding-bottom: 6px; }
    .rows.head .vo, .rows.head .vn {
      font-size: 10px; letter-spacing: 0.06em; color: var(--c-text-faint); text-align: right;
    }
    .rows .l { color: var(--c-text-muted); }
    .rows .vo { font-family: var(--font-mono); color: var(--c-text-muted); text-align: right; }
    .rows .vn {
      font-family: var(--font-mono); color: var(--c-text-strong); text-align: right;
      display: flex; align-items: center; justify-content: flex-end; gap: 3px;
    }
    .rows .empty { color: var(--c-text-faint); }
    .delta.good { color: var(--c-vitality); }
    .delta.bad { color: var(--c-weapon); }

    .caveat { margin-top: var(--sp-4); font-size: 11px; color: var(--c-text-faint); max-width: 62ch; }

    @media (max-width: 560px) {
      .rows li { grid-template-columns: minmax(0, 1fr) 70px 70px; font-size: 12px; }
    }
  </style>
</Base>
