---
/**
 * ビルドのバージョン間比較。/build/ で組んだビルド(ヒーロー+アイテム)を、
 * 2つのスナップショットバージョン(OLDER/NEWEST)それぞれの数値で評価し、
 * 武器・生命力・スピリットのステータスを左右ペアで並べて見せる。
 * 見た目は /build/ の各カテゴリーボックス(.box/.bhead/.bhl/.brows)をそのまま踏襲する。
 *
 * データは data/snapshots/ にある全バージョンぶんをこのページに埋め込み、
 * OLDER/NEWEST の選択はクライアント側で完結させる(ページ遷移なしで切り替え可能)。
 * 数値の計算式(maxHealth/weaponDamage/spiritPower)は /build/ の
 * src/pages/build/index.astro と同じもの。どちらかを直したらもう片方も直すこと。
 *
 * 重要: このページの動的な内容は全部 JS の innerHTML で組み立てる(OLDER/NEWEST を
 * 切り替えるたび作り直すため)。Astro の scoped CSS は innerHTML で挿し込んだ要素には
 * 効かないので、対象セレクタは :global() を使うこと(CLAUDE.md 既知の落とし穴 参照)。
 */
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import { t, modifierLabel, SLOT_META, releasedHeroes } from "../../lib/data.ts";
import { weaponRows, weaponHeadline, weaponName, vitalityRows, spiritRows } from "../../lib/gamestats.ts";
import { listSnapshotVersions, loadVersionedSnapshot } from "../../lib/versionedData.ts";
import { COST_BONUS_TARGET } from "../../types/hero.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const versions = listSnapshotVersions(); // 新しい順

/** 1バージョンぶんのヒーロー・アイテムを、比較に要る数値だけの軽量な形にする */
function buildVersionPayload(version: string) {
  const snap = loadVersionedSnapshot(version);
  const abilityOf = (key: string) => snap.abilitiesFile.abilities[key];

  const heroes = Object.fromEntries(
    Object.values(snap.heroesFile.heroes)
      .filter((h) => h.released)
      .map((h) => {
        const weaponSlot = h.abilities.find((a) => a.slot === "Weapon_Primary");
        const weapon = weaponSlot ? (abilityOf(weaponSlot.abilityKey)?.weapon ?? null) : null;
        return [
          h.id,
          {
            levels: h.levels.map((l) => ({
              level: l.level,
              requiredGold: l.requiredGold,
              up: l.useStandardUpgrade,
            })),
            costBonuses: h.costBonuses,
            weaponHead: weaponHeadline(weapon),
            weaponName: weaponName(h),
            rows: {
              WeaponMod: weaponRows(h, weapon),
              Armor: vitalityRows(h),
              Tech: spiritRows(h),
            },
            calc: {
              baseHealth: h.startingStats.EMaxHealth ?? 0,
              healthPerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_HEALTH_FROM_LEVEL ?? 0,
              techPowerPerBoon: h.levelUpBonuses.MODIFIER_VALUE_TECH_POWER ?? 0,
              bulletDamage: weapon?.bulletDamage ?? null,
              bulletDamagePerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_BULLET_DAMAGE_FROM_LEVEL ?? 0,
              cycleTime: weapon?.cycleTime ?? null,
              bulletsPerShot: weapon?.bulletsPerShot ?? 1,
            },
          },
        ];
      }),
  );

  const items = Object.fromEntries(
    Object.values(snap.itemsFile.items)
      .filter((i) => i.inShop)
      .map((i) => [
        i.id,
        {
          cost: i.cost,
          slot: i.slotType,
          mods: i.passiveProperties
            .map((n) => i.properties[n])
            .filter((p) => p?.providedType && p.value !== null)
            .map((p) => ({ type: p!.providedType!, value: p!.value! })),
        },
      ]),
  );

  return { heroes, items };
}

const versionPayloads = Object.fromEntries(versions.map((v) => [v, buildVersionPayload(v)]));

// ヒーロー名・アイテム名はラベルなので、どのバージョンで見ても最新版の表記でよい
const heroes = releasedHeroes();
const heroNames = Object.fromEntries(heroes.map((h) => [h.id, t(h.nameToken, h.key)]));
const allItemIds = new Set<string>();
for (const v of versions) for (const id of Object.keys(versionPayloads[v].items)) allItemIds.add(id);
const itemNames = Object.fromEntries([...allItemIds].map((id) => [id, t(id, id)]));

/*
 * アイコン表示用の見た目情報(tier/slotType/shopIcon等)は数値ではなく、
 * バージョン間でまず変わらない。新しい順に見て最初に見つかったバージョンの値を使う。
 */
const itemIconMeta: Record<
  string,
  { tier: number; slotType: string | null; shopIcon: string | null; activation: string; isImbue: boolean }
> = {};
for (const v of versions) {
  const snap = loadVersionedSnapshot(v);
  for (const id of allItemIds) {
    if (itemIconMeta[id]) continue;
    const it = snap.itemsFile.items[id];
    if (it) {
      itemIconMeta[id] = {
        tier: it.tier,
        slotType: it.slotType,
        shopIcon: it.shopIcon,
        activation: it.activation,
        isImbue: it.isImbue,
      };
    }
  }
}

// 合計ステータスの内訳ラベル(MODIFIER_VALUE_* → 日本語)。全バージョンの型を集める
const allModTypes = new Set<string>();
for (const v of versions) {
  for (const it of Object.values(versionPayloads[v].items)) {
    for (const m of it.mods) allModTypes.add(m.type);
  }
}
for (const c of Object.values(COST_BONUS_TARGET)) allModTypes.add(c.valueType);
const labels = Object.fromEntries([...allModTypes].map((type) => [type, modifierLabel(type)]));

const metaDesc = "Deadlock（デッドロック）のビルドを、パッチ間の数値差分で比較する。";
---

<Base title="ビルド比較" description={metaDesc}>
  <div class="head">
    <h1>ビルド比較</h1>
    <a class="back" id="backlink" href={`${base}/build/`}>← ビルドに戻る</a>
  </div>

  <p class="lead" id="nobuild" hidden>
    比較するビルドがありません。<a href={`${base}/build/`}>ビルドシミュレーター</a>
    でヒーローとアイテムを選んでから、このページへの導線を使ってください。
  </p>

  <div id="app" hidden>
    <div class="topbar">
      <div class="herow" id="herow"></div>
      <div class="cells" id="cells"></div>
    </div>

    <div class="verpick">
      <label>OLDER <select id="older"></select></label>
      <span class="verinfo" id="olderinfo"></span>
      <label>NEWEST <select id="newer"></select></label>
      <span class="verinfo" id="newerinfo"></span>
    </div>

    <p class="missingnote" id="missingnote" hidden>
      ⚠ 一部のアイテムは OLDER 側のバージョンに存在しません(未実装または削除済み)。
      該当アイテムはグレーアウトし、合計値には含めていません。
    </p>

    <div class="boxes" id="boxes"></div>

    <p class="caveat">
      表示しているのはクライアント側のデータです。サーバー側だけで調整された変更は、
      ここには反映されないことがあります。
    </p>
  </div>

  {/* アイコンの供給元。表示はせず、クローン元としてだけ使う(build/index.astro と同じ手法) */}
  <div class="iconsrc" aria-hidden="true">
    {
      heroes.map((h) => (
        <span class="heroicon-src" data-hero={h.id}>
          <HeroPortrait name={heroNames[h.id]} image={h.images.iconSmall} size={40} />
        </span>
      ))
    }
    {
      [...allItemIds].map((id) => {
        const m = itemIconMeta[id];
        if (!m) return null;
        return (
          <span class="itemicon-src" data-item={id}>
            <ItemIcon
              name={itemNames[id]}
              slotType={m.slotType as any}
              tier={m.tier}
              shopIcon={m.shopIcon}
              activation={m.activation}
              isImbue={m.isImbue}
              size={40}
            />
          </span>
        );
      })
    }
  </div>

  <script
    is:inline
    define:vars={{
      versionPayloads,
      versions,
      heroNames,
      itemNames,
      labels,
      costBonusTarget: COST_BONUS_TARGET,
      slotMeta: SLOT_META,
    }}
  >
    (() => {
      const $ = (id) => document.getElementById(id);
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      const round1 = (n) => Math.round(n * 10) / 10;
      const fmtSouls = (n) => Math.round(n).toLocaleString("en-US");

      // ---- URL(#h=<heroId>&i=<item,item,...>)は /build/ と同じ形式(短縮ID) ----
      const ID_PREFIX = "upgrade_";
      const expand = (s) => (s.startsWith("!") ? s.slice(1) : ID_PREFIX + s);
      const p = new URLSearchParams(location.hash.replace(/^#/, ""));
      const heroId = p.get("h") ? Number(p.get("h")) : null;
      const picked = (p.get("i") ?? "").split(",").filter(Boolean).map(expand);
      $("backlink").href = $("backlink").href.split("#")[0] + (location.hash || "");

      if (heroId === null || !heroNames[heroId]) {
        $("nobuild").hidden = false;
        return;
      }
      $("app").hidden = false;

      // ---- 計算(src/pages/build/index.astro と同じ式。直したら両方直す) ----
      const LOWER_IS_BETTER_LABELS = new Set(["リロード時間", "スタミナクールダウン"]);

      function boonCount(h, level) {
        let n = 0;
        for (const l of h?.levels ?? []) if (l.level > 1 && l.level <= level && l.up !== false) n++;
        return n;
      }
      function costBonusStep(h, slot, invested) {
        const table = h?.costBonuses?.[slot];
        if (!table?.length) return null;
        let step = null;
        for (const row of table) if (invested >= row.goldThreshold) step = row;
        return step;
      }
      function sumMods(payload, types) {
        const want = Array.isArray(types) ? types : [types];
        let v = 0;
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) if (want.includes(m.type)) v += m.value;
        return v;
      }
      function catCost(payload) {
        const c = { WeaponMod: 0, Armor: 0, Tech: 0 };
        for (const id of picked) {
          const it = payload.items[id];
          if (it && it.slot in c) c[it.slot] += it.cost;
        }
        return c;
      }
      function levelForSouls(h, spent) {
        let current = h?.levels?.length ? h.levels[0].level : 1;
        for (const l of h?.levels ?? []) {
          if (spent >= l.requiredGold) current = l.level;
          else break;
        }
        return current;
      }
      function spiritPower(payload, h, cost, level) {
        if (!h) return 0;
        const type = costBonusTarget.Tech.valueType;
        let v = boonCount(h, level) * h.calc.techPowerPerBoon;
        v += costBonusStep(h, "Tech", cost.Tech)?.bonus ?? 0;
        v += sumMods(payload, type);
        return v;
      }
      function maxHealthFull(payload, h, cost, level) {
        const boon = boonCount(h, level) * h.calc.healthPerBoon;
        const pct =
          (costBonusStep(h, "Armor", cost.Armor)?.bonus ?? 0) +
          sumMods(payload, ["MODIFIER_VALUE_BASE_HEALTH_PERCENT", "MODIFIER_VALUE_HEALTH_MAX_PERCENT"]);
        const flat = sumMods(payload, "MODIFIER_VALUE_HEALTH_MAX");
        const total = (h.calc.baseHealth + boon) * (1 + pct / 100) + flat;
        return { total, base: h.calc.baseHealth, boon, pct, flat };
      }
      function weaponDamageFull(payload, h, cost, level) {
        if (h.calc.bulletDamage === null) return null;
        const boon = boonCount(h, level) * h.calc.bulletDamagePerBoon;
        const pct =
          (costBonusStep(h, "WeaponMod", cost.WeaponMod)?.bonus ?? 0) +
          sumMods(payload, "MODIFIER_VALUE_WEAPON_DAMAGE_INCREASE");
        const perBullet = (h.calc.bulletDamage + boon) * (1 + pct / 100);
        const dps = h.calc.cycleTime ? (perBullet / h.calc.cycleTime) * (h.calc.bulletsPerShot || 1) : null;
        return { perBullet, dps, pct, base: h.calc.bulletDamage, boon };
      }
      function statsTotal(payload, cost) {
        const total = new Map();
        const add = (type, v) => total.set(type, (total.get(type) ?? 0) + v);
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) add(m.type, m.value);
        for (const slot of ["WeaponMod", "Armor", "Tech"]) {
          const step = costBonusStep(payload.heroes[heroId], slot, cost[slot]);
          if (step) add(costBonusTarget[slot].valueType, step.bonus);
        }
        return total;
      }

      /** 1バージョンぶんの全部入り結果 */
      function evaluate(version) {
        const payload = versionPayloads[version];
        const h = payload.heroes[heroId] ?? null;
        const cost = catCost(payload);
        const spent = cost.WeaponMod + cost.Armor + cost.Tech;
        const level = h ? levelForSouls(h, spent) : 1;
        const missing = picked.filter((id) => !payload.items[id]);

        let dps = null;
        let weaponNote = "";
        let healthTotal = null;
        let healthNote = "";
        let spiritTotal = 0;
        let spiritNote = "";
        const rows = { WeaponMod: [], Armor: [], Tech: [] };

        if (h) {
          const wd = weaponDamageFull(payload, h, cost, level);
          dps = wd && wd.dps !== null ? Math.round(wd.dps) : h.weaponHead ? Number(h.weaponHead.dps) : null;
          if (h.weaponHead) {
            const pctNote = wd && wd.pct ? ` / 武器 +${round1(wd.pct)}%` : "";
            weaponNote = `${h.weaponName} / 減衰 ${h.weaponHead.falloffStart} → ${h.weaponHead.falloffEnd}${pctNote}`;
          }

          const mh = maxHealthFull(payload, h, cost, level);
          healthTotal = mh.total;
          const parts = [`基礎 ${Math.round(mh.base)}`];
          if (mh.boon) parts.push(`Boon +${Math.round(mh.boon)}`);
          if (mh.pct) parts.push(`×(1+${round1(mh.pct)}%)`);
          if (mh.flat) parts.push(`平坦 +${Math.round(mh.flat)}`);
          healthNote = parts.join(" ");

          spiritTotal = spiritPower(payload, h, cost, level);
          const fromLevel = boonCount(h, level) * h.calc.techPowerPerBoon;
          const fromBonus = costBonusStep(h, "Tech", cost.Tech)?.bonus ?? 0;
          const fromItems = spiritTotal - fromLevel - fromBonus;
          spiritNote = `レベル ${round1(fromLevel)} + 購入ボーナス ${fromBonus} + アイテム ${round1(fromItems)}`;

          for (const slot of ["WeaponMod", "Armor", "Tech"]) {
            rows[slot] = h.rows[slot].map((r) => {
              let value = r.value;
              if (slot === "Armor" && r.label === "最大HP") value = String(Math.round(healthTotal));
              if (slot === "WeaponMod" && r.label === "弾薬ダメージ" && wd && wd.perBullet !== null)
                value = String(round1(wd.perBullet));
              return { label: r.label, value };
            });
          }
        }

        return {
          version,
          hero: h,
          level,
          spent,
          missing,
          dps,
          weaponNote,
          healthTotal,
          healthNote,
          spiritTotal,
          spiritNote,
          rows,
          totals: statsTotal(payload, cost),
        };
      }

      // ---- 表示 ----
      /** "6.4m" のような単位付き文字列でも先頭の数値だけ見て向きを判定する */
      function numOf(v) {
        if (v === null || v === undefined) return null;
        const n = typeof v === "number" ? v : Number.parseFloat(String(v));
        return Number.isNaN(n) ? null : n;
      }
      function deltaHtml(label, before, after) {
        const b = numOf(before);
        const a = numOf(after);
        if (b === null || a === null || b === a) return "";
        const lowerBetter = LOWER_IS_BETTER_LABELS.has(label);
        const up = a > b;
        const good = lowerBetter ? !up : up;
        const arrow = up ? "▲" : "▼";
        return `<span class="delta ${good ? "good" : "bad"}">${arrow}</span>`;
      }
      const disp = (v) => (v === null || v === undefined ? "—" : typeof v === "number" ? round1(v) : v);

      function rowLinePlain(label, value) {
        return `<li><span class="l">${esc(label)}</span><span class="v">${esc(disp(value))}</span></li>`;
      }
      function rowLine(label, before, after) {
        return (
          `<li><span class="l">${esc(label)}</span>` +
          `<span class="v">${deltaHtml(label, before, after)}${esc(disp(after))}</span></li>`
        );
      }

      function boxHeadline(slot, r, prev) {
        if (!r.hero) return "";
        if (slot === "WeaponMod") {
          const mark = prev ? deltaHtml("DPS", prev.dps, r.dps) : "";
          return `<b>${mark}${esc(disp(r.dps))}</b> DPS<small>${esc(r.weaponNote)}</small>`;
        }
        if (slot === "Armor") {
          const mark = prev ? deltaHtml("最大HP", prev.healthTotal, r.healthTotal) : "";
          const val = r.healthTotal !== null ? Math.round(r.healthTotal) : null;
          return `<b>${mark}${esc(disp(val))}</b> 最大HP<small>${esc(r.healthNote)}</small>`;
        }
        if (slot === "Tech") {
          const mark = prev ? deltaHtml("スピリットパワー", prev.spiritTotal, r.spiritTotal) : "";
          return `<b>${mark}${esc(disp(round1(r.spiritTotal)))}</b> スピリットパワー<small>${esc(r.spiritNote)}</small>`;
        }
        return "";
      }

      /** カテゴリー1つぶんを OLDER/NEWEST の左右ペアで描く。中身は build/index.astro の .box と同じ見た目 */
      function categoryPair(slot, older, newer) {
        const meta = slotMeta[slot];
        const oRows = older.rows[slot] ?? [];
        const nRows = newer.rows[slot] ?? [];
        const byLabel = new Map(oRows.map((r) => [r.label, r.value]));

        const oldRowsHtml = oRows.map((r) => rowLinePlain(r.label, r.value)).join("") || '<li class="empty">ヒーロー未選択</li>';
        const newRowsHtml = nRows.map((r) => rowLine(r.label, byLabel.get(r.label) ?? null, r.value)).join("") || '<li class="empty">ヒーロー未選択</li>';

        const style = `--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)`;
        const title = `${esc(meta.label)}ステータス`;
        return (
          `<div class="pair" style="${style}">` +
          `<div class="box"><div class="bhead"><h2>${title}</h2><span class="vtag">OLDER・${esc(older.version)}</span></div>` +
          `<div class="bhl">${boxHeadline(slot, older, null)}</div>` +
          `<ul class="brows">${oldRowsHtml}</ul></div>` +
          `<div class="box"><div class="bhead"><h2>${title}</h2><span class="vtag">NEWEST・${esc(newer.version)}</span></div>` +
          `<div class="bhl">${boxHeadline(slot, newer, older)}</div>` +
          `<ul class="brows">${newRowsHtml}</ul></div>` +
          `</div>`
        );
      }

      function totalsPair(older, newer) {
        const keys = new Set([...older.totals.keys(), ...newer.totals.keys()]);
        let oldLines = "";
        let newLines = "";
        for (const k of keys) {
          const label = labels[k] ?? k.replace("MODIFIER_VALUE_", "");
          const ov = older.totals.get(k) ?? 0;
          const nv = newer.totals.get(k) ?? 0;
          if (ov === 0 && nv === 0) continue;
          oldLines += rowLinePlain(label, ov);
          newLines += rowLine(label, ov, nv);
        }
        return (
          `<div class="pair">` +
          `<div class="box plain"><div class="bhead"><h2>合計ステータス</h2><span class="vtag">OLDER・${esc(older.version)}</span></div>` +
          `<ul class="brows">${oldLines || '<li class="empty">—</li>'}</ul></div>` +
          `<div class="box plain"><div class="bhead"><h2>合計ステータス</h2><span class="vtag">NEWEST・${esc(newer.version)}</span></div>` +
          `<ul class="brows">${newLines || '<li class="empty">—</li>'}</ul></div>` +
          `</div>`
        );
      }

      function renderTopBar(missing) {
        const heroSrc = document.querySelector(`.heroicon-src[data-hero="${heroId}"] .portrait`);
        $("herow").innerHTML = "";
        const wrap = document.createElement("div");
        wrap.className = "herowrap";
        if (heroSrc) wrap.append(heroSrc.cloneNode(true));
        const label = document.createElement("b");
        label.className = "heroname";
        label.textContent = heroNames[heroId];
        wrap.append(label);
        $("herow").append(wrap);

        const cellsEl = $("cells");
        cellsEl.innerHTML = "";
        const n = Math.max(12, picked.length);
        for (let i = 0; i < n; i++) {
          const id = picked[i];
          const cell = document.createElement("span");
          cell.className = "cell";
          if (id) {
            cell.classList.add("filled");
            if (missing.has(id)) cell.classList.add("warn");
            cell.title = itemNames[id] ?? id;
            const src = document.querySelector(`.itemicon-src[data-item="${CSS.escape(id)}"] .icon`);
            if (src) cell.append(src.cloneNode(true));
          }
          if (i >= 12) cell.classList.add("over");
          cellsEl.append(cell);
        }
      }

      function renderVerInfo(older, newer) {
        $("olderinfo").textContent = older.hero ? `Lv${older.level}・${fmtSouls(older.spent)}ソウル` : "";
        $("newerinfo").textContent = newer.hero ? `Lv${newer.level}・${fmtSouls(newer.spent)}ソウル` : "";
      }

      function populateSelect(el, selected) {
        el.innerHTML = versions.map((v) => `<option value="${v}"${v === selected ? " selected" : ""}>${v}</option>`).join("");
      }

      function refresh() {
        const older = evaluate($("older").value);
        const newer = evaluate($("newer").value);
        const missing = new Set([...older.missing, ...newer.missing]);
        $("missingnote").hidden = missing.size === 0;

        renderTopBar(missing);
        renderVerInfo(older, newer);
        $("boxes").innerHTML =
          categoryPair("WeaponMod", older, newer) +
          categoryPair("Armor", older, newer) +
          categoryPair("Tech", older, newer) +
          totalsPair(older, newer);
      }

      populateSelect($("older"), versions[1] ?? versions[0]);
      populateSelect($("newer"), versions[0]);
      $("older").addEventListener("change", refresh);
      $("newer").addEventListener("change", refresh);

      refresh();
    })();
  </script>

  <style>
    .head { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
    .back { font-size: 13px; }
    .lead { max-width: 62ch; color: var(--c-text-muted); }

    /* ---- 上部: ビルドのヒーロー・アイテムUI(見た目は /build/ のスロットバーと同じ) ---- */
    .topbar { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; margin: var(--sp-3) 0; }
    .herow :global(.herowrap) { display: flex; align-items: center; gap: var(--sp-2); }
    .herow :global(.heroname) { font-weight: 600; color: var(--c-text-strong); font-size: 14px; }
    .cells {
      display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: repeat(2, auto);
      grid-auto-flow: column; gap: 5px; width: min(100%, 320px);
    }
    .cells :global(.cell) {
      aspect-ratio: 1; border-radius: 5px; border: 1px dashed var(--c-border-strong);
      background: var(--c-bg); display: block; padding: 0; line-height: 0; width: 100%;
    }
    .cells :global(.cell.filled) { border: 1px solid var(--c-border-strong); overflow: hidden; }
    .cells :global(.cell.filled.warn) { outline: 2px solid var(--c-weapon); outline-offset: 1px; }
    .cells :global(.cell.over) { outline: 2px solid #d08a3e; outline-offset: 1px; }
    .cells :global(.cell.filled .icon) { width: 100%; height: 100%; border: none; border-radius: 4px; }

    .verpick { display: flex; align-items: baseline; gap: var(--sp-3); flex-wrap: wrap; margin: var(--sp-3) 0; font-size: 13px; }
    .verpick select { margin-left: var(--sp-2); }
    .verinfo { font-size: 11px; color: var(--c-text-muted); font-family: var(--font-mono); }

    .missingnote {
      font-size: 12px; color: var(--c-weapon); border-left: 3px solid var(--c-weapon);
      padding-left: var(--sp-2); max-width: 62ch;
    }

    /* ---- 比較ボックス: OLDER/NEWEST 左右ペア。中身は動的挿入なので :global() 必須 ---- */
    .boxes { display: block; margin-top: var(--sp-3); }
    .boxes :global(.pair) {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); margin-bottom: var(--sp-3);
    }
    .boxes :global(.box) {
      background: var(--cat-bg, var(--c-surface)); border: 1px solid var(--cat, var(--c-border));
      border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-4) var(--sp-4); min-width: 0;
    }
    .boxes :global(.box.plain) { background: var(--c-surface); border-color: var(--c-border); }
    .boxes :global(.bhead) { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-2); flex-wrap: wrap; }
    .boxes :global(.bhead h2) { font-size: 13px; margin: 0; border: none; padding: 0; color: var(--cat, var(--c-text-strong)); letter-spacing: .04em; }
    .boxes :global(.box.plain .bhead h2) { color: var(--c-text-strong); }
    .boxes :global(.vtag) { font-size: 10px; letter-spacing: .04em; color: var(--c-text-faint); font-family: var(--font-mono); }
    .boxes :global(.bhl) { margin: var(--sp-2) 0; font-size: 11px; min-height: 1em; }
    .boxes :global(.bhl b) { font-family: var(--font-mono); font-size: 17px; color: var(--c-text-strong); margin-right: 3px; }
    .boxes :global(.bhl small) { display: block; color: var(--c-text-faint); margin-top: 1px; }
    .boxes :global(.brows) { list-style: none; padding: 0; margin: 0; }
    .boxes :global(.brows li) {
      display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3);
      padding: 3px 0; font-size: 12px; border-bottom: 1px solid var(--c-border);
    }
    .boxes :global(.brows .l) { color: var(--c-text-muted); }
    .boxes :global(.brows .v) {
      font-family: var(--font-mono); color: var(--c-text-strong); white-space: nowrap;
      display: inline-flex; align-items: center; gap: 3px;
    }
    .boxes :global(.brows .empty) { color: var(--c-text-faint); border: none; font-size: 12px; display: block; }
    .boxes :global(.delta.good) { color: var(--c-vitality); }
    .boxes :global(.delta.bad) { color: var(--c-weapon); }

    .caveat { margin-top: var(--sp-4); font-size: 11px; color: var(--c-text-faint); max-width: 62ch; }
    .iconsrc { display: none; }

    @media (max-width: 700px) {
      .boxes :global(.pair) { grid-template-columns: 1fr; }
    }
  </style>
</Base>
