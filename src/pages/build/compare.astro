---
/**
 * ビルドのバージョン間比較。/build/ で組んだビルド(ヒーロー+アイテム)を、
 * 2つのスナップショットバージョン(OLDER/NEWEST)それぞれの数値で評価し、
 * 武器・生命力・スピリットのステータスを左右ペアで並べて見せる。
 * 見た目は /build/ の各カテゴリーボックス(.box/.bhead/.bhl/.brows)をそのまま踏襲する。
 *
 * データは data/snapshots/ にある全バージョンぶんを言語ごとの JSON(src/lib/comparePayload.ts)にして
 * <head> で preload し、スクリプトで読む。OLDER/NEWEST の選択はクライアント側で完結させる
 * (ページ遷移なしで切り替え可能)。
 * 数値の計算式(maxHealth/weaponDamage/spiritPower)は /build/ の
 * src/pages/build/index.astro と同じもの。どちらかを直したらもう片方も直すこと。
 *
 * 重要: このページの動的な内容は全部 JS の innerHTML で組み立てる(OLDER/NEWEST を
 * 切り替えるたび作り直すため)。Astro の scoped CSS は innerHTML で挿し込んだ要素には
 * 効かないので、対象セレクタは :global() を使うこと(CLAUDE.md 既知の落とし穴 参照)。
 */
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import { SLOT_META } from "../../lib/data.ts";
import { compareData, compareDataFile } from "../../lib/comparePayload.ts";
import { COST_BONUS_TARGET } from "../../types/hero.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, term, langPath } = Astro.locals.i18n;
const T = L();
/** クライアント側の文言。{n} などは差し込み位置 */
const C = {
  ...T.compare.client,
  heroNotSelected: T.common.heroNotSelected,
  weaponPct: T.build.client.weaponPct,
  falloff: T.build.client.falloff,
  base: T.build.client.base,
  flat: T.build.client.flat,
  spiritBreakdown: T.build.client.spiritBreakdown,
  totalStats: T.build.totalStats,
  maxHealth: term("maxHealth"),
  spiritPower: term("spiritPower"),
  statsTitle: { WeaponMod: term("weaponStats"), Armor: term("vitalityStats"), Tech: term("spiritStats") },
};
// 全バージョンぶんの数値は JSON に分ける。ここではアイコンのマークアップに要る分だけ使う
const { heroes, heroNames, allItemIds, itemIconMeta, itemNames } = compareData();
const dataUrl = compareDataFile(base).url;

const metaDesc = T.compare.description;
---

<Base title={T.compare.title} description={metaDesc}>
  {/* 比較のデータ。スクリプト側の fetch と同じ要求になるよう crossorigin を付ける */}
  <link slot="head" rel="preload" href={dataUrl} as="fetch" type="application/json" crossorigin="anonymous" />
  <div class="head">
    <h1>{T.compare.title}</h1>
    <a class="back" id="backlink" href={`${base}${langPath("/build/")}`}>{T.compare.back}</a>
  </div>

  <p class="lead" id="loading">{T.build.client.loading}</p>
  <p class="loaderr" id="loaderr" role="alert" hidden>
    {T.build.client.loadFailed}
    <button type="button">{T.build.client.reload}</button>
  </p>
  <p class="lead" id="nobuild" hidden>{T.compare.noBuildBefore}<a href={`${base}${langPath("/build/")}`}>{T.build.title}</a>{T.compare.noBuildAfter}</p>

  <div id="app" hidden>
    <div class="topbar">
      <div class="herow" id="herow"></div>
      <div class="cells" id="cells"></div>
    </div>

    <p class="missingnote" id="missingnote" hidden>{T.compare.missing}</p>

    <div class="comparegrid">
      <div class="vercard older">
        <div class="vercard-head">
          <span class="vertag">OLDER</span>
          <select id="older"></select>
          <span class="vernum" id="olderinfo"></span>
        </div>
        <div class="vercard-body" id="olderbody"></div>
      </div>

      <div class="arrow" aria-hidden="true">⇒</div>

      <div class="vercard newer">
        <div class="vercard-head">
          <span class="vertag">NEWEST</span>
          <select id="newer"></select>
          <span class="vernum" id="newerinfo"></span>
        </div>
        <div class="vercard-body" id="newerbody"></div>
      </div>
    </div>

    <p class="caveat">{T.compare.caveat}</p>
  </div>

  {/* アイコンの供給元。表示はせず、クローン元としてだけ使う(build/index.astro と同じ手法) */}
  <div class="iconsrc" aria-hidden="true">
    {
      heroes.map((h) => (
        <span class="heroicon-src" data-hero={h.id}>
          <HeroPortrait name={heroNames[h.id]} image={h.images.iconSmall} size={40} />
        </span>
      ))
    }
    {
      [...allItemIds].map((id) => {
        const m = itemIconMeta[id];
        if (!m) return null;
        return (
          <span class="itemicon-src" data-item={id}>
            <ItemIcon
              name={itemNames[id]}
              slotType={m.slotType as any}
              tier={m.tier}
              shopIcon={m.shopIcon}
              activation={m.activation}
              isImbue={m.isImbue}
              size={40}
            />
          </span>
        );
      })
    }
  </div>

  <script
    is:inline
    define:vars={{
      dataUrl,
      costBonusTarget: COST_BONUS_TARGET,
      slotMeta: SLOT_META,
      C,
    }}
  >
    (() => {
      const $ = (id) => document.getElementById(id);
      // ---- URL(#h=<heroId>&i=<item,item,...>)は /build/ と同じ形式(短縮ID) ----
      const ID_PREFIX = "upgrade_";
      const expand = (s) => (s.startsWith("!") ? s.slice(1) : ID_PREFIX + s);
      const p = new URLSearchParams(location.hash.replace(/^#/, ""));
      const heroId = p.get("h") ? Number(p.get("h")) : null;
      const picked = (p.get("i") ?? "").split(",").filter(Boolean).map(expand);
      $("backlink").href = $("backlink").href.split("#")[0] + (location.hash || "");
      $("loaderr").querySelector("button").addEventListener("click", () => location.reload());

      // ヒーローの無い URL ならデータを待たずに案内を出す
      if (heroId === null) {
        $("loading").hidden = true;
        $("nobuild").hidden = false;
        return;
      }
      // データは別ファイルの JSON(<head> の preload で取りに行き始めている)
      fetch(dataUrl)
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          return res.json();
        })
        .then(
          (data) => {
            $("loading").hidden = true;
            start(data);
          },
          () => {
            $("loading").hidden = true;
            $("loaderr").hidden = false;
          },
        );

      function start({ versionPayloads, versions, versionLabels, heroNames, itemNames, labels }) {
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      const round1 = (n) => Math.round(n * 10) / 10;
      const fmtSouls = (n) => Math.round(n).toLocaleString("en-US");

      if (!heroNames[heroId]) {
        $("nobuild").hidden = false;
        return;
      }
      $("app").hidden = false;

      // ---- 計算(src/pages/build/index.astro と同じ式。直したら両方直す) ----
      /** 小さいほど良い行(gamestats.ts の StatRow.key) */
      const LOWER_IS_BETTER_KEYS = new Set(["reloadTime", "staminaCooldown"]);

      function boonCount(h, level) {
        let n = 0;
        for (const l of h?.levels ?? []) if (l.level > 1 && l.level <= level && l.up !== false) n++;
        return n;
      }
      function costBonusStep(h, slot, invested) {
        const table = h?.costBonuses?.[slot];
        if (!table?.length) return null;
        let step = null;
        for (const row of table) if (invested >= row.goldThreshold) step = row;
        return step;
      }
      function sumMods(payload, types) {
        const want = Array.isArray(types) ? types : [types];
        let v = 0;
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) if (want.includes(m.type)) v += m.value;
        return v;
      }
      function catCost(payload) {
        const c = { WeaponMod: 0, Armor: 0, Tech: 0 };
        for (const id of picked) {
          const it = payload.items[id];
          if (it && it.slot in c) c[it.slot] += it.cost;
        }
        return c;
      }
      function levelForSouls(h, spent) {
        let current = h?.levels?.length ? h.levels[0].level : 1;
        for (const l of h?.levels ?? []) {
          if (spent >= l.requiredGold) current = l.level;
          else break;
        }
        return current;
      }
      function spiritPower(payload, h, cost, level) {
        if (!h) return 0;
        const type = costBonusTarget.Tech.valueType;
        let v = boonCount(h, level) * h.calc.techPowerPerBoon;
        v += costBonusStep(h, "Tech", cost.Tech)?.bonus ?? 0;
        v += sumMods(payload, type);
        return v;
      }
      function maxHealthFull(payload, h, cost, level) {
        const boon = boonCount(h, level) * h.calc.healthPerBoon;
        const pct =
          (costBonusStep(h, "Armor", cost.Armor)?.bonus ?? 0) +
          sumMods(payload, ["MODIFIER_VALUE_BASE_HEALTH_PERCENT", "MODIFIER_VALUE_HEALTH_MAX_PERCENT"]);
        const flat = sumMods(payload, "MODIFIER_VALUE_HEALTH_MAX");
        const total = (h.calc.baseHealth + boon) * (1 + pct / 100) + flat;
        return { total, base: h.calc.baseHealth, boon, pct, flat };
      }
      function weaponDamageFull(payload, h, cost, level) {
        if (h.calc.bulletDamage === null) return null;
        const boon = boonCount(h, level) * h.calc.bulletDamagePerBoon;
        const pct =
          (costBonusStep(h, "WeaponMod", cost.WeaponMod)?.bonus ?? 0) +
          sumMods(payload, "MODIFIER_VALUE_WEAPON_DAMAGE_INCREASE");
        const perBullet = (h.calc.bulletDamage + boon) * (1 + pct / 100);
        const dps = h.calc.cycleTime ? (perBullet / h.calc.cycleTime) * (h.calc.bulletsPerShot || 1) : null;
        return { perBullet, dps, pct, base: h.calc.bulletDamage, boon };
      }
      function statsTotal(payload, cost) {
        const total = new Map();
        const add = (type, v) => total.set(type, (total.get(type) ?? 0) + v);
        for (const id of picked) for (const m of payload.items[id]?.mods ?? []) add(m.type, m.value);
        for (const slot of ["WeaponMod", "Armor", "Tech"]) {
          const step = costBonusStep(payload.heroes[heroId], slot, cost[slot]);
          if (step) add(costBonusTarget[slot].valueType, step.bonus);
        }
        return total;
      }

      /** 1バージョンぶんの全部入り結果 */
      function evaluate(version) {
        const payload = versionPayloads[version];
        const h = payload.heroes[heroId] ?? null;
        const cost = catCost(payload);
        const spent = cost.WeaponMod + cost.Armor + cost.Tech;
        const level = h ? levelForSouls(h, spent) : 1;
        const missing = picked.filter((id) => !payload.items[id]);

        let dps = null;
        let weaponNote = "";
        let healthTotal = null;
        let healthNote = "";
        let spiritTotal = 0;
        let spiritNote = "";
        const rows = { WeaponMod: [], Armor: [], Tech: [] };

        if (h) {
          const wd = weaponDamageFull(payload, h, cost, level);
          dps = wd && wd.dps !== null ? Math.round(wd.dps) : h.weaponHead ? Number(h.weaponHead.dps) : null;
          if (h.weaponHead) {
            const pctNote = wd && wd.pct ? C.weaponPct.replace("{n}", round1(wd.pct)) : "";
            weaponNote = `${h.weaponName} / ${C.falloff} ${h.weaponHead.falloffStart} → ${h.weaponHead.falloffEnd}${pctNote}`;
          }

          const mh = maxHealthFull(payload, h, cost, level);
          healthTotal = mh.total;
          const parts = [`${C.base} ${Math.round(mh.base)}`];
          if (mh.boon) parts.push(`Boon +${Math.round(mh.boon)}`);
          if (mh.pct) parts.push(`×(1+${round1(mh.pct)}%)`);
          if (mh.flat) parts.push(`${C.flat} +${Math.round(mh.flat)}`);
          healthNote = parts.join(" ");

          spiritTotal = spiritPower(payload, h, cost, level);
          const fromLevel = boonCount(h, level) * h.calc.techPowerPerBoon;
          const fromBonus = costBonusStep(h, "Tech", cost.Tech)?.bonus ?? 0;
          const fromItems = spiritTotal - fromLevel - fromBonus;
          spiritNote = C.spiritBreakdown.replace("{level}", round1(fromLevel)).replace("{bonus}", fromBonus).replace("{items}", round1(fromItems));

          for (const slot of ["WeaponMod", "Armor", "Tech"]) {
            rows[slot] = h.rows[slot].map((r) => {
              let value = r.value;
              if (slot === "Armor" && r.key === "maxHealth") value = String(Math.round(healthTotal));
              if (slot === "WeaponMod" && r.key === "bulletDamage" && wd && wd.perBullet !== null)
                value = String(round1(wd.perBullet));
              return { key: r.key, label: r.label, value };
            });
          }
        }

        return {
          version,
          hero: h,
          level,
          spent,
          missing,
          dps,
          weaponNote,
          healthTotal,
          healthNote,
          spiritTotal,
          spiritNote,
          rows,
          totals: statsTotal(payload, cost),
        };
      }

      // ---- 表示 ----
      /** "6.4m" のような単位付き文字列でも先頭の数値だけ見て向きを判定する */
      function numOf(v) {
        if (v === null || v === undefined) return null;
        const n = typeof v === "number" ? v : Number.parseFloat(String(v));
        return Number.isNaN(n) ? null : n;
      }
      function deltaHtml(key, before, after) {
        const b = numOf(before);
        const a = numOf(after);
        if (b === null || a === null || b === a) return "";
        const lowerBetter = LOWER_IS_BETTER_KEYS.has(key);
        const up = a > b;
        const good = lowerBetter ? !up : up;
        const arrow = up ? "▲" : "▼";
        return `<span class="delta ${good ? "good" : "bad"}">${arrow}</span>`;
      }
      const disp = (v) => (v === null || v === undefined ? "—" : typeof v === "number" ? round1(v) : v);

      function rowLinePlain(label, value) {
        return `<li><span class="l">${esc(label)}</span><span class="v">${esc(disp(value))}</span></li>`;
      }
      /** key は小さいほど良い行の判定に使う(表示名は言語で変わるので使わない) */
      function rowLine(label, before, after, key) {
        return (
          `<li><span class="l">${esc(label)}</span>` +
          `<span class="v">${deltaHtml(key, before, after)}${esc(disp(after))}</span></li>`
        );
      }

      function boxHeadline(slot, r, prev) {
        if (!r.hero) return "";
        if (slot === "WeaponMod") {
          const mark = prev ? deltaHtml("DPS", prev.dps, r.dps) : "";
          return `<b>${mark}${esc(disp(r.dps))}</b> DPS<small>${esc(r.weaponNote)}</small>`;
        }
        if (slot === "Armor") {
          const mark = prev ? deltaHtml("maxHealth", prev.healthTotal, r.healthTotal) : "";
          const val = r.healthTotal !== null ? Math.round(r.healthTotal) : null;
          return `<b>${mark}${esc(disp(val))}</b> ${esc(C.maxHealth)}<small>${esc(r.healthNote)}</small>`;
        }
        if (slot === "Tech") {
          const mark = prev ? deltaHtml("spiritPower", prev.spiritTotal, r.spiritTotal) : "";
          return `<b>${mark}${esc(disp(round1(r.spiritTotal)))}</b> ${esc(C.spiritPower)}<small>${esc(r.spiritNote)}</small>`;
        }
        return "";
      }

      /*
       * カテゴリー1つぶんのボックス。OLDER側は素の値、NEWEST側はOLDERとの差分マーク付き。
       * 見た目は build/index.astro の .box と同じ(:global() は呼び出し元のカードで面倒を見る)。
       */
      function categoryBox(slot, r, prev) {
        const meta = slotMeta[slot];
        const rows = r.rows[slot] ?? [];
        const byKey = prev ? new Map((prev.rows[slot] ?? []).map((x) => [x.key, x.value])) : null;
        const rowsHtml =
          rows
            .map((row) => (prev ? rowLine(row.label, byKey.get(row.key) ?? null, row.value, row.key) : rowLinePlain(row.label, row.value)))
            .join("") || `<li class="empty">${esc(C.heroNotSelected)}</li>`;
        const style = `--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)`;
        return (
          `<div class="box" style="${style}"><div class="bhead"><h2>${esc(C.statsTitle[slot])}</h2></div>` +
          `<div class="bhl">${boxHeadline(slot, r, prev)}</div>` +
          `<ul class="brows">${rowsHtml}</ul></div>`
        );
      }

      function totalsBox(r, prev) {
        const keys = new Set([...r.totals.keys(), ...(prev ? prev.totals.keys() : [])]);
        let lines = "";
        for (const k of keys) {
          const label = labels[k] ?? k.replace("MODIFIER_VALUE_", "");
          const v = r.totals.get(k) ?? 0;
          const pv = prev ? (prev.totals.get(k) ?? 0) : v;
          if (v === 0 && pv === 0) continue;
          lines += prev ? rowLine(label, pv, v, k) : rowLinePlain(label, v);
        }
        return (
          `<div class="box plain"><div class="bhead"><h2>${esc(C.totalStats)}</h2></div>` +
          `<ul class="brows">${lines || '<li class="empty">—</li>'}</ul></div>`
        );
      }

      function renderCard(bodyId, r, prev) {
        $(bodyId).innerHTML =
          categoryBox("WeaponMod", r, prev) + categoryBox("Armor", r, prev) + categoryBox("Tech", r, prev) + totalsBox(r, prev);
      }

      function renderTopBar(missing) {
        const heroSrc = document.querySelector(`.heroicon-src[data-hero="${heroId}"] .portrait`);
        $("herow").innerHTML = "";
        const wrap = document.createElement("div");
        wrap.className = "herowrap";
        if (heroSrc) wrap.append(heroSrc.cloneNode(true));
        const label = document.createElement("b");
        label.className = "heroname";
        label.textContent = heroNames[heroId];
        wrap.append(label);
        $("herow").append(wrap);

        const cellsEl = $("cells");
        cellsEl.innerHTML = "";
        const n = Math.max(12, picked.length);
        for (let i = 0; i < n; i++) {
          const id = picked[i];
          const cell = document.createElement("span");
          cell.className = "cell";
          if (id) {
            cell.classList.add("filled");
            if (missing.has(id)) cell.classList.add("warn");
            cell.title = itemNames[id] ?? id;
            const src = document.querySelector(`.itemicon-src[data-item="${CSS.escape(id)}"] .icon`);
            if (src) cell.append(src.cloneNode(true));
          }
          if (i >= 12) cell.classList.add("over");
          cellsEl.append(cell);
        }
      }

      function renderVerInfo(older, newer) {
        const verInfo = (r) => C.verInfo.replace("{lv}", r.level).replace("{souls}", fmtSouls(r.spent));
        $("olderinfo").textContent = older.hero ? verInfo(older) : "";
        $("newerinfo").textContent = newer.hero ? verInfo(newer) : "";
      }

      function populateSelect(el, selected) {
        el.innerHTML = versions
          .map((v) => `<option value="${v}"${v === selected ? " selected" : ""}>${versionLabels[v] ?? v}</option>`)
          .join("");
      }

      function refresh() {
        const older = evaluate($("older").value);
        const newer = evaluate($("newer").value);
        const missing = new Set([...older.missing, ...newer.missing]);
        $("missingnote").hidden = missing.size === 0;

        renderTopBar(missing);
        renderVerInfo(older, newer);
        renderCard("olderbody", older, null);
        renderCard("newerbody", newer, older);
      }

      populateSelect($("older"), versions[1] ?? versions[0]);
      populateSelect($("newer"), versions[0]);
      $("older").addEventListener("change", refresh);
      $("newer").addEventListener("change", refresh);

      refresh();
      }
    })();
  </script>

  <style>
    .head { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
    .back { font-size: 13px; }
    .lead { max-width: 62ch; color: var(--c-text-muted); }
    /* データの JSON を読み込めなかったときの案内(build/index.astro と同じ見た目) */
    .loaderr {
      display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap;
      margin: var(--sp-3) 0; padding: var(--sp-2) var(--sp-3);
      font-size: 13px; color: var(--c-text-strong);
      background: var(--c-surface); border: 1px solid var(--c-border-strong); border-radius: var(--radius);
    }
    .loaderr[hidden] { display: none; }
    .loaderr button {
      padding: 4px 12px; border-radius: var(--radius); font: inherit; font-size: 12px; cursor: pointer;
      background: var(--c-accent-bg); color: var(--c-accent); border: 1px solid var(--c-accent-dim);
    }

    /* ---- 上部: ビルドのヒーロー・アイテムUI(見た目は /build/ のスロットバーと同じ) ---- */
    .topbar { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; margin: var(--sp-3) 0; }
    .herow :global(.herowrap) { display: flex; align-items: center; gap: var(--sp-2); }
    .herow :global(.heroname) { font-weight: 700; color: var(--c-text-strong); font-size: 14px; }
    .cells {
      display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: repeat(2, auto);
      grid-auto-flow: column; gap: 5px; width: min(100%, 320px);
    }
    .cells :global(.cell) {
      aspect-ratio: 1; border-radius: 5px; border: 1px dashed var(--c-border-strong);
      background: var(--c-bg); display: block; padding: 0; line-height: 0; width: 100%;
    }
    .cells :global(.cell.filled) { border: 1px solid var(--c-border-strong); overflow: hidden; }
    .cells :global(.cell.filled.warn) { outline: 2px solid var(--c-weapon); outline-offset: 1px; }
    .cells :global(.cell.over) { outline: 2px solid #d08a3e; outline-offset: 1px; }
    .cells :global(.cell.filled .icon) { width: 100%; height: 100%; border: none; border-radius: 4px; }

    .missingnote {
      font-size: 12px; color: var(--c-weapon); border-left: 3px solid var(--c-weapon);
      padding-left: var(--sp-2); max-width: 62ch; margin: var(--sp-3) 0;
    }

    /* ---- OLDER/NEWEST を大きなカードで包み、間に⇒を挟む ---- */
    .comparegrid {
      display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--sp-4);
      align-items: start; margin-top: var(--sp-3);
    }
    .vercard {
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-radius: var(--radius-lg); padding: var(--sp-4); min-width: 0;
    }
    .vercard.newer { border-color: var(--c-accent-dim); box-shadow: 0 0 0 1px var(--c-accent-dim) inset; }

    .vercard-head {
      display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-2) var(--sp-3);
      padding-bottom: var(--sp-3); margin-bottom: var(--sp-3); border-bottom: 1px solid var(--c-border);
    }
    .vertag {
      font-size: 19px; font-weight: 700; letter-spacing: .1em; line-height: 1;
      padding: 5px 14px; border-radius: var(--radius);
    }
    .vercard.older .vertag { color: var(--c-text-muted); background: var(--c-surface-2); border: 1px solid var(--c-border-strong); }
    .vercard.newer .vertag { color: var(--c-accent); background: var(--c-accent-bg); border: 1px solid var(--c-accent-dim); }
    .vercard-head select { margin-left: auto; }
    .vernum { font-size: 11px; color: var(--c-text-faint); font-family: var(--font-mono); flex-basis: 100%; }

    /* 中央の⇒。「変更後は右」を示す。スクロールしても見やすいよう軽く追従させる */
    .arrow {
      align-self: center; position: sticky; top: 74px;
      font-size: 30px; line-height: 1; color: var(--c-accent);
    }

    /* ---- カード内の各カテゴリーボックス。中身は動的挿入なので :global() 必須 ---- */
    .vercard-body :global(.box) {
      background: var(--cat-bg, var(--c-surface)); border: 1px solid var(--cat, var(--c-border));
      border-radius: var(--radius-lg); padding: var(--sp-3) var(--sp-4) var(--sp-4); min-width: 0;
      margin-bottom: var(--sp-3);
    }
    .vercard-body :global(.box:last-child) { margin-bottom: 0; }
    .vercard-body :global(.box.plain) { background: var(--c-surface); border-color: var(--c-border); }
    .vercard-body :global(.bhead) { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-2); flex-wrap: wrap; }
    .vercard-body :global(.bhead h2) { font-size: 13px; margin: 0; border: none; padding: 0; color: var(--cat, var(--c-text-strong)); letter-spacing: .04em; }
    .vercard-body :global(.box.plain .bhead h2) { color: var(--c-text-strong); }
    .vercard-body :global(.bhl) { margin: var(--sp-2) 0; font-size: 11px; min-height: 1em; }
    .vercard-body :global(.bhl b) { font-family: var(--font-mono); font-size: 17px; color: var(--c-text-strong); margin-right: 3px; }
    .vercard-body :global(.bhl small) { display: block; color: var(--c-text-faint); margin-top: 1px; }
    .vercard-body :global(.brows) { list-style: none; padding: 0; margin: 0; }
    .vercard-body :global(.brows li) {
      display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3);
      padding: 3px 0; font-size: 12px; border-bottom: 1px solid var(--c-border);
    }
    .vercard-body :global(.brows .l) { color: var(--c-text-muted); }
    .vercard-body :global(.brows .v) {
      font-family: var(--font-mono); color: var(--c-text-strong); white-space: nowrap;
      display: inline-flex; align-items: center; gap: 3px;
    }
    .vercard-body :global(.brows .empty) { color: var(--c-text-faint); border: none; font-size: 12px; display: block; }
    .vercard-body :global(.delta.good) { color: var(--c-vitality); }
    .vercard-body :global(.delta.bad) { color: var(--c-weapon); }

    .caveat { margin-top: var(--sp-4); font-size: 11px; color: var(--c-text-faint); max-width: 62ch; }
    .iconsrc { display: none; }

    @media (max-width: 900px) {
      .comparegrid { grid-template-columns: 1fr; }
      .arrow { position: static; transform: rotate(90deg); justify-self: center; padding: var(--sp-1) 0; }
    }
  </style>
</Base>
