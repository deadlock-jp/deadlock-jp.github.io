---
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import SoulIcon from "../../components/SoulIcon.astro";
import {
  releasedHeroes,
  shopItems,
  t,
  describe,
  formatProperty,
  itemsFile,
  ability,
  usedIn,
  modifierLabel,
  SLOT_META,
  souls,
  itemStats as itemStatsFile,
} from "../../lib/data.ts";
import {
  weaponRows,
  weaponHeadline,
  weaponName,
  vitalityRows,
  spiritRows,
  abilityDamages,
} from "../../lib/gamestats.ts";
import { COST_BONUS_TARGET, type ItemSlotType } from "../../types/hero.ts";

const heroes = releasedHeroes();
const items = shopItems();
const slots = ["WeaponMod", "Armor", "Tech"] as const;
const tiers = [1, 2, 3, 4];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/*
 * ヒーロー×アイテムの人気率・勝率(tools/fetch-item-stats.mjs が deadlock-api.com から取得)。
 * ヒーロー選択はクライアント側なので、全ヒーロー分をビルド時に埋め込む
 * (静的サイトのまま、実行時に追加の通信をしないという既存方針を維持する)。
 */
const itemStats = itemStatsFile;

/** ホバーカードに出す1行。ゲーム側のトークンで整形済み */
function propRows(names: string[], item: (typeof items)[number]) {
  return names
    .filter((n) => item.properties[n])
    .map((n) => formatProperty(n, item.properties[n]!));
}

/** クライアントに渡すデータ。ページ内で完結させ、追加の通信はしない */
const payload = {
  heroes: heroes.map((h) => {
    const weaponSlot = h.abilities.find((a) => a.slot === "Weapon_Primary");
    const weapon = weaponSlot ? (ability(weaponSlot.abilityKey)?.weapon ?? null) : null;
    return {
      id: h.id,
      name: t(h.nameToken, h.key),
      /* ビルドカードの背景 public/images/heroes/card16x9/<key>.webp を引くのに使う */
      key: h.key.replace(/^hero_/, ""),
      levels: h.levels.map((l) => ({
        level: l.level,
        requiredGold: l.requiredGold,
        // 標準レベルアップ = Boon 1。Boon 数を数えるのに使う
        up: l.useStandardUpgrade,
      })),
      // 購入ボーナスはカテゴリへの累計投資額で決まる階段関数
      costBonuses: h.costBonuses,
      weaponHead: weaponHeadline(weapon),
      weaponName: weaponName(h),
      rows: {
        WeaponMod: weaponRows(h, weapon),
        Armor: vitalityRows(h),
        Tech: spiritRows(h),
      },
      /*
       * 実測(実測チェックリストv2, 2026-09-07)で確定した式で最大HP・武器ダメージ・
       * スピリットパワーの実数値をクライアント側で組み立てるための、素の数値。
       */
      calc: {
        baseHealth: h.startingStats.EMaxHealth ?? 0,
        healthPerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_HEALTH_FROM_LEVEL ?? 0,
        techPowerPerBoon: h.levelUpBonuses.MODIFIER_VALUE_TECH_POWER ?? 0,
        bulletDamage: weapon?.bulletDamage ?? null,
        bulletDamagePerBoon: h.levelUpBonuses.MODIFIER_VALUE_BASE_BULLET_DAMAGE_FROM_LEVEL ?? 0,
        cycleTime: weapon?.cycleTime ?? null,
        bulletsPerShot: weapon?.bulletsPerShot ?? 1,
      },
      // ゲーム内の「スピリットパワーの影響値」と同じ並び
      abilities: abilityDamages(h),
    };
  }),
  items: Object.fromEntries(
    items.map((i) => [
      i.id,
      {
        name: t(i.nameToken, i.id),
        tier: i.tier,
        slot: i.slotType,
        cost: i.cost,
        slotCost: i.slotCost,
        activation: i.activation,
        isImbue: i.isImbue,
        desc: describe(i.descToken, i.properties),
        // 常時パッシブだけを合計ステータスに足す
        mods: i.passiveProperties
          .map((n) => i.properties[n])
          .filter((p) => p?.providedType && p.value !== null)
          .map((p) => ({ type: p!.providedType!, value: p!.value! })),
        passives: propRows(i.passiveProperties, i),
        conditional: i.tooltip
          .flatMap((s) => [...s.elevatedProperties, ...s.properties])
          .filter((n, idx, a) => a.indexOf(n) === idx && !i.passiveProperties.includes(n))
          .filter((n) => i.properties[n])
          .map((n) => formatProperty(n, i.properties[n]!)),
        components: i.componentItems
          .map((c) => itemsFile.items[c])
          .filter((c) => c !== undefined)
          .map((c) => t(c.nameToken, c.id)),
        // 上位アイテムを買ったときに下位を外すための参照。名前ではなくIDで持つ
        componentIds: i.componentItems.filter((c) => itemsFile.items[c] !== undefined),
        usedIn: usedIn(i.id).map((c) => t(c.nameToken, c.id)),
      },
    ]),
  ),
  labels: Object.fromEntries(
    [
      ...new Set([
        ...items.flatMap((i) =>
          i.passiveProperties.map((n) => i.properties[n]?.providedType).filter(Boolean),
        ),
        ...Object.values(COST_BONUS_TARGET).map((c) => c.valueType),
      ]),
    ].map((type) => [type, modifierLabel(type as string)]),
  ),
  costBonusTarget: COST_BONUS_TARGET,
  slotMeta: SLOT_META,
  /** ヒーロー×アイテムの人気率・勝率。ショップの並び替えと数値表示に使う */
  stats: {
    fetchedAt: itemStats.fetchedAt,
    window: itemStats.window,
    lowSampleMatches: itemStats.lowSampleMatches,
    heroes: itemStats.heroes,
  },
};
---

<Base title="ビルドシミュレーター" description="アイテムを選んでビルドを組み、URLで共有する">
  <h1>ビルドシミュレーター</h1>
  {/* ヒーロー選択と操作ボタンは見出しの下に一列で置く */}
  <div class="head">
    <label class="heropick">
      ヒーロー
      <select id="hero">
        <option value="">選択してください</option>
        {heroes.map((h) => <option value={h.id}>{t(h.nameToken, h.key)}</option>)}
      </select>
    </label>
    <span class="acts">
      <button class="share" id="share">共有URLをコピー</button>
      {/* localStorage が使えない環境では JS 側で丸ごと隠す */}
      <button class="savetoggle" id="savetoggle" aria-expanded="false" hidden>
        保存 / 呼び出し<span class="savecount" id="savecount"></span>
      </button>
      <button class="cardbtn" id="cardbtn">画像を保存</button>
      <a class="compare" id="compare" href={`${base}/build/compare/`}>バージョン比較</a>
      <button class="clear" id="clear">クリア</button>
    </span>
  </div>

  {/* 保存パネル。既定は閉じていて、保存済みがあれば開いた状態で始める */}
  <div class="savepanel" id="savepanel" hidden>
    <div class="savebar">
      <label class="savelabel" for="savename">ビルド名</label>
      <input
        id="savename"
        type="text"
        maxlength="40"
        placeholder="例: 序盤スピリット型（画像にも載ります）"
        autocomplete="off"
      />
      <button class="savebtn" id="savebtn">＋ 保存</button>
      <span class="savenote" id="savenote"></span>
    </div>
    <ul class="savedlist" id="savedlist"></ul>
  </div>

  <div class="layout">
    {/* ---------------- 左: ビルドの中身とステータス ---------------- */}
    <section class="side">
      <div class="heroline" id="heroline">
        {
          heroes.map((h) => (
            <span class="hp" data-hero={h.id} hidden>
              <HeroPortrait name={t(h.nameToken, h.key)} image={h.images.iconSmall} size={40} />
            </span>
          ))
        }
        <span class="hname" id="hname">ヒーロー未選択</span>
      </div>

      {/*
        アイテムスロット。ゲームでは12枠すべてがフレックス(TYPE固定ではない)なので、
        カテゴリごとに割らず、購入順に2段×6で埋める。枠の色でTYPEが分かるようにする。
        buildbar はスマホで画面上部に追従させる(sticky)。
      */}
      <div class="buildbar">
        <div class="slotbar">
          <span class="slotcount"><b id="t-count">0</b> / 12</span>
          <span class="lvl"><b id="t-level">Lv—</b></span>
          <span class="soulcost">
            <SoulIcon size={15} />
            <b id="t-souls">0</b>
            <small>ソウル</small>
          </span>
        </div>
        <div class="cells" data-cells>
          {Array.from({ length: 12 }, () => <span class="cell" />)}
        </div>
      </div>
      <p class="slotnote">
        枠のアイコンをタップすると外れます。ショップはタップで詳細、もう一度タップで追加します。
        枠はゲームと同じく12個です。
      </p>

      {/* TYPE別ステータス */}
      {
        slots.map((s) => (
          <section
            class="box"
            data-box={s}
            style={`--cat: var(--c-${SLOT_META[s].cssVar}); --cat-bg: var(--c-${SLOT_META[s].cssVar}-bg)`}
          >
            <header class="bhead">
              <h2>{SLOT_META[s].label}ステータス</h2>
              <span class="bhl" data-headline={s} />
            </header>
            <div class="bbody">
              <div class="bcol">
              <ul class="brows" data-rows={s} />
              {s === "Tech" && (
                <div class="spirit" data-spirit>
                  <h3>スピリットパワーの影響値</h3>
                  <ul class="alist" data-abilities />
                </div>
              )}
              </div>
              <div class="invest">
                <h3>投資額</h3>
                <ol class="ladder" data-ladder={s} />
              </div>
            </div>
          </section>
        ))
      }

      <section class="box plain">
        <header class="bhead"><h2>合計ステータス</h2></header>
        <ul class="stats" id="stats"><li class="empty">—</li></ul>
      </section>
    </section>

    {/* ---------------- 右: ショップ ---------------- */}
    <section class="shop">
      {/* アイテムTYPE選択を先頭に。並び替えは同じ行の右端に置く */}
      <div class="shophead">
        <div class="tabs" role="tablist">
          {
            slots.map((s, idx) => (
              <button
                class:list={["tab", { current: idx === 0 }]}
                data-slot={s}
                style={`--cat: var(--c-${SLOT_META[s].cssVar}); --cat-bg: var(--c-${SLOT_META[s].cssVar}-bg)`}
              >
                {SLOT_META[s].label}
                <small>{items.filter((i) => i.slotType === s).length}</small>
              </button>
            ))
          }
        </div>

        {/* ヒーローを選ぶまでは出す統計が無いので隠しておく */}
        <div class="sortbar" id="sortbar" hidden>
          <span class="sortlabel">並び替え</span>
          <div class="sortbtns" role="group">
            <button class="sortbtn current" data-sort="pick">人気率</button>
            <button class="sortbtn" data-sort="win">勝率</button>
          </div>
        </div>
      </div>

      {
        slots.map((slot, idx) => {
          const meta = SLOT_META[slot];
          return (
            <div
              class="cat"
              data-slot={slot}
              hidden={idx !== 0}
              style={`--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)`}
            >
              {tiers.map((tier) => {
                const rows = items.filter((i) => i.slotType === slot && i.tier === tier);
                if (rows.length === 0) return null;
                return (
                  <div class="tier">
                    <h3>
                      ティア{tier}
                      <span class="price">{souls(itemsFile.itemPricePerTier[tier] ?? 0)}</span>
                    </h3>
                    <div class="grid">
                      {rows.map((i, order) => (
                        <button
                          class="card"
                          data-id={i.id}
                          data-order={order}
                          aria-label={t(i.nameToken, i.id)}
                        >
                          <ItemIcon
                            name={t(i.nameToken, i.id)}
                            slotType={i.slotType}
                            tier={i.tier}
                            shopIcon={i.shopIcon}
                            activation={i.activation}
                            isImbue={i.isImbue}
                            size={48}
                          />
                          <span class="cname">{t(i.nameToken, i.id)}</span>
                          {/* 人気率・勝率。中身はヒーロー選択時にJSが入れる */}
                          <span class="cstat" hidden>
                            <span class="crow"><i>人気</i><b class="cpick">—</b></span>
                            <span class="crow"><i>勝率</i><b class="cwin">—</b></span>
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          );
        })
      }
    </section>
  </div>

  {/* ホバー時の詳細カード。中身はクライアントで組み立てる */}
  <div class="hovercard" id="hovercard" role="tooltip" hidden></div>

  <script is:inline define:vars={{ payload, base }}>
    /** 購入順を保持する。同じアイテムは1つまで */
    let picked = [];
    let heroId = null;
    /** ショップの並び替え基準。"pick" = 人気率 / "win" = 勝率 */
    let sortKey = "pick";
    /** 直近に並べ替えた (ヒーロー, 基準)。同じなら組み直さない */
    let statsApplied = "";
    /** スキルごとの AP 段(0〜3)。スキルダメージ表示に反映する */
    const apLevel = {};
    const SLOTS = ["WeaponMod", "Armor", "Tech"];
    const SLOT_TOTAL = 12; // ゲーム内のアイテム枠数。TYPE固定ではなく全部フレックス

    const ID_PREFIX = "upgrade_";
    const shorten = (id) => (id.startsWith(ID_PREFIX) ? id.slice(ID_PREFIX.length) : "!" + id);
    const expand = (s) => (s.startsWith("!") ? s.slice(1) : ID_PREFIX + s);
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => n.toLocaleString("en-US");
    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

    function hero() {
      return payload.heroes.find((h) => h.id === heroId) ?? null;
    }

    /**
     * そのアイテムが内包している素材アイテムを、入れ子も含めて全部返す。
     * 素材の素材まであるもの(トランセンデント ← クールダウンブースト ← コンプレッサー)が
     * 実在するため再帰で辿る。
     */
    function allComponents(id, seen = new Set()) {
      for (const c of payload.items[id]?.componentIds ?? []) {
        if (seen.has(c)) continue;
        seen.add(c);
        allComponents(c, seen);
      }
      return seen;
    }

    /** いま持っているアイテムに内包されている(=個別に持つ意味がない)IDの集合 */
    function coveredIds() {
      const out = new Set();
      for (const id of picked) for (const c of allComponents(id)) out.add(c);
      return out;
    }

    function levelForSouls(levels, spent) {
      let current = levels.length ? levels[0].level : 1;
      for (const l of levels) {
        if (spent >= l.requiredGold) current = l.level;
        else break;
      }
      return current;
    }

    /** 累計投資額に対応する段。投資額以下で最大の goldThreshold を引く（補間しない） */
    function costBonusStep(slot, invested) {
      const table = hero()?.costBonuses?.[slot];
      if (!table?.length) return null;
      let step = null;
      for (const row of table) if (invested >= row.goldThreshold) step = row;
      return step;
    }

    // ---- URL ---------------------------------------------------------
    function readUrl() {
      const p = new URLSearchParams(location.hash.replace(/^#/, ""));
      const h = p.get("h");
      heroId = h && /^\d+$/.test(h) ? Number(h) : null;
      const i = p.get("i");
      picked = i
        ? i.split(",").filter(Boolean).map(expand).filter((id) => payload.items[id])
        : [];
    }
    function writeUrl(replace) {
      const parts = [];
      if (heroId !== null) parts.push("h=" + heroId);
      if (picked.length) parts.push("i=" + picked.map(shorten).join(","));
      const hash = parts.length ? "#" + parts.join("&") : "";
      const url = location.pathname + location.search + hash;
      if (replace) history.replaceState(null, "", url);
      else history.pushState(null, "", url);
      $("compare").href = base + "/build/compare/" + hash;
    }

    // ---- 保存(localStorage) -------------------------------------------
    /*
     * 保存するのは URL のハッシュ(h=<heroId>&i=<短縮ID>)そのもの。
     * 呼び出しは readUrl() と同じ経路を通るので、共有URLと保存の仕様が自動で揃う。
     * count / souls / heroId は一覧表示用の控えで、hash から再計算できる。
     *
     * private ウィンドウなどで localStorage が使えないことがある。
     * その場合は保存機能ごと黙って無効化し、ページの他の部分は動かす。
     */
    const STORE_KEY = "dljp:builds";
    const SAVE_MAX = 20;
    let storeOk = false;
    try {
      const probe = "dljp:probe";
      localStorage.setItem(probe, "1");
      localStorage.removeItem(probe);
      storeOk = true;
    } catch {
      storeOk = false;
    }

    function loadSaved() {
      if (!storeOk) return [];
      try {
        const raw = JSON.parse(localStorage.getItem(STORE_KEY) ?? "[]");
        return Array.isArray(raw) ? raw.filter((b) => b && typeof b.hash === "string") : [];
      } catch {
        // 壊れた値が入っていても落とさない
        return [];
      }
    }
    function storeSaved(list) {
      if (!storeOk) return false;
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify(list));
        return true;
      } catch {
        // 容量超過など
        return false;
      }
    }

    /** いまのビルドの状態を保存用の形にする */
    function currentBuild(label) {
      const cost = catCost();
      return {
        id: String(Date.now()) + Math.random().toString(36).slice(2, 6),
        label,
        hash: (heroId !== null ? "h=" + heroId : "") +
          (picked.length ? (heroId !== null ? "&" : "") + "i=" + picked.map(shorten).join(",") : ""),
        heroId,
        count: picked.length,
        souls: cost.WeaponMod + cost.Armor + cost.Tech,
        savedAt: new Date().toISOString().slice(0, 10),
      };
    }

    function renderSaved() {
      const list = loadSaved();
      $("savecount").textContent = list.length ? ` ${list.length}` : "";
      const box = $("savedlist");
      if (!list.length) {
        box.innerHTML = `<li class="savedempty">まだ保存がありません。ビルドを組んで「＋ 保存」を押すと、この端末にだけ残ります。</li>`;
        return;
      }
      box.innerHTML = list
        .map((b) => {
          const h = payload.heroes.find((x) => x.id === b.heroId);
          const bars = (b.types ?? [])
            .map((t) => `<i class="${t}"></i>`)
            .join("");
          return (
            `<li data-id="${esc(b.id)}">` +
            `<span class="sv-mini">${bars}</span>` +
            `<span class="sv-name">${esc(b.label || "（無題）")}</span>` +
            `<span class="sv-meta">${h ? esc(h.name) + " / " : ""}${b.count}個 / ${fmt(b.souls ?? 0)}</span>` +
            `<button class="sv-load" data-act="load">呼び出し</button>` +
            `<button class="sv-del" data-act="del">削除</button>` +
            `</li>`
          );
        })
        .join("");
    }

    /** TYPE構成のミニバー用。購入順に最大8個ぶん色を並べる */
    function typeMarks() {
      const map = { WeaponMod: "w", Armor: "v", Tech: "s" };
      return picked.slice(0, 8).map((id) => map[payload.items[id]?.slot] ?? "w");
    }

    function saveCurrent() {
      if (heroId === null && !picked.length) {
        flashNote("保存するものがありません");
        return;
      }
      const list = loadSaved();
      if (list.length >= SAVE_MAX) {
        flashNote(`保存は${SAVE_MAX}件までです。古いものを削除してください`);
        return;
      }
      const typed = $("savename").value.trim();
      const h = payload.heroes.find((x) => x.id === heroId);
      const label = typed || `${h ? h.name : "ビルド"} ${picked.length}個`;
      const b = currentBuild(label);
      b.types = typeMarks();
      list.unshift(b);
      if (!storeSaved(list)) {
        flashNote("保存できませんでした（保存領域がいっぱいの可能性）");
        return;
      }
      $("savename").value = label;
      renderSaved();
      flashNote("保存しました");
    }

    let noteTimer = 0;
    function flashNote(msg) {
      const el = $("savenote");
      el.textContent = msg;
      clearTimeout(noteTimer);
      noteTimer = setTimeout(() => (el.textContent = ""), 2600);
    }

    // ---- 描画 --------------------------------------------------------
    function catCost() {
      const c = { WeaponMod: 0, Armor: 0, Tech: 0 };
      for (const id of picked) {
        const it = payload.items[id];
        if (it && it.slot in c) c[it.slot] += it.cost;
      }
      return c;
    }

    /**
     * アイテムスロット。ゲームでは12枠すべてがフレックスなので、
     * TYPEで分けずに購入順で埋める。ショップ側のアイコンを複製して入れる。
     */
    function renderSlots() {
      const cells = document.querySelector("[data-cells]");
      cells.innerHTML = "";
      const n = Math.max(SLOT_TOTAL, picked.length);
      for (let i = 0; i < n; i++) {
        const id = picked[i];
        if (!id) {
          const empty = document.createElement("span");
          empty.className = "cell";
          cells.append(empty);
          continue;
        }
        const item = payload.items[id];
        const meta = payload.slotMeta[item.slot];
        const cell = document.createElement("button");
        cell.className = "cell filled";
        cell.dataset.id = id;
        cell.title = `${item.name}（${fmt(item.cost)}ソウル） — クリックで外す`;
        if (meta) cell.style.setProperty("--cat", `var(--c-${meta.cssVar})`);
        const src = document.querySelector(`.card[data-id="${CSS.escape(id)}"] .icon`);
        if (src) cell.append(src.cloneNode(true));
        // 12枠を超えた分。ゲームでは持てない数であることを示す
        if (i >= SLOT_TOTAL) cell.classList.add("over");
        cells.append(cell);
      }
    }

    function renderHero() {
      const h = hero();
      $("hname").textContent = h ? h.name : "ヒーロー未選択";
      for (const el of document.querySelectorAll(".hp")) {
        el.hidden = !h || Number(el.dataset.hero) !== h.id;
      }
      $("hero").value = heroId === null ? "" : String(heroId);
    }

    /**
     * 標準レベルアップの回数 = Boon 数。
     * 実測(実測チェックリストv2 測定A, 2026-09-07)で、レベルアップによる基礎値の
     * 増加分にも購入ボーナス%が掛かる(=%の内側)ことを確認済み。
     */
    function boonCount(level) {
      const levels = hero()?.levels ?? [];
      let n = 0;
      for (const l of levels) if (l.level > 1 && l.level <= level && l.up !== false) n++;
      return n;
    }

    /** picked のアイテムが常時パッシブで供給する、指定タイプ(複数可)の合計 */
    function sumMods(types) {
      const want = Array.isArray(types) ? types : [types];
      let v = 0;
      for (const id of picked) {
        for (const m of payload.items[id]?.mods ?? []) if (want.includes(m.type)) v += m.value;
      }
      return v;
    }

    /**
     * 現在のスピリットパワー。すべて平坦加算なので%の合成規則に依らず確定できる。
     *   レベルアップぶん(Boon あたり TECH_POWER。v1測定1で 1レベル +1.1 を実測確認)
     * + 購入ボーナス(累計投資額の階段)
     * + アイテムの常時パッシブぶん
     */
    function spiritPower(cost, level) {
      const h = hero();
      if (!h) return 0;
      const type = payload.costBonusTarget.Tech.valueType;
      let v = boonCount(level) * h.calc.techPowerPerBoon;
      v += costBonusStep("Tech", cost.Tech)?.bonus ?? 0;
      for (const id of picked) {
        for (const m of payload.items[id]?.mods ?? []) if (m.type === type) v += m.value;
      }
      return v;
    }

    /**
     * 最大HP。実測(実測チェックリストv2, 2026-09-07)で確定した式:
     *   (基礎HP + Boon数 × レベルあたりHP) × (1 + Vitality%の合計/100) + 平坦HP
     * ・Vitality% は購入ボーナスの段とアイテムの%を「加算」してから1回だけ掛ける(測定B)
     * ・平坦HP(HEALTH_MAX) は%適用後に足す(v1測定3)
     * ・購入ボーナスの段は「投資額以下で最大の段」= 切り下げ(測定C)
     */
    function maxHealth(cost, level) {
      const h = hero();
      if (!h) return null;
      const boon = boonCount(level) * h.calc.healthPerBoon;
      const pct =
        (costBonusStep("Armor", cost.Armor)?.bonus ?? 0) +
        sumMods(["MODIFIER_VALUE_BASE_HEALTH_PERCENT", "MODIFIER_VALUE_HEALTH_MAX_PERCENT"]);
      const flat = sumMods("MODIFIER_VALUE_HEALTH_MAX");
      const total = (h.calc.baseHealth + boon) * (1 + pct / 100) + flat;
      return { total, base: h.calc.baseHealth, boon, pct, flat };
    }

    /**
     * 武器の1発ダメージと DPS。base に購入ボーナス%とアイテムの武器ダメージ%を掛ける。
     * 単一%の適用は実測(v1測定4: Rapid Rounds で 5.5 → 6)で確認済み。
     * 複数%の合成は直接測っていないが、HP(測定B)が加算合成だったのに揃えて「加算」で扱う。
     */
    function weaponDamage(cost, level) {
      const h = hero();
      if (!h || h.calc.bulletDamage === null) return null;
      const boon = boonCount(level) * h.calc.bulletDamagePerBoon;
      const pct =
        (costBonusStep("WeaponMod", cost.WeaponMod)?.bonus ?? 0) +
        sumMods("MODIFIER_VALUE_WEAPON_DAMAGE_INCREASE");
      const perBullet = (h.calc.bulletDamage + boon) * (1 + pct / 100);
      const dps = h.calc.cycleTime
        ? (perBullet / h.calc.cycleTime) * (h.calc.bulletsPerShot || 1)
        : null;
      return { perBullet, dps, pct, base: h.calc.bulletDamage, boon };
    }

    const round1 = (n) => Math.round(n * 10) / 10;

    /** TYPE別ボックス。ヒーロー未選択のときは案内だけ出す */
    function renderBoxes(cost, level) {
      const h = hero();
      for (const slot of SLOTS) {
        const rows = document.querySelector(`[data-rows="${slot}"]`);
        const head = document.querySelector(`[data-headline="${slot}"]`);
        const ladder = document.querySelector(`[data-ladder="${slot}"]`);

        if (!h) {
          rows.innerHTML = '<li class="empty">ヒーローを選ぶと表示されます</li>';
          head.textContent = "";
          ladder.innerHTML = "";
          continue;
        }

        // 「最大HP」「弾薬ダメージ」の行は、実測式で出した実数値に差し替える。
        // 他の行(移動速度・弾速など)は反映規則が未確定なので基礎値のまま。
        const mh = slot === "Armor" ? maxHealth(cost, level) : null;
        const wd = slot === "WeaponMod" ? weaponDamage(cost, level) : null;
        rows.innerHTML = h.rows[slot]
          .map((r) => {
            let value = r.value;
            if (mh && r.label === "最大HP") value = String(Math.round(mh.total));
            if (wd && r.label === "弾薬ダメージ") value = String(round1(wd.perBullet));
            return `<li><span class="l">${esc(r.label)}</span><span class="v">${esc(value)}</span></li>`;
          })
          .join("");

        if (slot === "WeaponMod" && h.weaponHead) {
          const dps = wd && wd.dps !== null ? Math.round(wd.dps) : h.weaponHead.dps;
          const pctNote = wd && wd.pct ? ` / 武器 +${round1(wd.pct)}%` : "";
          head.innerHTML =
            `<b>${esc(dps)}</b> DPS` +
            `<small>${esc(h.weaponName)} / 減衰 ${esc(h.weaponHead.falloffStart)} → ${esc(h.weaponHead.falloffEnd)}${esc(pctNote)}</small>`;
        } else if (slot === "Tech") {
          const sp = spiritPower(cost, level);
          const fromLevel = boonCount(level) * h.calc.techPowerPerBoon;
          const fromBonus = costBonusStep("Tech", cost.Tech)?.bonus ?? 0;
          const fromItems = sp - fromLevel - fromBonus;
          head.innerHTML =
            `<b>${round1(sp)}</b> スピリットパワー` +
            `<small>レベル ${round1(fromLevel)} + 購入ボーナス ${fromBonus} + アイテム ${round1(fromItems)}</small>`;
        } else if (slot === "Armor" && mh) {
          const parts = [`基礎 ${Math.round(mh.base)}`];
          if (mh.boon) parts.push(`Boon +${Math.round(mh.boon)}`);
          if (mh.pct) parts.push(`×(1+${round1(mh.pct)}%)`);
          if (mh.flat) parts.push(`平坦 +${Math.round(mh.flat)}`);
          head.innerHTML = `<b>${Math.round(mh.total)}</b> 最大HP<small>${esc(parts.join(" "))}</small>`;
        } else {
          head.textContent = "";
        }

        // 投資額の階段。現在の段に印を付け、まだ届いていない段は淡く出す
        const table = h.costBonuses[slot] ?? [];
        const step = costBonusStep(slot, cost[slot]);
        const kind = payload.costBonusTarget[slot].kind;
        ladder.innerHTML = [...table]
          .reverse()
          .map((r) => {
            const reached = cost[slot] >= r.goldThreshold;
            const current = step && step.goldThreshold === r.goldThreshold;
            const cls = current ? "now" : reached ? "done" : "todo";
            const val = kind === "percent" ? `+${r.bonus}%` : `+${r.bonus}`;
            return `<li class="${cls}"><span class="b">${val}</span><span class="g">${fmt(r.goldThreshold)}</span></li>`;
          })
          .join("");
      }

      // スピリット: ヒーローのスキルと、現在のスピリットパワー + AP段でのダメージ
      const box = document.querySelector("[data-abilities]");
      if (!h) {
        box.innerHTML = '<li class="empty">—</li>';
      } else {
        const sp = spiritPower(cost, level);
        box.innerHTML = h.abilities
          .map((a) => {
            const icon = document.querySelector(`.aicon-src[data-ab="${CSS.escape(a.key)}"]`);
            const img = icon ? icon.innerHTML : "";
            const lvl = apLevel[a.key] ?? 0;
            // AP でダメージが変わるスキルだけトグルを出す
            const hasAp = a.damage && a.damage.apBonus.some((x) => x !== 0);
            const apToggle = hasAp
              ? `<span class="aptop">${[1, 2, 3]
                  .map(
                    (n) =>
                      `<button type="button" class="apd${n <= lvl ? " on" : ""}" data-ab="${esc(
                        a.key,
                      )}" data-lvl="${n}" aria-label="AP${n}">${n}</button>`,
                  )
                  .join("")}</span>`
              : "";
            let v = '<span class="l">ダメージなし</span><span class="v">—</span>';
            if (a.damage) {
              const apAdd = lvl > 0 ? a.damage.apBonus[lvl - 1] : 0;
              const dmg = Math.round((a.damage.base + apAdd + sp * a.damage.scale) * 10) / 10;
              v = `<span class="l">${esc(a.damage.label)}</span><span class="v">${dmg}</span>`;
            }
            return (
              `<li class="${a.isUltimate ? "ult" : ""}"><span class="ai">${img}</span>` +
              `<span class="abody">${apToggle}` +
              `<span class="aline"><span class="an">${esc(a.name)}</span>${v}</span></span></li>`
            );
          })
          .join("");
      }
    }

    /** 常時パッシブと購入ボーナスの合算 */
    function renderStats(cost) {
      const total = new Map();
      const add = (type, value) => total.set(type, (total.get(type) ?? 0) + value);
      for (const id of picked) for (const m of payload.items[id]?.mods ?? []) add(m.type, m.value);
      for (const slot of SLOTS) {
        const step = costBonusStep(slot, cost[slot]);
        if (step) add(payload.costBonusTarget[slot].valueType, step.bonus);
      }
      const rows = [...total.entries()]
        .filter(([, v]) => v !== 0)
        .sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]));
      const el = $("stats");
      el.innerHTML = rows.length
        ? rows
            .map(([type, value]) => {
              const label = payload.labels[type] ?? type.replace("MODIFIER_VALUE_", "");
              const sign = value > 0 ? "+" : "";
              return `<li><span class="l">${esc(label)}</span><span class="v">${sign}${
                Math.round(value * 100) / 100
              }</span></li>`;
            })
            .join("")
        : '<li class="empty">—</li>';
    }

    /**
     * ショップのカードに人気率・勝率を入れ、グループ(カテゴリ×ティア)の中を
     * 選んだ基準で並べ替える。
     *
     * カードはサーバー側で出した実DOMで、クリック・ホバーのハンドラが要素に
     * 直接張ってある。innerHTML で組み直すとそれが外れるので、appendChild で
     * ノードを移動するだけにする(移動ならハンドラは保たれる)。
     */
    function renderShopStats() {
      const key = `${heroId ?? ""}:${sortKey}`;
      if (key === statsApplied) return;
      statsApplied = key;

      const hs = heroId === null ? null : payload.stats.heroes[String(heroId)];
      $("sortbar").hidden = !hs;

      for (const grid of document.querySelectorAll(".cat .grid")) {
        const cards = [...grid.children];
        for (const c of cards) {
          const st = hs ? hs.items[c.dataset.id] : null;
          const box = c.querySelector(".cstat");
          if (!st) {
            box.hidden = true;
            continue;
          }
          const [pick, win, n] = st;
          const low = n < payload.stats.lowSampleMatches;
          box.hidden = false;
          box.classList.toggle("low", low);
          box.title = low ? `サンプル ${n}試合(少ないため参考値)` : `サンプル ${fmt(n)}試合`;
          c.querySelector(".cpick").textContent = (pick / 10).toFixed(1) + "%";
          const winEl = c.querySelector(".cwin");
          winEl.textContent = (win / 10).toFixed(1) + "%";
          // 50%を境に色を変える。数値そのものは加工しない
          winEl.classList.toggle("good", win >= 500);
          winEl.classList.toggle("bad", win < 500);
        }

        cards.sort((a, b) => {
          if (!hs) return Number(a.dataset.order) - Number(b.dataset.order);
          const sa = hs.items[a.dataset.id];
          const sb = hs.items[b.dataset.id];
          if (!sa || !sb) return (sb ? 1 : 0) - (sa ? 1 : 0);
          // 勝率順のときだけ、サンプルが少ないものを後ろに送る。
          // 数試合しかないアイテムが勝率で上位に来ると誤読のもとになるため
          if (sortKey === "win") {
            const la = sa[2] < payload.stats.lowSampleMatches;
            const lb = sb[2] < payload.stats.lowSampleMatches;
            if (la !== lb) return la ? 1 : -1;
          }
          const idx = sortKey === "win" ? 1 : 0;
          return sb[idx] - sa[idx] || Number(a.dataset.order) - Number(b.dataset.order);
        });
        for (const c of cards) grid.appendChild(c);
      }
    }

    function render() {
      const cost = catCost();
      const spent = cost.WeaponMod + cost.Armor + cost.Tech;
      $("t-souls").textContent = fmt(spent);
      $("t-count").textContent = String(picked.length);
      document.querySelector(".slotcount").classList.toggle("over", picked.length > SLOT_TOTAL);
      const h = hero();
      const level = h ? levelForSouls(h.levels, spent) : 1;
      $("t-level").textContent = h ? "Lv" + level : "Lv—";
      renderHero();
      renderSlots();
      renderBoxes(cost, level);
      renderStats(cost);
      renderShopStats();
      const covered = coveredIds();
      for (const c of document.querySelectorAll(".card")) {
        const id = c.dataset.id;
        c.classList.toggle("on", picked.includes(id));
        c.classList.toggle("covered", covered.has(id));
      }
    }

    function refresh(replaceUrl) {
      writeUrl(replaceUrl);
      render();
    }

    // ---- ビルドカード画像 ---------------------------------------------
    /*
     * ゲーム本編のビルド画面に寄せた 1200x675 を Canvas 2D で描いて PNG で落とす。
     * 画像はすべて同一オリジン(public/ 配下)なので canvas は汚染されず toBlob できる。
     * アイテムのアイコンはショップの DOM にあるものをそのまま使う(追加の読み込みをしない)。
     */
    const CARD_W = 1200;
    const CARD_H = 675;
    const CAT_COLOR = { WeaponMod: "#e0a458", Armor: "#8cc96e", Tech: "#b58be6" };
    const CAT_TILE = {
      WeaponMod: ["#6b4c22", "#2a1f12"],
      Armor: ["#3f6b2f", "#17240f"],
      Tech: ["#5a3f80", "#241833"],
    };
    const ROMAN = ["", "I", "II", "III", "IV", "V"];

    /** 角丸の矩形パス */
    function roundRect(c, x, y, w, h, r) {
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function loadImage(src) {
      return new Promise((resolve) => {
        const im = new Image();
        im.onload = () => resolve(im);
        im.onerror = () => resolve(null);
        im.src = src;
      });
    }

    async function drawCard() {
      const h = hero();
      const cv = document.createElement("canvas");
      cv.width = CARD_W;
      cv.height = CARD_H;
      const c = cv.getContext("2d");

      // 下地。背景画像が透過を含むので必ず塗っておく
      c.fillStyle = "#0c1116";
      c.fillRect(0, 0, CARD_W, CARD_H);

      // 背景: ヒーローの16:9レンダー
      if (h) {
        const bg = await loadImage(`${base}/images/heroes/card16x9/${h.key}.webp`);
        if (bg) c.drawImage(bg, 0, 0, CARD_W, CARD_H);
      }

      // 下半分を落として UI を載せる
      const scrim = c.createLinearGradient(0, 0, 0, CARD_H);
      scrim.addColorStop(0, "rgba(8,12,16,.15)");
      scrim.addColorStop(0.26, "rgba(8,12,16,0)");
      scrim.addColorStop(0.55, "rgba(8,12,16,.72)");
      scrim.addColorStop(0.74, "rgba(6,9,12,.95)");
      scrim.addColorStop(1, "#05080a");
      c.fillStyle = scrim;
      c.fillRect(0, 0, CARD_W, CARD_H);

      const cost = catCost();
      const spent = cost.WeaponMod + cost.Armor + cost.Tech;
      const level = h ? levelForSouls(h.levels, spent) : 1;

      // 左上: ヒーロー名 + ビルド名
      c.textBaseline = "alphabetic";
      c.shadowColor = "rgba(0,0,0,.9)";
      c.shadowBlur = 18;
      c.fillStyle = "#fcf0d8";
      c.font = '900 40px "Noto Sans JP", sans-serif';
      c.fillText(h ? h.name : "ヒーロー未選択", 34, 62);
      const label = $("savename") ? $("savename").value.trim() : "";
      if (label) {
        c.fillStyle = "#cfe3dc";
        c.font = '500 19px "Noto Sans JP", sans-serif';
        c.fillText(label, 34, 90);
      }

      // 右上: サイト名
      c.textAlign = "right";
      c.fillStyle = "#fcf0d8";
      c.font = '700 15px "Noto Sans JP", sans-serif';
      c.fillText("DEADLOCK-JP DB", CARD_W - 34, 48);
      c.fillStyle = "#8fa39d";
      c.font = '500 12px "JetBrains Mono", monospace';
      c.fillText("deadlock-jpdb.com", CARD_W - 34, 66);
      c.textAlign = "left";
      c.shadowBlur = 0;

      /*
       * ---- 下部UI ----
       * アイテムは6列2段で横幅いっぱいに置く。セルの大きさは横から決まるので、
       * 段の高さもそれに従う(先に高さを決め打ちすると下段がはみ出す)。
       * 左のメーターはゲーム本編と同じく2段ぶんの高さに合わせる。
       */
      const PAD = 34;
      const METER_W = 132;
      const GAP = 9;
      const COLS = 6;
      const gridX = PAD + METER_W + 14;
      const cellSize = Math.floor((CARD_W - PAD - gridX - GAP * (COLS - 1)) / COLS);
      const gridH = cellSize * 2 + GAP;
      const gridTop = CARD_H - 30 - gridH;
      const soulsY = gridTop - 24;

      // レベル(緑の丸)。ゲーム本編ではソウル額の左にこれが出る
      const lvR = 32;
      const lvX = PAD + lvR;
      const lvY = soulsY - lvR + 6;
      c.beginPath();
      c.arc(lvX, lvY, lvR, 0, Math.PI * 2);
      c.strokeStyle = "#5fe0a8";
      c.lineWidth = 5;
      c.shadowColor = "rgba(95,224,168,.45)";
      c.shadowBlur = 14;
      c.stroke();
      c.shadowBlur = 0;
      c.fillStyle = "#5fe0a8";
      c.font = '700 30px "JetBrains Mono", monospace';
      c.textAlign = "center";
      c.fillText(String(level), lvX, lvY + 11);
      c.textAlign = "left";

      // ソウル額
      c.shadowColor = "rgba(0,0,0,.8)";
      c.shadowBlur = 10;
      c.fillStyle = "#5fe0a8";
      c.font = '700 40px "JetBrains Mono", monospace';
      c.fillText("$", PAD + lvR * 2 + 20, lvY + 18);
      const dollarW = c.measureText("$").width;
      c.font = '700 56px "JetBrains Mono", monospace';
      const amountX = PAD + lvR * 2 + 20 + dollarW + 6;
      c.fillText(fmt(spent), amountX, lvY + 18);
      const amountW = c.measureText(fmt(spent)).width;
      c.fillStyle = "#e9f2ef";
      c.font = '700 19px "Noto Sans JP", sans-serif';
      c.fillText("アイテム価値", amountX + amountW + 14, lvY + 18);
      c.shadowBlur = 0;

      // 投資メーター(武器/生命力/スピリット)。高さはアイテム2段ぶんに合わせる
      const mW = METER_W;
      const mH = gridH;
      c.fillStyle = "rgba(10,15,19,.82)";
      roundRect(c, PAD, gridTop, mW, mH, 6);
      c.fill();
      c.strokeStyle = "rgba(126,224,180,.14)";
      c.lineWidth = 1;
      c.stroke();
      const slotsOrder = ["WeaponMod", "Armor", "Tech"];
      const maxCost = Math.max(cost.WeaponMod, cost.Armor, cost.Tech, 1);
      const SEG = 14;
      slotsOrder.forEach((s, i) => {
        const bw = 24;
        const bx = PAD + mW / 2 - (bw * 3 + 20) / 2 + i * (bw + 10);
        const by = gridTop + 14;
        const bh = mH - 50;
        c.fillStyle = "rgba(255,255,255,.05)";
        roundRect(c, bx, by, bw, bh, 3);
        c.fill();
        const on = Math.round((cost[s] / maxCost) * SEG);
        const segH = (bh - 4) / SEG;
        for (let k = 0; k < SEG; k++) {
          c.fillStyle = k < on ? CAT_COLOR[s] : "rgba(255,255,255,.07)";
          c.fillRect(bx + 2, by + bh - 2 - (k + 1) * segH + 2, bw - 4, segH - 2);
        }
        // 下のしるし(当サイトで描いた図形。ゲームのアイコンそのものではない)
        c.fillStyle = CAT_COLOR[s];
        const ix = bx + bw / 2;
        const iy = gridTop + mH - 18;
        c.beginPath();
        if (s === "WeaponMod") {
          c.arc(ix, iy, 6, 0, Math.PI * 2);
          c.lineWidth = 2;
          c.strokeStyle = CAT_COLOR[s];
          c.stroke();
          c.beginPath();
          c.arc(ix, iy, 2.2, 0, Math.PI * 2);
          c.fill();
        } else if (s === "Armor") {
          c.moveTo(ix, iy - 7);
          c.lineTo(ix + 6, iy - 4);
          c.lineTo(ix + 6, iy + 1);
          c.quadraticCurveTo(ix + 6, iy + 6, ix, iy + 8);
          c.quadraticCurveTo(ix - 6, iy + 6, ix - 6, iy + 1);
          c.lineTo(ix - 6, iy - 4);
          c.closePath();
          c.fill();
        } else {
          c.moveTo(ix, iy - 8);
          c.lineTo(ix + 2.2, iy - 2.2);
          c.lineTo(ix + 8, iy);
          c.lineTo(ix + 2.2, iy + 2.2);
          c.lineTo(ix, iy + 8);
          c.lineTo(ix - 2.2, iy + 2.2);
          c.lineTo(ix - 8, iy);
          c.lineTo(ix - 2.2, iy - 2.2);
          c.closePath();
          c.fill();
        }
      });

      // アイテム 6x2
      const gx = gridX;
      const gap = GAP;
      const cols = COLS;
      const cell = cellSize;
      for (let i = 0; i < 12; i++) {
        const col = i % cols;
        const row = Math.floor(i / cols);
        const x = gx + col * (cell + gap);
        const y = gridTop + row * (cell + gap);
        const id = picked[i];
        const it = id ? payload.items[id] : null;
        if (!it) {
          c.fillStyle = "rgba(12,17,22,.55)";
          roundRect(c, x, y, cell, cell, 7);
          c.fill();
          c.strokeStyle = "rgba(255,255,255,.08)";
          c.setLineDash([5, 4]);
          c.lineWidth = 1;
          c.stroke();
          c.setLineDash([]);
          continue;
        }
        const [c1, c2] = CAT_TILE[it.slot] ?? CAT_TILE.WeaponMod;
        const g = c.createLinearGradient(x, y, x + cell, y + cell);
        g.addColorStop(0, c1);
        g.addColorStop(0.7, c2);
        c.fillStyle = g;
        roundRect(c, x, y, cell, cell, 7);
        c.fill();
        c.save();
        c.clip();
        // ショップにある実アイコンをそのまま使う
        const dom = document.querySelector(`.card[data-id="${CSS.escape(id)}"] .icon img`);
        if (dom && dom.complete && dom.naturalWidth) {
          const pad = cell * 0.11;
          c.drawImage(dom, x + pad, y + pad, cell - pad * 2, cell - pad * 2);
        } else {
          // 画像が無いアイテムは頭文字で代替(ItemIcon のプレースホルダと同じ考え方)
          c.fillStyle = "rgba(255,255,255,.75)";
          c.font = '700 20px "Noto Sans JP", sans-serif';
          c.textAlign = "center";
          c.fillText(it.name.slice(0, 2), x + cell / 2, y + cell / 2 + 7);
          c.textAlign = "left";
        }
        c.restore();
        c.strokeStyle = "rgba(255,255,255,.12)";
        c.lineWidth = 1;
        roundRect(c, x + 0.5, y + 0.5, cell - 1, cell - 1, 7);
        c.stroke();
        // 右上のティア
        const tw = 22;
        const th = 17;
        c.fillStyle = "rgba(255,255,255,.82)";
        c.beginPath();
        c.moveTo(x + cell - tw, y);
        c.lineTo(x + cell, y);
        c.lineTo(x + cell, y + th);
        c.lineTo(x + cell - tw + 6, y + th);
        c.quadraticCurveTo(x + cell - tw, y + th, x + cell - tw, y + th - 6);
        c.closePath();
        c.fill();
        c.fillStyle = "#0c1116";
        c.font = '700 11px "JetBrains Mono", monospace';
        c.textAlign = "center";
        c.fillText(ROMAN[it.tier] ?? String(it.tier), x + cell - tw / 2 + 2, y + 12);
        c.textAlign = "left";
      }
      return cv;
    }

    async function saveCardImage() {
      const btn = $("cardbtn");
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = "作成中…";
      try {
        // Webフォントが来る前に描くと別書体になるので待つ
        if (document.fonts && document.fonts.ready) await document.fonts.ready;
        const cv = await drawCard();
        const blob = await new Promise((r) => cv.toBlob(r, "image/png"));
        if (!blob) throw new Error("toBlob failed");
        const h = hero();
        const name =
          "deadlock-jpdb_" + (h ? h.key : "build") + "_" + new Date().toISOString().slice(0, 10) + ".png";
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      } catch (e) {
        btn.textContent = "作成できませんでした";
        setTimeout(() => (btn.textContent = label), 2400);
        return;
      }
      btn.disabled = false;
      btn.textContent = label;
    }

    // ---- ホバーカード -------------------------------------------------
    const card = $("hovercard");
    function showCard(id, anchor) {
      const it = payload.items[id];
      if (!it) return;
      const meta = payload.slotMeta[it.slot] ?? { label: "", cssVar: "accent" };
      const rows = (list, cls) =>
        list.length
          ? `<ul class="${cls}">${list
              .map((r) => `<li><span class="l">${esc(r.label)}</span><span class="v">${esc(r.value)}</span></li>`)
              .join("")}</ul>`
          : "";
      const badge = it.isImbue ? "IMBUE" : it.activation !== "PASSIVE" ? "ACTIVE" : null;
      card.style.setProperty("--cat", `var(--c-${meta.cssVar})`);
      card.style.setProperty("--cat-bg", `var(--c-${meta.cssVar}-bg)`);
      card.innerHTML =
        `<div class="hc-head"><span class="hc-name">${esc(it.name)}</span>` +
        `${badge ? `<span class="hc-badge">${badge}</span>` : ""}</div>` +
        `<div class="hc-meta">${esc(meta.label)}・ティア${it.tier}・<span class="hc-soul">${fmt(it.cost)}ソウル</span>・枠${it.slotCost}</div>` +
        (it.desc ? `<p class="hc-desc">${esc(it.desc)}</p>` : "") +
        (it.passives.length ? `<div class="hc-sec">常時パッシブ</div>${rows(it.passives, "hc-rows")}` : "") +
        (it.conditional.length ? `<div class="hc-sec">条件付き</div>${rows(it.conditional, "hc-rows")}` : "") +
        (it.components.length ? `<div class="hc-rel">素材: ${esc(it.components.join("、"))}</div>` : "") +
        (it.usedIn.length ? `<div class="hc-rel">上位: ${esc(it.usedIn.join("、"))}</div>` : "");
      card.hidden = false;

      /*
       * 位置決め。カードは position: fixed なので、ビューポート座標をそのまま入れる。
       *
       * 縦は、カードがビューポートより高い場合に上端が画面外へ飛ばないよう、
       * 下端クランプのあとに必ず上端クランプをかける(順序が逆だと画面外に出る)。
       *
       * 高さは直後に変わることがある(Webフォントの適用で行の折り返しが変わる)。
       * 1回だけ測って置くと下にはみ出すため、次の描画フレームでもう一度測り直す。
       */
      const place = () => {
        const M = 8; // 画面端からの余白
        const r = anchor.getBoundingClientRect();
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;
        const vw = document.documentElement.clientWidth;
        const vh = document.documentElement.clientHeight;

        // ショップが右側にあるため、左に出すと自分のステータス欄を隠す。右を優先する
        let left = r.right + 10;
        if (left + cw > vw - M) left = r.left - cw - 10;
        left = Math.min(left, vw - cw - M);
        left = Math.max(M, left);

        let top = r.top - 4;
        top = Math.min(top, vh - ch - M);
        top = Math.max(M, top);

        card.style.left = left + "px";
        card.style.top = top + "px";
      };
      place();
      requestAnimationFrame(place);
    }
    // モバイル(ホバー不可)は「1タップで詳細チップ、もう一度タップで追加」にする
    const coarse = window.matchMedia("(hover: none)").matches;
    let tapPreviewId = null; // いまタップでチップを出しているアイテム

    function hideCard() {
      card.hidden = true;
      tapPreviewId = null;
    }

    /** ショップのアイテムをビルドに足す/外す */
    function toggleItem(id) {
      const at = picked.indexOf(id);
      if (at >= 0) {
        picked.splice(at, 1);
      } else {
        // 既に持っている上位アイテムに内包されているものは、単体で足す意味がない
        if (coveredIds().has(id)) return;
        /*
         * 上位アイテムは下位アイテムの効果を含むので、下位は外す。
         * 価格もこれで辻褄が合う。ゲームでは素材を先に買うと差額で強化できるため、
         * 「素材800 + 差額2400」も「上位を直接3200」も合計は同じになる。
         */
        const drop = allComponents(id);
        picked = picked.filter((x) => !drop.has(x));
        picked.push(id);
      }
      refresh(false);
    }

    // ---- 操作 --------------------------------------------------------
    for (const el of document.querySelectorAll(".card")) {
      el.addEventListener("click", () => {
        const id = el.dataset.id;
        // モバイルで、まだそのアイテムのチップを出していない → チップを出すだけ
        if (coarse && tapPreviewId !== id) {
          tapPreviewId = id;
          showCard(id, el);
          return;
        }
        // デスクトップ、またはモバイルで同じアイテムの2回目のタップ
        if (coarse) hideCard();
        toggleItem(id);
      });
      el.addEventListener("mouseenter", () => showCard(el.dataset.id, el));
      el.addEventListener("focus", () => showCard(el.dataset.id, el));
      el.addEventListener("mouseleave", hideCard);
      el.addEventListener("blur", hideCard);
    }

    // モバイル: カード以外をタップしたらチップを閉じる
    if (coarse) {
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".card")) hideCard();
      });
    }

    document.querySelector("[data-cells]").addEventListener("click", (e) => {
      const cell = e.target.closest(".cell.filled");
      if (!cell) return;
      picked = picked.filter((id) => id !== cell.dataset.id);
      refresh(false);
    });

    // スキルの AP 段トグル(スキルダメージ表示に反映)。中身は render で作り直すので委譲
    document.querySelector("[data-spirit]").addEventListener("click", (e) => {
      const btn = e.target.closest(".apd");
      if (!btn) return;
      const key = btn.dataset.ab;
      const n = Number(btn.dataset.lvl);
      apLevel[key] = (apLevel[key] ?? 0) === n ? n - 1 : n;
      render();
    });

    $("hero").addEventListener("change", (e) => {
      heroId = e.target.value === "" ? null : Number(e.target.value);
      refresh(false);
    });
    $("clear").addEventListener("click", () => {
      picked = [];
      refresh(false);
    });

    // ---- 保存パネルの配線 ----
    $("cardbtn").addEventListener("click", saveCardImage);
    if (storeOk) {
      $("savetoggle").hidden = false;
      const panel = $("savepanel");
      $("savetoggle").addEventListener("click", () => {
        const open = panel.hidden;
        panel.hidden = !open;
        $("savetoggle").setAttribute("aria-expanded", String(open));
      });
      $("savebtn").addEventListener("click", saveCurrent);
      $("savename").addEventListener("keydown", (e) => {
        if (e.key === "Enter") saveCurrent();
      });
      // 呼び出し・削除はイベント委譲(一覧は描き直すため)
      $("savedlist").addEventListener("click", (e) => {
        const btn = e.target.closest("[data-act]");
        if (!btn) return;
        const id = btn.closest("li")?.dataset.id;
        const list = loadSaved();
        const b = list.find((x) => x.id === id);
        if (!b) return;
        if (btn.dataset.act === "del") {
          storeSaved(list.filter((x) => x.id !== id));
          renderSaved();
          return;
        }
        // 呼び出し: ハッシュを入れて既存の読み込み経路に乗せる
        location.hash = b.hash;
        readUrl();
        $("savename").value = b.label ?? "";
        render();
        $("compare").href = base + "/build/compare/" + (b.hash ? "#" + b.hash : "");
      });
      renderSaved();
      // 保存済みがあるときは開いた状態で始める
      if (loadSaved().length) {
        panel.hidden = false;
        $("savetoggle").setAttribute("aria-expanded", "true");
      }
    }
    $("share").addEventListener("click", async () => {
      const btn = $("share");
      try {
        await navigator.clipboard.writeText(location.href);
        btn.textContent = "コピーしました";
      } catch {
        btn.textContent = location.href;
      }
      setTimeout(() => (btn.textContent = "共有URLをコピー"), 2000);
    });

    for (const btn of document.querySelectorAll(".sortbtn")) {
      btn.addEventListener("click", () => {
        if (btn.dataset.sort === sortKey) return;
        sortKey = btn.dataset.sort;
        for (const x of document.querySelectorAll(".sortbtn")) {
          x.classList.toggle("current", x === btn);
        }
        renderShopStats();
      });
    }

    for (const tab of document.querySelectorAll(".tab")) {
      tab.addEventListener("click", () => {
        for (const x of document.querySelectorAll(".tab")) x.classList.remove("current");
        tab.classList.add("current");
        for (const c of document.querySelectorAll(".cat")) {
          c.hidden = c.dataset.slot !== tab.dataset.slot;
        }
        hideCard();
      });
    }

    window.addEventListener("hashchange", () => {
      readUrl();
      render();
    });
    window.addEventListener("scroll", hideCard, { passive: true });

    readUrl();
    refresh(true);
  </script>

  {/* スキルアイコンの供給元。表示はせず、クローン元としてだけ使う */}
  <div class="iconsrc" aria-hidden="true">
    {
      heroes.flatMap((h) =>
        abilityDamages(h).map((a) => (
          <span class="aicon-src" data-ab={a.key} set:html={
            a.image
              ? `<img src="${base}/${(a.image.replace("file://{images}/", "images/")).replace(/\.[a-z0-9]+$/i, ".png")}" alt="" width="26" height="26" loading="lazy">`
              : ""
          } />
        )),
      )
    }
  </div>

  <style>
    /* ---- 見出し ---- */
    /* 見出しの下の操作列(ヒーロー選択・共有URL・バージョン比較・クリア) */
    .head {
      display: flex;
      align-items: center;
      gap: var(--sp-4);
      flex-wrap: wrap;
      margin: calc(var(--sp-2) * -1) 0 var(--sp-4);
    }
    .heropick { font-size: 13px; color: var(--c-text-muted); display: flex; align-items: center; gap: var(--sp-2); }
    select {
      background: var(--c-surface); color: var(--c-text);
      border: 1px solid var(--c-border-strong); border-radius: var(--radius);
      padding: 5px 8px; font: inherit; font-size: 13px;
    }
    .totals { display: flex; gap: var(--sp-4); margin-left: auto; font-size: 12px; color: var(--c-text-muted); }
    .totals b { font-family: var(--font-mono); color: var(--c-text-strong); font-size: 14px; }
    .acts { display: flex; gap: var(--sp-2); }
    .share, .clear, .compare {
      padding: 5px 12px; border-radius: var(--radius); font: inherit; font-size: 12px; cursor: pointer;
      text-decoration: none; display: inline-block;
    }
    .share { background: var(--c-accent-bg); border: 1px solid var(--c-accent-dim); color: var(--c-accent); }
    .share:hover { background: var(--c-accent-bg-strong); color: var(--c-accent-hover); }
    .compare { background: transparent; border: 1px solid var(--c-spirit); color: var(--c-spirit); }
    .compare:hover { background: var(--c-spirit-bg); }
    .clear { background: transparent; border: 1px solid var(--c-border); color: var(--c-text-muted); }
    .clear:hover { border-color: var(--c-border-strong); color: var(--c-text); }

    .layout {
      display: grid;
      grid-template-columns: 360px minmax(0, 1fr);
      gap: var(--sp-5);
      align-items: start;
    }

    /* ---- 左: ヒーロー行 ---- */
    .heroline { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); }
    .hname { font-weight: 600; color: var(--c-text-strong); }

    /* ---- 左: アイテムスロット(12枠フレックス) ---- */
    .slotbar {
      display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3);
      margin-bottom: var(--sp-2);
    }
    .slotcount { font-size: 11px; color: var(--c-text-muted); font-family: var(--font-mono); }
    .slotcount b { color: var(--c-text-strong); font-size: 13px; }
    .slotcount.over b { color: #d08a3e; }
    .lvl { margin-right: auto; }
    .lvl b {
      font-family: var(--font-mono); font-size: 13px; color: var(--c-accent);
      border: 1px solid var(--c-accent-dim); border-radius: var(--radius);
      padding: 2px 8px;
    }
    /* ソウルの合計。ゲームの通貨表示に合わせて水色で目立たせる */
    .soulcost {
      display: flex; align-items: center; gap: 5px;
      color: var(--c-soul); background: var(--c-soul-bg);
      border: 1px solid var(--c-soul-dim); border-radius: var(--radius);
      padding: 3px 10px;
    }
    .soulcost b { font-family: var(--font-mono); font-size: 17px; line-height: 1.1; letter-spacing: -0.01em; }
    .soulcost small { font-size: 10px; color: var(--c-soul); opacity: .75; }

    /*
     * 2段×6。ゲームと同じく「上下を埋めてから次の列へ」進む。
     * grid-auto-flow: column にすると、列ごとに行を埋めてから次の列に移る。
     */
    .cells {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(2, auto);
      grid-auto-flow: column;
      gap: 5px;
    }
    .cells :global(.cell) {
      aspect-ratio: 1; border-radius: 5px;
      border: 1px dashed var(--c-border-strong); background: var(--c-bg);
      display: block; padding: 0; line-height: 0; width: 100%;
    }
    .cells :global(.cell.filled) {
      border: 1px solid var(--cat, var(--c-border-strong)); background: none; cursor: pointer;
      overflow: hidden;
    }
    .cells :global(.cell.filled:hover) { filter: brightness(1.25); }
    /* 12枠を超えた分。ゲームでは持てない数であることを示す */
    .cells :global(.cell.over) { outline: 2px solid #d08a3e; outline-offset: 1px; }
    .cells :global(.cell.filled .icon) { width: 100%; height: 100%; border: none; border-radius: 4px; }
    .slotnote { font-size: 11px; color: var(--c-text-faint); margin: var(--sp-2) 0 var(--sp-4); }

    /* ---- 左: TYPE別ボックス ---- */
    .box {
      background: var(--cat-bg);
      border: 1px solid var(--cat);
      border-radius: var(--radius-lg);
      padding: var(--sp-3) var(--sp-4) var(--sp-4);
      margin-bottom: var(--sp-3);
    }
    .box.plain { background: var(--c-surface); border-color: var(--c-border); }
    .bhead { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3); }
    .bhead h2 {
      font-size: 13px; margin: 0 0 var(--sp-2); border: none; padding: 0;
      color: var(--cat); letter-spacing: .04em;
    }
    .box.plain .bhead h2 { color: var(--c-text-strong); }
    .bhl { font-size: 11px; color: var(--c-text-muted); text-align: right; }
    .bbody { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-4); align-items: start; }
    .bcol { min-width: 0; }
    .invest { min-width: 0; }
    .bhl :global(b) { font-family: var(--font-mono); font-size: 15px; color: var(--c-text-strong); margin-right: 3px; }
    .bhl :global(small) { display: block; color: var(--c-text-faint); }
    /*
     * 以下は中身をJSで差し込むため、Astroのスコープ属性が付かない。
     * :global でないと当たらない。
     */
    .brows, .stats, .alist { list-style: none; padding: 0; margin: 0; }
    .brows :global(li), .stats :global(li), .alist :global(li) {
      display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3);
      padding: 3px 0; font-size: 12px; border-bottom: 1px solid var(--c-border);
    }
    .brows :global(.l), .stats :global(.l), .alist :global(.l) { color: var(--c-text-muted); }
    .brows :global(.v), .stats :global(.v), .alist :global(.v) {
      font-family: var(--font-mono); color: var(--c-text-strong); white-space: nowrap;
    }
    .brows :global(.empty), .stats :global(.empty), .alist :global(.empty) {
      color: var(--c-text-faint); border: none; font-size: 12px; display: block;
    }

    /* スピリット: スキルアイコン付きの一覧 */
    .spirit h3, .invest h3 {
      font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--c-text-muted); margin: var(--sp-4) 0 var(--sp-2); border: none; padding: 0;
    }
    /* スキル1行: アイコン + (AP段トグル / 名前+ダメージ) */
    .alist :global(li) { align-items: flex-start; gap: var(--sp-2); }
    .alist :global(.ai) { flex: 0 0 auto; line-height: 0; margin-top: 2px; }
    .alist :global(.ai img) {
      width: 26px; height: 26px; border-radius: 4px;
      border: 1px solid var(--cat); background: var(--c-surface-2);
    }
    .alist :global(.abody) { flex: 1 1 auto; min-width: 0; }
    .alist :global(.aline) {
      display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-2);
    }
    .alist :global(.an) {
      flex: 1 1 auto; min-width: 0; color: var(--c-text); font-size: 11px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .alist :global(.l) { font-size: 10px; }
    .alist :global(li.ult .an) { color: var(--c-spirit); font-weight: 600; }
    /* AP 段トグル(ゲームの菱形マークを模した clip-path) */
    .alist :global(.aptop) { display: flex; gap: 3px; margin: 1px 0 3px; }
    .alist :global(.apd) {
      width: 15px; height: 15px; padding: 0; border: 0;
      clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
      background: color-mix(in srgb, var(--c-spirit) 22%, transparent);
      color: var(--c-spirit);
      font-family: var(--font-mono); font-size: 9px; font-weight: 700; line-height: 1;
      display: grid; place-items: center; cursor: pointer;
    }
    .alist :global(.apd:hover) { background: color-mix(in srgb, var(--c-spirit) 45%, transparent); }
    .alist :global(.apd.on) { background: var(--c-spirit); color: var(--c-bg); }

    /* 投資額の階段 */
    .ladder { list-style: none; margin: 0; padding: 0; }
    .ladder :global(li) {
      display: flex; justify-content: space-between; gap: var(--sp-2);
      font-family: var(--font-mono); font-size: 10px; line-height: 1.5;
      padding: 0 4px; border-radius: 3px;
    }
    .ladder :global(.b), .ladder :global(.g) { color: var(--c-text-faint); }
    .ladder :global(li.done .b) { color: var(--c-text); }
    .ladder :global(li.done .g) { color: var(--c-text-muted); }
    .ladder :global(li.now) { background: var(--cat); }
    .ladder :global(li.now .b), .ladder :global(li.now .g) { color: var(--c-bg); font-weight: 700; }

    /* ---- 右: ショップ ---- */
    .tabs { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
    .tab {
      --cat: var(--c-accent);
      display: flex; align-items: baseline; gap: 6px;
      background: var(--c-surface); border: 1px solid var(--c-border); color: var(--c-text-muted);
      border-radius: var(--radius); padding: 6px 16px; font: inherit; font-size: 13px; cursor: pointer;
    }
    .tab small { font-family: var(--font-mono); font-size: 10px; color: var(--c-text-faint); }
    .tab:hover { color: var(--c-text); border-color: var(--c-border-strong); }
    .tab.current { color: var(--cat); border-color: var(--cat); background: var(--cat-bg); }
    .tab.current small { color: var(--cat); }
    .tier h3 {
      font-size: 11px; letter-spacing: .08em; color: var(--c-text-muted); text-transform: uppercase;
      display: flex; justify-content: space-between; margin: 0 0 var(--sp-2); border: none; padding: 0;
    }
    .tier { margin-bottom: var(--sp-5); }
    .price { font-family: var(--font-mono); color: var(--c-soul); opacity: .85; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: var(--sp-2); }
    .card {
      display: flex; flex-direction: column; align-items: center; gap: 5px;
      padding: var(--sp-2) 4px;
      background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius);
      color: var(--c-text-muted); font: inherit; font-size: 10px; line-height: 1.3;
      text-align: center; cursor: pointer;
    }
    .card:hover { background: var(--cat-bg); border-color: var(--cat); color: var(--c-text); }
    .card.on { border-color: var(--cat); background: var(--cat-bg); color: var(--c-text-strong); box-shadow: inset 0 0 0 1px var(--cat); }
    /* 上位アイテムに内包されているもの。単体で持つ意味がないので選べない */
    .card.covered { opacity: 0.32; cursor: not-allowed; }
    .card.covered:hover { background: var(--c-surface); border-color: var(--c-border); }
    .cname { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* ---- ビルドの保存(localStorage) ---- */
    .savetoggle[aria-expanded="true"] { color: var(--c-soul); border-color: var(--c-soul-dim); background: var(--c-soul-bg); }
    .savecount { font-family: var(--font-mono); font-size: 11px; color: var(--c-text-faint); }
    .savetoggle[aria-expanded="true"] .savecount { color: var(--c-soul); }
    .savepanel {
      margin: calc(var(--sp-2) * -1) 0 var(--sp-4);
      padding: var(--sp-3) 0 0;
      border-top: 1px solid var(--c-border);
    }
    .savebar { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
    .savelabel { font-size: 11px; color: var(--c-text-muted); letter-spacing: .04em; }
    .savepanel input {
      flex: 1 1 260px; max-width: 340px;
      background: var(--c-surface); border: 1px solid var(--c-border-strong); color: var(--c-text);
      border-radius: var(--radius); padding: 5px 9px; font: inherit; font-size: 13px;
    }
    .savepanel input:focus { outline: none; border-color: var(--c-accent); }
    .savenote { font-size: 11px; color: var(--c-accent); }
    .savedlist { list-style: none; padding: 0; margin: var(--sp-3) 0 0; display: grid; gap: 4px; max-width: 720px; }
    .savedlist li {
      display: flex; align-items: center; gap: var(--sp-2);
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-left: 3px solid var(--c-accent-dim); border-radius: var(--radius); padding: 6px 8px;
    }
    .savedempty {
      display: block !important; border: none !important; background: none !important;
      font-size: 12px; color: var(--c-text-faint); padding: 2px 0 !important;
    }
    .sv-mini { display: flex; gap: 2px; flex: 0 0 auto; }
    .sv-mini i { width: 14px; height: 14px; border-radius: 3px; display: block; }
    .sv-mini .w { background: var(--c-weapon-bg); border: 1px solid var(--c-weapon); }
    .sv-mini .v { background: var(--c-vitality-bg); border: 1px solid var(--c-vitality); }
    .sv-mini .s { background: var(--c-spirit-bg); border: 1px solid var(--c-spirit); }
    .sv-name {
      flex: 1 1 auto; min-width: 0; font-size: 13px; color: var(--c-text-strong);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sv-meta { font-family: var(--font-mono); font-size: 11px; color: var(--c-text-faint); white-space: nowrap; }
    .savedlist button {
      background: var(--c-surface-2); color: var(--c-text-muted);
      border: 1px solid var(--c-border); border-radius: var(--radius);
      font: inherit; font-size: 11px; padding: 3px 8px; cursor: pointer;
    }
    .savedlist .sv-load:hover { color: var(--c-accent); border-color: var(--c-accent-dim); }
    .savedlist .sv-del:hover { color: var(--c-weapon); border-color: var(--c-weapon); }

    /* ---- ショップ見出し行: 左にTYPE選択、右に並び替え ---- */
    .shophead {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: var(--sp-2) var(--sp-4);
      margin-bottom: var(--sp-4);
    }
    /* ---- 人気率・勝率(ヒーロー選択中だけ出る) ---- */
    .sortbar {
      display: flex; align-items: center; gap: var(--sp-2);
      margin-left: auto;
    }
    .sortlabel { font-size: 11px; color: var(--c-text-muted); }
    .sortbtns { display: flex; }
    .sortbtn {
      background: var(--c-surface); color: var(--c-text-muted);
      border: 1px solid var(--c-border); font: inherit; font-size: 12px;
      padding: 3px 12px; cursor: pointer;
    }
    .sortbtn:first-child { border-radius: var(--radius) 0 0 var(--radius); }
    .sortbtn:last-child { border-radius: 0 var(--radius) var(--radius) 0; margin-left: -1px; }
    .sortbtn:hover { color: var(--c-text); border-color: var(--c-border-strong); }
    .sortbtn.current {
      color: var(--c-accent); border-color: var(--c-accent-dim); background: var(--c-accent-bg);
      position: relative; z-index: 1;
    }

    .cstat {
      display: flex; flex-direction: column; gap: 1px; width: 100%;
      margin-top: 1px; padding-top: 3px; border-top: 1px solid var(--c-border);
      font-family: var(--font-mono); font-size: 9px; line-height: 1.4;
    }
    .cstat .crow { display: flex; justify-content: space-between; gap: 4px; }
    .cstat i { font-style: normal; color: var(--c-text-faint); }
    .cstat b { font-weight: 500; color: var(--c-text); }
    .cstat .cwin.good { color: var(--c-vitality); }
    .cstat .cwin.bad { color: var(--c-text-muted); }
    /* サンプルが少ない行は薄くして、鵜呑みにしないことが分かるようにする */
    .cstat.low { opacity: 0.45; }

    /* ---- ホバーカード ---- */
    .hovercard {
      /*
       * position: absolute だと基準が .site-main(position:relative)になり、
       * ビューポート座標で計算した値がヘッダーぶんずれて下にはみ出す。
       * fixed にして、そのままビューポート座標で置く。
       */
      position: fixed; z-index: 40; width: 280px;
      max-height: calc(100vh - 16px); overflow: auto;
      background: var(--c-surface); border: 1px solid var(--cat);
      border-left: 3px solid var(--cat);
      border-radius: var(--radius); padding: var(--sp-3);
      box-shadow: 0 8px 28px rgb(0 0 0 / 0.5);
      pointer-events: none;
    }
    .hovercard :global(.hc-head) { display: flex; align-items: center; gap: var(--sp-2); }
    .hovercard :global(.hc-name) { font-weight: 700; color: var(--c-text-strong); font-size: 14px; }
    .hovercard :global(.hc-badge) {
      font-size: 9px; font-weight: 700; letter-spacing: .06em; padding: 0 4px; border-radius: 2px;
      color: var(--c-bg); background: var(--cat);
    }
    .hovercard :global(.hc-meta) { font-size: 11px; color: var(--cat); margin-top: 2px; font-family: var(--font-mono); }
    .hovercard :global(.hc-soul) { color: var(--c-soul); }
    .hovercard :global(.hc-desc) { font-size: 12px; color: var(--c-text); line-height: 1.6; margin: var(--sp-2) 0 0; }
    .hovercard :global(.hc-sec) {
      font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--c-text-muted); margin-top: var(--sp-3);
    }
    .hovercard :global(.hc-rows) { list-style: none; padding: 0; margin: 2px 0 0; }
    .hovercard :global(.hc-rows li) {
      display: flex; justify-content: space-between; gap: var(--sp-3);
      font-size: 11px; padding: 2px 0; border-bottom: 1px solid var(--c-border);
    }
    .hovercard :global(.hc-rows .l) { color: var(--c-text-muted); }
    .hovercard :global(.hc-rows .v) { font-family: var(--font-mono); color: var(--c-text-strong); }
    .hovercard :global(.hc-rel) { font-size: 11px; color: var(--c-text-muted); margin-top: var(--sp-2); }

    .iconsrc { display: none; }

    @media (max-width: 1000px) {
      /*
       * スマホ: 左右段組みをやめて縦一列。
       * .side を display:contents にして子要素を .layout 直下に出すことで、
       * sticky な .buildbar の基準(包含ブロック)が .side ではなく .layout になり、
       * ショップまでスクロールしても追従し続ける(.side 内だけだと途中で外れる)。
       */
      .layout { display: block; }
      .side { display: contents; }
      .shop { margin-top: var(--sp-4); }
      /*
       * 12スロット(buildbar)を画面上部に追従。site-header(sticky・約58px)の直下。
       * 左右は画面端までベタ塗り。
       */
      .buildbar {
        position: sticky;
        top: 57px;
        z-index: 15;
        background: var(--c-bg);
        margin: 0 calc(var(--sp-5) * -1);
        padding: var(--sp-2) var(--sp-5) var(--sp-3);
        border-bottom: 1px solid var(--c-border);
      }
      /*
       * スマホはホバーが無いのでチップはタップで出す(JS)。
       * 2回目のタップ位置(裏のアイコン)が見えるよう背景を少し透過し、
       * 文字が読めるようすりガラスにする。
       */
      .hovercard {
        width: min(280px, calc(100vw - 16px));
        background: color-mix(in srgb, var(--c-surface) 82%, transparent);
        backdrop-filter: blur(8px);
      }
    }
  </style>
</Base>
