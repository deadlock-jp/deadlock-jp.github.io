---
import Base from "../../layouts/Base.astro";
import HeroRender from "../../components/HeroRender.astro";
import StatRadar from "../../components/StatRadar.astro";
import SkillCard from "../../components/SkillCard.astro";
import {
  releasedHeroes,
  t,
  ability,
  modifierLabel,
  heroTags,
  heroNotes,
  heroAdjustments,
  upstreamRepo,
} from "../../lib/data.ts";
import { heroRadar, heroMiscRows, radarAxesForWeapon } from "../../lib/herorank.ts";
import { skillCard } from "../../lib/skillcard.ts";
import AdjustmentHistory from "../../components/AdjustmentHistory.astro";
import HeroStrip from "../../components/HeroStrip.astro";

export function getStaticPaths() {
  return releasedHeroes().map((h) => ({ params: { id: String(h.id) }, props: { hero: h } }));
}
const { hero } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const name = t(hero.nameToken, hero.key);
const tags = heroTags(hero);
const radar = heroRadar(hero.id);
const miscRows = heroMiscRows(hero.id);

/**
 * 成長度レーダーに出す4つ(武器ダメージ・最大HP・近接ダメージ・スピリットパワー)+恩恵は
 * 全38ヒーロー共通。それ以外(テック耐性・弾丸装甲ダメージ耐性・攻撃射程・サブ射撃ダメージ)は
 * 一部のヒーローだけが持つので radar には載せず、その分だけ文で注記する。
 */
const STD_GROWTH = new Set([
  "MODIFIER_VALUE_BASE_BULLET_DAMAGE_FROM_LEVEL",
  "MODIFIER_VALUE_BASE_HEALTH_FROM_LEVEL",
  "MODIFIER_VALUE_BASE_MELEE_DAMAGE_FROM_LEVEL",
  "MODIFIER_VALUE_TECH_POWER",
  "MODIFIER_VALUE_BOON_COUNT",
]);
const extraGrowth = Object.entries(hero.levelUpBonuses).filter(
  ([k, v]) => v !== 0 && !STD_GROWTH.has(k),
);

function buildSkills(abilities: typeof hero.abilities) {
  return abilities
    .filter((a) => a.slot.startsWith("Signature"))
    .sort((a, b) => a.slot.localeCompare(b.slot))
    .map((a) => {
      const ab = ability(a.abilityKey);
      return ab
        ? { key: a.abilityKey, ab, card: skillCard(ab, name), notes: heroNotes(a.abilityKey) }
        : null;
    })
    .filter((s): s is NonNullable<typeof s> => s !== null);
}
const skills = buildSkills(hero.abilities);

/**
 * 変身で一部スキルが入れ替わるヒーロー(今のところシルバーのみ)。
 * alternateFormAbilities はスロット名→実IDの対応表(citadel_ability_transformation側が持つ)。
 * 該当スロットだけ差し替えたアビリティ一覧から、もう一方のスキルセットを組み立てる。
 */
const transformAbility = hero.abilities
  .map((a) => ability(a.abilityKey))
  .find((ab): ab is NonNullable<typeof ab> => !!ab?.alternateFormAbilities);
const altSkills = transformAbility
  ? buildSkills(
      hero.abilities.map((a) => ({
        slot: a.slot,
        abilityKey: transformAbility.alternateFormAbilities![a.slot] ?? a.abilityKey,
      })),
    )
  : null;
const skillGroups = altSkills
  ? [
      { form: "human", label: t("ability_header_human", "人間時").replace(/[：:]$/, ""), list: skills },
      { form: "werewolf", label: t("ability_header_werewolf", "人狼時").replace(/[：:]$/, ""), list: altSkills },
    ]
  : [{ form: null, label: null, list: skills }];

// 変身で武器も入れ替わる場合、その武器の値を既存ヒーロー全員の分布に載せてレーダーを作る
// (heroRadar は常に既定武器=Weapon_Primaryを見るため、変身後の武器は別計算になる)
const altWeaponKey = transformAbility?.alternateFormAbilities?.["Weapon_Primary"];
const altWeapon = altWeaponKey ? (ability(altWeaponKey)?.weapon ?? null) : null;
const altWeaponRadar = altWeapon ? radarAxesForWeapon(altWeapon) : null;

const adjRows = heroAdjustments(hero.key);
const skillNames = skills.map((s) => t(s.key, "")).filter(Boolean);
const metaDesc =
  `Deadlock（デッドロック）のヒーロー「${name}」の基礎ステータス・スキル・レベル成長を日本語で。` +
  `最大HP ${hero.startingStats.EMaxHealth}／移動速度 ${hero.startingStats.EMaxMoveSpeed}m。` +
  (tags.length ? `特徴: ${tags.join("・")}。` : "") +
  (skillNames.length ? `スキル: ${skillNames.join("・")}。` : "");
---

<Base
  title={name}
  description={metaDesc}
  ogType="article"
  breadcrumbs={[
    { name: "ヒーロー", path: "/heroes/" },
    { name, path: `/heroes/${hero.id}/` },
  ]}
>
  <HeroStrip current={hero.id} />
  <a class="back" href={`${base}/heroes/`}>← ヒーロー一覧</a>
  <HeroRender name={name} heroKey={hero.key} />
  <h1>{name}</h1>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
  <p class="lead">{t(hero.roleToken, "")}</p>

  {altSkills && (
    <div class="formtoggle" role="tablist">
      {skillGroups.map((g, i) => (
        <button type="button" class:list={["ftbtn", { active: i === 0 }]} data-form={g.form}>
          {g.label}
        </button>
      ))}
    </div>
  )}

  <h2>ステータス</h2>
  <div class="radars">
    {altWeaponRadar ? (
      <>
        <div class="formpanel" data-form="human">
          {radar.weapon.length > 0 && <StatRadar axes={radar.weapon} cssVar="weapon" title="武器" />}
        </div>
        <div class="formpanel" data-form="werewolf" hidden>
          <StatRadar axes={altWeaponRadar} cssVar="weapon" title="武器" />
        </div>
      </>
    ) : (
      radar.weapon.length > 0 && <StatRadar axes={radar.weapon} cssVar="weapon" title="武器" />
    )}
    <StatRadar axes={radar.base} cssVar="vitality" title="生命力" />
    <StatRadar axes={radar.growth} cssVar="spirit" title="成長度／Lv" />
  </div>
  {miscRows.length > 0 && (
    <ul class="msrow">
      <li class="hd">その他</li>
      {miscRows.map((r) => (
        <li>
          <span class="l">{r.label}</span>
          <span class="v">{r.value}</span>
        </li>
      ))}
    </ul>
  )}
  {extraGrowth.length > 0 && (
    <p class="radarnote extra">
      このヒーローは成長度の4項目に加えて、レベルごとに
      {extraGrowth.map(([k, v]) => `${modifierLabel(k)} +${v}`).join(" / ")}
      も上がります。
    </p>
  )}

  <h2>スキル</h2>
  <div class="skills">
    {skillGroups.map((g) => g.list.map((s) => (
      <div data-form={g.form} hidden={g.form === "werewolf"}>
        <SkillCard
          abilityKey={s.key}
          ab={s.ab}
          card={s.card}
          notes={s.notes}
          heroName={name}
          href={`${base}/abilities/${s.key}/`}
        />
      </div>
    )))}
  </div>

  {altSkills && (
    <script is:inline>
      (() => {
        const buttons = document.querySelectorAll(".formtoggle .ftbtn");
        const panels = document.querySelectorAll(".skills [data-form], .radars .formpanel");
        for (const btn of buttons) {
          btn.addEventListener("click", () => {
            const form = btn.dataset.form;
            for (const b of buttons) b.classList.toggle("active", b === btn);
            for (const el of panels) el.hidden = el.dataset.form !== form;
          });
        }
      })();
    </script>
  )}

  <AdjustmentHistory rows={adjRows} upstreamRepo={upstreamRepo} />

  <style>
    .back { font-size: 13px; }
    h1 { margin-top: var(--sp-4); margin-bottom: var(--sp-2); }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2);
      padding: 0;
      margin: 0 0 var(--sp-2);
    }
    .tags li {
      font-size: 12px;
      color: var(--c-accent);
      border: 1px solid var(--c-accent-dim);
      border-radius: 999px;
      padding: 1px 10px;
    }
    .lead { color: var(--c-text-muted); margin-top: var(--sp-1); }

    .radars {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-4) var(--sp-6);
      justify-content: center;
      margin: var(--sp-4) 0 var(--sp-3);
      padding: var(--sp-4) var(--sp-3) var(--sp-3);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
    }
    .radars :global(.radar) { flex: 0 1 300px; }
    /* レーダーに載せにくい少数の値 */
    .msrow {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: var(--sp-2) var(--sp-4);
      padding: 0;
      margin: 0 0 var(--sp-3);
      font-size: 12px;
    }
    .msrow li { display: flex; gap: var(--sp-2); align-items: baseline; }
    .msrow .hd {
      font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .msrow .l { color: var(--c-text-muted); }
    .msrow .v { font-family: var(--font-mono); color: var(--c-text-strong); }
    .radarnote {
      font-size: 11px; color: var(--c-text-faint); text-align: center;
      max-width: 60ch; margin: 0 auto var(--sp-4); line-height: 1.7;
    }
    .radarnote.extra { color: var(--c-text-muted); margin-top: calc(var(--sp-4) * -1 + var(--sp-1)); }

    /* ---- スキルカード ---- */
    .formtoggle { display: flex; gap: var(--sp-2); margin: var(--sp-2) 0 var(--sp-3); }
    .ftbtn {
      font: inherit;
      font-size: 13px;
      padding: 5px 14px;
      border-radius: var(--radius);
      border: 1px solid var(--c-border-strong);
      background: var(--c-surface);
      color: var(--c-text-muted);
      cursor: pointer;
    }
    .ftbtn.active { color: var(--c-text-strong); border-color: var(--c-accent); background: var(--c-surface-2); }
    .skills { display: grid; gap: var(--sp-3); }

    @media (max-width: 560px) {
      .radars { gap: var(--sp-4); }
    }
  </style>
</Base>
