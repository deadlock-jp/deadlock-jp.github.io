---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import AbilityIcon from "../../components/AbilityIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import HeroHoverCard from "../../components/HeroHoverCard.astro";
import AbilityHoverCard, { type AbilityHoverDetail } from "../../components/AbilityHoverCard.astro";
import RankBandPicker from "../../components/RankBandPicker.astro";
import { releasedHeroes, t, ability, heroTags, describe, heroNotes, heroStats, hasHeroStats, latestChangeMarks, ADJUSTMENT_LABEL, statsPeriodLabel } from "../../lib/data.ts";
import { resolveImagePath } from "../../parsers/image-manifest.ts";
import { heroRanks, pickRows, topRankRows, heroTierTable } from "../../lib/herorank.ts";
import { skillCard } from "../../lib/skillcard.ts";
import { EFFECT_CATEGORIES, effectIndex, effectName, effectHeroAbilities } from "../../lib/effects.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, t: tIn, term, langPath, currentLang } = Astro.locals.i18n;
const T = L();

/* 効果での絞り込みの選択肢と判定(状態異常・効果ページと同じ src/lib/effects.ts)。スキルで持つ効果だけ */
const effectHeroes = effectHeroAbilities();
const effectGroups = EFFECT_CATEGORIES.map((cat) => ({
  label: T.effects.categories[cat],
  options: effectIndex()
    .filter((e) => e.def.category === cat && effectHeroes[e.def.id])
    .map((e) => ({ id: e.def.id, name: effectName(e.def) })),
})).filter((g) => g.options.length > 0);
const isJa = currentLang() === "ja";
/** ヒーローへのリンクの接頭辞(日本語は "") */
const linkBase = base + langPath("/").slice(0, -1);
const ranks = heroRanks();
const tier = heroTierTable();
const BOON_LABEL: Record<string, string> = { hp: T.rank.boonHp, weapon: T.rank.boonWeapon, spirit: T.rank.boonSpirit };

/** トップページと同じホバーカードのデータ + 正方形アイコンのURL */
const heroMeta: Record<number, { name: string; sm: string | null }> = {};
const heroDetail: Record<number, unknown> = {};
for (const h of releasedHeroes()) {
  const name = t(h.nameToken, h.key);
  const key = h.key.replace(/^hero_/, "");
  const gloatRel = `images/heroes/gloat/${key}.webp`;
  const smResolved = resolveImagePath(h.images.iconSmall);
  const smRel = smResolved ? smResolved.outPath.replace(/^public\//, "") : null;
  const r = ranks[h.id];
  heroMeta[h.id] = {
    name,
    sm: smRel && existsSync(join(process.cwd(), "public", smRel)) ? `${base}/${smRel}` : null,
  };
  heroDetail[h.id] = {
    name,
    gloat: existsSync(join(process.cwd(), "public", gloatRel)) ? `${base}/${gloatRel}` : null,
    tags: heroTags(h),
    weapon: pickRows(r.weapon, ["dps", "bullet", "clip", "range"]),
    vitality: pickRows(r.vitality, ["hp", "regen", "move", "stam"]),
    spirit: pickRows(r.growth, ["gspower"]).concat(pickRows(r.spirit, ["skillscale"])),
    boon: r.boonAccent.map((a) => BOON_LABEL[a]),
  };
}

// 下部の一覧(従来のカード)。統計は固定のHP/速度ではなく、このヒーローが
// 実際に上位に入っている項目を2つ選ぶ(heroRanksの百分位順)
const heroes = releasedHeroes().map((h) => ({
  hero: h,
  name: t(h.nameToken, h.key),
  /** 日本語以外では英語名でも絞り込めるようにする(日本語版は従来どおり) */
  findName: isJa ? t(h.nameToken, h.key) : `${t(h.nameToken, h.key)} ${tIn(h.nameToken, h.key, "en")}`,
  role: t(h.roleToken, ""),
  topStats: topRankRows(ranks[h.id], 2),
  skills: h.abilities
    .filter((a) => a.slot.startsWith("Signature"))
    .sort((a, b) => a.slot.localeCompare(b.slot))
    .map((a) => ({ key: a.abilityKey, ab: ability(a.abilityKey) })),
}));
const cx = (n: number) => Math.max(0, Math.min(3, n));
/** 最新アップデートで数値が変わったヒーローの札 */
const marks = latestChangeMarks();
const markTitle = marks ? T.patchPage.changedIn(marks.title, marks.date) : "";

/**
 * 一覧カードのスキルアイコンにホバーで出す詳細カードのデータ。
 * 中身はヒーロー詳細ページの SkillCard.astro(スキルカードUI改善)と同じ
 * skillCard()/describe() の結果を使う。
 */
const abilityDetails: Record<string, AbilityHoverDetail> = {};
for (const h of releasedHeroes()) {
  const heroName = t(h.nameToken, h.key);
  for (const a of h.abilities) {
    if (!a.slot.startsWith("Signature") || abilityDetails[a.abilityKey]) continue;
    const ab = ability(a.abilityKey);
    if (!ab) continue;
    const card = skillCard(ab, heroName);
    abilityDetails[a.abilityKey] = {
      name: t(a.abilityKey, a.abilityKey),
      isUlt: ab.kind === "Ultimate",
      isPassive: ab.kind !== "Ultimate" && ab.activation === "PASSIVE",
      meta: card.meta,
      desc: describe(`${a.abilityKey}_desc`, ab.properties, T.common.noDesc, { hero_name: heroName }),
      tiles: card.tiles,
      secondaryRows: card.secondaryRows,
      upgrades: card.upgrades,
      notes: heroNotes(a.abilityKey),
    };
  }
}

/*
 * ランク帯別のピック率・勝率・BAN率(deadlock-api.com 由来)。
 * 選択肢は 全ランク / 下位・中位・上位(src/lib/rankBands.ts)/ ランクtier ごと。部品は RankBandPicker。
 * ランク名はゲーム内のトークン Citadel_ranks_rank<N> をそのまま使う(tier1 が rank0 なので N は tier-1)。
 */
const rankTiers = Object.keys(heroStats.buckets)
  .filter((k) => /^\d+$/.test(k))
  .map(Number)
  .sort((a, b) => a - b);
const statsPayload = {
  fetchedAt: heroStats.fetchedAt,
  lowSampleMatches: heroStats.lowSampleMatches,
  // 注記の文は data/hero-stats.json(日本語)。日本語以外ではその言語の辞書の文に差し替える
  banRateNote: isJa ? heroStats.banRateNote : T.heroes.banRateNote,
  buckets: heroStats.buckets,
};
/** クライアント側の文言 */
const H = {
  related: T.common.related,
  /** 絞り込み件数の表示で「件」を「人」に言い換える */
  countFrom: T.heroes.countFrom,
  countTo: T.heroes.countTo,
};
const H2 = {
  empty: T.heroes.tierEmpty,
  // 集計期間(「〜のアップデート以降」)はビルド時に埋める。{n} と {date} はランク帯を切り替えるたびに JS が埋める
  note: T.heroes.statsNote.replace("{period}", statsPeriodLabel(heroStats)),
  ban: T.heroes.banNote,
  low: T.heroes.lowSample,
  titleSep: T.common.titleSep,
  /** BAN率の注記。日本語は data/hero-stats.json の文をそのまま使う */
  banRateNote: isJa ? null : T.heroes.banRateNote,
};
---

<Base title={T.heroes.title} description={T.heroes.description}>
  <h1>{T.nav.heroes}</h1>

  {/* ------------ 最上部: ランク帯別の使用状況(実際の対戦記録)。統計ファイルが無いビルドでは出さない ------------ */}
  {hasHeroStats && (
  <section class="hs panel">
    <div class="hs-head">
      <h2>{T.heroes.usage}</h2>
      <RankBandPicker tiers={rankTiers} />
    </div>
    <div class="hs-cols">
      {
        [
          { key: "pick", label: T.heroes.pickRate, cssVar: "weapon" },
          { key: "win", label: T.heroes.winRate, cssVar: "vitality" },
          { key: "ban", label: T.heroes.banRate, cssVar: "spirit" },
        ].map((c) => (
          <div class="hs-col" data-metric={c.key} style={`--cat: var(--c-${c.cssVar})`}>
            <h3>{c.label}</h3>
            <ol class="hs-list"></ol>
          </div>
        ))
      }
    </div>
    <p class="hs-note" id="hs-note"></p>
  </section>
  )}

  {/* ------------ 上部: 項目別ステータスランク ------------ */}
  <section class="tt panel">
    <div class="tt-head">
      <h2>{T.heroes.statusRank}</h2>
      <label class="metricpick">
        <span class="mplabel">{T.heroes.metric}</span>
        <select id="metric">
          {
            [...new Set(tier.metrics.map((m) => m.group))].map((g) => (
              <optgroup label={g}>
                {tier.metrics
                  .filter((m) => m.group === g)
                  .map((m) => (
                    <option value={m.key}>{m.label}</option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </label>
    </div>
    <div class="tt-body" id="ttbody"></div>
  </section>

  {/* ------------ 下部: 一覧 ------------ */}
  <h2 class="listh">{T.heroes.list}</h2>

  {/*
    スキル効果での絞り込み。検索辞書(言い換え・関連語)は /items/・ビルドページと共用の
    public/js/item-search.js。基本の説明文に加えて、AP強化で付く効果(t1〜t3_desc)も探す。
  */}
  <div class="herosearch">
    <input
      type="search"
      id="heroq"
      placeholder={T.heroes.searchPlaceholder}
      autocomplete="off"
      aria-label={T.heroes.searchAria}
    />
    {/* 効果(状態異常など)での絞り込み。?effect=<id> でも指定できる。判定は src/lib/effects.ts(状態異常・効果ページと共通) */}
    <label class="effpick">
      <span>{T.heroes.effectFilter}</span>
      <select id="heroeffect">
        <option value="">{T.heroes.effectAll}</option>
        {effectGroups.map((g) => (
          <optgroup label={g.label}>
            {g.options.map((o) => <option value={o.id}>{o.name}</option>)}
          </optgroup>
        ))}
      </select>
    </label>
    <a class="effectslink" href={`${base}${langPath("/mechanics/effects/")}`}>{T.heroes.effectsLink} →</a>
    <span class="herohits" id="herohits"></span>
    <span class="herolegend" id="herolegend" hidden>
      <i class="lg lg-base"></i>{T.heroes.legendBase}
      <i class="lg lg-up"></i>{T.heroes.legendUp}
      <i class="lg lg-rel"></i>{T.common.related}
    </span>
  </div>

  <ul class="grid" id="herogrid">
    {
      heroes.map(({ hero: h, name, findName, role, skills, topStats }) => (
        <li data-find={`${findName} ${role} ${h.key}`} data-hero={h.id}>
          <a href={`${linkBase}/heroes/${h.id}/`} data-herocard={h.id}>
            <span class="head">
              <HeroPortrait name={name} image={h.images.iconSmall} size={44} />
              <span class="who">
                <span class="name">{name}{marks?.heroes.has(h.key) && (
                  <span class="chg" data-kind={marks.heroes.get(h.key)} title={markTitle}>{ADJUSTMENT_LABEL[marks.heroes.get(h.key)!]}</span>
                )}</span>
                <span class="role">{role}</span>
              </span>
            </span>
            <span class="skills">
              {skills.map((s) => {
                const d = abilityDetails[s.key];
                // AP強化の各段: [AP, その段の説明文]。説明文が無い段(数値だけの段)は探さない
                const ups = (d?.upgrades ?? [])
                  .filter((u) => u.description)
                  .map((u) => [u.ap, u.description]);
                return (
                  <span
                    class="skillicon"
                    data-abilitycard={s.key}
                    data-find={`${t(s.key, s.key)} ${d?.desc ?? ""}`}
                    data-up={JSON.stringify(ups)}
                  >
                    <AbilityIcon
                      name={t(s.key, s.key)}
                      image={s.ab?.image ?? null}
                      size={30}
                      cssVar={s.ab?.kind === "Ultimate" ? "spirit" : "accent"}
                    />
                    {/* AP強化で付く効果で当たったときに、何APの段かを出す */}
                    <span class="upmark" hidden></span>
                  </span>
                );
              })}
            </span>
            <span class="stats">
              {topStats.map((r) => (
                <span class="top"><b>{r.value}</b> {r.label}</span>
              ))}
              <span class="cx">{`${term("complexity")} ${"●".repeat(cx(h.complexity))}`}<span class="dim">{"●".repeat(3 - cx(h.complexity))}</span></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* アイコンの供給元(ホバーカードのヘッダー用)。表示はせず、クローン元としてだけ使う */}
  <div class="hcicon-src-wrap" aria-hidden="true">
    {
      Object.entries(abilityDetails).map(([key, d]) => (
        <span class="hcicon-src" data-ability={key}>
          <AbilityIcon name={d.name} image={ability(key)?.image ?? null} size={44} cssVar={d.isUlt ? "spirit" : "accent"} />
        </span>
      ))
    }
  </div>

  {/* ホバー詳細カード(トップページと共通コンポーネント + スキルアイコン用) */}
  <HeroHoverCard heroDetail={heroDetail} />
  <AbilityHoverCard details={abilityDetails} />

  <script src={`${base}/js/${isJa ? "item-search.js" : "item-search-intl.js"}`} is:inline data-summary={isJa ? undefined : JSON.stringify(T.search)}></script>
  <script is:inline define:vars={{ H, EFF: effectHeroes }}>
    // 一覧の絞り込み。ヒーロー名・ロール・スキル名・スキル説明・AP強化の説明のどれかで当たったヒーローを残し、
    // 当たったスキルのアイコンを強調する(基本の効果=実線、AP強化で付く効果=点線+AP表示)。
    (() => {
      const S = window.itemSearch;
      const q = document.getElementById("heroq");
      const hits = document.getElementById("herohits");
      const legend = document.getElementById("herolegend");
      const rows = [...document.querySelectorAll("#herogrid > li")].map((li) => {
        const skills = [...li.querySelectorAll(".skillicon")].map((el) => ({
          el,
          mark: el.querySelector(".upmark"),
          base: S.prepare(el.dataset.find),
          ups: JSON.parse(el.dataset.up || "[]").map(([ap, text]) => [ap, S.prepare(text)]),
        }));
        // ヒーロー単位の判定用。複数語が別々のスキルに分かれて当たる場合も拾えるよう全部つなげる
        const all = [S.prepare(li.dataset.find), ...skills.flatMap((s) => [s.base, ...s.ups.map((u) => u[1])])].join(" ");
        return { li, skills, all };
      });
      const total = rows.length;

      // 効果での絞り込み(?effect=<id>)。EFF は 効果 id → ヒーローID → [[スキルの実ID, AP強化なら1], …]
      const eff = document.getElementById("heroeffect");
      const fromUrl = new URLSearchParams(location.search).get("effect");
      if (fromUrl && EFF[fromUrl]) eff.value = fromUrl;

      function apply() {
        const cq = S.compile(q.value);
        const em = eff.value ? EFF[eff.value] : null;
        let direct = 0;
        let related = 0;
        let shown = 0;
        const labels = new Set();
        for (const { li, skills, all } of rows) {
          const effKeys = em ? em[li.dataset.hero] : null;
          const m = em && !effKeys ? null : cq ? S.match(cq, all) : [];
          li.hidden = m === null;
          for (const s of skills) {
            s.el.classList.remove("hit", "hitup", "rel", "miss");
            s.mark.hidden = true;
          }
          if (m === null) continue;
          shown++;
          // 効果で絞っているときは、その効果を持つスキルを強調する(AP強化で付くものは点線 + AP)
          if (effKeys && !cq) {
            for (const s of skills) {
              const hit = effKeys.find(([k]) => k === s.el.dataset.abilitycard);
              if (!hit) s.el.classList.add("miss");
              else if (hit[1]) {
                s.el.classList.add("hitup");
                s.mark.textContent = "AP";
                s.mark.hidden = false;
              } else s.el.classList.add("hit");
            }
            continue;
          }
          if (m.length > 0) {
            related++;
            m.forEach((l) => labels.add(l));
          } else {
            direct++;
          }
          if (!cq) continue;
          let any = false;
          for (const s of skills) {
            // 基本の説明 → AP強化の段(安い順)の順に見る。検索語そのもの(直接)で当たる段を
            // 関連語で当たる段より優先する(基本が関連、AP5で直接、なら AP5 を採る)
            const cands = [[null, s.base], ...s.ups.map(([a, text]) => [a, `${s.base} ${text}`])]
              .map(([a, text]) => [a, S.match(cq, text)])
              .filter(([, m]) => m !== null);
            const pick = cands.find(([, m]) => m.length === 0) ?? cands[0];
            if (!pick) continue;
            const [ap, sm] = pick;
            any = true;
            // 関連語(デバフ対策など)だけで当たったスキルは、検索語そのものの効果と見分ける
            if (sm.length > 0) {
              s.el.classList.add("rel");
              s.mark.textContent = H.related;
              s.mark.hidden = false;
            } else if (ap !== null) {
              s.el.classList.add("hitup");
              s.mark.textContent = `AP${ap}`;
              s.mark.hidden = false;
            } else {
              s.el.classList.add("hit");
            }
          }
          // ヒーロー名だけで当たったときは、スキルを薄くしない
          if (any) for (const s of skills) if (!s.el.matches(".hit, .hitup, .rel")) s.el.classList.add("miss");
        }
        hits.textContent = cq
          ? S.summary(direct, related, labels, total).split(H.countFrom).join(H.countTo)
          : em
            ? `${shown} / ${total}${H.countTo}`
            : "";
        legend.hidden = !cq && !em;
        document.getElementById("herogrid").classList.toggle("searching", !!cq || !!em);
      }

      q.addEventListener("input", apply);
      eff.addEventListener("change", () => {
        // 絞り込みを URL に残す(共有・再読み込みで同じ表示になるように)
        const u = new URL(location.href);
        if (eff.value) u.searchParams.set("effect", eff.value);
        else u.searchParams.delete("effect");
        history.replaceState(null, "", u);
        apply();
      });
      apply();
    })();
  </script>

  <script is:inline define:vars={{ heroMeta, tierData: tier.data, base: linkBase, statsPayload, H2 }}>
    (() => {
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

      // ---- ティア表の描画 ----
      const LETTER = ["", "D", "C", "B", "A", "S"];
      const ttbody = document.getElementById("ttbody");
      const sel = document.getElementById("metric");
      function render(key) {
        const list = tierData[key] ?? [];
        const bucket = { 5: [], 4: [], 3: [], 2: [], 1: [] };
        for (const r of list) (bucket[r.tier] ?? bucket[1]).push(r);
        ttbody.innerHTML = [5, 4, 3, 2, 1]
          .map((tn) => {
            const L = LETTER[tn];
            const icons = bucket[tn]
              .map((r) => {
                const m = heroMeta[r.id] ?? { name: "?", sm: null };
                const img = m.sm
                  ? `<img src="${m.sm}" alt="" loading="lazy">`
                  : `<span class="ph">${esc(m.name.slice(0, 1))}</span>`;
                return (
                  `<a class="tt-hero" data-herocard="${r.id}" href="${base}/heroes/${r.id}/" ` +
                  `title="${esc(m.name)}${esc(H2.titleSep)}${esc(r.value)}">${img}</a>`
                );
              })
              .join("");
            return (
              `<div class="tt-row tier-${L}"><span class="tt-rank">${L}</span>` +
              `<div class="tt-icons">${icons || `<span class="tt-empty">${esc(H2.empty)}</span>`}</div></div>`
            );
          })
          .join("");
        // 差し込んだアイコンにホバーカードを張り直す
        window.heroHoverCard?.wire(ttbody);
      }
      sel.addEventListener("change", () => render(sel.value));
      render(sel.value);

      // ---- ランク帯別の使用状況(ピック率 / 勝率 / BAN率) ----
      const hsNote = document.getElementById("hs-note");
      /** 指標ごとの、値の取り出し位置。[ピック率, 勝率, BAN率, 試合数] */
      const METRIC_IDX = { pick: 0, win: 1, ban: 2 };
      const TOP_N = 5;

      function renderRank(key) {
        const bucket = statsPayload.buckets[key];
        // 統計が無いビルドでは使用状況のセクション自体が無い
        if (!bucket || !hsNote) return;
        const low = bucket.matches < statsPayload.lowSampleMatches;

        for (const col of document.querySelectorAll(".hs-col")) {
          const idx = METRIC_IDX[col.dataset.metric];
          const rows = Object.entries(bucket.heroes)
            // BAN率はデータが無いランク帯もある(null)ので外す
            .filter(([, v]) => v[idx] !== null && v[idx] !== undefined)
            .sort((a, b) => b[1][idx] - a[1][idx])
            .slice(0, TOP_N);
          col.querySelector(".hs-list").innerHTML = rows
            .map(([id, v]) => {
              const m = heroMeta[id] ?? { name: "?", sm: null };
              const img = m.sm
                ? `<img src="${m.sm}" alt="" loading="lazy">`
                : `<span class="ph">${esc(m.name.slice(0, 1))}</span>`;
              return (
                `<li><a class="hs-hero" data-herocard="${id}" href="${base}/heroes/${id}/">` +
                `${img}<span class="hs-name">${esc(m.name)}</span>` +
                `<span class="hs-val">${(v[idx] / 10).toFixed(1)}%</span></a></li>`
              );
            })
            .join("");
        }
        // innerHTML で差し込んだので、ホバーカードを張り直す
        window.heroHoverCard?.wire(document.querySelector(".hs-cols"));

        const d = new Date(statsPayload.fetchedAt);
        const stamp = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        hsNote.textContent =
          H2.note.replace("{n}", bucket.matches.toLocaleString("en-US")).replace("{date}", stamp) +
          H2.ban.replace("{note}", H2.banRateNote ?? statsPayload.banRateNote) +
          (low ? H2.low : "");
        hsNote.classList.toggle("low", low);
      }

      // 切り替えは RankBandPicker が "rankband" イベントで知らせる(覚えている値があれば読み込み後にも来る)。
      // このページは tier ごとにも選べるので、帯に直す前の key を使う。データが無い値なら帯に直す
      document.addEventListener("rankband", (e) =>
        renderRank(statsPayload.buckets[e.detail.key] ? e.detail.key : e.detail.band),
      );
      renderRank("all");
    })();
  </script>

