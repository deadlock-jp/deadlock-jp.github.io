---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import AbilityIcon from "../../components/AbilityIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import HeroHoverCard from "../../components/HeroHoverCard.astro";
import { releasedHeroes, t, ability, heroTags } from "../../lib/data.ts";
import { resolveImagePath } from "../../parsers/image-manifest.ts";
import { heroRanks, pickRows, heroTierTable } from "../../lib/herorank.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ranks = heroRanks();
const tier = heroTierTable();
const BOON_LABEL: Record<string, string> = { hp: "HP成長", weapon: "武器成長", spirit: "スピリット成長" };

/** トップページと同じホバーカードのデータ + 正方形アイコンのURL */
const heroMeta: Record<number, { name: string; sm: string | null }> = {};
const heroDetail: Record<number, unknown> = {};
for (const h of releasedHeroes()) {
  const name = t(h.nameToken, h.key);
  const key = h.key.replace(/^hero_/, "");
  const gloatRel = `images/heroes/gloat/${key}.webp`;
  const smResolved = resolveImagePath(h.images.iconSmall);
  const smRel = smResolved ? smResolved.outPath.replace(/^public\//, "") : null;
  const r = ranks[h.id];
  heroMeta[h.id] = {
    name,
    sm: smRel && existsSync(join(process.cwd(), "public", smRel)) ? `${base}/${smRel}` : null,
  };
  heroDetail[h.id] = {
    name,
    gloat: existsSync(join(process.cwd(), "public", gloatRel)) ? `${base}/${gloatRel}` : null,
    tags: heroTags(h),
    weapon: pickRows(r.weapon, ["dps", "bullet", "clip", "range"]),
    vitality: pickRows(r.vitality, ["hp", "regen", "move", "stam"]),
    spirit: pickRows(r.growth, ["gspower"]).concat(pickRows(r.spirit, ["skillscale"])),
    boon: r.boonAccent.map((a) => BOON_LABEL[a]),
  };
}

// 下部の一覧(従来のカード)
const heroes = releasedHeroes().map((h) => ({
  hero: h,
  name: t(h.nameToken, h.key),
  role: t(h.roleToken, ""),
  skills: h.abilities
    .filter((a) => a.slot.startsWith("Signature"))
    .sort((a, b) => a.slot.localeCompare(b.slot))
    .map((a) => ({ key: a.abilityKey, ab: ability(a.abilityKey) })),
}));
const cx = (n: number) => Math.max(0, Math.min(3, n));
---

<Base
  title="ヒーロー一覧"
  description="Deadlock（デッドロック）の実装済みヒーロー全員の基礎ステータス（最大HP・移動速度・スタミナ）とスキル、項目別ティア表を日本語で。レベル1・アイテムなしの素の数値。"
>
  <h1>ヒーロー</h1>

  {/* ------------ 上部: 項目別ティア表 ------------ */}
  <section class="tt">
    <div class="tt-head">
      <h2>ティア表</h2>
      <label>
        項目
        <select id="metric">
          {
            [...new Set(tier.metrics.map((m) => m.group))].map((g) => (
              <optgroup label={g}>
                {tier.metrics
                  .filter((m) => m.group === g)
                  .map((m) => (
                    <option value={m.key}>{m.label}</option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </label>
    </div>
    <div class="tt-body" id="ttbody"></div>
  </section>

  {/* ------------ 下部: 一覧 ------------ */}
  <h2 class="listh">一覧</h2>

  <ul class="grid">
    {
      heroes.map(({ hero: h, name, role, skills }) => (
        <li>
          <a href={`${base}/heroes/${h.id}/`} data-herocard={h.id}>
            <span class="head">
              <HeroPortrait name={name} image={h.images.iconSmall} size={44} />
              <span class="who">
                <span class="name">{name}</span>
                <span class="role">{role}</span>
              </span>
            </span>
            <span class="skills">
              {skills.map((s) => (
                <AbilityIcon
                  name={t(s.key, s.key)}
                  image={s.ab?.image ?? null}
                  size={30}
                  cssVar={s.ab?.kind === "Ultimate" ? "spirit" : "accent"}
                />
              ))}
            </span>
            <span class="stats">
              <span><b>{h.startingStats.EMaxHealth}</b> HP</span>
              <span><b>{h.startingStats.EMaxMoveSpeed}</b> 速度</span>
              <span class="cx">複雑さ {"●".repeat(cx(h.complexity))}<span class="dim">{"●".repeat(3 - cx(h.complexity))}</span></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* ホバー詳細カード(トップページと共通コンポーネント) */}
  <HeroHoverCard heroDetail={heroDetail} />

  <script is:inline define:vars={{ heroMeta, tierData: tier.data, base }}>
    (() => {
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

      // ---- ティア表の描画 ----
      const LETTER = ["", "D", "C", "B", "A", "S"];
      const ttbody = document.getElementById("ttbody");
      const sel = document.getElementById("metric");
      function render(key) {
        const list = tierData[key] ?? [];
        const bucket = { 5: [], 4: [], 3: [], 2: [], 1: [] };
        for (const r of list) (bucket[r.tier] ?? bucket[1]).push(r);
        ttbody.innerHTML = [5, 4, 3, 2, 1]
          .map((tn) => {
            const L = LETTER[tn];
            const icons = bucket[tn]
              .map((r) => {
                const m = heroMeta[r.id] ?? { name: "?", sm: null };
                const img = m.sm
                  ? `<img src="${m.sm}" alt="" loading="lazy">`
                  : `<span class="ph">${esc(m.name.slice(0, 1))}</span>`;
                return (
                  `<a class="tt-hero" data-herocard="${r.id}" href="${base}/heroes/${r.id}/" ` +
                  `title="${esc(m.name)}｜${esc(r.value)}">${img}</a>`
                );
              })
              .join("");
            return (
              `<div class="tt-row tier-${L}"><span class="tt-rank">${L}</span>` +
              `<div class="tt-icons">${icons || '<span class="tt-empty">該当なし</span>'}</div></div>`
            );
          })
          .join("");
        // 差し込んだアイコンにホバーカードを張り直す
        window.heroHoverCard?.wire(ttbody);
      }
      sel.addEventListener("change", () => render(sel.value));
      render(sel.value);
    })();
  </script>

  <style>
    .lead { color: var(--c-text-muted); margin-bottom: var(--sp-5); }

    /* ---- ティア表 ---- */
    .tt {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      padding: var(--sp-4);
      margin-bottom: var(--sp-6);
    }
    .tt-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--sp-3);
      margin-bottom: var(--sp-3);
    }
    .tt-head h2 { margin: 0; border: none; padding: 0; }
    .tt-head label { font-size: 13px; color: var(--c-text-muted); display: flex; align-items: center; gap: var(--sp-2); }
    .tt-head select {
      background: var(--c-surface-2); color: var(--c-text);
      border: 1px solid var(--c-border-strong); border-radius: var(--radius);
      padding: 5px 8px; font: inherit; font-size: 13px;
    }
    .tt-body { display: grid; gap: 4px; }
    /* tt-body の中身は JS で innerHTML 挿入するので、以下はすべて :global で当てる */
    .tt-body :global(.tt-row) {
      --tier: var(--c-text-muted);
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      gap: var(--sp-3);
      align-items: center;
      background: color-mix(in srgb, var(--tier) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--tier) 35%, transparent);
      border-left: 3px solid var(--tier);
      border-radius: var(--radius);
      padding: 5px var(--sp-2);
      min-height: 46px;
    }
    /* S=レジェンダリー(金) A=エピック(紫) B=レア(青) C=アンコモン(緑) D=コモン(白) */
    .tt-body :global(.tier-S) { --tier: #e8b93a; }
    .tt-body :global(.tier-A) { --tier: #a970d6; }
    .tt-body :global(.tier-B) { --tier: #4f9fd8; }
    .tt-body :global(.tier-C) { --tier: #6bbf59; }
    .tt-body :global(.tier-D) { --tier: #b9bcc0; }
    .tt-body :global(.tt-rank) {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 18px;
      text-align: center;
      color: var(--tier);
    }
    .tt-body :global(.tt-icons) { display: flex; flex-wrap: wrap; gap: 4px; }
    .tt-body :global(.tt-empty) { font-size: 12px; color: var(--c-text-faint); }
    .tt-body :global(.tt-hero) {
      display: block;
      width: 34px;
      height: 34px;
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--tier) 50%, var(--c-border));
      background: var(--c-surface-2);
      line-height: 0;
    }
    .tt-body :global(.tt-hero:hover) {
      border-color: var(--tier);
      filter: brightness(1.15);
    }
    .tt-body :global(.tt-hero img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tt-body :global(.tt-hero .ph) {
      display: flex; align-items: center; justify-content: center;
      width: 100%; height: 100%; font-size: 13px; font-weight: 700; color: var(--c-accent);
    }

    .listh { border: none; }

    /* ---- 下部の一覧(従来) ---- */
    .grid {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--sp-3);
    }
    .grid a {
      display: flex; flex-direction: column; padding: var(--sp-4);
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-left: 3px solid var(--c-accent-dim); border-radius: var(--radius);
      color: inherit; height: 100%;
    }
    .grid a:hover {
      background: var(--c-surface-2); border-color: var(--c-border-strong);
      border-left-color: var(--c-accent); text-decoration: none;
    }
    .head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); }
    .who { min-width: 0; }
    .name { display: block; font-size: 16px; font-weight: 600; color: var(--c-text-strong); }
    .role { display: block; font-size: 12px; color: var(--c-text-muted); }
    .stats {
      margin-top: auto; display: flex; flex-wrap: wrap; gap: var(--sp-3);
      font-size: 12px; color: var(--c-text-muted);
      border-top: 1px solid var(--c-border); padding-top: var(--sp-2);
    }
    .stats b { font-family: var(--font-mono); font-weight: 500; color: var(--c-text); }
    .cx { color: var(--c-accent); letter-spacing: 1px; }
    .cx .dim { color: var(--c-text-faint); }
    .skills { display: flex; gap: 4px; margin-bottom: var(--sp-3); }
  </style>
</Base>
