---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import AbilityIcon from "../../components/AbilityIcon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import HeroHoverCard from "../../components/HeroHoverCard.astro";
import AbilityHoverCard, { type AbilityHoverDetail } from "../../components/AbilityHoverCard.astro";
import { releasedHeroes, t, ability, heroTags, describe, heroNotes, heroStats } from "../../lib/data.ts";
import { resolveImagePath } from "../../parsers/image-manifest.ts";
import { heroRanks, pickRows, topRankRows, heroTierTable } from "../../lib/herorank.ts";
import { skillCard } from "../../lib/skillcard.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ranks = heroRanks();
const tier = heroTierTable();
const BOON_LABEL: Record<string, string> = { hp: "HP成長", weapon: "武器成長", spirit: "スピリット成長" };

/** トップページと同じホバーカードのデータ + 正方形アイコンのURL */
const heroMeta: Record<number, { name: string; sm: string | null }> = {};
const heroDetail: Record<number, unknown> = {};
for (const h of releasedHeroes()) {
  const name = t(h.nameToken, h.key);
  const key = h.key.replace(/^hero_/, "");
  const gloatRel = `images/heroes/gloat/${key}.webp`;
  const smResolved = resolveImagePath(h.images.iconSmall);
  const smRel = smResolved ? smResolved.outPath.replace(/^public\//, "") : null;
  const r = ranks[h.id];
  heroMeta[h.id] = {
    name,
    sm: smRel && existsSync(join(process.cwd(), "public", smRel)) ? `${base}/${smRel}` : null,
  };
  heroDetail[h.id] = {
    name,
    gloat: existsSync(join(process.cwd(), "public", gloatRel)) ? `${base}/${gloatRel}` : null,
    tags: heroTags(h),
    weapon: pickRows(r.weapon, ["dps", "bullet", "clip", "range"]),
    vitality: pickRows(r.vitality, ["hp", "regen", "move", "stam"]),
    spirit: pickRows(r.growth, ["gspower"]).concat(pickRows(r.spirit, ["skillscale"])),
    boon: r.boonAccent.map((a) => BOON_LABEL[a]),
  };
}

// 下部の一覧(従来のカード)。統計は固定のHP/速度ではなく、このヒーローが
// 実際に上位に入っている項目を2つ選ぶ(heroRanksの百分位順)
const heroes = releasedHeroes().map((h) => ({
  hero: h,
  name: t(h.nameToken, h.key),
  role: t(h.roleToken, ""),
  topStats: topRankRows(ranks[h.id], 2),
  skills: h.abilities
    .filter((a) => a.slot.startsWith("Signature"))
    .sort((a, b) => a.slot.localeCompare(b.slot))
    .map((a) => ({ key: a.abilityKey, ab: ability(a.abilityKey) })),
}));
const cx = (n: number) => Math.max(0, Math.min(3, n));

/**
 * 一覧カードのスキルアイコンにホバーで出す詳細カードのデータ。
 * 中身はヒーロー詳細ページの SkillCard.astro(スキルカードUI改善)と同じ
 * skillCard()/describe() の結果を使う。
 */
const abilityDetails: Record<string, AbilityHoverDetail> = {};
for (const h of releasedHeroes()) {
  const heroName = t(h.nameToken, h.key);
  for (const a of h.abilities) {
    if (!a.slot.startsWith("Signature") || abilityDetails[a.abilityKey]) continue;
    const ab = ability(a.abilityKey);
    if (!ab) continue;
    const card = skillCard(ab, heroName);
    abilityDetails[a.abilityKey] = {
      name: t(a.abilityKey, a.abilityKey),
      isUlt: ab.kind === "Ultimate",
      isPassive: ab.kind !== "Ultimate" && ab.activation === "PASSIVE",
      meta: card.meta,
      desc: describe(`${a.abilityKey}_desc`, ab.properties, "（説明なし）", { hero_name: heroName }),
      tiles: card.tiles,
      secondaryRows: card.secondaryRows,
      upgrades: card.upgrades,
      notes: heroNotes(a.abilityKey),
    };
  }
}

/*
 * ランク帯別のピック率・勝率・BAN率(deadlock-api.com 由来)。
 * ランク名はゲーム内のトークン Citadel_ranks_rank<N> をそのまま使う。
 * tier1 が rank0(オブスキュラス)なので、トークン番号は tier-1。
 */
const rankBuckets = Object.keys(heroStats.buckets)
  .filter((k) => k !== "all")
  .map(Number)
  .sort((a, b) => a - b);
const rankOptions = [
  { key: "all", label: "全ランク" },
  ...rankBuckets.map((tier) => ({
    key: String(tier),
    label: t(`Citadel_ranks_rank${tier - 1}`, `ランク${tier}`),
  })),
];
const statsPayload = {
  fetchedAt: heroStats.fetchedAt,
  lowSampleMatches: heroStats.lowSampleMatches,
  banRateNote: heroStats.banRateNote,
  buckets: heroStats.buckets,
};
---

<Base
  title="ヒーロー一覧"
  description="Deadlock（デッドロック）の実装済みヒーロー全員の基礎ステータス（最大HP・移動速度・スタミナ）とスキル、項目別ステータスランクを日本語で。レベル1・アイテムなしの素の数値。"
>
  <h1>ヒーロー</h1>

  {/* ------------ 最上部: ランク帯別の使用状況(実際の対戦記録) ------------ */}
  <section class="hs panel">
    <div class="hs-head">
      <h2>使用状況</h2>
      <label class="rankpick">
        <span class="rplabel">ランク帯</span>
        <select id="rank">
          {rankOptions.map((r) => <option value={r.key}>{r.label}</option>)}
        </select>
      </label>
    </div>
    <div class="hs-cols">
      {
        [
          { key: "pick", label: "ピック率", cssVar: "weapon" },
          { key: "win", label: "勝率", cssVar: "vitality" },
          { key: "ban", label: "BAN率", cssVar: "spirit" },
        ].map((c) => (
          <div class="hs-col" data-metric={c.key} style={`--cat: var(--c-${c.cssVar})`}>
            <h3>{c.label}</h3>
            <ol class="hs-list"></ol>
          </div>
        ))
      }
    </div>
    <p class="hs-note" id="hs-note"></p>
  </section>

  {/* ------------ 上部: 項目別ステータスランク ------------ */}
  <section class="tt panel">
    <div class="tt-head">
      <h2>ステータスランク</h2>
      <label class="metricpick">
        <span class="mplabel">項目</span>
        <select id="metric">
          {
            [...new Set(tier.metrics.map((m) => m.group))].map((g) => (
              <optgroup label={g}>
                {tier.metrics
                  .filter((m) => m.group === g)
                  .map((m) => (
                    <option value={m.key}>{m.label}</option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </label>
    </div>
    <div class="tt-body" id="ttbody"></div>
  </section>

  {/* ------------ 下部: 一覧 ------------ */}
  <h2 class="listh">一覧</h2>

  {/*
    スキル効果での絞り込み。検索辞書(言い換え・関連語)は /items/・ビルドページと共用の
    public/js/item-search.js。基本の説明文に加えて、AP強化で付く効果(t1〜t3_desc)も探す。
  */}
  <div class="herosearch">
    <input
      type="search"
      id="heroq"
      placeholder="ヒーロー名・スキルの効果で絞り込む(例: サイレンス)"
      autocomplete="off"
      aria-label="ヒーローの絞り込み"
    />
    <span class="herohits" id="herohits"></span>
    <span class="herolegend" id="herolegend" hidden>
      <i class="lg lg-base"></i>基本の効果
      <i class="lg lg-up"></i>AP強化で付く効果
      <i class="lg lg-rel"></i>関連
    </span>
  </div>

  <ul class="grid" id="herogrid">
    {
      heroes.map(({ hero: h, name, role, skills, topStats }) => (
        <li data-find={`${name} ${role} ${h.key}`}>
          <a href={`${base}/heroes/${h.id}/`} data-herocard={h.id}>
            <span class="head">
              <HeroPortrait name={name} image={h.images.iconSmall} size={44} />
              <span class="who">
                <span class="name">{name}</span>
                <span class="role">{role}</span>
              </span>
            </span>
            <span class="skills">
              {skills.map((s) => {
                const d = abilityDetails[s.key];
                // AP強化の各段: [AP, その段の説明文]。説明文が無い段(数値だけの段)は探さない
                const ups = (d?.upgrades ?? [])
                  .filter((u) => u.description)
                  .map((u) => [u.ap, u.description]);
                return (
                  <span
                    class="skillicon"
                    data-abilitycard={s.key}
                    data-find={`${t(s.key, s.key)} ${d?.desc ?? ""}`}
                    data-up={JSON.stringify(ups)}
                  >
                    <AbilityIcon
                      name={t(s.key, s.key)}
                      image={s.ab?.image ?? null}
                      size={30}
                      cssVar={s.ab?.kind === "Ultimate" ? "spirit" : "accent"}
                    />
                    {/* AP強化で付く効果で当たったときに、何APの段かを出す */}
                    <span class="upmark" hidden></span>
                  </span>
                );
              })}
            </span>
            <span class="stats">
              {topStats.map((r) => (
                <span class="top"><b>{r.value}</b> {r.label}</span>
              ))}
              <span class="cx">複雑さ {"●".repeat(cx(h.complexity))}<span class="dim">{"●".repeat(3 - cx(h.complexity))}</span></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* アイコンの供給元(ホバーカードのヘッダー用)。表示はせず、クローン元としてだけ使う */}
  <div class="hcicon-src-wrap" aria-hidden="true">
    {
      Object.entries(abilityDetails).map(([key, d]) => (
        <span class="hcicon-src" data-ability={key}>
          <AbilityIcon name={d.name} image={ability(key)?.image ?? null} size={44} cssVar={d.isUlt ? "spirit" : "accent"} />
        </span>
      ))
    }
  </div>

  {/* ホバー詳細カード(トップページと共通コンポーネント + スキルアイコン用) */}
  <HeroHoverCard heroDetail={heroDetail} />
  <AbilityHoverCard details={abilityDetails} />

  <script src={`${base}/js/item-search.js`} is:inline></script>
  <script is:inline>
    // 一覧の絞り込み。ヒーロー名・ロール・スキル名・スキル説明・AP強化の説明のどれかで当たったヒーローを残し、
    // 当たったスキルのアイコンを強調する(基本の効果=実線、AP強化で付く効果=点線+AP表示)。
    (() => {
      const S = window.itemSearch;
      const q = document.getElementById("heroq");
      const hits = document.getElementById("herohits");
      const legend = document.getElementById("herolegend");
      const rows = [...document.querySelectorAll("#herogrid > li")].map((li) => {
        const skills = [...li.querySelectorAll(".skillicon")].map((el) => ({
          el,
          mark: el.querySelector(".upmark"),
          base: S.prepare(el.dataset.find),
          ups: JSON.parse(el.dataset.up || "[]").map(([ap, text]) => [ap, S.prepare(text)]),
        }));
        // ヒーロー単位の判定用。複数語が別々のスキルに分かれて当たる場合も拾えるよう全部つなげる
        const all = [S.prepare(li.dataset.find), ...skills.flatMap((s) => [s.base, ...s.ups.map((u) => u[1])])].join(" ");
        return { li, skills, all };
      });
      const total = rows.length;

      function apply() {
        const cq = S.compile(q.value);
        let direct = 0;
        let related = 0;
        const labels = new Set();
        for (const { li, skills, all } of rows) {
          const m = cq ? S.match(cq, all) : [];
          li.hidden = m === null;
          for (const s of skills) {
            s.el.classList.remove("hit", "hitup", "rel", "miss");
            s.mark.hidden = true;
          }
          if (m === null) continue;
          if (m.length > 0) {
            related++;
            m.forEach((l) => labels.add(l));
          } else {
            direct++;
          }
          if (!cq) continue;
          let any = false;
          for (const s of skills) {
            // 基本の説明 → AP強化の段(安い順)の順に見る。検索語そのもの(直接)で当たる段を
            // 関連語で当たる段より優先する(基本が関連、AP5で直接、なら AP5 を採る)
            const cands = [[null, s.base], ...s.ups.map(([a, text]) => [a, `${s.base} ${text}`])]
              .map(([a, text]) => [a, S.match(cq, text)])
              .filter(([, m]) => m !== null);
            const pick = cands.find(([, m]) => m.length === 0) ?? cands[0];
            if (!pick) continue;
            const [ap, sm] = pick;
            any = true;
            // 関連語(デバフ対策など)だけで当たったスキルは、検索語そのものの効果と見分ける
            if (sm.length > 0) {
              s.el.classList.add("rel");
              s.mark.textContent = "関連";
              s.mark.hidden = false;
            } else if (ap !== null) {
              s.el.classList.add("hitup");
              s.mark.textContent = `AP${ap}`;
              s.mark.hidden = false;
            } else {
              s.el.classList.add("hit");
            }
          }
          // ヒーロー名だけで当たったときは、スキルを薄くしない
          if (any) for (const s of skills) if (!s.el.matches(".hit, .hitup, .rel")) s.el.classList.add("miss");
        }
        hits.textContent = cq ? S.summary(direct, related, labels, total).replace(/件/g, "人") : "";
        legend.hidden = !cq;
        document.getElementById("herogrid").classList.toggle("searching", !!cq);
      }

      q.addEventListener("input", apply);
      apply();
    })();
  </script>

  <script is:inline define:vars={{ heroMeta, tierData: tier.data, base, statsPayload }}>
    (() => {
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

      // ---- ティア表の描画 ----
      const LETTER = ["", "D", "C", "B", "A", "S"];
      const ttbody = document.getElementById("ttbody");
      const sel = document.getElementById("metric");
      function render(key) {
        const list = tierData[key] ?? [];
        const bucket = { 5: [], 4: [], 3: [], 2: [], 1: [] };
        for (const r of list) (bucket[r.tier] ?? bucket[1]).push(r);
        ttbody.innerHTML = [5, 4, 3, 2, 1]
          .map((tn) => {
            const L = LETTER[tn];
            const icons = bucket[tn]
              .map((r) => {
                const m = heroMeta[r.id] ?? { name: "?", sm: null };
                const img = m.sm
                  ? `<img src="${m.sm}" alt="" loading="lazy">`
                  : `<span class="ph">${esc(m.name.slice(0, 1))}</span>`;
                return (
                  `<a class="tt-hero" data-herocard="${r.id}" href="${base}/heroes/${r.id}/" ` +
                  `title="${esc(m.name)}｜${esc(r.value)}">${img}</a>`
                );
              })
              .join("");
            return (
              `<div class="tt-row tier-${L}"><span class="tt-rank">${L}</span>` +
              `<div class="tt-icons">${icons || '<span class="tt-empty">該当なし</span>'}</div></div>`
            );
          })
          .join("");
        // 差し込んだアイコンにホバーカードを張り直す
        window.heroHoverCard?.wire(ttbody);
      }
      sel.addEventListener("change", () => render(sel.value));
      render(sel.value);

      // ---- ランク帯別の使用状況(ピック率 / 勝率 / BAN率) ----
      const rankSel = document.getElementById("rank");
      const hsNote = document.getElementById("hs-note");
      /** 指標ごとの、値の取り出し位置。[ピック率, 勝率, BAN率, 試合数] */
      const METRIC_IDX = { pick: 0, win: 1, ban: 2 };
      const TOP_N = 5;

      function renderRank(key) {
        const bucket = statsPayload.buckets[key];
        if (!bucket) return;
        const low = bucket.matches < statsPayload.lowSampleMatches;

        for (const col of document.querySelectorAll(".hs-col")) {
          const idx = METRIC_IDX[col.dataset.metric];
          const rows = Object.entries(bucket.heroes)
            // BAN率はデータが無いランク帯もある(null)ので外す
            .filter(([, v]) => v[idx] !== null && v[idx] !== undefined)
            .sort((a, b) => b[1][idx] - a[1][idx])
            .slice(0, TOP_N);
          col.querySelector(".hs-list").innerHTML = rows
            .map(([id, v]) => {
              const m = heroMeta[id] ?? { name: "?", sm: null };
              const img = m.sm
                ? `<img src="${m.sm}" alt="" loading="lazy">`
                : `<span class="ph">${esc(m.name.slice(0, 1))}</span>`;
              return (
                `<li><a class="hs-hero" data-herocard="${id}" href="${base}/heroes/${id}/">` +
                `${img}<span class="hs-name">${esc(m.name)}</span>` +
                `<span class="hs-val">${(v[idx] / 10).toFixed(1)}%</span></a></li>`
              );
            })
            .join("");
        }
        // innerHTML で差し込んだので、ホバーカードを張り直す
        window.heroHoverCard?.wire(document.querySelector(".hs-cols"));

        const d = new Date(statsPayload.fetchedAt);
        const stamp = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        hsNote.textContent =
          `直近30日 / ${bucket.matches.toLocaleString("en-US")}試合 / ${stamp}時点。` +
          `BAN率は${statsPayload.banRateNote}。` +
          (low ? "　※このランク帯は母数が少なく、数値がぶれます。" : "");
        hsNote.classList.toggle("low", low);
      }

      rankSel.addEventListener("change", () => renderRank(rankSel.value));
      renderRank(rankSel.value);
    })();
  </script>

  <style>
    .lead { color: var(--c-text-muted); margin-bottom: var(--sp-5); }

    /* ---- ランク帯別の使用状況 ---- */
    .hs { margin-bottom: var(--sp-5); }
    .hs-head {
      display: flex; align-items: baseline; justify-content: space-between;
      flex-wrap: wrap; gap: var(--sp-3); margin-bottom: var(--sp-3);
    }
    .hs-head h2 { margin: 0; border: none; padding: 0; }
    .rankpick {
      display: flex; align-items: center; gap: var(--sp-2);
      background: var(--c-accent-bg); border: 1px solid var(--c-accent-dim);
      border-radius: var(--radius); padding: 5px 6px 5px 12px;
    }
    .rplabel { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--c-accent); }
    .rankpick select {
      background: var(--c-surface); color: var(--c-text-strong);
      border: 1px solid var(--c-accent-dim); border-radius: var(--radius);
      padding: 6px 10px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    }
    .rankpick select:hover { border-color: var(--c-accent); }

    .hs-cols {
      display: grid;
      /* 中身の増減で列幅が変わらないよう、列数は画面幅だけで決める */
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: var(--sp-3);
    }
    .hs-col { min-width: 0; }
    .hs-col h3 {
      font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--cat); margin: 0 0 var(--sp-2);
      border-bottom: 1px solid var(--cat); padding-bottom: 4px;
    }
    .hs-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 3px; }
    /*
     * 以下は JS が innerHTML で差し込む中身。スコープ付きCSSは効かないので
     * :global() で当てる(CLAUDE.md「Astro: scoped CSS は innerHTML に効かない」)。
     * 起点の .hs-list はサーバー側で出しているのでスコープが付く。
     */
    .hs-list :global(.hs-hero) {
      display: flex; align-items: center; gap: var(--sp-2);
      padding: 4px 6px; border-radius: var(--radius);
      background: var(--c-surface); border: 1px solid var(--c-border);
      color: var(--c-text); text-decoration: none; font-size: 13px;
    }
    .hs-list :global(.hs-hero:hover) {
      border-color: var(--cat); background: var(--c-surface-2); text-decoration: none;
    }
    .hs-list :global(.hs-hero img),
    .hs-list :global(.hs-hero .ph) {
      width: 28px; height: 28px; border-radius: 5px; flex: 0 0 auto;
      background: var(--c-surface-2); display: block;
    }
    .hs-list :global(.hs-hero .ph) {
      display: flex; align-items: center; justify-content: center;
      color: var(--cat); font-weight: 700; font-size: 12px;
    }
    .hs-list :global(.hs-hero .hs-name) {
      flex: 1 1 auto; min-width: 0; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap;
    }
    .hs-list :global(.hs-hero .hs-val) {
      flex: 0 0 auto; font-family: var(--font-mono); font-weight: 500; color: var(--cat);
    }
    .hs-note { margin: var(--sp-3) 0 0; font-size: 11px; color: var(--c-text-faint); line-height: 1.6; }
    .hs-note.low { color: var(--c-weapon); }

    /* ---- ティア表(見た目は global.css の .panel を流用) ---- */
    .tt {
      margin-bottom: var(--sp-6);
    }
    .tt-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--sp-3);
      margin-bottom: var(--sp-3);
    }
    .tt-head h2 { margin: 0; border: none; padding: 0; }
    /* 項目セレクトを強調(このカードが何のランキングを出しているかの主役なので目立たせる) */
    .metricpick {
      display: flex; align-items: center; gap: var(--sp-2);
      background: var(--c-accent-bg); border: 1px solid var(--c-accent-dim);
      border-radius: var(--radius); padding: 5px 6px 5px 12px;
    }
    .mplabel { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--c-accent); }
    .tt-head select {
      background: var(--c-surface); color: var(--c-text-strong);
      border: 1px solid var(--c-accent-dim); border-radius: var(--radius);
      padding: 6px 10px; font: inherit; font-size: 14px; font-weight: 600;
      cursor: pointer;
    }
    .tt-head select:hover { border-color: var(--c-accent); }
    .tt-body { display: grid; gap: 4px; }
    /* tt-body の中身は JS で innerHTML 挿入するので、以下はすべて :global で当てる */
    .tt-body :global(.tt-row) {
      --tier: var(--c-text-muted);
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      gap: var(--sp-3);
      align-items: center;
      background: color-mix(in srgb, var(--tier) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--tier) 35%, transparent);
      border-left: 3px solid var(--tier);
      border-radius: var(--radius);
      padding: 5px var(--sp-2);
      min-height: 46px;
    }
    /* S=レジェンダリー(金) A=エピック(紫) B=レア(青) C=アンコモン(緑) D=コモン(白) */
    .tt-body :global(.tier-S) { --tier: #e8b93a; }
    .tt-body :global(.tier-A) { --tier: #a970d6; }
    .tt-body :global(.tier-B) { --tier: #4f9fd8; }
    .tt-body :global(.tier-C) { --tier: #6bbf59; }
    .tt-body :global(.tier-D) { --tier: #b9bcc0; }
    .tt-body :global(.tt-rank) {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 18px;
      text-align: center;
      color: var(--tier);
    }
    .tt-body :global(.tt-icons) { display: flex; flex-wrap: wrap; gap: 4px; }
    .tt-body :global(.tt-empty) { font-size: 12px; color: var(--c-text-faint); }
    .tt-body :global(.tt-hero) {
      display: block;
      width: 34px;
      height: 34px;
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--tier) 50%, var(--c-border));
      background: var(--c-surface-2);
      line-height: 0;
    }
    .tt-body :global(.tt-hero:hover) {
      border-color: var(--tier);
      filter: brightness(1.15);
    }
    .tt-body :global(.tt-hero img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tt-body :global(.tt-hero .ph) {
      display: flex; align-items: center; justify-content: center;
      width: 100%; height: 100%; font-size: 13px; font-weight: 700; color: var(--c-accent);
    }

    .listh { border: none; }

    /* ---- 下部の一覧(従来) ---- */
    .grid {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--sp-3);
    }
    .grid a {
      display: flex; flex-direction: column; padding: var(--sp-4);
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-left: 3px solid var(--c-accent-dim); border-radius: var(--radius);
      color: inherit; height: 100%;
    }
    .grid a:hover {
      background: var(--c-surface-2); border-color: var(--c-border-strong);
      border-left-color: var(--c-accent); text-decoration: none;
    }
    .head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); }
    .who { min-width: 0; }
    .name { display: block; font-size: 16px; font-weight: 600; color: var(--c-text-strong); }
    .role { display: block; font-size: 12px; color: var(--c-text-muted); }
    .stats {
      margin-top: auto; display: flex; flex-wrap: wrap; gap: var(--sp-3);
      font-size: 12px; color: var(--c-text-muted);
      border-top: 1px solid var(--c-border); padding-top: var(--sp-2);
    }
    .stats b { font-family: var(--font-mono); font-weight: 500; color: var(--c-text); }
    /* 得意項目(topStats)の値だけ少し目立たせる。複雑さと区別するため */
    .stats .top b { color: var(--c-accent); font-weight: 700; }
    .cx { color: var(--c-accent); letter-spacing: 1px; }
    .cx .dim { color: var(--c-text-faint); }
    .skills { display: flex; gap: 4px; margin-bottom: var(--sp-3); }
    .skillicon { display: block; line-height: 0; position: relative; border-radius: 6px; }

    /* ---- 一覧の絞り込み ---- */
    .herosearch { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-2) var(--sp-4); margin-bottom: var(--sp-4); }
    .herosearch input {
      flex: 1 1 260px; max-width: 420px;
      background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius);
      color: var(--c-text); font: inherit; font-size: 13px; padding: 6px 10px;
    }
    .herosearch input:focus { outline: none; border-color: var(--c-accent); }
    .herohits { font-size: 12px; color: var(--c-text-muted); font-family: var(--font-mono); }
    .herolegend { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--c-text-muted); }
    .herolegend[hidden] { display: none; }
    .lg { display: inline-block; width: 12px; height: 12px; border-radius: 3px; }
    .herolegend .lg-up { margin-left: var(--sp-2); }
    .lg-base { outline: 2px solid var(--c-soul); }
    .lg-up { outline: 2px dashed var(--c-soul); }
    .grid > li[hidden] { display: none; }
    /* 検索中はアイコン下のAPバッジ分だけ余白を空ける */
    .grid.searching .skills { gap: 6px; margin-bottom: calc(var(--sp-3) + 10px); }
    /* 当たったスキル: 実線=基本の効果 / 点線=AP強化で付く効果。当たらなかったスキルは薄く */
    .skillicon.hit { outline: 2px solid var(--c-soul); outline-offset: 1px; }
    .skillicon.hitup { outline: 2px dashed var(--c-soul); outline-offset: 1px; }
    .skillicon.rel { outline: 2px dotted var(--c-text-muted); outline-offset: 1px; }
    .skillicon.rel .upmark { border-color: var(--c-border-strong); color: var(--c-text-muted); white-space: nowrap; }
    .lg-rel { outline: 2px dotted var(--c-text-muted); margin-left: var(--sp-2); }
    .skillicon.miss { opacity: 0.3; }
    .upmark {
      position: absolute; left: 50%; bottom: -13px; transform: translateX(-50%); white-space: nowrap;
      font-family: var(--font-mono); font-size: 9px; line-height: 1.2; padding: 0 3px;
      background: var(--c-bg); border: 1px solid var(--c-soul); border-radius: 3px; color: var(--c-soul);
    }
    .upmark[hidden] { display: none; }
    .hcicon-src-wrap { display: none; }
  </style>
</Base>
