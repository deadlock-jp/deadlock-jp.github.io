---
/**
 * スキル単体の詳細ページ。実IDをそのままパスに使う(ルール5)。
 * 対象は Signature / Ultimate のみ(全ヒーロー共通の移動アビリティ等は対象外)。
 * 変身でスキルが入れ替わるヒーロー(シルバー)は、両方の形態ぶんのスキルを対象にする。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import SkillCard from "../../components/SkillCard.astro";
import BalanceHistory from "../../components/BalanceHistory.astro";
import { releasedHeroes, t, ability, heroNotes } from "../../lib/data.ts";
import { skillCard } from "../../lib/skillcard.ts";
import { abilityBalanceHistory } from "../../lib/balance.ts";
import type { Hero } from "../../types/hero.ts";

interface Owner {
  hero: Hero;
  slot: string;
  /** シルバーの人狼形態のように、既定ではなく変身後のスロットで持つスキルか */
  isAlternate: boolean;
}

export function getStaticPaths() {
  // 実装済み全ヒーローの Signature/Ultimate スキルと、その持ち主を集める。
  // (buildOwnerMap を外に切り出すと、Astro の getStaticPaths 抽出時のバンドルで
  //  シンボルが欠落する問題があったため、この関数の中にそのまま置く)
  const owners = new Map<string, Owner>();
  for (const hero of releasedHeroes()) {
    for (const a of hero.abilities) {
      if (!a.slot.startsWith("Signature")) continue;
      if (!owners.has(a.abilityKey)) owners.set(a.abilityKey, { hero, slot: a.slot, isAlternate: false });
    }
    // 変身で入れ替わるスキル(今のところシルバーのみ。architecture.html参照)
    const transformAbility = hero.abilities
      .map((a) => ability(a.abilityKey))
      .find((ab): ab is NonNullable<typeof ab> => !!ab?.alternateFormAbilities);
    if (transformAbility) {
      for (const [slot, key] of Object.entries(transformAbility.alternateFormAbilities!)) {
        if (!slot.startsWith("Signature")) continue;
        if (!owners.has(key)) owners.set(key, { hero, slot, isAlternate: true });
      }
    }
  }
  return [...owners.entries()].map(([abilityKey, owner]) => ({
    params: { id: abilityKey },
    props: { abilityKey, owner },
  }));
}

const { abilityKey, owner } = Astro.props as { abilityKey: string; owner: Owner };
const ab = ability(abilityKey)!;
const hero = owner.hero;
const heroName = t(hero.nameToken, hero.key);
const name = t(abilityKey, abilityKey);
const card = skillCard(ab, heroName);
const notes = heroNotes(abilityKey);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const history = abilityBalanceHistory(abilityKey, base);

const metaDesc =
  `Deadlock（デッドロック）のスキル「${name}」（${heroName}）の効果・数値・` +
  `アップグレード・バランス調整を日本語で。`;

/*
 * プレビュー画像は持ち主のヒーロー画像(16:9)。スキルアイコン自体は137x137前後で、
 * Xがカードに要求する最低サイズ(小カードでも144x144)に届かないため使えない。
 */
const cardRel = `images/heroes/card16x9/${hero.key.replace(/^hero_/, "")}.webp`;
const ogImage = existsSync(join(process.cwd(), "public", cardRel)) ? `/${cardRel}` : undefined;
---

<Base
  title={`${name} - ${heroName}`}
  description={metaDesc}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImage ? 1200 : undefined}
  ogImageHeight={ogImage ? 675 : undefined}
  breadcrumbs={[
    { name: "ヒーロー", path: "/heroes/" },
    { name: heroName, path: `/heroes/${hero.id}/` },
    { name, path: `/abilities/${abilityKey}/` },
  ]}
>
  <a class="back" href={`${base}/heroes/${hero.id}/`}>← {heroName}</a>

  {owner.isAlternate && <p class="formnote">人狼形態(シルバー)のスキルです</p>}

  <SkillCard abilityKey={abilityKey} ab={ab} card={card} notes={notes} heroName={heroName} />

  <BalanceHistory entries={history} />

  <style>
    .back { font-size: 13px; }
    .formnote {
      margin: var(--sp-2) 0 0; font-size: 12px; color: var(--c-text-muted);
      border-left: 3px solid var(--c-spirit); padding-left: var(--sp-2);
    }
    h2 { margin-top: var(--sp-5); margin-bottom: var(--sp-2); }
  </style>
</Base>
