---
/**
 * SNS用のバランス調整カード生成(運用者向けの非公開ページ)。
 *
 * data/updates.json の調整内容から、ヒーロー1体につき1枚、アイテムはまとめて数枚の
 * 1200x675 PNG を作る。以前は機械翻訳とExcelで手作りしていたものを、
 * サイトが既に持っているデータで置き換えるのが目的。
 *
 * 描画はビルドページの「画像を保存」と同じ Canvas 2D・同じ配色で、見た目を揃える。
 * ナビにもサイトマップにも載せず、noindex にしている(公開する意味が無いため)。
 * 中身は公開データだけなので、URLを知られても実害は無い。
 */
import Base from "../../../layouts/Base.astro";
import { balanceUpdates } from "../../../lib/balance.ts";
import { resolveImagePath } from "../../../parsers/image-manifest.ts";
import { releasedHeroes, t } from "../../../lib/data.ts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * カードに載せない行かどうか。
 *
 * 値0で新規追加されたプロパティ(ホリデイのクラックショットの「弾薬耐性 0%」など)は、
 * 実際の効果はT2強化側に乗っていて、基礎値としては何も起きていない。
 * 詳細ページでは事実として出すが、SNSカードでは読み手を迷わせるだけなので省く。
 */
const isZeroAddition = (from: string | null, to: string | null): boolean =>
  from === null && to !== null && /^0(\D|$)/.test(to);

/** file://{images}/... を public/ の実ファイルに解決する。無ければ null */
function pub(ref: string | null): string | null {
  if (!ref) return null;
  const r = resolveImagePath(ref);
  if (!r || !existsSync(join(process.cwd(), r.outPath))) return null;
  return `${base}/${r.outPath.replace(/^public\//, "")}`;
}

/* 画像生成に必要なぶんだけを取り出してクライアントへ渡す */
const payload = balanceUpdates(base).map((u) => {
  const heroes = u.entities
    .filter((e) => e.target === "hero")
    .map((e) => {
      const key = e.key.replace(/^hero_/, "");
      const bgRel = `images/heroes/card16x9/${key}.webp`;
      return {
        name: e.name,
        kind: e.kind,
        bg: existsSync(join(process.cwd(), "public", bgRel)) ? `${base}/${bgRel}` : null,
        groups: e.groups
          .map((g) => ({
            name: g.name,
            icon: pub(g.image),
            rows: g.rows
              .filter((r) => !isZeroAddition(r.fromText, r.toText))
              .map((r) => ({
                label: r.label,
                tier: r.tier,
                from: r.fromText,
                to: r.toText,
                good: r.good,
              })),
          }))
          .filter((g) => g.rows.length > 0),
      };
    })
    .filter((h) => h.groups.length > 0);

  const items = u.entities
    .filter((e) => e.target === "item")
    .map((e) => ({
      name: e.name,
      kind: e.kind,
      icon: pub(e.item?.shopIcon ?? null),
      rows: (e.groups[0]?.rows ?? [])
        .filter((r) => !isZeroAddition(r.fromText, r.toText))
        .map((r) => ({
          label: r.label,
          tier: r.tier,
          from: r.fromText,
          to: r.toText,
          good: r.good,
        })),
    }))
    .filter((it) => it.rows.length > 0);

  return { date: u.date, title: u.title, heroes, items };
});

/*
 * 数値上の調整が無いヒーローを手で追加できるようにするための全員分の一覧。
 * ヴェナトルのように、直接の変更は無くてもアイテム側の調整でアルティメットに
 * 新しい効果が付く、といった「実質バフ/ナーフ」を書き足すためのもの。
 * 数値は一切持たない(名前と背景画像だけ)。
 */
const allHeroes = releasedHeroes().map((h) => {
  const key = h.key.replace(/^hero_/, "");
  const bgRel = `images/heroes/card16x9/${key}.webp`;
  return {
    key,
    name: t(h.nameToken, h.key),
    bg: existsSync(join(process.cwd(), "public", bgRel)) ? `${base}/${bgRel}` : null,
  };
});
---

<Base title="バランス調整カード生成" noindex={true}>
  <h1>バランス調整カード生成</h1>
  <p class="lead">
    アップデートの調整内容から、SNSに貼る1200x675のPNGを作ります。
    数値はサイトの他のページと同じデータから出しているので、手で書き写す必要はありません。
  </p>

  <div class="bar">
    <label>
      アップデート
      <select id="upd"></select>
    </label>
    <button id="all" class="primary">すべて保存</button>
    <span id="stat" class="stat"></span>
  </div>

  <div class="bar">
    <label>
      数値変更なしのヒーローを追加
      <select id="addHero"></select>
    </label>
    <label>
      扱い
      <select id="addKind">
        <option value="buff">実質バフ</option>
        <option value="nerf">実質ナーフ</option>
        <option value="mixed">実質混在</option>
        <option value="neutral">影響なし・報告のみ</option>
      </select>
    </label>
    <button id="addBtn">カードを追加</button>
    <span class="stat">直接の数値調整は無いが、アイテム側の変化などで影響を受けるヒーロー用。TIPS欄に理由を書く前提のカード</span>
  </div>

  <div id="list" class="list"></div>

  <script type="application/json" id="payload" is:inline set:html={JSON.stringify(payload)} />
  <script type="application/json" id="heroes" is:inline set:html={JSON.stringify(allHeroes)} />

  <script is:inline>
    (() => {
      const DATA = JSON.parse(document.getElementById("payload").textContent);
      const HEROES = JSON.parse(document.getElementById("heroes").textContent);
      const $ = (id) => document.getElementById(id);

      const W = 1200;
      const H = 675;
      const PAD = 34;
      /* サイト共通の配色に合わせる(global.css の --c-* と同じ考え方) */
      const COLOR = {
        buff: "#8cc96e",
        nerf: "#e06c6c",
        mixed: "#e0a458",
        neutral: "#8fa39d",
        rework: "#b58be6",
        text: "#fcf0d8",
        sub: "#cfe3dc",
        muted: "#8fa39d",
        bg: "#0c1116",
      };
      const KIND_LABEL = {
        buff: "バフ",
        nerf: "ナーフ",
        mixed: "混在",
        neutral: "調整",
        rework: "リワーク",
      };
      /*
       * 直接の数値調整が無いヒーロー用のバッジ文言。
       * アイテム側の変更で恩恵/割りを食う場合に「実質バフ」のように区別する
       * (ヴェナトルの例: アルティメットに効果を与えるアイテムが調整され、
       * 本人のスキル・ステータスは1つも変わっていないが恩恵を受けている)。
       */
      const INDIRECT_KIND_LABEL = {
        buff: "実質バフ",
        nerf: "実質ナーフ",
        mixed: "実質混在",
        neutral: "報告",
      };

      const loadImage = (src) =>
        new Promise((resolve) => {
          if (!src) return resolve(null);
          const im = new Image();
          im.onload = () => resolve(im);
          im.onerror = () => resolve(null);
          im.src = src;
        });

      function roundRect(c, x, y, w, h, r) {
        c.beginPath();
        c.moveTo(x + r, y);
        c.arcTo(x + w, y, x + w, y + h, r);
        c.arcTo(x + w, y + h, x, y + h, r);
        c.arcTo(x, y + h, x, y, r);
        c.arcTo(x, y, x + w, y, r);
        c.closePath();
      }

      /** 幅に収まるよう末尾を「…」で詰める */
      function fit(c, text, max) {
        if (c.measureText(text).width <= max) return text;
        let s = text;
        while (s.length > 1 && c.measureText(s + "…").width > max) s = s.slice(0, -1);
        return s + "…";
      }

      /** 見出し(ヒーロー名/種別バッジ/日付)とサイト名。ヒーロー・アイテム共通 */
      function drawHeader(c, title, kind, date, sub, badgeLabel) {
        c.textBaseline = "alphabetic";
        c.shadowColor = "rgba(0,0,0,.9)";
        c.shadowBlur = 18;
        c.fillStyle = COLOR.text;
        c.font = '900 40px "Noto Sans JP", sans-serif';
        c.fillText(title, PAD, 62);
        const titleW = c.measureText(title).width;

        if (kind) {
          const label = badgeLabel ?? KIND_LABEL[kind] ?? kind;
          c.font = '700 16px "Noto Sans JP", sans-serif';
          const bw = c.measureText(label).width + 22;
          c.shadowBlur = 0;
          c.fillStyle = COLOR[kind] ?? COLOR.muted;
          roundRect(c, PAD + titleW + 14, 40, bw, 26, 13);
          c.fill();
          c.fillStyle = "#0c1116";
          c.fillText(label, PAD + titleW + 14 + 11, 58);
          c.shadowBlur = 18;
        }

        c.fillStyle = COLOR.sub;
        c.font = '500 18px "Noto Sans JP", sans-serif';
        c.fillText(sub ? `${date}　${sub}` : date, PAD, 92);

        c.textAlign = "right";
        c.fillStyle = COLOR.text;
        c.font = '700 15px "Noto Sans JP", sans-serif';
        c.fillText("DEADLOCK-JP DB", W - PAD, 48);
        c.fillStyle = COLOR.muted;
        c.font = '500 12px "JetBrains Mono", monospace';
        c.fillText("deadlock-jpdb.com", W - PAD, 66);
        c.textAlign = "left";
        c.shadowBlur = 0;
      }

      /**
       * 背景。ヒーローの絵を敷き、見出しが読める程度に上を軽く落とすだけにする。
       * 本文は後から半透明のパネルに載せるので、ここで全面を暗くしない
       * (暗くすると絵がほとんど見えず、ヒーローカードである意味が薄れる)。
       */
      function drawBackdrop(c, bgImage) {
        c.fillStyle = COLOR.bg;
        c.fillRect(0, 0, W, H);
        if (bgImage) c.drawImage(bgImage, 0, 0, W, H);
        const g = c.createLinearGradient(0, 0, 0, H);
        g.addColorStop(0, "rgba(6,9,12,.78)");
        g.addColorStop(0.18, "rgba(6,9,12,.42)");
        g.addColorStop(0.5, "rgba(6,9,12,.30)");
        g.addColorStop(1, "rgba(5,8,10,.66)");
        c.fillStyle = g;
        c.fillRect(0, 0, W, H);
      }

      /* ---- ヒーローカード ------------------------------------------- */
      const GROUP_H = 34;
      const ROW_H = 25;
      const BODY_TOP = 150;
      const TIPS_H = 74; // 手打ちTIPSに使う下部の帯
      const BODY_BOTTOM = H - 30;

      /**
       * カード下部の手書きTIPS。数値に出ない変更(組み合わせの強弱、挙動の変化など)を
       * 人が書き足すための欄。空なら帯ごと描かない。
       */
      function drawTips(c, text) {
        if (!text) return;
        const top = H - TIPS_H;
        c.fillStyle = "rgba(5,8,10,.88)";
        c.fillRect(0, top, W, TIPS_H);
        c.fillStyle = COLOR.mixed;
        c.fillRect(0, top, 4, TIPS_H);

        c.fillStyle = COLOR.muted;
        c.font = '700 12px "Noto Sans JP", sans-serif';
        c.fillText("TIPS", PAD, top + 24);

        // 2行まで。幅に入らなければ折り返し、あふれたら末尾を詰める
        c.fillStyle = COLOR.sub;
        c.font = '500 17px "Noto Sans JP", sans-serif';
        const maxW = W - PAD * 2;
        const lines = [];
        let cur = "";
        for (const ch of text.replace(/\s+/g, " ").trim()) {
          if (c.measureText(cur + ch).width > maxW) {
            lines.push(cur);
            cur = ch;
            if (lines.length === 2) break;
          } else cur += ch;
        }
        if (lines.length < 2 && cur) lines.push(cur);
        lines.forEach((ln, i) => {
          const last = i === lines.length - 1;
          c.fillText(last ? fit(c, ln, maxW) : ln, PAD, top + 46 + i * 22);
        });
      }

      /**
       * 直接の数値調整を持たないヒーロー(手で追加したカード)の本文。
       * データ行の代わりに、TIPSで書いた説明をそのままカードの主役として大きく出す。
       * 空欄のまま保存されるのを防ぐため、TIPSが無いときは注意書きを表示する。
       */
      function drawIndirectBody(c, top, bottom, tips) {
        const h = bottom - top;
        c.fillStyle = "rgba(6,9,12,.74)";
        roundRect(c, PAD - 16, top, W - (PAD - 16) * 2, h, 12);
        c.fill();

        const maxW = W - PAD * 2 - 20;
        c.fillStyle = COLOR.muted;
        c.font = '700 13px "Noto Sans JP", sans-serif';
        c.fillText("直接の数値調整はありません", PAD + 4, top + 32);

        c.fillStyle = tips ? COLOR.text : COLOR.muted;
        c.font = tips ? '500 24px "Noto Sans JP", sans-serif' : '500 17px "Noto Sans JP", sans-serif';
        const body = tips || "（TIPS欄に、影響を受けている理由を書いてください）";
        const lineH = tips ? 36 : 26;
        const maxLines = Math.max(1, Math.floor((h - 70) / lineH));

        const lines = [];
        let cur = "";
        for (const ch of body.replace(/\s+/g, " ").trim()) {
          if (c.measureText(cur + ch).width > maxW) {
            lines.push(cur);
            cur = ch;
            if (lines.length === maxLines) break;
          } else cur += ch;
        }
        if (lines.length < maxLines && cur) lines.push(cur);

        const blockH = lines.length * lineH;
        let ly = top + (h - blockH) / 2 + lineH * 0.72 + 10;
        lines.forEach((ln, i) => {
          const last = i === lines.length - 1;
          c.fillText(last ? fit(c, ln, maxW) : ln, PAD + 4, ly + i * lineH);
        });
      }

      async function drawHeroCard(hero, date, tips) {
        const cv = document.createElement("canvas");
        cv.width = W;
        cv.height = H;
        const c = cv.getContext("2d");
        /* TIPSを書くぶんだけ本文の下限を上げる(重なると読めなくなる) */
        const bottom = tips && !hero.indirect ? H - TIPS_H - 16 : BODY_BOTTOM;

        drawBackdrop(c, await loadImage(hero.bg));
        drawHeader(
          c,
          hero.name,
          hero.kind,
          date,
          hero.indirect ? "アイテム等の間接的な影響" : "バランス調整",
          hero.indirect ? INDIRECT_KIND_LABEL[hero.kind] : undefined,
        );

        if (hero.indirect) {
          drawIndirectBody(c, BODY_TOP - 26, bottom, tips);
          return cv;
        }

        /*
         * 行数が多いヒーロー(セレステは5スキル11項目)は2列に割る。
         * 1列に収まるなら1列のまま大きく見せる。
         */
        const lines = hero.groups.reduce((n, g) => n + 1 + g.rows.length, 0);
        const cols = lines > 11 ? 2 : 1;
        const gap = 28;
        const colW = (W - PAD * 2 - gap * (cols - 1)) / cols;

        // 列に振り分ける。スキル単位で切り、1つのスキルが列をまたがないようにする
        const buckets = Array.from({ length: cols }, () => []);
        if (cols === 1) {
          buckets[0] = hero.groups;
        } else {
          const half = Math.ceil(lines / 2);
          let used = 0;
          for (const g of hero.groups) {
            buckets[used < half ? 0 : 1].push(g);
            used += 1 + g.rows.length;
          }
        }

        const icons = new Map();
        for (const g of hero.groups) icons.set(g, await loadImage(g.icon));

        /*
         * 本文の高さを先に測り、パネルを敷いてから縦中央に置く。
         * 先に描くと、項目が少ないヒーローで下半分が大きく空いてしまう。
         */
        const groupH = (g) => 46 + g.rows.length * ROW_H;
        const colH = buckets.map((b) => b.reduce((n, g) => n + groupH(g), 0));
        const bodyH = Math.max(...colH);
        const areaTop = BODY_TOP - 26;
        const areaH = bottom - areaTop;
        const top = areaTop + Math.max(0, (areaH - bodyH) / 2);

        c.fillStyle = "rgba(6,9,12,.74)";
        roundRect(c, PAD - 16, top - 30, W - (PAD - 16) * 2, bodyH + 34, 12);
        c.fill();

        for (let i = 0; i < cols; i++) {
          const x = PAD + i * (colW + gap);
          let y = top;
          for (const g of buckets[i]) {
            if (y + GROUP_H > bottom) break;
            // スキル名(アイコンがあれば添える)
            const icon = icons.get(g);
            let tx = x;
            if (icon) {
              c.save();
              roundRect(c, x, y - 18, 24, 24, 5);
              c.clip();
              c.drawImage(icon, x, y - 18, 24, 24);
              c.restore();
              tx = x + 32;
            }
            c.fillStyle = COLOR.text;
            c.font = '700 17px "Noto Sans JP", sans-serif';
            c.fillText(fit(c, g.name, colW - (tx - x)), tx, y);
            y += GROUP_H - 10;

            c.strokeStyle = "rgba(255,255,255,.12)";
            c.beginPath();
            c.moveTo(x, y - 4);
            c.lineTo(x + colW, y - 4);
            c.stroke();
            y += 12;

            for (const r of g.rows) {
              if (y > bottom) break;
              const tier = r.tier ? `T${r.tier} ` : "";
              const value =
                r.to === null ? "削除" : r.from === null ? `${r.to}（新規）` : `${r.from} → ${r.to}`;
              c.font = '500 15px "Noto Sans JP", sans-serif';
              c.textAlign = "right";
              c.fillStyle =
                r.good === true ? COLOR.buff : r.good === false ? COLOR.nerf : COLOR.muted;
              const vw = c.measureText(value).width;
              c.fillText(value, x + colW, y);
              c.textAlign = "left";
              c.fillStyle = COLOR.sub;
              c.fillText(fit(c, tier + r.label, colW - vw - 14), x, y);
              y += ROW_H;
            }
            y += 10;
          }
        }
        drawTips(c, tips);
        return cv;
      }

      /* ---- アイテムまとめカード ------------------------------------- */
      const ITEMS_PER_CARD = 9;

      async function drawItemCard(items, date, page, pages, tips) {
        const cv = document.createElement("canvas");
        cv.width = W;
        cv.height = H;
        const c = cv.getContext("2d");
        const bottom = tips ? H - TIPS_H - 16 : BODY_BOTTOM;

        drawBackdrop(c, null);
        drawHeader(
          c,
          "アイテム調整",
          null,
          date,
          pages > 1 ? `バランス調整　${page}/${pages}` : "バランス調整",
        );

        /* ヒーローカードと同じく、件数が少ない最終ページで下が大きく空かないよう縦中央に置く */
        const ROW_PITCH = 58;
        const areaTop = BODY_TOP - 26;
        const blockH = items.length * ROW_PITCH;
        let y = areaTop + Math.max(0, (bottom - areaTop - blockH) / 2) + 26;

        for (const it of items) {
          const icon = await loadImage(it.icon);
          if (icon) {
            c.save();
            roundRect(c, PAD, y - 26, 38, 38, 7);
            c.clip();
            c.drawImage(icon, PAD, y - 26, 38, 38);
            c.restore();
          }
          const tx = PAD + 50;

          c.fillStyle = COLOR.text;
          c.font = '700 19px "Noto Sans JP", sans-serif';
          c.fillText(it.name, tx, y - 6);
          const nameW = c.measureText(it.name).width;

          const label = KIND_LABEL[it.kind] ?? it.kind;
          c.font = '700 13px "Noto Sans JP", sans-serif';
          const bw = c.measureText(label).width + 16;
          c.fillStyle = COLOR[it.kind] ?? COLOR.muted;
          roundRect(c, tx + nameW + 12, y - 22, bw, 20, 10);
          c.fill();
          c.fillStyle = "#0c1116";
          c.fillText(label, tx + nameW + 20, y - 8);

          // 変更内容は1行にまとめる。入りきらない分は「ほか◯件」
          c.font = '500 15px "Noto Sans JP", sans-serif';
          const parts = it.rows.map((r) => {
            const tier = r.tier ? `T${r.tier} ` : "";
            const v =
              r.to === null ? "削除" : r.from === null ? `${r.to}（新規）` : `${r.from}→${r.to}`;
            return `${tier}${r.label} ${v}`;
          });
          let text = parts.join(" ／ ");
          const maxW = W - PAD - tx;
          if (c.measureText(text).width > maxW) {
            let n = parts.length;
            while (n > 1) {
              n--;
              text = parts.slice(0, n).join(" ／ ") + ` ／ ほか${parts.length - n}件`;
              if (c.measureText(text).width <= maxW) break;
            }
          }
          c.fillStyle = COLOR.muted;
          c.fillText(fit(c, text, maxW), tx, y + 16);

          y += ROW_PITCH;
          if (y > bottom) break;
        }
        drawTips(c, tips);
        return cv;
      }

      /* ---- 画面 ------------------------------------------------------ */
      /* {name, canvas, tips, render(tips)} 。render はTIPSを変えて描き直すのに使う */
      const cards = [];

      function download(canvas, name) {
        return new Promise((resolve) => {
          canvas.toBlob((blob) => {
            if (!blob) return resolve();
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob);
            a.download = name;
            a.click();
            setTimeout(() => {
              URL.revokeObjectURL(a.href);
              resolve();
            }, 120);
          }, "image/png");
        });
      }

      async function render() {
        const u = DATA[$("upd").selectedIndex];
        const list = $("list");
        list.textContent = "";
        cards.length = 0;
        $("stat").textContent = "描画中…";

        // Webフォントが載る前に描くと游ゴシック等に化けるので待つ
        if (document.fonts && document.fonts.ready) await document.fonts.ready;

        for (const h of u.heroes) {
          cards.push({
            name: `${u.date}_${h.name}.png`,
            tips: "",
            render: (tips) => drawHeroCard(h, u.date, tips),
          });
        }
        const pages = Math.ceil(u.items.length / ITEMS_PER_CARD) || 0;
        for (let p = 0; p < pages; p++) {
          const slice = u.items.slice(p * ITEMS_PER_CARD, (p + 1) * ITEMS_PER_CARD);
          cards.push({
            name: `${u.date}_アイテム_${p + 1}.png`,
            tips: "",
            render: (tips) => drawItemCard(slice, u.date, p + 1, pages, tips),
          });
        }

        for (const card of cards) await mountCard(card);
        updateStat();
      }

      /**
       * カード1枚ぶんの figure(画像・保存ボタン・TIPS欄)を組み立てて #list に足す。
       * render() の初期表示と、「カードを追加」ボタンの両方から使う共通処理。
       */
      async function mountCard(card) {
        const list = $("list");
        card.canvas = await card.render(card.tips ?? "");
        const fig = document.createElement("figure");
        card.canvas.style.width = "100%";
        card.canvas.style.height = "auto";
        fig.appendChild(card.canvas);

        const cap = document.createElement("figcaption");
        const btn = document.createElement("button");
        btn.textContent = "PNGで保存";
        btn.addEventListener("click", () => download(card.canvas, card.name));
        cap.appendChild(document.createTextNode(card.name));
        cap.appendChild(btn);
        fig.appendChild(cap);

        /*
         * 数値に出ない変更(組み合わせの強弱・挙動の変化など)を書き足す欄。
         * 打つたびに描き直すと重いので、入力が止まってから描く。
         * 手で追加したカード(indirect)はこの欄自体が本文になるので、初期表示から
         * 注意書きを促す文言を変えている。
         */
        const ta = document.createElement("textarea");
        ta.placeholder = card.indirectHint
          ? "ここに影響の内容を書いてください（例: ○○の調整でアルティメットに追加効果）"
          : "TIPS（任意）数値に出ない変更や、組み合わせの評価など";
        ta.rows = card.indirectHint ? 3 : 2;
        ta.value = card.tips ?? "";
        let timer = null;
        ta.addEventListener("input", () => {
          card.tips = ta.value.trim();
          clearTimeout(timer);
          timer = setTimeout(async () => {
            const next = await card.render(card.tips);
            next.style.width = "100%";
            next.style.height = "auto";
            fig.replaceChild(next, card.canvas);
            card.canvas = next;
          }, 300);
        });
        fig.appendChild(ta);

        list.appendChild(fig);
      }

      function updateStat() {
        $("stat").textContent = `カード ${cards.length} 枚`;
      }

      const sel = $("upd");
      for (const u of DATA) {
        const o = document.createElement("option");
        o.textContent = `${u.date}　${u.title}`;
        sel.appendChild(o);
      }
      sel.addEventListener("change", render);
      $("all").addEventListener("click", async () => {
        for (const card of cards) await download(card.canvas, card.name);
      });

      const addHeroSel = $("addHero");
      for (const h of HEROES) {
        const o = document.createElement("option");
        o.value = h.key;
        o.textContent = h.name;
        addHeroSel.appendChild(o);
      }
      $("addBtn").addEventListener("click", async () => {
        const h = HEROES[addHeroSel.selectedIndex];
        const kind = $("addKind").value;
        const date = DATA[sel.selectedIndex].date;
        const hero = { name: h.name, bg: h.bg, kind, indirect: true, groups: [] };
        const card = {
          name: `${date}_${h.name}_${INDIRECT_KIND_LABEL[kind]}.png`,
          tips: "",
          indirectHint: true,
          render: (tips) => drawHeroCard(hero, date, tips),
        };
        cards.push(card);
        await mountCard(card);
        updateStat();
        card.canvas.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      render();
    })();
  </script>

  <style>
