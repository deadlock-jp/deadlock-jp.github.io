      margin: var(--sp-4) 0;
      padding: var(--sp-3) var(--sp-4);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
    }
    .bar label {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: 13px;
      color: var(--c-text-muted);
    }
    select {
      background: var(--c-surface-2);
      color: var(--c-text);
      border: 1px solid var(--c-border);
      border-radius: 5px;
      padding: 5px 8px;
      font: inherit;
      font-size: 13px;
    }
    button {
      background: transparent;
      border: 1px solid var(--c-border);
      color: var(--c-text-muted);
      border-radius: 5px;
      padding: 5px 12px;
      font: inherit;
      font-size: 12.5px;
      cursor: pointer;
    }
    button:hover {
      border-color: var(--c-border-strong);
      color: var(--c-text);
    }
    button.primary {
      border-color: var(--c-accent);
      color: var(--c-accent);
    }
    .stat {
      font-size: 12px;
      color: var(--c-text-faint);
      font-family: var(--font-mono);
    }
    .list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: var(--sp-4);
    }
    figure {
      margin: 0;
