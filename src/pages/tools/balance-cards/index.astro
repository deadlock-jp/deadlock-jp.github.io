    figure canvas {
      display: block;
      border-radius: 4px;
    }
    figcaption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-2);
      margin-top: var(--sp-2);
      font-size: 11px;
      color: var(--c-text-faint);
      font-family: var(--font-mono);
    }
    textarea {
      display: block;
      width: 100%;
      margin-top: var(--sp-2);
      box-sizing: border-box;
      background: var(--c-surface-2);
      color: var(--c-text);
      border: 1px solid var(--c-border);
      border-radius: 5px;
      padding: 6px 8px;
      font: inherit;
      font-size: 12.5px;
      line-height: 1.6;
      resize: vertical;
    }
    textarea:focus {
      outline: none;
      border-color: var(--c-accent);
    }
  </style>
</Base>
