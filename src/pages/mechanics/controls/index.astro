---
/**
 * キャラクターコントロールのリファレンス。
 *
 * 旧「移動テクニック」(/mechanics/movement/)と統合したページ(2026-09-23)。
 * 同じ操作を土台にした内容が2ページに分かれていたため、ダッシュ・ジャンプ・
 * マントルなど操作の起点ごとにカテゴリ分けし、基礎操作の説明→それを組み合わせた
 * 発展的なテクニックの順で1つにまとめている(data/controls-notes.json)。
 * ヒーロー別の数値は heroes.json の startingStats から自動で出す(src/lib/controls.ts)。
 */
import Base from "../../../layouts/Base.astro";
import HeroPortrait from "../../../components/HeroPortrait.astro";
import { heroControlStats, controlCategories } from "../../../lib/controls.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows = heroControlStats();
const categories = controlCategories();
---

<Base
  title="キャラクターコントロール"
  description="Deadlock（デッドロック）の共通操作（ダッシュ・二段ジャンプ・マントル等）とそれを組み合わせた発展的な移動テクニック、ヒーローごとの移動・近接ダメージの数値差を、日本語でまとめたリファレンス。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "キャラクターコントロール", path: `${base}/mechanics/controls/` },
  ]}
>
  <h1>キャラクターコントロール</h1>
  <p class="lead">
    どのヒーローにも共通する操作と、それらを組み合わせた発展的な移動テクニックを、
    ダッシュ・ジャンプといった操作の起点ごとにまとめています。
    ヒーローごとに違う移動・近接ダメージの基礎値はページ下部の数値表を参照してください。
  </p>

  <nav class="toc">
    <span class="toclabel">目次</span>
    <ol>
      {categories.map((c) => <li><a href={`#${c.id}`}>{c.title}</a></li>)}
    </ol>
  </nav>

  {categories.map((c) => (
    <section id={c.id} class="block panel">
      <h2>{c.title}</h2>
      {c.basics.length > 0 && (
        <ul class="notes">
          {c.basics.map((line) => <li>{line}</li>)}
        </ul>
      )}
      {c.techniques.length > 0 && (() => {
        const videoTechs = c.techniques.filter((t) => typeof t !== "string");
        return (
          <div class:list={["techniques", { withBasics: c.basics.length > 0 }]}>
            {c.basics.length > 0 && <span class="techlabel">応用テクニック</span>}
            <div class:list={["techsplit", { split: videoTechs.length > 0 }]}>
              <div class="techtext">
                {c.techniques.map((t) =>
                  typeof t === "string" ? (
                    <p>{t}</p>
                  ) : (
                    <div class="techitem">
                      <h3>{t.title}</h3>
                      <p>{t.text}</p>
                    </div>
                  ),
                )}
              </div>
              {videoTechs.length > 0 && (
                <div class="techvideos">
                  {videoTechs.map((t) => (
                    <div class="techvideo">
                      <iframe
                        src={`https://www.youtube.com/embed/${t.videoId}?mute=1`}
                        title={t.title}
                        loading="lazy"
                        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })()}
    </section>
  ))}

  <section class="block panel">
    <details class="hd">
      <summary>
        <h2>ヒーロー別の数値</h2>
        <span class="hdcount">{rows.length}人</span>
      </summary>
      <p class="tlead">
        基礎ステータス。レベルアップやアイテムでの強化前の値。
      </p>
      <div class="tablewrap">
        <table>
          <thead>
            <tr>
              <th>ヒーロー</th>
              <th>移動速度</th>
              <th>スプリント速度</th>
              <th>スタミナ</th>
              <th>スタミナ回復</th>
              <th>地上ダッシュ</th>
              <th>空中ダッシュ</th>
              <th>近接（軽）</th>
              <th>近接（重）</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="hero">
                  <a href={`${base}/heroes/${r.heroId}/`}>
                    <HeroPortrait name={r.name} image={r.iconSmall} size={24} />
                    {r.name}
                  </a>
                </td>
                <td class="n">{r.moveSpeed}m／秒</td>
                <td class="n">+{r.sprintSpeed}m／秒</td>
                <td class="n">{r.stamina}</td>
                <td class="n">{r.staminaRegenPerSecond}秒／1</td>
                <td class="n">{r.groundDashDistance}m／{r.groundDashDuration}秒</td>
                <td class="n">{r.airDashDistance}m／{r.airDashDuration}秒</td>
                <td class="n">{r.lightMeleeDamage}</td>
                <td class="n">{r.heavyMeleeDamage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <p class="foot">
    ヒーロー別の数値は <code>heroes.vdata</code> から自動抽出したものです。
    <a href={`${base}/mechanics/strategy/`}>戦略</a> のページも参照してください。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .lead {
      color: var(--c-text-muted);
      line-height: 1.8;
    }
    .toc {
      margin-top: var(--sp-4);
      padding: var(--sp-3) var(--sp-4);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      max-width: 62ch;
    }
    .toclabel {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .toc ol {
      margin: var(--sp-2) 0 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
      column-width: 22ch;
    }
    .toc a {
      color: var(--c-text);
    }
    .toc a:hover {
      color: var(--c-accent);
    }

    .block {
      margin-top: var(--sp-5);
    }
    .block h2 {
      margin-top: 0;
    }
    .tlead {
      margin: 0 0 var(--sp-4);
      font-size: 13px;
      color: var(--c-text-muted);
    }

    .notes {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
      color: var(--c-text);
    }

    .techniques {
      margin-top: var(--sp-3);
    }
    .techniques.withBasics {
      padding-top: var(--sp-3);
      border-top: 1px dashed var(--c-border);
    }
    .techlabel {
      display: block;
      margin-bottom: var(--sp-2);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-faint);
    }
    .techniques p {
      margin: 0 0 var(--sp-3);
      font-size: 14px;
      line-height: 1.9;
      color: var(--c-text);
    }
    .techniques p:last-child {
      margin-bottom: 0;
    }

    .techitem {
      margin-bottom: var(--sp-3);
    }
    .techitem h3 {
      margin: 0 0 var(--sp-2);
      font-size: 14px;
      color: var(--c-text-strong);
    }

    .techsplit.split {
      display: flex;
      gap: var(--sp-5);
      align-items: flex-start;
    }
    .techtext {
      flex: 1;
      min-width: 0;
    }
    .techvideos {
      flex: 0 0 auto;
      display: flex;
      flex-direction: row;
      gap: var(--sp-3);
    }
    .techvideo {
      flex: 0 0 150px;
      width: 150px;
      aspect-ratio: 9 / 16;
      border-radius: var(--radius);
      overflow: hidden;
      background: #000;
    }
    .techvideo iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    @media (max-width: 720px) {
      .techsplit.split {
        flex-direction: column;
      }
      /* スマホこそ縦動画が映えるので、画面幅いっぱい近くまで大きくする。
         複数本あるときは横スワイプで送る */
      .techvideos {
        align-self: stretch;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        justify-content: safe center;
        padding-bottom: var(--sp-2);
      }
      .techvideo {
        flex: 0 0 min(78vw, 360px);
        width: min(78vw, 360px);
        scroll-snap-align: center;
      }
    }

    .hd summary {
      display: flex;
      align-items: baseline;
      gap: var(--sp-3);
      cursor: pointer;
      list-style: none;
    }
    .hd summary::-webkit-details-marker {
      display: none;
    }
    .hd summary h2 {
      margin: 0;
    }
    .hd summary::before {
      content: "▸";
      font-size: 11px;
      color: var(--c-text-faint);
      transition: transform 0.15s;
    }
    .hd[open] summary::before {
      transform: rotate(90deg);
    }
    .hdcount {
      font-size: 12px;
      color: var(--c-text-faint);
      font-variant-numeric: tabular-nums;
    }
    .hd .tlead {
      margin-top: var(--sp-3);
    }

    .tablewrap {
      overflow-x: auto;
    }
    table {
      border-collapse: collapse;
      font-size: 12.5px;
      width: 100%;
    }
    th,
    td {
      text-align: left;
      padding: 6px 12px 6px 0;
      border-bottom: 1px solid var(--c-border);
      white-space: nowrap;
    }
    th {
      font-size: 11px;
      font-weight: 500;
      color: var(--c-text-faint);
    }
    td.n {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      color: var(--c-text-strong);
    }
    td.hero a {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      color: var(--c-text-strong);
      text-decoration: none;
    }
    td.hero a:hover {
      text-decoration: underline;
    }

    .foot {
      margin-top: var(--sp-5);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .foot a {
      color: inherit;
    }
  </style>
</Base>
