---
/**
 * オブジェクト。建造物・トルーパー・シュライン・中立モンスター(ホーント)の数値と、マップ上の目標物。
 * 旧・試合の流れ(/mechanics/match/)の付録から、書き換えずに移したもの(さらに前は独立した /mechanics/objects/ だった)。
 * 位置はマップとファームの地図へ、その種類だけを表示した状態で飛ばす(FarmMap の ?show=)。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import MechanicsNav from "../../../components/MechanicsNav.astro";
import MechanicsNext from "../../../components/MechanicsNext.astro";
import { objectTopics, hauntSpecies } from "../../../lib/objects.ts";
import { gameSystemSections } from "../../../lib/gameSystem.ts";
import { objectNotes } from "../../../lib/data.ts";
import { resolveImagePath } from "../../../parsers/image-manifest.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const topics = objectTopics();
/* 中立モンスター(ホーント)の種類。HP・ソウルは段ごとに共通なので、種類は絵と名前だけ並べる */
const haunts = hauntSpecies();
const sys = Object.fromEntries(gameSystemSections().map((s) => [s.id, s]));

/** アイコン参照を public/ の実ファイルに解決する。無いものは null(絵を出さない) */
function iconSrc(ref: string | null): string | null {
  if (!ref) return null;
  const resolved = resolveImagePath(ref);
  if (!resolved || !existsSync(join(process.cwd(), resolved.outPath))) return null;
  return `${base}/${resolved.outPath.replace(/^public\//, "")}`;
}

/**
 * 章ごとの「マップで位置を見る」で表示する種類(FarmMap の layer の key)。
 * 空文字は建造物だけ(建造物は切り替えの対象外で常に出ている)。トルーパーは地図に置かれていないので無し
 */
const MAP_LINK: Record<string, string | undefined> = {
  lane: "",
  shrine: "",
  neutral: "weak,medium,strong,vaults",
};

const toc = [
  ...topics.map((tp) => ({ id: tp.id, label: tp.title })),
  ...(sys["map-objects"] ? [{ id: "map-objects", label: sys["map-objects"].title }] : []),
];
---

<Base
  title="オブジェクト"
  description="Deadlock（デッドロック）のガーディアン・ウォーカー・パトロンなどレーンの建造物、トルーパー、シュライン、中立モンスター（ホーント）のHP・ダメージ・報酬と、マップ上の目標物の一覧。ゲームの生データから自動で抽出した数値です。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "オブジェクト", path: `${base}/mechanics/objects/` },
  ]}
>
  <MechanicsNav />
  <h1>オブジェクト</h1>

  <nav class="toc" aria-label="目次">
    {toc.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
  </nav>

      {topics.map((topic) => (
        <section class="chapter panel topic" id={topic.id}>
          <h2>{topic.title}</h2>
          {MAP_LINK[topic.id] !== undefined && (
            <p class="maplink"><a href={`${base}/mechanics/farm/?show=${MAP_LINK[topic.id]}#map`}>マップで位置を見る</a></p>
          )}
          <div class="objs">
            {topic.objects.map((o) => {
              const src = iconSrc(o.icon);
              const tips = objectNotes(o.id);
              return (
                <div class="obj">
                  <h5>{src && <img class="oicon" src={src} alt="" loading="lazy" />}{o.name}</h5>
                  <dl>
                    {o.stats.map((s) => <div class="row"><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
                  </dl>
                  {tips.length > 0 && <ul class="otips">{tips.map((tip) => <li>{tip}</li>)}</ul>}
                </div>
              );
            })}
          </div>
          {topic.id === "neutral" && haunts.length > 0 && (
            <ul class="haunts">
              {haunts.map((h) => (
                <li>
                  {h.icon && <img src={`${base}/${h.icon}`} alt="" loading="lazy" />}
                  <b>{h.name}</b>
                  <small>マップに{h.placed}体</small>
                </li>
              ))}
            </ul>
          )}
          {topic.lines.length > 0 && <ul class="notes">{topic.lines.map((line) => <li>{line}</li>)}</ul>}
        </section>
      ))}

      {["map-objects"].map((id) => sys[id] && (
        <section class="chapter panel topic" id={id}>
          <h2>{sys[id]!.title}</h2>
          <p class="maplink"><a href={`${base}/mechanics/farm/?show=marker,facility,broker#map`}>マップで位置を見る</a></p>
          {sys[id]!.icons.length > 0 && (
            <ul class="icongrid">
              {sys[id]!.icons.map((ic) => <li><img src={`${base}/${ic.src}`} alt="" loading="lazy" /><span>{ic.label}</span></li>)}
            </ul>
          )}
          <ul class="notes">{sys[id]!.lines.map((line) => <li>{line}</li>)}</ul>
        </section>
      ))}

  <p class="foot">
    数値はゲーム本体のデータ（<code>npc_units.vdata</code> ほか）から自動で出しています。<a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .toc { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--sp-3) 0 var(--sp-5); }
    .toc a {
      font-size: 12px; padding: 4px 10px; border: 1px solid var(--c-border); border-radius: 999px;
      background: var(--c-surface); color: var(--c-text-muted);
    }
    .toc a:hover { color: var(--c-accent); border-color: var(--c-accent-dim); text-decoration: none; }

    .chapter { margin-top: var(--sp-5); scroll-margin-top: 72px; }
    .chapter h2 { margin-top: 0; }
    .chapter h3 { margin: var(--sp-5) 0 var(--sp-2); font-size: 15px; color: var(--c-text-strong); }
    .chapter p { line-height: 1.9; font-size: 14px; margin: 0 0 var(--sp-3); }
    .chapter p.small { font-size: 13px; color: var(--c-text-muted); }
    .chapter b { color: var(--c-text-strong); }
    .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
    b.num { color: var(--c-soul); }
    .notes { margin: 0 0 var(--sp-3); padding-left: 1.2em; font-size: 13.5px; line-height: 1.9; }

    /* 全体像: 建造物の連なり */
    .chain { list-style: none; padding: 0; margin: var(--sp-3) 0 var(--sp-4); display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .chain li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 96px; padding: var(--sp-2) var(--sp-3); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .chain .cicon { width: 48px; height: 48px; display: grid; place-items: center; }
    .chain .cicon img { max-width: 48px; max-height: 48px; }
    .chain .ph { width: 32px; height: 32px; border-radius: 50%; border: 1px dashed var(--c-border-strong); }
    .chain .cname { font-size: 12px; color: var(--c-text-strong); white-space: nowrap; }
    .chain .cgold { font-family: var(--font-mono); font-size: 12px; color: var(--c-soul); }
    .chain .cgold.win { color: var(--c-accent); }
    .chain .arrow { position: absolute; right: -9px; top: 50%; transform: translateY(-50%); color: var(--c-text-faint); font-size: 14px; z-index: 1; }

    /* 計算ボックス */
    .calc { margin: var(--sp-3) 0 var(--sp-4); padding: var(--sp-3) var(--sp-4); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .calclabel { font-size: 11px; letter-spacing: .06em; color: var(--c-text-muted); }
    .calcrows { margin-top: var(--sp-2); display: grid; gap: 4px; }
    .calcrows > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px var(--sp-3); font-size: 13px; }
    .calcrows b { color: var(--c-soul); }
    .calc .calcnote { margin: var(--sp-2) 0 0; font-size: 13px; color: var(--c-text-strong); }
    .calc .lh { margin: var(--sp-2) 0 0; }
    .calc .calcsrc { margin: 2px 0 0; font-size: 11px; color: var(--c-text-faint); }

    /* ソウル推移 */
    .chart { margin: var(--sp-3) 0 var(--sp-4); }
    .chart svg { width: 100%; height: auto; display: block; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .chart .hl line { stroke: var(--c-border-strong); stroke-dasharray: 3 4; }
    .chart .hl.ult line { stroke: var(--c-spirit); stroke-dasharray: 6 3; }
    .chart .hl text, .chart .tick { font-size: 10px; fill: var(--c-text-faint); font-family: var(--font-mono); }
    .chart .hl.ult text { fill: var(--c-spirit); }
    .chart .axis { stroke: var(--c-border-strong); }

    .chips { list-style: none; padding: 0; margin: 0 0 var(--sp-3); display: flex; flex-wrap: wrap; gap: 6px; }
    .chips a { display: inline-block; font-size: 12px; padding: 3px 10px; border: 1px solid var(--c-vitality); border-radius: var(--radius); color: var(--c-vitality); background: var(--c-surface); }
    .chips a:hover { text-decoration: none; background: var(--c-surface-2); }

    /* タイムライン */
    .timeline { position: relative; margin: var(--sp-3) 0 var(--sp-3); padding-left: 64px; border-left: none; }
    .timeline::before { content: ""; position: absolute; left: 52px; top: 4px; bottom: 4px; width: 2px; background: var(--c-border-strong); }
    .tev { position: relative; display: flex; gap: var(--sp-3); align-items: baseline; padding: 4px 0; }
    .tev::before { content: ""; position: absolute; left: -16px; top: 11px; width: 8px; height: 8px; border-radius: 50%; background: var(--c-soul); }
    .tclock { position: absolute; left: -64px; width: 40px; text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--c-soul); }
    .tlabels { display: flex; flex-wrap: wrap; gap: 4px; }
    .tlabels span { font-size: 12.5px; padding: 1px 8px; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }

    /* 表 */
    .tablewrap { overflow-x: auto; }
    table { border-collapse: collapse; font-size: 12.5px; margin-bottom: var(--sp-3); }
    th, td { text-align: left; padding: 5px 14px 5px 0; border-bottom: 1px solid var(--c-border); white-space: nowrap; }
    th { font-size: 11px; font-weight: 500; color: var(--c-text-faint); }
    td.n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--c-text-strong); }
    td.rec { display: flex; gap: 3px; }
    td.rec a { line-height: 0; }

    /* 特別枠(地下トンネル) */
    .special { margin: var(--sp-4) 0 var(--sp-3); padding: var(--sp-3) var(--sp-4); border: 1px solid var(--c-spirit); border-radius: var(--radius); background: var(--c-surface); }
    .speciallabel { font-size: 11px; letter-spacing: .06em; color: var(--c-spirit); }
    .special h3 { margin-top: 2px; }
    .special .heroes { list-style: none; padding: 0; margin: 0 0 var(--sp-2); display: flex; flex-wrap: wrap; gap: var(--sp-3); }
    .special .heroes a { display: flex; align-items: center; gap: 8px; color: var(--c-text-strong); font-size: 13px; }
    .special .heroes a:hover { text-decoration: none; color: var(--c-accent); }

    /* 付録 */
    .apx { border-top: 1px solid var(--c-border); padding: var(--sp-3) 0; }
    .apx summary { cursor: pointer; font-size: 14px; color: var(--c-text-strong); }
    .apx[open] summary { margin-bottom: var(--sp-3); }
    .apx h4 { margin: var(--sp-3) 0 var(--sp-2); font-size: 13px; color: var(--c-text-strong); }
    .apx .sub { font-size: 12px; color: var(--c-text-faint); margin: 0 0 var(--sp-2); }
    .econ { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--sp-4); align-items: start; }
    .econ .wide { grid-column: 1 / -1; }
    .objs { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--sp-3); }
    .obj { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: var(--sp-2) var(--sp-3); }
    .obj h5 { display: flex; align-items: center; gap: 6px; margin: 0 0 var(--sp-2); font-size: 13px; color: var(--c-text-strong); }
    .oicon { width: 24px; height: 24px; object-fit: contain; }
    .haunts { list-style: none; margin: var(--sp-3) 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: var(--sp-2); }
    .haunts li { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: var(--sp-2); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); text-align: center; }
    .haunts img { width: 72px; height: 72px; object-fit: contain; }
    .haunts b { font-size: 13px; color: var(--c-text-strong); line-height: 1.4; }
    .haunts small { font-size: 11px; color: var(--c-text-muted); }
    .obj dl { margin: 0; font-size: 12px; }
    .obj .row { display: flex; justify-content: space-between; gap: var(--sp-3); padding: 2px 0; border-bottom: 1px solid var(--c-border); }
    .obj dt { color: var(--c-text-muted); }
    .obj dd { margin: 0; font-family: var(--font-mono); color: var(--c-text-strong); }
    .otips { margin: var(--sp-2) 0 0; padding-left: 1.1em; font-size: 11.5px; color: var(--c-text-muted); line-height: 1.7; }

    .icongrid { list-style: none; padding: 0; margin: var(--sp-2) 0 var(--sp-3); display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .icongrid li { display: flex; align-items: center; gap: 6px; font-size: 12px; padding: 3px 10px 3px 4px; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .icongrid img { width: 22px; height: 22px; object-fit: contain; }

    .calc b.miss { color: var(--c-nerf); }
    .calc .warn { display: block; margin-top: 4px; color: var(--c-nerf); }
    .chart .lgds { display: grid; gap: 6px; margin: 0 0 var(--sp-2); }
    .chart .lgd { display: flex; align-items: center; gap: 8px; font-size: 12.5px; }
    .chart .lgd > span:last-child { display: flex; flex-direction: column; }
    .chart .lgd small { font-size: 11.5px; color: var(--c-text-muted); }
    .sw { display: inline-block; width: 16px; height: 0; border-top: 3px solid; vertical-align: middle; }
    .sw.ideal { border-color: var(--c-soul); }
    .sw.basic { border-color: var(--c-mixed); }
    .sw.behind { border-color: var(--c-nerf); }
    .chart path.ln { fill: none; stroke-width: 2.2; }
    .chart path.ln.ideal { stroke: var(--c-soul); }
    .chart path.ln.basic { stroke: var(--c-mixed); }
    .chart path.ln.behind { stroke: var(--c-nerf); }
    .chart .ev circle { stroke: var(--c-bg); stroke-width: 1.5; fill: var(--c-soul); }
    .chart .ev text { font-size: 10.5px; fill: var(--c-text-strong); paint-order: stroke; stroke: var(--c-surface); stroke-width: 3px; }
    table.miles { margin-top: var(--sp-3); }
    .tip { border-color: var(--c-accent-dim); }
    .buff { margin: var(--sp-3) 0; padding: var(--sp-3) var(--sp-4); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .buff p { margin: 0 0 var(--sp-2); font-size: 13.5px; }
    .buff .notes { margin-bottom: 0; }

    .foot { margin-top: var(--sp-5); font-size: 12px; color: var(--c-text-faint); }

    @media (max-width: 640px) {
      .chain li { min-width: 0; flex: 1 1 40%; }
      .chain .arrow { display: none; }
    }
    .topic h2 { margin-bottom: var(--sp-2); }
    .maplink { margin: 0 0 var(--sp-3); font-size: 13px; }
  </style>
  <MechanicsNext />
</Base>
