---
/**
 * オブジェクトのリファレンス。
 *
 * 数値は data/snapshots/<版>/objects.json（ゲーム本体の npc_units.vdata 由来）から自動で出す。
 * 手で書くのは data/mechanics-notes.json の補足と data/object-notes.json のTIPSだけで、
 * そこに数値は書かない（CLAUDE.md ルール6）。ヒーロー個別のビルド論・対面論はここには書かない。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import { objectTopics, campSpawnTimes } from "../../../lib/objects.ts";
import { objectNotes } from "../../../lib/data.ts";
import { resolveImagePath } from "../../../parsers/image-manifest.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const topics = objectTopics();
const camps = campSpawnTimes();

const fmtMin = (n: number): string => (Number.isInteger(n) ? `${n}分` : `${Math.floor(n)}分${Math.round((n % 1) * 60)}秒`);

/** アイコン参照を public/ の実ファイルに解決する。無いものは null(絵を出さない) */
function iconSrc(ref: string | null): string | null {
  if (!ref) return null;
  const resolved = resolveImagePath(ref);
  if (!resolved || !existsSync(join(process.cwd(), resolved.outPath))) return null;
  return `${base}/${resolved.outPath.replace(/^public\//, "")}`;
}
---

<Base
  title="オブジェクト"
  description="Deadlock（デッドロック）のガーディアン・ウォーカー・シュライン・パトロン・トルーパー・ニュートラルのHPと挙動を、ゲームの生データから自動生成した日本語リファレンス。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "オブジェクト", path: `${base}/mechanics/objects/` },
  ]}
>
  <h1>オブジェクト</h1>
  <p class="lead">
    マップ上のNPC・建造物の数値です。ヒーローやアイテムと同じく、
    すべてゲーム本体から抽出したデータをそのまま出しています。名前もゲーム内の表記をそのまま使っています。
  </p>

  {topics.map((topic) => (
    <section class="block panel">
      <h2>{topic.title}</h2>
      <p class="tlead">{topic.lead}</p>

      <div class="objs">
        {topic.objects.map((o) => {
          const tips = objectNotes(o.id);
          const src = iconSrc(o.icon);
          return (
            <div class="obj">
              <h3>
                {src && <img class="oicon" src={src} alt="" loading="lazy" />}
                <span class="onm">{o.name}</span>
                <code>{o.id}</code>
              </h3>
              <dl>
                {o.stats.map((s) => (
                  <div class="row">
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
              {tips.length > 0 && (
                <div class="onotes">
                  <span class="nt">TIPS</span>
                  <ul>
                    {tips.map((tip) => <li>{tip}</li>)}
                  </ul>
                </div>
              )}
            </div>
          );
        })}
      </div>

      {topic.lines.length > 0 && (
        <ul class="notes">
          {topic.lines.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      )}
    </section>
  ))}

  {camps.length > 0 && (
    <section class="block panel">
      <h2>キャンプの出現タイミング</h2>
      <p class="tlead">試合開始からの初回出現と、全滅させてからの再出現までの時間。</p>
      <div class="tablewrap">
        <table>
          <thead>
            <tr>
              <th>対象</th>
              <th>初回出現</th>
              <th>再出現</th>
            </tr>
          </thead>
          <tbody>
            {camps.map((c) => (
              <tr>
                <td>{c.label}</td>
                <td class="n">{c.initialSpawnMinutes === 0 ? "試合開始時" : fmtMin(c.initialSpawnMinutes)}</td>
                <td class="n">
                  {fmtMin(c.respawnMinutes)}
                  {c.shrinksToMinutes !== null && ` → ${fmtMin(c.shrinksToMinutes)}（下限）`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tlead" style="margin-top: var(--sp-3); margin-bottom: 0;">
        ミッドボスは撃破するたびに再出現までの時間が短くなり、下限に達するとそれ以上は縮まらない。
      </p>
    </section>
  )}

  <p class="foot">
    数値は <code>npc_units.vdata</code>（キャンプの出現タイミングは <code>misc.vdata</code>）から
    自動抽出したものです。表示していない内部値（当たり判定やHPバーの位置など）もデータには含まれています。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .lead {
      color: var(--c-text-muted);
      line-height: 1.8;
    }
    .block {
      margin-top: var(--sp-5);
    }
    .block h2 {
      margin-top: 0;
    }
    .tlead {
      margin: 0 0 var(--sp-4);
      font-size: 13px;
      color: var(--c-text-muted);
    }

    .objs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--sp-3);
    }
    .obj {
      min-width: 0;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: var(--sp-3) var(--sp-4);
    }
    .obj h3 {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      margin: 0 0 var(--sp-2);
      padding-bottom: var(--sp-2);
      border-bottom: 1px solid var(--c-border);
      font-size: 14px;
      color: var(--c-text-strong);
    }
    .oicon {
      width: 34px;
      height: 34px;
      flex: 0 0 auto;
      border-radius: 5px;
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      object-fit: cover;
    }
    .onm {
      /* 実IDを右端に寄せるため、名前側で余白を吸う */
      margin-right: auto;
    }
    .obj h3 code {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--c-text-faint);
      background: none;
      padding: 0;
      /* 実IDは長いので縮む側にする */
      min-width: 0;
      overflow-wrap: anywhere;
      text-align: right;
    }
    .obj dl {
      margin: 0;
      display: grid;
      gap: 2px;
    }
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--sp-3);
      align-items: baseline;
      font-size: 12.5px;
      padding: 2px 0;
    }
    .row dt {
      color: var(--c-text-muted);
      min-width: 0;
    }
    .row dd {
      margin: 0;
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      color: var(--c-text-strong);
      white-space: nowrap;
    }

    .onotes {
      margin-top: var(--sp-3);
      padding-top: var(--sp-2);
      border-top: 1px dashed var(--c-border);
    }
    .onotes .nt {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .onotes ul {
      margin: var(--sp-1) 0 0;
      padding-left: 1.2em;
      font-size: 12px;
      color: var(--c-text-muted);
      line-height: 1.7;
    }

    .notes {
      margin: var(--sp-4) 0 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
      color: var(--c-text);
    }

    .foot {
      margin-top: var(--sp-5);
      font-size: 12px;
      color: var(--c-text-faint);
    }
  </style>
</Base>
