---
/**
 * ソウル獲得システムのリファレンス。
 *
 * 数値は heroes.json / items.json / economy.json（generic_data.vdata と misc.vdata 由来）から
 * 自動で出す。手で書くのは data/souls-notes.json のTIPSだけ（CLAUDE.md ルール6）。
 * ただしカムバックのTIPSだけは、ツマミがコンソール変数にあって抽出できないため数値を含む。
 * そのことがページ上で分かるように、該当セクションには断りを出す。
 */
import Base from "../../../layouts/Base.astro";
import {
  economyTable,
  objectiveGold,
  objectiveGoldNearPlayerSplitPct,
  killShareFrac,
  riftComeback,
  breakableSpawnTimes,
} from "../../../lib/souls.ts";
import { souls, soulsNotes } from "../../../lib/data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const economy = economyTable();
const objGold = objectiveGold();
const objGoldSplitPct = objectiveGoldNearPlayerSplitPct();
const shareFrac = killShareFrac();
const generalNotes = soulsNotes("general");
const rift = riftComeback();
const breakables = breakableSpawnTimes();
const comebackNotes = soulsNotes("comeback");

const pct = (n: number): string => `${Math.round(n * 100)}%`;
---

<Base
  title="ソウル獲得システム"
  description="Deadlock（デッドロック）のアイテム価格・レベル必要ソウル・購入ボーナスと、建造物破壊やキルで得るソウルを、ゲームの生データから自動生成した日本語リファレンス。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "ソウル獲得システム", path: `${base}/mechanics/souls/` },
  ]}
>
  <h1>ソウル獲得システム</h1>
  <p class="lead">
    ソウルの入手源とアイテム・レベルの価格です。ヒーローやアイテムと同じく、
    すべてゲーム本体から抽出したデータをそのまま出しています。
  </p>

  {generalNotes.length > 0 && (
    <section class="block panel">
      <h2>ソウルの基本</h2>
      <ul class="notes">
        {generalNotes.map((line) => <li>{line}</li>)}
      </ul>
    </section>
  )}

  <section class="block panel">
    <h2>建造物破壊で得るソウル</h2>
    <p class="tlead">
      破壊した瞬間に直接入るソウル。オーブとして周囲に散らばる分は含まない。
      このうち{objGoldSplitPct}%が破壊に関わった付近のプレイヤーへ、残りはチーム全体に均等に配られる。
    </p>
    <table>
      <thead><tr><th>建造物</th><th>ソウル</th></tr></thead>
      <tbody>
        {objGold.map((o) => (
          <tr>
            <td>{o.label}</td>
            <td class="n">{souls(o.goldKill)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {soulsNotes("objectiveGold").length > 0 && (
      <div class="snotes">
        <span class="nt">TIPS</span>
        <ul>
          {soulsNotes("objectiveGold").map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    )}
  </section>

  <section class="block panel">
    <h2>キルの分配率</h2>
    <p class="tlead">
      キルに絡んだ人数が多いほど、1人あたりの取り分は減る。
    </p>
    <table>
      <thead><tr><th>絡んだ人数</th><th>トルーパー</th><th>ヒーロー</th></tr></thead>
      <tbody>
        {shareFrac.map((r) => (
          <tr>
            <td>{r.count}人</td>
            <td class="n">{pct(r.trooperFrac)}</td>
            <td class="n">{pct(r.heroFrac)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {soulsNotes("killShareFrac").length > 0 && (
      <div class="snotes">
        <span class="nt">TIPS</span>
        <ul>
          {soulsNotes("killShareFrac").map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    )}
  </section>

  {(rift.length > 0 || comebackNotes.length > 0) && (
    <section class="block panel">
      <h2>カムバック（劣勢側への補正）</h2>
      <p class="tlead">
        ネットワースで劣勢のチームに入るソウルと耐性の補正。
        表は不安定な裂け目を確保した側が受ける補正で、ゲームデータから自動抽出している。
      </p>
      {rift.length > 0 && (
        <table>
          <thead><tr><th>項目</th><th>値</th></tr></thead>
          <tbody>
            {rift.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td class="n">{r.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      {comebackNotes.length > 0 && (
        <div class="snotes">
          <span class="nt">TIPS</span>
          <ul>
            {comebackNotes.map((tip) => <li>{tip}</li>)}
          </ul>
          <p class="src">
            この項目の数値だけは、ゲームのコンソール変数にあってデータファイルから抽出できないため、
            手で書き写しています。他のページの数値はすべて自動抽出です。
          </p>
        </div>
      )}
    </section>
  )}

  {breakables.length > 0 && (
    <section class="block panel">
      <h2>破壊可能オブジェクトの出現</h2>
      <p class="tlead">
        壊すとソウルが手に入るオブジェクトの出現時間。
        ゲームデータ側は配置に名前を持たないため、定義された順に並べている。
      </p>
      <table>
        <thead><tr><th>配置</th><th>初回出現</th><th>再出現間隔</th></tr></thead>
        <tbody>
          {breakables.map((b) => (
            <tr>
              <td>配置{b.index}</td>
              <td class="n">{b.initialSpawnMinutes}分</td>
              <td class="n">{b.respawnMinutes}分</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section class="block panel">
    <h2>アイテム・レベルの価格</h2>
    <p class="tlead">アイテムの価格とレベルアップに必要なソウル、累計投資額による購入ボーナス。</p>

    <div class="econ">
      <div class="etable">
        <h3>ティアごとのアイテム価格</h3>
        <table>
          <thead><tr><th>ティア</th><th>価格</th></tr></thead>
          <tbody>
            {economy.itemPrices.map((p) => (
              <tr>
                <td>T{p.tier}</td>
                <td class="n">{souls(p.cost)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {soulsNotes("itemPrices").length > 0 && (
          <div class="snotes">
            <span class="nt">TIPS</span>
            <ul>
              {soulsNotes("itemPrices").map((tip) => <li>{tip}</li>)}
            </ul>
          </div>
        )}
      </div>

      <div class="etable">
        <h3>レベルに必要な累計ソウル</h3>
        <table>
          <thead><tr><th>Lv</th><th>累計</th></tr></thead>
          <tbody>
            {economy.levels.map((l) => (
              <tr>
                <td>{l.level}</td>
                <td class="n">{souls(l.requiredGold)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="etable wide">
        <h3>購入ボーナス</h3>
        <p class="sub">
          そのカテゴリに投資した累計ソウルが閾値を超えるたびに、対応するステータスが上がります。全ヒーロー共通です。
        </p>
        <table>
          <thead>
            <tr>
              <th>累計投資額</th>
              {economy.costBonuses.map((c) => <th>{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {(economy.costBonuses[0]?.rows ?? []).map((_, i) => (
              <tr>
                <td class="n">{souls(economy.costBonuses[0]!.rows[i]!.goldThreshold)}</td>
                {economy.costBonuses.map((c) => <td class="n">+{c.rows[i]?.bonus ?? "—"}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        {soulsNotes("costBonuses").length > 0 && (
          <div class="snotes">
            <span class="nt">TIPS</span>
            <ul>
              {soulsNotes("costBonuses").map((tip) => <li>{tip}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <p class="foot">
    数値は <code>heroes.vdata</code> / <code>items.vdata</code> / <code>generic_data.vdata</code> /
    <code>misc.vdata</code> から自動抽出したものです（カムバックのTIPSを除く）。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .lead {
      color: var(--c-text-muted);
      line-height: 1.8;
    }
    .block {
      margin-top: var(--sp-5);
    }
    .block h2 {
      margin-top: 0;
    }
    .tlead {
      margin: 0 0 var(--sp-4);
      font-size: 13px;
      color: var(--c-text-muted);
    }
    .notes {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
      color: var(--c-text);
    }
    table {
      width: 100%;
      max-width: 420px;
      border-collapse: collapse;
      font-size: 12.5px;
    }
    th,
    td {
      text-align: left;
      padding: 4px 10px 4px 0;
      border-bottom: 1px solid var(--c-border);
      white-space: nowrap;
    }
    th {
      font-size: 11px;
      font-weight: 500;
      color: var(--c-text-faint);
    }
    td.n {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      color: var(--c-text-strong);
    }

    .econ {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--sp-4);
      align-items: start;
    }
    .etable {
      min-width: 0;
    }
    .etable.wide {
      grid-column: 1 / -1;
    }
    .etable table {
      max-width: none;
    }
    .etable h3 {
      margin: 0 0 var(--sp-2);
      font-size: 13px;
      color: var(--c-text-strong);
    }
    .etable .sub {
      margin: 0 0 var(--sp-2);
      font-size: 12px;
      color: var(--c-text-faint);
    }

    .snotes {
      margin-top: var(--sp-3);
      padding-top: var(--sp-2);
      border-top: 1px dashed var(--c-border);
    }
    .snotes .nt {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .snotes ul {
      margin: var(--sp-1) 0 0;
      padding-left: 1.2em;
      font-size: 12px;
      color: var(--c-text-muted);
      line-height: 1.7;
    }
    .snotes .src {
      margin: var(--sp-2) 0 0;
      font-size: 11px;
      color: var(--c-text-faint);
      line-height: 1.7;
    }

    .foot {
      margin-top: var(--sp-5);
      font-size: 12px;
      color: var(--c-text-faint);
    }
  </style>
</Base>
