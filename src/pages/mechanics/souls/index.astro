---
/**
 * ソウル獲得システムのリファレンス。
 *
 * 数値は heroes.json / items.json / economy.json（generic_data.vdata 由来）から自動で出す。
 * 手で書くのは data/souls-notes.json のTIPSだけ（CLAUDE.md ルール6）。
 */
import Base from "../../../layouts/Base.astro";
import { economyTable, objectiveGold, killShareFrac } from "../../../lib/souls.ts";
import { souls, soulsNotes } from "../../../lib/data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const economy = economyTable();
const objGold = objectiveGold();
const shareFrac = killShareFrac();

const pct = (n: number): string => `${Math.round(n * 100)}%`;
---

<Base
  title="ソウル獲得システム"
  description="Deadlock（デッドロック）のアイテム価格・レベル必要ソウル・購入ボーナスと、建造物破壊やキルで得るソウルを、ゲームの生データから自動生成した日本語リファレンス。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "ソウル獲得システム", path: `${base}/mechanics/souls/` },
  ]}
>
  <h1>ソウル獲得システム</h1>
  <p class="lead">
    ソウルの入手源とアイテム・レベルの価格です。ヒーローやアイテムと同じく、
    すべてゲーム本体から抽出したデータをそのまま出しています。
  </p>

  <section class="block panel">
    <h2>建造物破壊で得るソウル</h2>
    <p class="tlead">
      破壊した瞬間に破壊者へ直接入るソウル。オーブとして周囲に散らばる分は含まない。
    </p>
    <table>
      <thead><tr><th>建造物</th><th>ソウル</th></tr></thead>
      <tbody>
        {objGold.map((o) => (
          <tr>
            <td>{o.label}</td>
            <td class="n">{souls(o.goldKill)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {soulsNotes("objectiveGold").length > 0 && (
      <div class="snotes">
        <span class="nt">TIPS</span>
        <ul>
          {soulsNotes("objectiveGold").map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    )}
  </section>

  <section class="block panel">
    <h2>キルの分配率</h2>
    <p class="tlead">
      キルに絡んだ人数が多いほど、1人あたりの取り分は減る。
    </p>
    <table>
      <thead><tr><th>絡んだ人数</th><th>トルーパー</th><th>ヒーロー</th></tr></thead>
      <tbody>
        {shareFrac.map((r) => (
          <tr>
            <td>{r.count}人</td>
            <td class="n">{pct(r.trooperFrac)}</td>
            <td class="n">{pct(r.heroFrac)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {soulsNotes("killShareFrac").length > 0 && (
      <div class="snotes">
        <span class="nt">TIPS</span>
        <ul>
          {soulsNotes("killShareFrac").map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    )}
  </section>

  <section class="block panel">
    <h2>アイテム・レベルの価格</h2>
    <p class="tlead">アイテムの価格とレベルアップに必要なソウル、累計投資額による購入ボーナス。</p>

    <div class="econ">
      <div class="etable">
        <h3>ティアごとのアイテム価格</h3>
        <table>
          <thead><tr><th>ティア</th><th>価格</th></tr></thead>
          <tbody>
            {economy.itemPrices.map((p) => (
              <tr>
                <td>T{p.tier}</td>
                <td class="n">{souls(p.cost)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {soulsNotes("itemPrices").length > 0 && (
          <div class="snotes">
            <span class="nt">TIPS</span>
            <ul>
              {soulsNotes("itemPrices").map((tip) => <li>{tip}</li>)}
            </ul>
          </div>
        )}
      </div>

      <div class="etable">
        <h3>レベルに必要な累計ソウル</h3>
        <table>
          <thead><tr><th>Lv</th><th>累計</th></tr></thead>
          <tbody>
            {economy.levels.map((l) => (
              <tr>
                <td>{l.level}</td>
                <td class="n">{souls(l.requiredGold)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="etable wide">
        <h3>購入ボーナス</h3>
        <p class="sub">
          そのカテゴリに投資した累計ソウルが閾値を超えるたびに、対応するステータスが上がります。全ヒーロー共通です。
        </p>
        <table>
          <thead>
            <tr>
              <th>累計投資額</th>
              {economy.costBonuses.map((c) => <th>{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {(economy.costBonuses[0]?.rows ?? []).map((_, i) => (
              <tr>
                <td class="n">{souls(economy.costBonuses[0]!.rows[i]!.goldThreshold)}</td>
                {economy.costBonuses.map((c) => <td class="n">+{c.rows[i]?.bonus ?? "—"}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        {soulsNotes("costBonuses").length > 0 && (
          <div class="snotes">
            <span class="nt">TIPS</span>
            <ul>
              {soulsNotes("costBonuses").map((tip) => <li>{tip}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <p class="foot">
    数値は <code>heroes.vdata</code> / <code>items.vdata</code> / <code>generic_data.vdata</code>
    から自動抽出したものです。 <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .lead {
      color: var(--c-text-muted);
      max-width: 62ch;
      line-height: 1.8;
    }
    .block {
      margin-top: var(--sp-5);
    }
    .block h2 {
      margin-top: 0;
    }
    .tlead {
      margin: 0 0 var(--sp-4);
      font-size: 13px;
      color: var(--c-text-muted);
    }
    table {
      width: 100%;
      max-width: 420px;
      border-collapse: collapse;
      font-size: 12.5px;
    }
    th,
    td {
      text-align: left;
      padding: 4px 10px 4px 0;
      border-bottom: 1px solid var(--c-border);
      white-space: nowrap;
    }
    th {
      font-size: 11px;
      font-weight: 500;
      color: var(--c-text-faint);
    }
    td.n {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      color: var(--c-text-strong);
    }

    .econ {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--sp-4);
      align-items: start;
    }
    .etable {
      min-width: 0;
    }
    .etable.wide {
      grid-column: 1 / -1;
    }
    .etable table {
      max-width: none;
    }
    .etable h3 {
      margin: 0 0 var(--sp-2);
      font-size: 13px;
      color: var(--c-text-strong);
    }
    .etable .sub {
      margin: 0 0 var(--sp-2);
      font-size: 12px;
      color: var(--c-text-faint);
      max-width: 62ch;
    }

    .snotes {
      margin-top: var(--sp-3);
      padding-top: var(--sp-2);
      border-top: 1px dashed var(--c-border);
      max-width: 62ch;
    }
    .snotes .nt {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .snotes ul {
      margin: var(--sp-1) 0 0;
      padding-left: 1.2em;
      font-size: 12px;
      color: var(--c-text-muted);
      line-height: 1.7;
    }

    .foot {
      margin-top: var(--sp-5);
      font-size: 12px;
      color: var(--c-text-faint);
      max-width: 70ch;
    }
  </style>
</Base>
