---
/**
 * 攻略情報のハブページ。
 * ゲームシステム・オブジェクト・ソウル獲得システム・キャラクターコントロールの
 * 4ページへの入り口だけを持つ(src/pages/build/index.astro + build/compare.astro と
 * 同じ、1つのナビ項目の下にサブページをぶら下げる構成)。
 */
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pages = [
  {
    href: `${base}/mechanics/system/`,
    title: "ゲームシステム",
    lead: "勝利条件、レーンの進行順、デナイやバックドア保護といったルール。",
  },
  {
    href: `${base}/mechanics/objects/`,
    title: "オブジェクト",
    lead: "ガーディアン・ウォーカー・シュライン・パトロン、トルーパー、ニュートラルのHPと挙動。",
  },
  {
    href: `${base}/mechanics/souls/`,
    title: "ソウル獲得システム",
    lead: "アイテム価格・レベル必要ソウル・購入ボーナスと、建造物破壊やキルで得るソウル。",
  },
  {
    href: `${base}/mechanics/controls/`,
    title: "キャラクターコントロール",
    lead: "ダッシュ・二段ジャンプなど共通の操作と、ヒーローごとの移動・近接ダメージの数値差。",
  },
];
---

<Base
  title="攻略情報"
  description="Deadlock（デッドロック）の勝利条件・レーンのルール・ソウル獲得システム・キャラクター操作を、ゲームの生データから自動生成した日本語リファレンス。"
  breadcrumbs={[{ name: "攻略情報", path: `${base}/mechanics/` }]}
>
  <h1>攻略情報</h1>
  <p class="lead">
    ヒーローやアイテムと同じく、ゲーム本体から抽出したデータをそのまま出しています。
    名前もゲーム内の表記をそのまま使っています。
  </p>

  <div class="cards">
    {pages.map((p) => (
      <a class="card panel" href={p.href}>
        <h2>{p.title}</h2>
        <p>{p.lead}</p>
      </a>
    ))}
  </div>

  <style>
    .lead {
      color: var(--c-text-muted);
      max-width: 62ch;
      line-height: 1.8;
    }
    .cards {
      margin-top: var(--sp-5);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--sp-4);
    }
    .card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, background 0.15s;
    }
    .card:hover {
      border-color: var(--c-border-strong);
      background: var(--c-surface-2);
    }
    .card h2 {
      margin: 0 0 var(--sp-2);
      font-size: 15px;
      color: var(--c-text-strong);
    }
    .card p {
      margin: 0;
      font-size: 13px;
      color: var(--c-text-muted);
      line-height: 1.7;
    }
  </style>
</Base>
