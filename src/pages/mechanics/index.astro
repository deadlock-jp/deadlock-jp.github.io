---
/**
 * 攻略情報のハブページ。目的から選ぶカードで、目的別の7ページへの入口にする(2026-10)。
 *   はじめての Deadlock / 試合の流れ / マップとファーム / オブジェクト / 状態異常・効果 / 用語集 /
 *   キャラクターコントロール
 * 見出しで煽らず、各ページに入っている中身を、サイトで使っているゲーム画像と一緒にそのまま並べる。
 * 小さな地図(MapPreview)は「マップとファーム」への入口。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import MapPreview from "../../components/MapPreview.astro";
import { controlCategories } from "../../lib/controls.ts";
import { item } from "../../lib/data.ts";
import { resolveImagePath } from "../../parsers/image-manifest.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const img = (p: string): string | null => (existsSync(join(process.cwd(), "public", p)) ? `${base}/${p}` : null);
const M = `${base}/mechanics`;
/* アイテムのショップアイコン(サイトで既に使っているもの) */
const itemImg = (id: string): string | null => {
  const icon = item(id)?.shopIcon;
  const r = icon ? resolveImagePath(icon) : null;
  return r && existsSync(join(process.cwd(), r.outPath)) ? `${base}/${r.outPath.replace(/^public\//, "")}` : null;
};

/* 目的から選ぶカード(画像はサイトで既に使っているもの) */
const purposes = [
  { href: `${M}/beginner/`, title: "初めて遊ぶ", page: "はじめての Deadlock", body: "勝利条件と試合の全体像、最初に覚える3つのこと、よく出る用語", img: img("images/npcs/trooper.png") },
  { href: `${M}/match/`, title: "試合の進め方を知りたい", page: "試合の流れ", body: "レーン戦・中盤・終盤で意識すること、買い物の目安、橋バフ、ガーディアンのパリィ", img: img("images/npcs/tier_1_boss.png") },
  { href: `${M}/objects/`, title: "建造物や敵の数値を知りたい", page: "オブジェクト", body: "ガーディアン・ウォーカー・シュライン・トルーパー・ホーントのHPや報酬", img: img("images/npcs/tier_2_boss.png") },
  { href: `${M}/effects/`, title: "状態異常と対策を知りたい", page: "状態異常・効果", body: "スタン・サイレンス・スロウなどを持つスキルとアイテム、デバフ解除やデバフ耐性などの対策", img: itemImg("upgrade_unstoppable") },
  { href: `${M}/glossary/`, title: "用語の意味を調べたい", page: "用語集", body: "ゲーム内用語、ガンク・ディナイなどのMOBA・FPS用語、CC・DPSなどの略語", img: img("images/npcs/patron.png") },
];
/* キャラクターコントロール: 実演動画つきのテクニックと、全カテゴリ */
const categories = controlCategories();
const videos = categories.flatMap((c) =>
  c.techniques.flatMap((t) => (typeof t === "string" ? [] : [{ ...t, categoryId: c.id }])),
);
---

<Base
  title="攻略情報"
  description="Deadlock（デッドロック）の攻略情報。初心者向けのはじめてのガイド、試合の流れ（レーン戦・中盤・終盤）、マップとファーム、建造物やトルーパーの数値、ダッシュやマントルなどキャラクター操作の実演動画つき解説。"
  breadcrumbs={[{ name: "攻略情報", path: `${base}/mechanics/` }]}
>
  <h1>攻略情報</h1>

  <p class="lead">目的に合わせて、読むページを選んでください。</p>

  <div class="purposes">
    {purposes.slice(0, 1).map((c) => (
      <a class="pcard" href={c.href}>
        <span class="ti">{c.img && <img src={c.img} alt="" loading="lazy" />}</span>
        <span class="tx">
          <span class="tt">{c.title}</span>
          <span class="pg">{c.page}</span>
          <span class="tb">{c.body}</span>
        </span>
      </a>
    ))}
    {/* ---------- マップとファーム(地図つきの大きいカード。広い画面では左の列を縦に占める) ---------- */}
    <a class="pcard mapcard" href={`${M}/farm/`}>
      <MapPreview />
      <span class="tx">
        <span class="tt">ファームを上達したい・マップを覚えたい</span>
        <span class="pg">マップとファーム</span>
        <span class="tb">キャンプ・箱・黄金像・ヒーリングスナックの位置、ソウルの入り方、中立キャンプの報酬と出現時刻、アイテム価格やレベルの数値表</span>
      </span>
    </a>
    {purposes.slice(1).map((c) => (
      <a class="pcard" href={c.href}>
        <span class="ti">{c.img && <img src={c.img} alt="" loading="lazy" />}</span>
        <span class="tx">
          <span class="tt">{c.title}</span>
          <span class="pg">{c.page}</span>
          <span class="tb">{c.body}</span>
        </span>
      </a>
    ))}
  </div>

  {/* ---------- キャラクターコントロール ---------- */}
  <section class="panel hubsec">
    <h2><a href={`${base}/mechanics/controls/`}>操作を上達したい <small>キャラクターコントロール</small></a></h2>
    {videos.length > 0 && (
      <ul class="thumbs">
        {videos.map((v) => (
          <li>
            <a href={`${base}/mechanics/controls/#${v.categoryId}`}>
              <span class="thumb">
                <img src={`https://i.ytimg.com/vi/${v.videoId}/oardefault.jpg`} alt="" loading="lazy" />
                <span class="play" aria-hidden="true">▶</span>
              </span>
              <span class="tt">{v.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <ul class="cats">
      {categories.map((c) => (
        <li><a href={`${base}/mechanics/controls/#${c.id}`}>{c.title}</a></li>
      ))}
      <li><a href={`${base}/mechanics/controls/`}>ヒーロー別の移動数値</a></li>
    </ul>
  </section>

  <style>
    .hubsec { margin-top: var(--sp-5); }
    .hubsec h2 { margin: 0 0 var(--sp-4); font-size: 18px; }
    .hubsec h2 a { color: var(--c-text-strong); }
    .hubsec h2 a:hover { color: var(--c-accent); text-decoration: none; }
    .tt { display: block; font-size: 14px; font-weight: 600; color: var(--c-text-strong); }
    .tb { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.6; color: var(--c-text-muted); }

    .lead { color: var(--c-text-muted); font-size: 14px; }
    .hubsec h2 small { font-size: 12.5px; font-weight: 500; color: var(--c-text-muted); margin-left: 6px; }

    /* 目的から選ぶカード。マップとファームだけ地図つきで2行分の高さ */
    .purposes { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-auto-rows: auto; gap: var(--sp-3); margin-top: var(--sp-3); }
    .pcard {
      display: flex; gap: var(--sp-3); align-items: center; padding: var(--sp-3) var(--sp-4);
      background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); color: inherit;
    }
    .pcard:hover { border-color: var(--c-accent-dim); text-decoration: none; }
    .pcard:hover .tt { color: var(--c-accent); }
    .pcard { grid-column: 2; }
    .mapcard { grid-column: 1; grid-row: 1 / span 5; flex-direction: column; align-items: stretch; }
    .mapcard :global(.mp) { width: 100%; max-width: 360px; margin: 0 auto var(--sp-2); }
    .tx { display: flex; flex-direction: column; min-width: 0; }
    .pg { display: block; margin-top: 2px; font-size: 12px; color: var(--c-accent); }
    .ti { flex: 0 0 56px; height: 56px; display: grid; place-items: center; }
    .ti img { max-width: 56px; max-height: 56px; object-fit: contain; }

    /* キャラクターコントロール: 縦長サムネイルとカテゴリ */
    .thumbs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: var(--sp-3); }
    .thumbs a { display: flex; flex-direction: column; gap: 6px; color: inherit; }
    .thumbs a:hover { text-decoration: none; }
    .thumbs a:hover .tt { color: var(--c-accent); }
    .thumb { position: relative; display: block; aspect-ratio: 9 / 16; border-radius: var(--radius); overflow: hidden; background: #000; border: 1px solid var(--c-border); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; }
    .thumbs a:hover .thumb { border-color: var(--c-accent); }
    .play {
      position: absolute; inset: 0; margin: auto; width: 40px; height: 40px; border-radius: 50%;
      display: grid; place-items: center; font-size: 15px; padding-left: 3px;
      background: rgb(0 0 0 / 0.55); color: #fff; border: 1px solid rgb(255 255 255 / 0.4);
    }
    .thumbs .tt { font-size: 12.5px; font-weight: 500; }
    .cats { list-style: none; padding: 0; margin: var(--sp-4) 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .cats a { display: inline-block; font-size: 12.5px; padding: 4px 12px; border: 1px solid var(--c-border); border-radius: 999px; background: var(--c-surface); color: var(--c-text); }
    .cats a:hover { border-color: var(--c-accent-dim); color: var(--c-accent); text-decoration: none; }

    @media (max-width: 720px) {
      .purposes { grid-template-columns: 1fr; }
      .pcard, .mapcard { grid-column: auto; grid-row: auto; }
      .thumbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</Base>
