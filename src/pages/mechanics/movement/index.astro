---
/**
 * 移動テクニックのリファレンス。
 *
 * strategy(/mechanics/strategy/)と同じく、自動抽出データではなく
 * data/movement-notes.json の手書き記事がそのまま本文になる。
 * ダッシュ・二段ジャンプ・スライドといった基礎操作そのものの説明は
 * 「キャラクターコントロール」ページ（data/controls-notes.json の "common"）に譲り、
 * ここではそれらを組み合わせた発展的なテクニックだけを扱う。
 */
import Base from "../../../layouts/Base.astro";
import { movementSections } from "../../../lib/movement.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = movementSections();
---

<Base
  title="移動テクニック"
  description="Deadlock（デッドロック）のダッシュ・マントル・壁ジャンプ・バニーホップ・ジップライン・ヘビーメレーを組み合わせた発展的な移動テクニックをまとめた日本語の攻略記事。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "移動テクニック", path: `${base}/mechanics/movement/` },
  ]}
>
  <h1>移動テクニック</h1>
  <p class="lead">
    ダッシュ・マントル・壁ジャンプといった基礎操作を組み合わせた、発展的な移動テクニック集です。
    ここは数値データではなく解説記事です。ダッシュや二段ジャンプなど基礎操作そのものの説明は
    <a href={`${base}/mechanics/controls/`}>キャラクターコントロール</a>のページにまとめています。
  </p>

  <nav class="toc">
    <span class="toclabel">目次</span>
    <ol>
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
    </ol>
  </nav>

  {sections.map((s) => (
    <section id={s.id} class="block panel">
      <h2>{s.title}</h2>
      {s.paragraphs.map((p) => <p>{p}</p>)}
    </section>
  ))}

  <p class="foot">
    <a href={`${base}/mechanics/controls/`}>キャラクターコントロール</a> ・
    <a href={`${base}/mechanics/strategy/`}>戦略</a> の各ページも参照してください。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .lead {
      color: var(--c-text-muted);
      line-height: 1.8;
    }
    .toc {
      margin-top: var(--sp-4);
      padding: var(--sp-3) var(--sp-4);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      max-width: 62ch;
    }
    .toclabel {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }
    .toc ol {
      margin: var(--sp-2) 0 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
    }
    .toc a {
      color: var(--c-text);
    }
    .toc a:hover {
      color: var(--c-accent);
    }

    .block {
      margin-top: var(--sp-5);
    }
    .block h2 {
      margin-top: 0;
    }
    .block p {
      margin: 0 0 var(--sp-3);
      font-size: 14px;
      line-height: 1.9;
      color: var(--c-text);
    }
    .block p:last-child {
      margin-bottom: 0;
    }

    .foot {
      margin-top: var(--sp-5);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .foot a {
      color: inherit;
    }
  </style>
</Base>
