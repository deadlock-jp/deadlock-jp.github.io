---
/**
 * 試合の流れ。レーン戦 → 中盤 → 終盤の進め方と立ち回り。
 *
 * 2026-10 に目的別のページへ分けた。全体像・準備フェーズは「はじめての Deadlock」(/mechanics/beginner/)、
 * ソウルの仕組み・ファーミング・マップと付録の数値表の大半は「マップとファーム」(/mechanics/farm/)、
 * 建造物などの数値は「オブジェクト」(/mechanics/objects/)へ移し、ここには要約とリンクだけを残す。
 * 外部から貼られている旧アンカー(#overview #pregame #farming #map)は、下の script で移動先へ飛ばす。
 *
 * 文章は手書き(運営者と相談して練ったもの。deadlock.wiki の文章は使わない。ルール3)。
 * 文中の数値はすべて src/lib/matchFlow.ts ほかがスナップショットから引いたもの(ルール6)。
 */
import Base from "../../../layouts/Base.astro";
import MechanicsNav from "../../../components/MechanicsNav.astro";
import MechanicsNext from "../../../components/MechanicsNext.astro";
import { matchFlow, clock, duration } from "../../../lib/matchFlow.ts";
import { riftComeback } from "../../../lib/souls.ts";
import { gameSystemSections } from "../../../lib/gameSystem.ts";
import { souls, t, item } from "../../../lib/data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const f = matchFlow();
const rift = riftComeback();
const sys = Object.fromEntries(gameSystemSections().map((s) => [s.id, s]));

const objGold = (key: string): number => f.objectives.find((o) => o.key === key)?.gold ?? 0;

/* ---- ゲーム内の呼び名(ルール1) ---- */
const N = {
  midboss: t("Objective_MidBoss", "ミッド・ボス"),
  rift: "不安定な裂け目", // ping_koth などの文中表記。単独の名前トークンが無い
  urn: t("ability_golden_idol", "魂の壺"),
  statue: t("Citadel_ShopStats_GoldenStatues", "黄金像"),
  vault: t("neutral_sinners", "罪人の供物"),
};

/* ---- 1. レーン戦: 回復アイテム(運営者が選んだもの。価格や効果はデータから) ---- */
const HEAL_ITEMS = ["upgrade_endurance", "upgrade_health_stimpak", "upgrade_grit", "upgrade_medic_bullets"];
const healItems = HEAL_ITEMS.flatMap((id) => {
  const it = item(id);
  return it ? [{ id, name: t(it.nameToken, id) }] : [];
});

/* ---- レーン中のタイムライン ---- */
const events = [
  { sec: f.trooper?.firstWaveSeconds ?? null, label: "最初のウェーブ" },
  { sec: f.camps.weak?.initial ?? null, label: "小キャンプ" },
  { sec: f.breakable.firstSeconds, label: "箱・黄金像" },
  { sec: f.powerup.initial, label: "橋バフ" },
  { sec: f.camps.medium?.initial ?? null, label: "中キャンプ" },
  { sec: f.camps.strong?.initial ?? null, label: "大キャンプ" },
  { sec: f.camps.vaults?.initial ?? null, label: N.vault },
  { sec: f.tickGoldStartSeconds, label: "ティックゴールド" },
  { sec: f.rift?.initial ?? null, label: N.rift },
].filter((e): e is { sec: number; label: string } => e.sec !== null);
// 同じ時刻はまとめて1つの目盛りにする
const timeline = [...new Map(events.map((e) => [e.sec, [] as string[]])).keys()]
  .sort((a, b) => a - b)
  .map((sec) => ({ sec, labels: events.filter((e) => e.sec === sec).map((e) => e.label) }));
const timelineMax = Math.max(...timeline.map((e) => e.sec)) + 60;

const beginner = `${base}/mechanics/beginner/`;
const farm = `${base}/mechanics/farm/`;
const objects = `${base}/mechanics/objects/`;
/** 移した節の旧アンカー → 移動先(外部から貼られたリンク用) */
const moved: Record<string, string> = {
  overview: `${beginner}#overview`,
  pregame: `${beginner}#pregame`,
  farming: `${farm}#farming`,
  map: `${farm}#map`,
};

const toc = [
  { id: "laning", label: "1. レーン戦" },
  { id: "postlane", label: "2. レーン後・中盤" },
  { id: "lategame", label: "3. 終盤" },
  { id: "appendix", label: "付録" },
];
---

<Base
  title="試合の流れ"
  description="Deadlock（デッドロック）の試合の進め方を、レーン戦・中盤・終盤の順に解説。買い物の目安、ファーストブラッド、橋バフ、ガーディアンのパリィ、中盤のマクロ、終盤のカムバック補正まで、ゲームの生データの数値つき。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "試合の流れ", path: `${base}/mechanics/match/` },
  ]}
>
  <script is:inline define:vars={{ moved }}>
    const to = moved[location.hash.slice(1)];
    if (to) location.replace(to);
  </script>

  <MechanicsNav />
  <h1>試合の流れ</h1>
  <p class="lead">初めての方は <a href={beginner}>はじめての Deadlock</a> へ。</p>

  <nav class="toc" aria-label="目次">
    {toc.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
  </nav>

  {/* ================= 0〜1(移動先の要約) ================= */}
  <section class="chapter panel moved" id="overview">
    <h2>全体像・準備フェーズ</h2>
    <p>
      敵のパトロンを破壊したチームの勝ちです。ガーディアンからパトロンまでの防衛建造物の順番と報酬は
      <a href={`${beginner}#overview`}>はじめての Deadlock「全体像」</a>にまとめています。
    </p>
    <p id="pregame">
      試合前のレーンの割り振りと、編成の偏りを直すレーン交代は <a href={`${beginner}#pregame`}>「準備フェーズ」</a>へ。
    </p>
  </section>

  {/* ================= 1. レーン戦 ================= */}
  <section class="chapter panel" id="laning">
    <h2>1. レーン戦</h2>
    <p>
      試合開始から、自分のレーンの<b>ガーディアン</b>が倒れるまでがレーン戦です。
      目的は相手より多くソウルを集めて、先にアイテムとアビリティをそろえることです。
    </p>

    <div class="calc moved">
      <p class="calcnote">
        ウェーブのソウルの入り方、ディナイで差が倍に開く仕組み、3つのシナリオで見るレーン戦のソウル推移は
        <a href={`${farm}#souls`}>マップとファーム</a>にまとめています。
      </p>
    </div>

    <h3>買い物の目安</h3>
    <p>
      レーン中は <b class="num">{souls(f.tier1Price)}</b> のティア1アイテムを何個も買うのが基本なので、
      {f.buySteps.map((v) => souls(v)).join("・")} のように <b>{souls(f.tier1Price)}の倍数</b>が買い物のタイミングになります。
    </p>
    {f.ultimate?.totalGold && (
      <p>
        アルティメットアビリティは、所持ソウルの総額が <b class="num">{souls(f.ultimate.totalGold)}</b> になると解放されます
        （初期の{souls(f.startingGold ?? 0)}＋稼いだ{souls(f.ultimate.earnedGold)}。Lv{f.ultimate.level}）。
        レーンの力関係が大きく変わる節目なので、<b>敵と味方のソウル</b>はこまめに確認しましょう。
      </p>
    )}

    <h3>倒されない意識</h3>
    <p>
      試合で最初のキル（ファーストブラッド）を取った側には
      {f.firstKillBonus !== null ? <b class="num">+{f.firstKillBonus}</b> : "追加"}のソウルボーナスが入ります。
      <b>自分は絶対にファーストブラッドを取られない</b>、という意識で立ち回りましょう。
      倒されている間はウェーブのソウルも取れないので、失うものは報酬だけではありません。
    </p>

    <h3>撃ち合いに負けるとき</h3>
    <p>
      どうしてもダメージのやり取り（トレード）で負けてしまうときは、一時的に<b>回復アイテム</b>を買って立て直しましょう。
    </p>
    {healItems.length > 0 && (
      <ul class="chips">
        {healItems.map((h) => <li><a href={`${base}/items/${h.id}/`} data-itemcard={h.id}>{h.name}</a></li>)}
      </ul>
    )}

    <h3>レーン中に起きること</h3>
    <div class="timeline" style={`--max: ${timelineMax}`}>
      {timeline.map((e) => (
        <div class="tev" style={`--at: ${e.sec}`}>
          <span class="tclock">{clock(e.sec)}</span>
          <span class="tlabels">{e.labels.map((l) => <span>{l}</span>)}</span>
        </div>
      ))}
    </div>
    <ul class="notes">
      <li>
        小キャンプや箱から出るソウルもレーン中は差につながります。
      </li>
    </ul>
    <div class="buff">
      <p>
        <b>橋バフ（ブリッジバフ）</b>：{f.powerup.interval !== null && `${clock(f.powerup.initial)}から${duration(f.powerup.interval)}ごとに`}横レーンの橋の上に出現し、近接強攻撃で獲得します。
        次の4種類で、時間がたつほど効果が強くなります。倒されると失います。
      </p>
      {sys["powerups"]?.icons.length ? (
        <ul class="icongrid">
          {sys["powerups"].icons.map((ic) => <li><img src={`${base}/${ic.src}`} alt="" loading="lazy" /><span>{ic.label}</span></li>)}
        </ul>
      ) : null}
      <ul class="notes">
        <li>キャスト系：スピリットパワーとクールダウン短縮</li>
        <li>ガン系：連射速度と弾数</li>
        <li>移動系：スタミナ・スプリント速度・スタミナ回復・ジップライン速度</li>
        <li>生存系：ボーナスHPとHP回復</li>
      </ul>
    </div>

    <h3>ガーディアンとパリィ</h3>
    <p>
      ガーディアンの近接攻撃は<b>パリィ</b>できます。成功するとガーディアンは
      {f.parry.bossNoMeleeSeconds !== null ? <b class="num">{f.parry.bossNoMeleeSeconds}秒間</b> : "しばらく"}近接攻撃ができなくなり、
      その間は味方トルーパーが倒されるまでの時間が大きく延びます。ウェーブを押し込みたい場面で効くテクニックです。
    </p>
    <p class="small">
      ヒーロー同士でも、序盤はヘビーメレーよりパリィを優先する意識が大切です
      （パリィで与えるスタン{f.parry.stunSeconds !== null && `は${f.parry.stunSeconds}秒あり、その間`}ならヘビーメレーが確実に当たります）。
      詳しくは<a href={`${base}/mechanics/controls/#parry`}>キャラクターコントロール</a>へ。
    </p>

    <p class="small">
      ガーディアンを倒すと <b class="num">+{souls(objGold("Tier1"))}</b>。そのレーンのレーン戦はここで終わり、<a href="#postlane">レーン後</a>に移ります。
    </p>
  </section>

  {/* ================= 2. レーン後・中盤 ================= */}
  <section class="chapter panel" id="postlane">
    <h2>2. レーン後・中盤</h2>
    <p>
      ガーディアンが落ちると、レーンを離れて自由に動けるようになります。よくある分担は
      <b>1人がレーンに残ってウェーブのソウルを取り続け、もう1人がガンクや中立キャンプに向かう</b>形です。
      誰が動くかはヒーローとプレイヤーの得意不得意で変わりますが、中立キャンプを素早く倒せるヒーローが
      キャンプを回りながらガンクにも行くことが多いです。
    </p>
    <h3>中盤で意識すること</h3>
    <ul class="notes">
      <li><b>敵側の中立エリアを奪う。</b>自陣のキャンプだけでなく、相手のキャンプを先に倒せればソウル差はそのまま広がります。</li>
      <li>
        <b>{N.rift}と{N.urn}</b>を見逃さない。どちらもミニマップで確認できます。
        {f.rift && `${N.rift}は${clock(f.rift.initial)}から${duration(f.rift.interval)}ごとに出現します。`}
        {f.urnOrbs !== null && `${N.urn}は持ち帰るとソウルオーブが${f.urnOrbs}個出ます。`}
      </li>
      <li><b>ウェーブ・中立キャンプ・{N.vault}を管理する。</b>それぞれ出現と再出現の時間が決まっているので、空いた時間を作らずに回るほどソウルが増えます。数値は<a href={`${base}/mechanics/farm/#farming`}>ファーミング</a>へ。</li>
      <li>
        マップ全体で「今どこで何をすべきか」を考えるのがマクロです。自分がどれだけ試合に貢献し続けているか（稼働率）を意識すると、
        リスポーン待ちや目的のない移動が減り、次の一手を決めやすくなります。
      </li>
    </ul>

    <div class="calc moved">
      <p class="calcnote">
        ソウル差を広げる考え方（テンポ・カウンター・ファネリング）と、ウェーブのフリーズは
        <a href={`${farm}#farming`}>マップとファーム「稼ぎ方」</a>へ。
      </p>
    </div>
  </section>

  {/* ================= ファーミング(移動先の要約) ================= */}
  <section class="chapter panel moved" id="farming">
    <h2>ファーミング</h2>
    <p>
      中立キャンプ・箱・{N.vault}の報酬と出現時刻、地下トンネルの箱は <a href={`${farm}#farming`}>マップとファーム「稼ぎ方」</a>、
      キャンプや箱の位置は <a href={`${farm}#map`} id="map">マップ</a> で確認できます。
    </p>
  </section>

  {/* ================= 3. 終盤 ================= */}
  <section class="chapter panel" id="lategame">
    <h2>3. 終盤</h2>
    <p>
      大きなソウル差がついたり、複数のウォーカーが落ちたりすると、試合は終盤に入ります。
      マップ上のオブジェクトを取り合い、敵の拠点を攻め落としにいく段階です。リスポーンまでの時間が長くなっていくため、
      1回のキルやデスの重みが増していきます。
    </p>
    <ul class="notes">
      <li>
        ウォーカー（<b class="num">+{souls(objGold("Tier2"))}</b>）→ ベース・ガーディアン（<b class="num">+{souls(objGold("BaseGuardians"))}</b>）→
        シュライン（<b class="num">+{souls(objGold("Shrines"))}</b>）→ パトロン の順に攻めます。
      </li>
      <li>
        劣勢側には<b>カムバック</b>の補正がかかります。ネットワースの差に比例して、キル・トルーパー・中立キャンプ・建造物から得るソウルが増えます
        （差がわずかでも効き、倍率の計算式はサーバー側にしかないため載せられません）。
      </li>
      {f.comeback.tickStartSeconds !== null && f.comeback.lowestPct !== null && (
        <li>
          各チームのソウルが少ない下位2人には、{clock(f.comeback.tickStartSeconds)}から<b>ティックゴールド</b>が入り続けます
          （チームの収入に対して最下位 <b class="num">{f.comeback.lowestPct}%</b>、次に低い人 <b class="num">{f.comeback.secondLowestPct}%</b>）。
          {f.comeback.redirectPct !== null && `敵チームの平均ネットワースを上回っている人が得るカムバック分は、その${f.comeback.redirectPct}%がこのティックゴールドへ回されます。`}
        </li>
      )}
      <li>{N.rift}を確保した劣勢側が受ける補正は<a href="#appendix">付録</a>へ。</li>
    </ul>
  </section>

  {/* ================= 付録 ================= */}
  <section class="chapter panel" id="appendix">
    <h2>付録：数値表</h2>
    <p class="small">数値表は内容ごとに、次のページへ移しました。</p>
    <ul class="notes">
      <li>キルの分配率・アイテム価格・レベルに必要な累計ソウル・購入ボーナス・ミニマップ … <a href={`${farm}#tables`}>マップとファーム「数値表」</a></li>
      <li>レーンの建造物・トルーパー・シュライン・中立モンスター（ホーント）・マップ上の目標物 … <a href={objects}>オブジェクト</a></li>
    </ul>

    {rift.length > 0 && (
      <details class="apx">
        <summary>カムバック（{N.rift}を確保した劣勢側の補正）</summary>
        <table>
          <thead><tr><th>項目</th><th>値</th></tr></thead>
          <tbody>{rift.map((r) => <tr><td>{r.label}</td><td class="n">{r.value}</td></tr>)}</tbody>
        </table>
      </details>
    )}

    <details class="apx">
      <summary>{sys["pause"]?.title ?? "ポーズ"}</summary>
      {["pause"].map((id) => sys[id] && (
        <div class="topic">
          {sys[id]!.icons.length > 0 && (
            <ul class="icongrid">
              {sys[id]!.icons.map((ic) => <li><img src={`${base}/${ic.src}`} alt="" loading="lazy" /><span>{ic.label}</span></li>)}
            </ul>
          )}
          <ul class="notes">{sys[id]!.lines.map((line) => <li>{line}</li>)}</ul>
        </div>
      ))}
    </details>
  </section>

  <p class="foot">
    数値はゲーム本体のデータ（<code>heroes.vdata</code> / <code>abilities.vdata</code> / <code>generic_data.vdata</code> /
    <code>misc.vdata</code> / <code>npc_units.vdata</code>）と、ゲームの設定変数（convar。
    {f.convarVersion ? `ClientVersion ${f.convarVersion} のダンプ` : "未取得"}）から自動で出しています。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

  <style>
    .toc { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--sp-3) 0 var(--sp-5); }
    .toc a {
      font-size: 12px; padding: 4px 10px; border: 1px solid var(--c-border); border-radius: 999px;
      background: var(--c-surface); color: var(--c-text-muted);
    }
    .toc a:hover { color: var(--c-accent); border-color: var(--c-accent-dim); text-decoration: none; }

    .chapter { margin-top: var(--sp-5); scroll-margin-top: 72px; }
    .chapter h2 { margin-top: 0; }
    .chapter h3 { margin: var(--sp-5) 0 var(--sp-2); font-size: 15px; color: var(--c-text-strong); }
    .chapter p { line-height: 1.9; font-size: 14px; margin: 0 0 var(--sp-3); }
    .chapter p.small { font-size: 13px; color: var(--c-text-muted); }
    .chapter b { color: var(--c-text-strong); }
    .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
    b.num { color: var(--c-soul); }
    .notes { margin: 0 0 var(--sp-3); padding-left: 1.2em; font-size: 13.5px; line-height: 1.9; }

    /* 全体像: 建造物の連なり */
    .chain { list-style: none; padding: 0; margin: var(--sp-3) 0 var(--sp-4); display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .chain li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 96px; padding: var(--sp-2) var(--sp-3); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .chain .cicon { width: 48px; height: 48px; display: grid; place-items: center; }
    .chain .cicon img { max-width: 48px; max-height: 48px; }
    .chain .ph { width: 32px; height: 32px; border-radius: 50%; border: 1px dashed var(--c-border-strong); }
    .chain .cname { font-size: 12px; color: var(--c-text-strong); white-space: nowrap; }
    .chain .cgold { font-family: var(--font-mono); font-size: 12px; color: var(--c-soul); }
    .chain .cgold.win { color: var(--c-accent); }
    .chain .arrow { position: absolute; right: -9px; top: 50%; transform: translateY(-50%); color: var(--c-text-faint); font-size: 14px; z-index: 1; }

    /* 計算ボックス */
    .calc { margin: var(--sp-3) 0 var(--sp-4); padding: var(--sp-3) var(--sp-4); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .calclabel { font-size: 11px; letter-spacing: .06em; color: var(--c-text-muted); }
    .calcrows { margin-top: var(--sp-2); display: grid; gap: 4px; }
    .calcrows > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px var(--sp-3); font-size: 13px; }
    .calcrows b { color: var(--c-soul); }
    .calc .calcnote { margin: var(--sp-2) 0 0; font-size: 13px; color: var(--c-text-strong); }
    .calc .lh { margin: var(--sp-2) 0 0; }
    .calc .calcsrc { margin: 2px 0 0; font-size: 11px; color: var(--c-text-faint); }

    /* ソウル推移 */
    .chart { margin: var(--sp-3) 0 var(--sp-4); }
    .chart svg { width: 100%; height: auto; display: block; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
    .chart .hl line { stroke: var(--c-border-strong); stroke-dasharray: 3 4; }
    .chart .hl.ult line { stroke: var(--c-spirit); stroke-dasharray: 6 3; }
