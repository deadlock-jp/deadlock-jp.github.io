---
/**
 * 試合の流れ。旧「ゲームシステム」「ソウル獲得システム」「戦略」「オブジェクト」を、
 * 試合の時間軸(全体像 → 準備 → レーン戦 → レーン後 → 終盤)に沿った1本の記事にまとめたもの。
 *
 * 文章は手書き(運営者と相談して練ったもの。deadlock.wiki の文章は使わない。ルール3)。
 * 文中の数値はすべて src/lib/matchFlow.ts ほかがスナップショットから引いたもので、
 * 「1ウェーブで800を超える」のような結論も計算で出している(ルール6)。
 * 付録の数値表は旧ページの表をそのまま移したもの。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import HeroPortrait from "../../../components/HeroPortrait.astro";
import FarmMap from "../../../components/FarmMap.astro";
import farmingNotes from "../../../../data/farming-notes.json" with { type: "json" };
import { matchFlow, clock, duration } from "../../../lib/matchFlow.ts";
import { laneScenarios, ASSUMPTIONS } from "../../../lib/laneScenarios.ts";
import { economyTable, killShareFrac, riftComeback } from "../../../lib/souls.ts";
import { objectTopics } from "../../../lib/objects.ts";
import { gameSystemSections } from "../../../lib/gameSystem.ts";
import { souls, t, item, heroesFile, objectNotes } from "../../../lib/data.ts";
import { resolveImagePath } from "../../../parsers/image-manifest.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const f = matchFlow();
const economy = economyTable();
const shareFrac = killShareFrac();
const rift = riftComeback();
const topics = objectTopics();
const sys = Object.fromEntries(gameSystemSections().map((s) => [s.id, s]));

const pct = (n: number): string => `${Math.round(n * 100)}%`;
const objGold = (key: string): number => f.objectives.find((o) => o.key === key)?.gold ?? 0;

/** アイコン参照を public/ の実ファイルに解決する。無いものは null(絵を出さない) */
function iconSrc(ref: string | null): string | null {
  if (!ref) return null;
  const resolved = resolveImagePath(ref);
  if (!resolved || !existsSync(join(process.cwd(), resolved.outPath))) return null;
  return `${base}/${resolved.outPath.replace(/^public\//, "")}`;
}
const img = (p: string): string | null => (existsSync(join(process.cwd(), "public", p)) ? `${base}/${p}` : null);

/* ---- 0. 全体像: 防衛建造物の順番 ---- */
const chain = [
  { key: "Tier1", name: t("Citadel_Hud_KillFeedGuardian", "ガーディアン"), icon: img("images/npcs/tier_1_boss.png") },
  { key: "Tier2", name: t("Citadel_Hud_KillFeedWalker", "ウォーカー"), icon: img("images/npcs/tier_2_boss.png") },
  { key: "BaseGuardians", name: t("Citadel_Hud_KillFeedBarracksBoss", "ベース・ガーディアン"), icon: null },
  { key: "Shrines", name: t("Citadel_Hud_KillFeedShieldName", "シュライン"), icon: img("images/npcs/shield_generator.png") },
  { key: "PatronPhase1", name: t("Citadel_Hud_KillFeedTitan", "パトロン"), icon: img("images/npcs/patron.png") },
];

/* ---- ゲーム内の呼び名(ルール1) ---- */
const N = {
  midboss: t("Objective_MidBoss", "ミッド・ボス"),
  rift: "不安定な裂け目", // ping_koth などの文中表記。単独の名前トークンが無い
  urn: t("ability_golden_idol", "魂の壺"),
  statue: t("Citadel_ShopStats_GoldenStatues", "黄金像"),
  vault: "罪人の生贄",
};

/* ---- 2. レーン戦: 回復アイテム(運営者が選んだもの。価格や効果はデータから) ---- */
const HEAL_ITEMS = ["upgrade_endurance", "upgrade_health_stimpak", "upgrade_grit", "upgrade_medic_bullets"];
const healItems = HEAL_ITEMS.flatMap((id) => {
  const it = item(id);
  return it ? [{ id, name: t(it.nameToken, id) }] : [];
});

/* ---- おすすめヒーロー(data/farming-notes.json。キーだけ手書きし、名前とアイコンはデータから) ---- */
const recommended = (farmingNotes as { recommendedHeroes: Record<string, string[]> }).recommendedHeroes;
function heroesFor(key: string): { id: number; name: string; icon: string | null }[] {
  return (recommended[key] ?? []).flatMap((heroKey) => {
    const h = Object.values(heroesFile.heroes).find((x) => x.key === heroKey);
    return h ? [{ id: h.id, name: t(h.nameToken, heroKey), icon: h.images.iconSmall }] : [];
  });
}
const tunnelHeroes = heroesFor("tunnel");

/* ---- ソウル推移のグラフ(3つのシナリオ。src/lib/laneScenarios.ts) ---- */
const scenarios = laneScenarios();
const scenarioHero = (key: string) => {
  const h = Object.values(heroesFile.heroes).find((x) => x.key === key);
  return h ? { id: h.id, name: t(h.nameToken, key), icon: h.images.iconSmall } : null;
};
const chart = (() => {
  if (!scenarios) return null;
  const end = ASSUMPTIONS.endSeconds;
  const top = Math.max(...scenarios.map((s) => s.final), f.ultimate?.totalGold ?? 0);
  const step = f.tier1Price || 800;
  const yMax = Math.ceil((top + 200) / step) * step;
  const W = 680, H = 340, L = 50, R = 14, T = 12, B = 34;
  const X = (sec: number) => L + (sec / end) * (W - L - R);
  const Y = (v: number) => T + (1 - v / yMax) * (H - T - B);
  // 処理時間のあいだは斜めに上がり、それ以外は平らになる(点をそのまま直線でつなぐ)
  const path = (pts: { t: number; total: number }[]) =>
    pts.map((p, i) => `${i === 0 ? "M" : "L"}${X(Math.min(p.t, end)).toFixed(1)},${Y(p.total).toFixed(1)}`).join("");
  const lines = [
    ...Array.from({ length: Math.floor(yMax / step) }, (_, i) => ({ v: (i + 1) * step, kind: "buy" })),
    ...(f.ultimate?.totalGold ? [{ v: f.ultimate.totalGold, kind: "ult" }] : []),
  ];
  const minutes = Array.from({ length: Math.floor(end / 60) + 1 }, (_, i) => i);
  return { W, H, L, R, T, B, X, Y, path, lines, minutes, yMax };
})();

/* ---- TIPS: トロフィーコレクター(効果の数値はアイテムのデータから) ---- */
const trophy = (() => {
  const it = item("upgrade_trophy_collector");
  if (!it) return null;
  const perStack = it.properties["StackingGoldPerMinute"]?.value;
  const maxStacks = it.properties["MaxStacks"]?.value;
  if (perStack == null || maxStacks == null) return null;
  return { id: it.id, name: t(it.nameToken, it.id), price: it.cost, perStack, maxStacks };
})();

/* ---- レーン中のタイムライン ---- */
const events = [
  { sec: f.trooper?.firstWaveSeconds ?? null, label: "最初のウェーブ" },
  { sec: f.camps.weak?.initial ?? null, label: "小キャンプ" },
  { sec: f.breakable.firstSeconds, label: "箱・黄金像" },
  { sec: f.powerup.initial, label: "橋バフ" },
  { sec: f.camps.medium?.initial ?? null, label: "中キャンプ" },
  { sec: f.camps.strong?.initial ?? null, label: "大キャンプ" },
  { sec: f.camps.vaults?.initial ?? null, label: N.vault },
  { sec: f.tickGoldStartSeconds, label: "ティックゴールド" },
  { sec: f.rift?.initial ?? null, label: N.rift },
].filter((e): e is { sec: number; label: string } => e.sec !== null);
// 同じ時刻はまとめて1つの目盛りにする
const timeline = [...new Map(events.map((e) => [e.sec, [] as string[]])).keys()]
  .sort((a, b) => a - b)
  .map((sec) => ({ sec, labels: events.filter((e) => e.sec === sec).map((e) => e.label) }));
const timelineMax = Math.max(...timeline.map((e) => e.sec)) + 60;

/* ---- ファーミング: 報酬と難易度 ---- */
const growth = f.neutralReward.weak?.growthPct ?? 0;
const farm = [
  {
    key: "breakables",
    name: "箱・壺などの小物",
    reward: f.breakable.gold !== null ? `${f.breakable.gold}（${f.breakable.dropChancePct}%の確率）` : "—",
    growth: f.breakable.goldPerMinute !== null ? `+${f.breakable.goldPerMinute}／分` : "—",
    first: clock(f.breakable.firstSeconds),
    respawn: duration(f.breakable.respawnSeconds),
  },
  {
    key: "weak",
    name: "小キャンプ（1体あたり）",
    reward: f.neutralReward.weak ? String(f.neutralReward.weak.gold) : "—",
    growth: `+${growth}%／分`,
    first: clock(f.camps.weak?.initial),
    respawn: duration(f.camps.weak?.interval),
  },
  {
    key: "medium",
    name: "中キャンプ（1体あたり）",
    reward: f.neutralReward.normal ? String(f.neutralReward.normal.gold) : "—",
    growth: `+${growth}%／分`,
    first: clock(f.camps.medium?.initial),
    respawn: duration(f.camps.medium?.interval),
  },
  {
    key: "strong",
    name: "大キャンプ（1体あたり）",
    reward: f.neutralReward.strong ? String(f.neutralReward.strong.gold) : "—",
    growth: `+${growth}%／分`,
    first: clock(f.camps.strong?.initial),
    respawn: duration(f.camps.strong?.interval),
  },
  {
    key: "vaults",
    name: `${N.vault}（スロット）`,
    reward: f.neutralReward.vault ? String(f.neutralReward.vault.gold) : "—",
    growth: `+${f.neutralReward.vault?.growthPct ?? 0}%／分`,
    first: clock(f.camps.vaults?.initial),
    respawn: duration(f.camps.vaults?.interval),
  },
  {
    key: "rift",
    name: N.rift,
    reward: f.rift ? `${souls(f.rift.rewardBase)}〜（時間で増える）` : "—",
    growth: "—",
    first: clock(f.rift?.initial),
    respawn: duration(f.rift?.interval),
  },
];

const toc = [
  { id: "overview", label: "0. 全体像" },
  { id: "pregame", label: "1. 準備フェーズ" },
  { id: "laning", label: "2. レーン戦" },
  { id: "postlane", label: "3. レーン後・中盤" },
  { id: "farming", label: "ファーミング" },
  { id: "lategame", label: "4. 終盤" },
  { id: "appendix", label: "付録：数値表" },
];
---

<Base
  title="試合の流れ"
  description="Deadlock（デッドロック）の試合を、準備フェーズ・レーン戦・中盤・終盤の順に解説。初期ソウル、ウェーブのソウル、ディナイ、アイテム購入の目安、中立キャンプの報酬まで、ゲームの生データの数値つき。"
  breadcrumbs={[
    { name: "攻略情報", path: `${base}/mechanics/` },
    { name: "試合の流れ", path: `${base}/mechanics/match/` },
  ]}
>
  <h1>試合の流れ</h1>

  <nav class="toc" aria-label="目次">
    {toc.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
  </nav>

  {/* ================= 0. 全体像 ================= */}
  <section class="chapter panel" id="overview">
    <h2>0. 全体像</h2>
    <p>
      敵の<b>パトロン</b>を破壊したチームが勝ちます。パトロンまでの道のりには防衛建造物が並んでいて、
      手前から順に壊さないと奥には攻撃が届きません。数字は破壊したときに入るソウルです。
    </p>
    <ol class="chain">
      {chain.map((c, i) => (
        <li>
          <span class="cicon">{c.icon ? <img src={c.icon} alt="" loading="lazy" /> : <span class="ph" />}</span>
          <span class="cname">{c.name}</span>
          {objGold(c.key) > 0 ? <span class="cgold">+{souls(objGold(c.key))}</span> : <span class="cgold win">勝利</span>}
          {i < chain.length - 1 && <span class="arrow" aria-hidden="true">›</span>}
        </li>
      ))}
    </ol>
    <p class="small">
      建造物のソウルは、そのうち{f.objectiveNearPlayerPct}%が破壊に関わった近くのプレイヤーへ、残りはチーム全員に均等に入ります。
      パトロンは左右の<b>シュライン</b>を両方壊すまで攻撃を受け付けません。
      また防衛建造物には「バックドア保護」があり、範囲内に守る側のプレイヤーがいない状態がしばらく続くと無敵が解けます（範囲は付録の建造物の数値へ）。
      中央には{N.midboss}がいて、試合開始時から出現しています（倒されると{duration(f.camps.midboss?.interval)}後に再出現、
      以後{duration(Math.abs(f.camps.midboss?.change ?? 0))}ずつ短くなり最短{duration(f.camps.midboss?.min)}）。
    </p>
    <p class="small">
      試合は大きく <a href="#laning">レーン戦</a> → <a href="#postlane">レーン後・中盤</a> → <a href="#lategame">終盤</a> と進みます。
      レーン戦は、自分のレーンのガーディアンが倒れた時点で終わります。
    </p>
  </section>

  {/* ================= 1. 準備フェーズ ================= */}
  <section class="chapter panel" id="pregame">
    <h2>1. 準備フェーズ</h2>
    <p>
      試合が始まる前の短い準備時間で、どのレーンに誰が行くかが決まります。ここで意識したいのは<b>編成のバランス</b>です。
      同じレーンにサポート役が2人、近接で戦うヒーローが2人、といった偏りがあると、そのレーンは苦しくなります。
    </p>
    <ul class="notes">
      <li>偏りがあれば、画面上部の他プレイヤーのポートレートから<b>レーンの交代</b>を持ちかけられます。</li>
      <li>ランクマッチでは、まだ誰にも選ばれていないヒーローへの変更もこの間にできます。</li>
      <li>ストリートブロールでは、この時間にアイテムの選択とスキルポイントの割り振りを行います。</li>
    </ul>
  </section>

  {/* ================= 2. レーン戦 ================= */}
  <section class="chapter panel" id="laning">
    <h2>2. レーン戦</h2>
    <p>
      試合開始から、自分のレーンの<b>ガーディアン</b>が倒れるまでがレーン戦です。
      目的は相手より多くソウルを集めて、先にアイテムとアビリティをそろえることです。
    </p>

    {f.trooper && f.startingGold !== null && (
      <>
        <h3>ソウルの入り方</h3>
        <ul class="notes">
          <li>試合開始時の所持ソウルは <b class="num">{souls(f.startingGold)}</b>。</li>
          <li>
            トルーパーは <b class="num">{f.trooper.squadSize}体</b>で1ウェーブとなり、序盤は <b class="num">{f.trooper.intervalEarly}秒</b>ごとに来ます。
            1体の報酬は <b class="num">{f.trooper.gold}</b>（試合時間1分ごとに <b class="num">+{f.trooper.goldPerMinute}</b>）。
          </li>
          <li>
            倒した瞬間に入るのは報酬の<b>{pct(f.trooper.instantRatio)}</b>だけです。残りは<b>ソウルオーブ</b>として浮き上がるので、撃って回収します。
            回収しないまま少したつと近くの味方に入り、味方がいなければ消えてしまいます。
          </li>
          <li>
            <b>近接攻撃</b>（スキルによる近接ダメージを含む）でトルーパーを倒すとオーブが浮かばず、その分もすぐに入ります。
          </li>
          <li>
            2人レーンでは、近くにいる人数に応じて報酬が分けられ、1人あたり <b class="num">{pct(f.trooperShare[1] ?? 0)}</b> になります
            （{f.trooperShare.map((s, i) => `${i + 1}人 ${pct(s)}`).join("、")}）。
          </li>
        </ul>
        <div class="calc">
          <span class="calclabel">ラストヒットの目安：トルーパーのHPバー</span>
          <ul class="notes lh">
            <li><b>濃い赤が薄くなった</b> … ヘビーメレーで倒せる</li>
            <li><b>薄い赤が点滅している</b> … ライトメレーで倒せる</li>
            <li><b>トルーパー自体が点滅している</b> … 1ダメージでも与えれば倒せる</li>
          </ul>
        </div>
      </>
    )}

    {f.deny && (
      <>
        <h3>ディナイで差が倍に開く</h3>
        <p>
          相手のトルーパーから浮き上がったオーブを先に撃つと<b>ディナイ</b>になり、そのオーブのソウルは
          <b class="num">{f.deny.denierPct}%</b>が自分に入り、相手には<b class="num">{f.deny.deniedPct}%</b>しか入りません。
          相手のマイナスと自分のプラスが同時に起きるので、1回ごとに差が倍になって効いてきます。
        </p>
      </>
    )}

    {f.firstWave && (
      <div class="calc">
        <span class="calclabel">計算：最初のウェーブ（2人レーン）</span>
        <div class="calcrows">
          <div>
            <span>ディナイされなかった場合</span>
            <span class="num">{f.trooper!.squadSize}体 × {f.trooper!.gold} × {pct(f.firstWave.shareDuo)} = +{f.firstWave.full} → 所持 <b>{souls(f.firstWave.afterFull)}</b></span>
          </div>
          <div>
            <span>オーブを<b>1つ</b>ディナイされた場合</span>
            <span class="num">−{f.firstWave.perOrb} → 所持 <b class={f.firstWave.afterOneDeny < f.tier1Price ? "miss" : ""}>{souls(f.firstWave.afterOneDeny)}</b></span>
          </div>
        </div>
        <p class="calcnote">
          {f.firstWave.afterFull >= f.tier1Price
            ? `ディナイされなければ、最初のウェーブだけでティア1アイテム（${souls(f.tier1Price)}）が買えます。`
            : `最初のウェーブだけではティア1アイテム（${souls(f.tier1Price)}）に届きません。`}
          {f.firstWave.deniesToMiss === 1 && <strong class="warn">ところが、オーブを1つディナイされるだけで届かなくなります。最序盤で最も重大なポイントです。</strong>}
          {f.firstWave.deniesToMiss > 1 && `オーブを${f.firstWave.deniesToMiss}つディナイされると届かなくなります。`}
        </p>
        <p class="calcsrc">
          トルーパー1体の報酬は「{f.trooper!.gold} ＋ {f.trooper!.goldPerMinute} × 経過分数」で増えていきます。最初のウェーブ（{clock(f.trooper!.firstWaveSeconds)}）はほぼ{f.trooper!.gold}なので、ここでは{f.trooper!.gold}で計算しています。
          オーブ分も同じ割合で分けられるものとして計算しています。
        </p>
      </div>
    )}

    <h3>買い物の目安</h3>
    <p>
      レーン中は <b class="num">{souls(f.tier1Price)}</b> のティア1アイテムを何個も買うのが基本なので、
      {f.buySteps.map((v) => souls(v)).join("・")} のように <b>{souls(f.tier1Price)}の倍数</b>が買い物のタイミングになります。
    </p>
    {f.ultimate?.totalGold && (
      <p>
        アルティメットアビリティは、所持ソウルの総額が <b class="num">{souls(f.ultimate.totalGold)}</b> になると解放されます
        （初期の{souls(f.startingGold ?? 0)}＋稼いだ{souls(f.ultimate.earnedGold)}。Lv{f.ultimate.level}）。
        レーンの力関係が大きく変わる節目なので、<b>敵と味方のソウル</b>はこまめに確認しましょう。
      </p>
    )}

    <h3>レーン戦のソウル推移</h3>
    <p>同じ8分間でも、動き方しだいで買い物とアルティメットのタイミングは大きく変わります。</p>
    {chart && scenarios && (
      <figure class="chart">
        <figcaption class="lgds">
          {scenarios.map((s, i) => {
            const h = scenarioHero(s.heroKey);
            return (
              <span class={`lgd ${s.key}`}>
                <i class={`sw ${s.key}`} />
                {h && <HeroPortrait name={h.name} image={h.icon} size={24} />}
                <span><b>{["①", "②", "③"][i]} {s.title}</b><small>{s.summary}</small></span>
              </span>
            );
          })}
        </figcaption>
        <svg viewBox={`0 0 ${chart.W} ${chart.H}`} role="img" aria-label="レーン戦の所持ソウルの推移（3つのシナリオ）">
          {chart.lines.map((l) => (
            <g class={`hl ${l.kind}`}>
              <line x1={chart.L} x2={chart.W - chart.R} y1={chart.Y(l.v)} y2={chart.Y(l.v)} />
              <text x={chart.L - 6} y={chart.Y(l.v) + 4} text-anchor="end">{souls(l.v)}</text>
            </g>
          ))}
          <line class="axis" x1={chart.L} x2={chart.W - chart.R} y1={chart.H - chart.B} y2={chart.H - chart.B} />
          {chart.minutes.map((m) => (
            <text class="tick" x={chart.X(m * 60)} y={chart.H - chart.B + 16} text-anchor="middle">{m}:00</text>
          ))}
          {scenarios.map((s) => <path class={`ln ${s.key}`} d={chart.path(s.points)} />)}
          {scenarios.flatMap((s) =>
            s.points
              .filter((p) => p.note === "ファーストブラッド" || p.note === "ガーディアン破壊")
              .map((p) => (
                <g class={`ev ${s.key}`}>
                  <circle cx={chart.X(p.t)} cy={chart.Y(p.total)} r="4" />
                  <text x={chart.X(p.t) - 6} y={chart.Y(p.total) - 8} text-anchor="end">{p.note}</text>
                </g>
              )),
          )}
        </svg>
        <div class="tablewrap">
          <table class="miles">
            <thead>
              <tr>
                <th>到達時刻</th>
                {scenarios[0]!.milestones.map((m) => <th>{souls(m.gold)}{m.gold === f.ultimate?.totalGold ? "（アルティメット）" : ""}</th>)}
                <th>{clock(ASSUMPTIONS.endSeconds)}時点の所持</th>
              </tr>
            </thead>
            <tbody>
              {scenarios.map((s, i) => (
                <tr>
                  <td><i class={`sw ${s.key}`} /> {["①", "②", "③"][i]} {s.title}</td>
                  {s.milestones.map((m) => <td class="n">{m.t === null ? "届かない" : clock(m.t)}</td>)}
                  <td class="n">{souls(s.final)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="cap">
          2人レーンで、ウェーブはトルーパーの出現時刻に到着し、{ASSUMPTIONS.waveSeconds}秒かけて倒すものとしています。
          箱は1個{ASSUMPTIONS.crateSeconds}秒、小キャンプは{ASSUMPTIONS.campSeconds}秒、キルとガーディアン破壊は一瞬で入ります（処理は1つずつ順番）。
          報酬の額・出現時刻・分配率はゲームのデータです。キル報酬は最低額（{f.heroKillMin ?? "—"}）＋ファーストブラッドのボーナス、
          箱は落とす確率をかけた期待値、ガーディアンはレーンの2人と味方全員への配分で計算しています。
          どう動いたか（各シナリオの説明）はこちらで置いた想定です。
        </p>
      </figure>
    )}

    {trophy && (
      <div class="calc tip">
        <span class="calclabel">TIPS</span>
        <p class="calcnote">
          <a href={`${base}/items/${trophy.id}/`}>{trophy.name}</a>（{souls(trophy.price)}）を序盤から買うと、
          キルかアシストのたびに毎分 <b class="num">+{trophy.perStack}</b> のソウル生成が積み上がり（最大{trophy.maxStacks}回・デスしても消えない）、
          ソウルの伸びをブーストできる可能性があります。
        </p>
      </div>
    )}

    <h3>倒されない意識</h3>
    <p>
      試合で最初のキル（ファーストブラッド）を取った側には
      {f.firstKillBonus !== null ? <b class="num">+{f.firstKillBonus}</b> : "追加"}のソウルボーナスが入ります。
      <b>自分は絶対にファーストブラッドを取られない</b>、という意識で立ち回りましょう。
      倒されている間はウェーブのソウルも取れないので、失うものは報酬だけではありません。
    </p>

    <h3>撃ち合いに負けるとき</h3>
    <p>
      どうしてもダメージのやり取り（トレード）で負けてしまうときは、一時的に<b>回復アイテム</b>を買って立て直しましょう。
    </p>
    {healItems.length > 0 && (
      <ul class="chips">
        {healItems.map((h) => <li><a href={`${base}/items/${h.id}/`} data-itemcard={h.id}>{h.name}</a></li>)}
      </ul>
    )}

    <h3>レーン中に起きること</h3>
    <div class="timeline" style={`--max: ${timelineMax}`}>
      {timeline.map((e) => (
        <div class="tev" style={`--at: ${e.sec}`}>
          <span class="tclock">{clock(e.sec)}</span>
          <span class="tlabels">{e.labels.map((l) => <span>{l}</span>)}</span>
        </div>
      ))}
    </div>
    <ul class="notes">
      <li>
        小キャンプや箱から出るソウルもレーン中は差につながります。
      </li>
    </ul>
    <div class="buff">
      <p>
        <b>橋バフ（ブリッジバフ）</b>：{f.powerup.interval !== null && `${clock(f.powerup.initial)}から${duration(f.powerup.interval)}ごとに`}横レーンの橋の上に出現し、近接強攻撃で獲得します。
        次の4種類で、時間がたつほど効果が強くなります。倒されると失います。
      </p>
      {sys["powerups"]?.icons.length ? (
        <ul class="icongrid">
          {sys["powerups"].icons.map((ic) => <li><img src={`${base}/${ic.src}`} alt="" loading="lazy" /><span>{ic.label}</span></li>)}
        </ul>
      ) : null}
      <ul class="notes">
        <li>キャスト系：スピリットパワーとクールダウン短縮</li>
        <li>ガン系：連射速度と弾数</li>
        <li>移動系：スタミナ・スプリント速度・スタミナ回復・ジップライン速度</li>
        <li>生存系：ボーナスHPとHP回復</li>
      </ul>
    </div>

    <h3>ガーディアンとパリィ</h3>
    <p>
      ガーディアンの近接攻撃は<b>パリィ</b>できます。成功するとガーディアンは
      {f.parry.bossNoMeleeSeconds !== null ? <b class="num">{f.parry.bossNoMeleeSeconds}秒間</b> : "しばらく"}近接攻撃ができなくなり、
      その間は味方トルーパーが倒されるまでの時間が大きく延びます。ウェーブを押し込みたい場面で効くテクニックです。
    </p>
    <p class="small">
      ヒーロー同士でも、序盤はヘビーメレーよりパリィを優先する意識が大切です
      （パリィで与えるスタン{f.parry.stunSeconds !== null && `は${f.parry.stunSeconds}秒あり、その間`}ならヘビーメレーが確実に当たります）。
      詳しくは<a href={`${base}/mechanics/controls/#parry`}>キャラクターコントロール</a>へ。
    </p>

    <p class="small">
      ガーディアンを倒すと <b class="num">+{souls(objGold("Tier1"))}</b>。そのレーンのレーン戦はここで終わり、<a href="#postlane">レーン後</a>に移ります。
    </p>
  </section>

  {/* ================= 3. レーン後・中盤 ================= */}
  <section class="chapter panel" id="postlane">
    <h2>3. レーン後・中盤</h2>
    <p>
      ガーディアンが落ちると、レーンを離れて自由に動けるようになります。よくある分担は
      <b>1人がレーンに残ってウェーブのソウルを取り続け、もう1人がガンクや中立キャンプに向かう</b>形です。
      誰が動くかはヒーローとプレイヤーの得意不得意で変わりますが、中立キャンプを素早く倒せるヒーローが
      キャンプを回りながらガンクにも行くことが多いです。
    </p>
    <h3>中盤で意識すること</h3>
    <ul class="notes">
      <li><b>敵側の中立エリアを奪う。</b>自陣のキャンプだけでなく、相手のキャンプを先に倒せればソウル差はそのまま広がります。</li>
      <li>
        <b>{N.rift}と{N.urn}</b>を見逃さない。どちらもミニマップで確認できます。
        {f.rift && `${N.rift}は${clock(f.rift.initial)}から${duration(f.rift.interval)}ごとに出現します。`}
        {f.urnOrbs !== null && `${N.urn}は持ち帰るとソウルオーブが${f.urnOrbs}個出ます。`}
      </li>
      <li><b>ウェーブ・中立キャンプ・{N.vault}を管理する。</b>それぞれ出現と再出現の時間が決まっているので、空いた時間を作らずに回るほどソウルが増えます。数値は<a href="#farming">ファーミング</a>へ。</li>
      <li>
        マップ全体で「今どこで何をすべきか」を考えるのがマクロです。自分がどれだけ試合に貢献し続けているか（稼働率）を意識すると、
        リスポーン待ちや目的のない移動が減り、次の一手を決めやすくなります。
      </li>
    </ul>
    <h3>ソウル差を広げる考え方</h3>
    <ul class="notes">
      <li><b>テンポ</b>：必要のないアイテムを削って、重要な強化に人より早く届くほど有利になります。</li>
      <li><b>カウンター</b>：相手の強みに合わせてアイテムを選びます。ヒーローごとの対策は各ヒーローページの「強みと対策」へ。</li>
      <li><b>ファネリング</b>：チームで意図的に1人へソウルを集め、早く強くする作戦もあります。</li>
      <li>
        撃ち合いでは<b>遮蔽物</b>の使い方が大切です。角ぎりぎりに体を寄せると頭だけ出して撃ち合えます。
        カメラが肩越しに固定されているので、遮蔽物のどちら側から撃つかで、自分と相手の見え方に差が出ます。
      </li>
    </ul>

    <h3>ウェーブのフリーズ</h3>
    <p>
      味方のトルーパーがたまっている状態で、敵のトルーパーを利用してウェーブをその場に留め、
      溜まった味方のトルーパーを一気に流す<b>フリーズ</b>という技術があります。押し込みすぎると自陣から離れて危険になるため、
      あえてウェーブを動かさない判断も必要です。
    </p>
  </section>

  {/* ================= ファーミング ================= */}
  <section class="chapter panel" id="farming">
    <h2>ファーミング</h2>
    <p>
      レーンのウェーブ以外のソウル源です。どれを回るかは、得られるソウルと出現・再出現の時間を見て判断しましょう。
      報酬は試合時間とともに増えます。
    </p>
    <div class="tablewrap">
      <table class="farm">
        <thead><tr><th>対象</th><th>ソウル</th><th>増加</th><th>初回</th><th>再出現</th><th>おすすめヒーロー</th></tr></thead>
        <tbody>
          {farm.map((r) => (
            <tr>
              <td>{r.name}</td>
              <td class="n">{r.reward}</td>
              <td class="n">{r.growth}</td>
              <td class="n">{r.first}</td>
              <td class="n">{r.respawn}</td>
              <td class="rec">
                {heroesFor(r.key).map((h) => (
                  <a href={`${base}/heroes/${h.id}/`} title={h.name}><HeroPortrait name={h.name} image={h.icon} size={22} /></a>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>未回収ソウルに注意</h3>
    <p>
      中立モンスター・{N.vault}・箱から得たソウルは、しばらく<b>未回収</b>の扱いで、その間に倒されると落としてしまいます。
      未回収ソウルを一定以上持ったまま倒されると、その場に<b>ソウルコンテナ</b>が残り、敵味方の誰でもヘビーメレーで拾えます。
      未回収のソウルは時間とともに自動で確保されていくので、ファーム直後に無理な戦闘をしないことが大切です。
    </p>

    <h3>マップ</h3>
    <p>キャンプ・箱・黄金像の場所です。種類ごとに表示を切り替えられ、「地下（共用）」で誰でも入れる地下も見られます。</p>
    <FarmMap />

    {f.waveByMinute.length > 0 && (
      <>
        <h3>レーンのウェーブ</h3>
        <p>1ウェーブ（全員分）のソウルは時間とともに増えます。レーンに残ってウェーブを取り続けることも立派なファームです。</p>
        <div class="tablewrap">
          <table>
            <thead><tr><th>経過時間</th><th>1体</th><th>1ウェーブ</th><th>ウェーブ間隔</th></tr></thead>
            <tbody>
              {f.waveByMinute.map((w) => (
                <tr>
                  <td>{w.minute}分</td>
                  <td class="n">{w.perTrooper}</td>
                  <td class="n">{w.perWave}</td>
                  <td class="n">
                    {w.minute >= f.trooper!.intervalVeryLateMinutes
                      ? f.trooper!.intervalVeryLate
                      : w.minute >= f.trooper!.intervalLateMinutes
                        ? f.trooper!.intervalLate
                        : f.trooper!.intervalEarly}秒
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {tunnelHeroes.length > 0 && (
      <div class="special">
        <span class="speciallabel">特別枠</span>
        <h3>地下トンネルの箱</h3>
        <p>
          地下トンネルの中にも箱があり、トンネルに入れるのは次の{tunnelHeroes.length}人だけです。
          入れるヒーローが限られた、特別なソウル源です。
        </p>
        {f.tunnel && (
          <ul class="notes">
            <li>
              箱 <b class="num">{f.tunnel.crates}</b>個・黄金像 <b class="num">{f.tunnel.statues}</b>個。
              {clock(f.tunnel.firstSeconds)}に出現し、壊してから{duration(f.tunnel.respawnSeconds)}で再出現します（地上の箱より遅め）。
            </li>
            {f.breakable.gold !== null && (
              <li>箱から出るソウルは地上と同じで、{f.breakable.dropChancePct}%の確率で <b class="num">{f.breakable.gold}</b>（1分ごとに+{f.breakable.goldPerMinute}）。</li>
            )}
            <li>場所は上のマップの「地下トンネルの箱（3人専用）」で確認できます。</li>
          </ul>
        )}
        <ul class="heroes">
          {tunnelHeroes.map((h) => (
            <li>
              <a href={`${base}/heroes/${h.id}/`}>
                <HeroPortrait name={h.name} image={h.icon} size={40} />
                <span>{h.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </section>

  {/* ================= 4. 終盤 ================= */}
  <section class="chapter panel" id="lategame">
    <h2>4. 終盤</h2>
    <p>
      大きなソウル差がついたり、複数のウォーカーが落ちたりすると、試合は終盤に入ります。
      マップ上のオブジェクトを取り合い、敵の拠点を攻め落としにいく段階です。リスポーンまでの時間が長くなっていくため、
      1回のキルやデスの重みが増していきます。
    </p>
    <ul class="notes">
      <li>
        ウォーカー（<b class="num">+{souls(objGold("Tier2"))}</b>）→ ベース・ガーディアン（<b class="num">+{souls(objGold("BaseGuardians"))}</b>）→
        シュライン（<b class="num">+{souls(objGold("Shrines"))}</b>）→ パトロン の順に攻めます。
      </li>
      <li>
        劣勢側には<b>カムバック</b>の補正がかかります。ネットワースの差に比例して、キル・トルーパー・中立キャンプ・建造物から得るソウルが増えます
        （差がわずかでも効き、倍率の計算式はサーバー側にしかないため載せられません）。
      </li>
      {f.comeback.tickStartSeconds !== null && f.comeback.lowestPct !== null && (
        <li>
          各チームのソウルが少ない下位2人には、{clock(f.comeback.tickStartSeconds)}から<b>ティックゴールド</b>が入り続けます
          （チームの収入に対して最下位 <b class="num">{f.comeback.lowestPct}%</b>、次に低い人 <b class="num">{f.comeback.secondLowestPct}%</b>）。
          {f.comeback.redirectPct !== null && `敵チームの平均ネットワースを上回っている人が得るカムバック分は、その${f.comeback.redirectPct}%がこのティックゴールドへ回されます。`}
        </li>
      )}
      <li>{N.rift}を確保した劣勢側が受ける補正は<a href="#appendix">付録</a>へ。</li>
    </ul>
  </section>

  {/* ================= 付録 ================= */}
  <section class="chapter panel" id="appendix">
    <h2>付録：数値表</h2>

    <details class="apx" open>
      <summary>キルの分配率</summary>
      <table>
        <thead><tr><th>絡んだ人数</th><th>トルーパー</th><th>ヒーロー</th></tr></thead>
        <tbody>
          {shareFrac.map((r) => (
            <tr><td>{r.count}人</td><td class="n">{pct(r.trooperFrac)}</td><td class="n">{pct(r.heroFrac)}</td></tr>
          ))}
        </tbody>
      </table>
    </details>

    <details class="apx">
      <summary>アイテム価格・レベル・購入ボーナス</summary>
      <div class="econ">
        <div>
          <h4>ティアごとのアイテム価格</h4>
          <table>
            <thead><tr><th>ティア</th><th>価格</th></tr></thead>
            <tbody>{economy.itemPrices.map((p) => <tr><td>T{p.tier}</td><td class="n">{souls(p.cost)}</td></tr>)}</tbody>
          </table>
        </div>
        <div>
          <h4>レベルに必要な累計ソウル</h4>
          <p class="sub">初期の{souls(f.startingGold ?? 0)}を含まない、試合中に稼いだ分。</p>
          <table>
            <thead><tr><th>Lv</th><th>累計</th></tr></thead>
            <tbody>{economy.levels.map((l) => <tr><td>{l.level}</td><td class="n">{souls(l.requiredGold)}</td></tr>)}</tbody>
          </table>
        </div>
        <div class="wide">
          <h4>購入ボーナス</h4>
          <p class="sub">そのカテゴリに投資した累計ソウルが閾値を超えるたびに、対応するステータスが上がります。全ヒーロー共通です。</p>
          <div class="tablewrap">
            <table>
              <thead><tr><th>累計投資額</th>{economy.costBonuses.map((c) => <th>{c.label}</th>)}</tr></thead>
              <tbody>
                {(economy.costBonuses[0]?.rows ?? []).map((_, i) => (
                  <tr>
                    <td class="n">{souls(economy.costBonuses[0]!.rows[i]!.goldThreshold)}</td>
                    {economy.costBonuses.map((c) => <td class="n">+{c.rows[i]?.bonus ?? "—"}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </details>

    {rift.length > 0 && (
      <details class="apx">
        <summary>カムバック（{N.rift}を確保した劣勢側の補正）</summary>
        <table>
          <thead><tr><th>項目</th><th>値</th></tr></thead>
          <tbody>{rift.map((r) => <tr><td>{r.label}</td><td class="n">{r.value}</td></tr>)}</tbody>
        </table>
      </details>
    )}

    <details class="apx">
      <summary>建造物・トルーパー・中立モンスターの数値</summary>
      {topics.map((topic) => (
        <div class="topic">
          <h4>{topic.title}</h4>
          <div class="objs">
            {topic.objects.map((o) => {
              const src = iconSrc(o.icon);
              const tips = objectNotes(o.id);
              return (
                <div class="obj">
                  <h5>{src && <img class="oicon" src={src} alt="" loading="lazy" />}{o.name}</h5>
                  <dl>
                    {o.stats.map((s) => <div class="row"><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
                  </dl>
                  {tips.length > 0 && <ul class="otips">{tips.map((tip) => <li>{tip}</li>)}</ul>}
                </div>
              );
            })}
          </div>
          {topic.lines.length > 0 && <ul class="notes">{topic.lines.map((line) => <li>{line}</li>)}</ul>}
        </div>
      ))}
    </details>

    <details class="apx">
      <summary>その他のルール（ミニマップ・移動手段・ポーズ）</summary>
      {["map-objects", "minimap", "pause"].map((id) => sys[id] && (
        <div class="topic">
          <h4>{sys[id]!.title}</h4>
          {sys[id]!.icons.length > 0 && (
            <ul class="icongrid">
              {sys[id]!.icons.map((ic) => <li><img src={`${base}/${ic.src}`} alt="" loading="lazy" /><span>{ic.label}</span></li>)}
            </ul>
          )}
          <ul class="notes">{sys[id]!.lines.map((line) => <li>{line}</li>)}</ul>
        </div>
      ))}
    </details>
  </section>

  <p class="foot">
    数値はゲーム本体のデータ（<code>heroes.vdata</code> / <code>abilities.vdata</code> / <code>generic_data.vdata</code> /
    <code>misc.vdata</code> / <code>npc_units.vdata</code>）と、ゲームの設定変数（convar。
    {f.convarVersion ? `ClientVersion ${f.convarVersion} のダンプ` : "未取得"}）から自動で出しています。
    <a href={`${base}/about/`}>このサイトについて</a>
  </p>

