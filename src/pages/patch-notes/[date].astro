---
/**
 * 公式アップデート1件のページ。URL はその投稿の日付(/patch-notes/2026-08-22/)。
 *
 * 上にゲームデータから抽出したバランス調整、下に Valve 公式の投稿本文。
 * 本文はここにしか置かない(一覧ページにも載せると同じ文章がサイト内で
 * 二重になり、検索側にどちらを出すか委ねることになる)。
 *
 * 多言語版(/en/patch-notes/<日付>/ など。入口は src/pages/[lang]/patch-notes/)も同じ実装で描く。
 *   - バランス調整は changes[] からその言語で組み立てる(updates.json の note の日本語文は使わない)
 *   - 公式の本文と題は英語の原文(翻訳しない)。lang="en" を付ける
 *   - 手書きの補足(update-notes.json)は日本語のまま、lang="ja" と「日本語のみ」を付ける
 * 日本語版の出力は多言語化の前と変えない(文言は辞書 patchPage に移しただけ)。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import BalanceDetail from "../../components/BalanceDetail.astro";
import AbilityHoverCards from "../../components/AbilityHoverCards.astro";
import { patchNotes, ADJUSTMENT_LABEL, heroesAnnouncedIn, t, noteTitle, noteLines } from "../../lib/data.ts";
import { balanceUpdateByDate } from "../../lib/balance.ts";
import { updateNoteSections, updateNoteSources } from "../../lib/updateNotes.ts";

export function getStaticPaths() {
  return patchNotes().map((n) => ({ params: { date: n.date }, props: { note: n } }));
}

const { note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, currentLang, langPath } = Astro.locals.i18n;
const T = L();
const P = T.patchPage;
const lang = currentLang();
const isJa = lang === "ja";
/** 英語の原文を出す要素に付ける lang。英語版のページでは不要なので付けない(日本語版では出さない) */
const enLang = isJa || lang === "en" ? undefined : "en";
/** 日本語の手書きを出す要素に付ける lang(日本語版では付けない) */
const jaLang = isJa ? undefined : "ja";
const pageLink = (p: string) => `${base}${langPath(p)}`;

const update = balanceUpdateByDate(note.date, base);
/* このアップデートで発表された新ヒーロー(解禁前はデータが名前と絵だけなので、カードだけ出す) */
const announced = heroesAnnouncedIn(update?.fromVersion ?? null, update?.toVersion ?? null);

/* General 節のうち、対応する数値がゲームデータに無くて差分に出てこない変更 */
const generalSections = updateNoteSections(note.date);
/* その手書きを書くときに読んだ、パッチノート以外の告知(特設ページなど) */
const noteSources = updateNoteSources(note.date);

/** "## 見出し" 行と通常行を分けて、見出しごとの塊にする(一覧ページと同じ規則) */
function toSections(lines: string[]): { heading: string | null; items: string[] }[] {
  const sections: { heading: string | null; items: string[] }[] = [];
  for (const line of lines) {
    if (line.startsWith("## ")) {
      sections.push({ heading: line.slice(3), items: [] });
      continue;
    }
    if (sections.length === 0) sections.push({ heading: null, items: [] });
    sections[sections.length - 1]!.items.push(line);
  }
  return sections.filter((s) => s.items.length > 0);
}
const sections = toSections(noteLines(note, lang));
const title = noteTitle(note, lang);

/* 前後のアップデートへの導線。日付の新しい順に並んでいる */
const all = patchNotes();
const at = all.findIndex((n) => n.date === note.date);
const newer = at > 0 ? all[at - 1] : null;
const older = at >= 0 && at < all.length - 1 ? all[at + 1] : null;

/* スキルアイコンのホバー詳細。このページに出るスキルぶんだけ用意する */
const abilityKeys = [
  ...new Set(
    (update?.entities ?? []).flatMap((e) =>
      e.groups.map((g) => g.abilityKey).filter((k): k is string => !!k),
    ),
  ),
];

const summary = update
  ? (["buff", "nerf", "mixed", "rework", "neutral"] as const)
      .filter((k) => update.counts[k] > 0)
      .map((k) => `${ADJUSTMENT_LABEL[k]} ${update.counts[k]}`)
      .join(" / ")
  : null;
/*
 * description に入れる主な対象。実際に値が変わったヒーロー/アイテムを先に(項目の追加・削除だけのものは
 * データの書き方の変化のことが多いので後ろに回す)、その中で先頭から4つ
 */
const mainNames = (update?.entities ?? [])
  .filter((e) => e.target !== "system" && e.kind !== "neutral")
  .sort((x, y) => Number(y.realChange) - Number(x.realChange))
  .slice(0, 4)
  .map((e) => e.name);

/*
 * XやDiscordに貼ったときのプレビュー画像。そのアップデートの「注目トピック」を
 * 手作りした 1600x900 を public/images/patch-notes/<日付>.jpg に置いておくと拾う。
 * 無ければ Base 側の既定(images/ogp.jpg)に落ちる。heroes/[id].astro と同じ規約。
 * 画像の文字は日本語なので、日本語版でだけ使う。
 */
const ogRel = `images/patch-notes/${note.date}.jpg`;
const ogImage = isJa && existsSync(join(process.cwd(), "public", ogRel)) ? `/${ogRel}` : undefined;
---

<Base
  title={P.pageTitle(title, note.date)}
  description={P.pageDescription({ title, date: note.date, summary, names: mainNames })}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImage ? 1600 : undefined}
  ogImageHeight={ogImage ? 900 : undefined}
  datePublished={note.date}
  breadcrumbs={[
    { name: T.nav.patchNotes, path: pageLink("/patch-notes/") },
    { name: title, path: pageLink(`/patch-notes/${note.date}/`) },
  ]}
>
  <h1 lang={enLang}>{title}</h1>
  <p class="meta">
    <time datetime={note.date}>{note.date}</time>
    {update?.fromVersion && update?.toVersion && (
      <span class="ver">build {update.fromVersion} → {update.toVersion}</span>
    )}
    {summary && <span class="sum">{summary}</span>}
  </p>

  {announced.length > 0 && (
    <section class="block panel">
      <h2>{P.newHeroes}</h2>
      <p class="note">{P.newHeroesNote}</p>
      <ul class="newheroes">
        {announced.map(({ hero, released }) => {
          const key = hero.key.replace(/^hero_/, "");
          const body = (
            <>
              <img src={`${base}/images/heroes/upcoming/${key}.webp`} alt="" width="240" height="567" loading="lazy" />
              <span class="nh-name">{t(hero.nameToken)}</span>
              <span class={released ? "nh-tag done" : "nh-tag"}>{released ? P.released : P.upcoming}</span>
            </>
          );
          return (
            <li>
              {released ? <a class="nh" href={pageLink(`/heroes/${hero.id}/`)}>{body}</a> : <div class="nh">{body}</div>}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {generalSections.length > 0 && (
    <section class="block panel">
      <h2>{P.summaryTitle}{!isJa && <span class="jaonly">{T.jaOnly}</span>}</h2>
      <p class="note">{P.summaryNote}</p>
      {generalSections.map((s) => (
        <div class="gsection" lang={jaLang}>
          <h3>{s.title}</h3>
          <ul>
            {s.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      ))}
      {noteSources.length > 0 && (
        <p class="src">
          {P.sources}
          {noteSources.map((src, i) => (
            <>
              {i > 0 && P.sourcesSep}
              <a href={src.url} rel="noopener" target="_blank" lang={jaLang}>{src.label}</a>
            </>
          ))}
          {P.sourcesTail}
        </p>
      )}
    </section>
  )}

  {update ? (
    <section class="block panel">
      <h2>{T.adjust.historyTitle}</h2>
      <p class="note">{P.balanceNote}</p>
      <BalanceDetail entities={update.entities} />
      <ul class="legend">
        <li class="good">{P.legendGood}</li>
        <li class="bad">{P.legendBad}</li>
        <li class="flat">{P.legendFlat}</li>
      </ul>
    </section>
  ) : (
    <p class="none">{P.noBalance}</p>
  )}

  <section class="block panel">
    <h2>{P.officialTitle}</h2>
    <p class="note">{P.officialNote}</p>
    {sections.map((s) => (
      <div class="psection" lang={isJa ? undefined : "en"}>
        {s.heading && <h3>{s.heading}</h3>}
        <ul>
          {s.items.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ))}
    <p class="src">
      <a href={note.url} rel="noopener" target="_blank">{P.viewOriginal}</a>
    </p>
  </section>

  <nav class="pager">
    {older ? (
      <a href={pageLink(`/patch-notes/${older.date}/`)} lang={enLang}>← {noteTitle(older, lang)}</a>
    ) : (
      <span></span>
    )}
    <a class="all" href={pageLink("/patch-notes/")}>{P.allUpdates}</a>
    {newer ? <a href={pageLink(`/patch-notes/${newer.date}/`)} lang={enLang}>{noteTitle(newer, lang)} →</a> : <span></span>}
  </nav>

  <AbilityHoverCards abilityKeys={abilityKeys} />

  <style>
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin: calc(var(--sp-2) * -1) 0 var(--sp-5);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .sum { color: var(--c-text-muted); }
    .note {
      margin: 0 0 var(--sp-3);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .none { color: var(--c-text-muted); }

    .newheroes {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(120px, 30%), 1fr));
      gap: var(--sp-3);
    }
    .nh {
      position: relative;
      display: block;
      color: inherit;
      text-decoration: none;
    }
    .nh img {
      display: block;
      width: 100%;
      height: auto;
    }
    .nh-name {
      display: block;
      margin-top: var(--sp-1);
      font-size: 13px;
      font-weight: 600;
      text-align: center;
    }
    .nh-tag {
      position: absolute;
      top: 6px;
      left: 6px;
      padding: 1px 7px;
      border-radius: 3px;
      background: var(--c-accent);
      color: #111;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .nh-tag.done {
      background: var(--c-surface);
      color: var(--c-text-muted);
    }
    a.nh:hover .nh-name { text-decoration: underline; }

    .legend {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin: var(--sp-4) 0 0;
      padding: 0;
      font-size: 12px;
      color: var(--c-text-muted);
    }
    .legend li {
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .legend li::before {
      content: "";
      width: 12px;
      height: 12px;
      border-radius: 3px;
      border: 1px solid var(--c-border);
      background: var(--c-surface);
    }
    .legend .good::before { border-color: var(--c-buff-dim); background: var(--c-buff-bg); }
    .legend .bad::before { border-color: var(--c-nerf-dim); background: var(--c-nerf-bg); }

    .gsection h3,
    .psection h3 {
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--c-text-muted);
      margin: var(--sp-3) 0 var(--sp-1);
      border: none;
      padding: 0;
    }
    .gsection:first-of-type h3 { margin-top: 0; }
    .gsection ul {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
    }
    .psection ul {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.8;
      /* Valveの本文にはURLがそのまま入ることがある。途中で折り返せないと横に伸びる */
      overflow-wrap: anywhere;
    }
    .src {
      margin: var(--sp-4) 0 0;
      font-size: 12px;
    }

    .pager {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-3);
      margin-top: var(--sp-5);
      font-size: 12px;
    }
    .pager a { text-decoration: none; }
    .pager a:hover { text-decoration: underline; }
    .pager > :last-child { text-align: right; }
    .pager .all { color: var(--c-text-muted); white-space: nowrap; }

    @media (max-width: 560px) {
      .pager {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sp-2);
      }
      .pager > :last-child { text-align: left; }
    }
  </style>
</Base>
