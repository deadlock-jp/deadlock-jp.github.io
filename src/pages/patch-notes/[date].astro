---
/**
 * 公式アップデート1件のページ。URL はその投稿の日付(/patch-notes/2026-08-22/)。
 *
 * 上にゲームデータから抽出したバランス調整、下に Valve 公式の投稿本文。
 * 本文はここにしか置かない(一覧ページにも載せると同じ文章がサイト内で
 * 二重になり、検索側にどちらを出すか委ねることになる)。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import BalanceDetail from "../../components/BalanceDetail.astro";
import AbilityHoverCards from "../../components/AbilityHoverCards.astro";
import { patchNotes, ADJUSTMENT_LABEL, heroesAnnouncedIn, t } from "../../lib/data.ts";
import { balanceUpdateByDate } from "../../lib/balance.ts";
import { updateNoteSections, updateNoteSources } from "../../lib/updateNotes.ts";

export function getStaticPaths() {
  return patchNotes().map((n) => ({ params: { date: n.date }, props: { note: n } }));
}

const { note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const update = balanceUpdateByDate(note.date, base);
/* このアップデートで発表された新ヒーロー(解禁前はデータが名前と絵だけなので、カードだけ出す) */
const announced = heroesAnnouncedIn(update?.fromVersion ?? null, update?.toVersion ?? null);

/* General 節のうち、対応する数値がゲームデータに無くて差分に出てこない変更 */
const generalSections = updateNoteSections(note.date);
/* その手書きを書くときに読んだ、パッチノート以外の告知(特設ページなど) */
const noteSources = updateNoteSources(note.date);

/** "## 見出し" 行と通常行を分けて、見出しごとの塊にする(一覧ページと同じ規則) */
function toSections(lines: string[]): { heading: string | null; items: string[] }[] {
  const sections: { heading: string | null; items: string[] }[] = [];
  for (const line of lines) {
    if (line.startsWith("## ")) {
      sections.push({ heading: line.slice(3), items: [] });
      continue;
    }
    if (sections.length === 0) sections.push({ heading: null, items: [] });
    sections[sections.length - 1]!.items.push(line);
  }
  return sections.filter((s) => s.items.length > 0);
}
const sections = toSections(note.lines);

/* 前後のアップデートへの導線。日付の新しい順に並んでいる */
const all = patchNotes();
const at = all.findIndex((n) => n.date === note.date);
const newer = at > 0 ? all[at - 1] : null;
const older = at >= 0 && at < all.length - 1 ? all[at + 1] : null;

/* スキルアイコンのホバー詳細。このページに出るスキルぶんだけ用意する */
const abilityKeys = [
  ...new Set(
    (update?.entities ?? []).flatMap((e) =>
      e.groups.map((g) => g.abilityKey).filter((k): k is string => !!k),
    ),
  ),
];

const summary = update
  ? (["buff", "nerf", "mixed", "rework", "neutral"] as const)
      .filter((k) => update.counts[k] > 0)
      .map((k) => `${ADJUSTMENT_LABEL[k]} ${update.counts[k]}`)
      .join(" / ")
  : null;

/*
 * XやDiscordに貼ったときのプレビュー画像。そのアップデートの「注目トピック」を
 * 手作りした 1600x900 を public/images/patch-notes/<日付>.jpg に置いておくと拾う。
 * 無ければ Base 側の既定(images/ogp.jpg)に落ちる。heroes/[id].astro と同じ規約。
 */
const ogRel = `images/patch-notes/${note.date}.jpg`;
const ogImage = existsSync(join(process.cwd(), "public", ogRel)) ? `/${ogRel}` : undefined;
---

<Base
  title={note.title}
  description={`Deadlock（デッドロック）${note.date} のアップデート。${
    summary ? `${summary}。` : ""
  }ゲームデータから抽出した数値の変更点と、Valve公式のパッチノート本文。`}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImage ? 1600 : undefined}
  ogImageHeight={ogImage ? 900 : undefined}
  datePublished={note.date}
  breadcrumbs={[
    { name: "パッチノート", path: `${base}/patch-notes/` },
    { name: note.title, path: `${base}/patch-notes/${note.date}/` },
  ]}
>
  <h1>{note.title}</h1>
  <p class="meta">
    <time datetime={note.date}>{note.date}</time>
    {update?.fromVersion && update?.toVersion && (
      <span class="ver">build {update.fromVersion} → {update.toVersion}</span>
    )}
    {summary && <span class="sum">{summary}</span>}
  </p>

  {announced.length > 0 && (
    <section class="block panel">
      <h2>新ヒーロー</h2>
      <p class="note">
        このアップデートで発表されたヒーローです。解禁されるまではゲームデータに名前と絵しかないため、
        ステータスとスキルは解禁後に掲載します。
      </p>
      <ul class="newheroes">
        {announced.map(({ hero, released }) => {
          const key = hero.key.replace(/^hero_/, "");
          const body = (
            <>
              <img src={`${base}/images/heroes/upcoming/${key}.webp`} alt="" width="240" height="567" loading="lazy" />
              <span class="nh-name">{t(hero.nameToken)}</span>
              <span class={released ? "nh-tag done" : "nh-tag"}>{released ? "追加済み" : "近日追加"}</span>
            </>
          );
          return (
            <li>
              {released ? <a class="nh" href={`${base}/heroes/${hero.id}/`}>{body}</a> : <div class="nh">{body}</div>}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {generalSections.length > 0 && (
    <section class="block panel">
      <h2>変更点のまとめ</h2>
      <p class="note">
        ゲームデータに数値が無く、下のバランス調整に出てこない変更です。
        公式の告知を読んで、日本語で手書きしています。
      </p>
      {generalSections.map((s) => (
        <div class="gsection">
          <h3>{s.title}</h3>
          <ul>
            {s.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      ))}
      {noteSources.length > 0 && (
        <p class="src">
          出典：
          {noteSources.map((src, i) => (
            <>
              {i > 0 && "、"}
              <a href={src.url} rel="noopener" target="_blank">{src.label}</a>
            </>
          ))}
          、公式パッチノート（下）
        </p>
      )}
    </section>
  )}

  {update ? (
    <section class="block panel">
      <h2>バランス調整</h2>
      <p class="note">
        ゲームデータの差分から自動生成しています。公式の文面に無い変更も含みます。
      </p>
      <BalanceDetail entities={update.entities} />
      <ul class="legend">
        <li class="good">有利な向きに動いた項目</li>
        <li class="bad">不利な向きに動いた項目</li>
        <li class="flat">向きを判定していない項目</li>
      </ul>
    </section>
  ) : (
    <p class="none">
      このアップデートの数値差分はまだありません（前後のスナップショットが揃っていない期間のものです）。
    </p>
  )}

  <section class="block panel">
    <h2>公式パッチノート</h2>
    <p class="note">
      Steamの公式ニュースから取得した、Valve公式の投稿本文です。第三者の要約や翻訳ではありません。
    </p>
    {sections.map((s) => (
      <div class="psection">
        {s.heading && <h3>{s.heading}</h3>}
        <ul>
          {s.items.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ))}
    <p class="src">
      <a href={note.url} rel="noopener" target="_blank">Steamで原文を見る →</a>
    </p>
  </section>

  <nav class="pager">
    {older ? (
      <a href={`${base}/patch-notes/${older.date}/`}>← {older.title}</a>
    ) : (
      <span></span>
    )}
    <a class="all" href={`${base}/patch-notes/`}>アップデート一覧</a>
    {newer ? <a href={`${base}/patch-notes/${newer.date}/`}>{newer.title} →</a> : <span></span>}
  </nav>

  <AbilityHoverCards abilityKeys={abilityKeys} />

  <style>
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin: calc(var(--sp-2) * -1) 0 var(--sp-5);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .sum { color: var(--c-text-muted); }
    .note {
      margin: 0 0 var(--sp-3);
      font-size: 12px;
      color: var(--c-text-faint);
    }
    .none { color: var(--c-text-muted); }

    .newheroes {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(120px, 30%), 1fr));
      gap: var(--sp-3);
    }
    .nh {
      position: relative;
      display: block;
      color: inherit;
      text-decoration: none;
    }
    .nh img {
      display: block;
      width: 100%;
      height: auto;
    }
    .nh-name {
      display: block;
      margin-top: var(--sp-1);
      font-size: 13px;
      font-weight: 600;
      text-align: center;
    }
    .nh-tag {
      position: absolute;
      top: 6px;
      left: 6px;
      padding: 1px 7px;
      border-radius: 3px;
      background: var(--c-accent);
      color: #111;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .nh-tag.done {
      background: var(--c-surface);
      color: var(--c-text-muted);
    }
    a.nh:hover .nh-name { text-decoration: underline; }

    .legend {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin: var(--sp-4) 0 0;
      padding: 0;
      font-size: 12px;
      color: var(--c-text-muted);
    }
    .legend li {
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .legend li::before {
      content: "";
      width: 12px;
      height: 12px;
      border-radius: 3px;
      border: 1px solid var(--c-border);
      background: var(--c-surface);
    }
    .legend .good::before { border-color: var(--c-buff-dim); background: var(--c-buff-bg); }
    .legend .bad::before { border-color: var(--c-nerf-dim); background: var(--c-nerf-bg); }

    .gsection h3,
    .psection h3 {
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--c-text-muted);
      margin: var(--sp-3) 0 var(--sp-1);
      border: none;
      padding: 0;
    }
    .gsection:first-of-type h3 { margin-top: 0; }
    .gsection ul {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.9;
    }
    .psection ul {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.8;
      /* Valveの本文にはURLがそのまま入ることがある。途中で折り返せないと横に伸びる */
      overflow-wrap: anywhere;
    }
    .src {
      margin: var(--sp-4) 0 0;
      font-size: 12px;
    }

    .pager {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-3);
      margin-top: var(--sp-5);
      font-size: 12px;
    }
    .pager a { text-decoration: none; }
    .pager a:hover { text-decoration: underline; }
    .pager > :last-child { text-align: right; }
    .pager .all { color: var(--c-text-muted); white-space: nowrap; }

    @media (max-width: 560px) {
      .pager {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sp-2);
      }
      .pager > :last-child { text-align: left; }
    }
  </style>
</Base>
