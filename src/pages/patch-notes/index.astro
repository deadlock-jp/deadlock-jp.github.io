---
/**
 * アップデートの一覧。
 *
 * 公式の投稿本文は各アップデートのページ(/patch-notes/<日付>/)にだけ置く。
 * ここに全文も載せると同じ文章がサイト内で二重になり、検索側にどちらを出すか
 * 委ねることになるため、一覧はタイトル・日付・バランス調整のアイコンだけにする。
 *
 * 多言語版(/en/patch-notes/ など)も同じ実装。題は英語の原文(lang="en")。
 */
import Base from "../../layouts/Base.astro";
import BalanceChips from "../../components/BalanceChips.astro";
import ItemHoverCard from "../../components/ItemHoverCard.astro";
import AbilityHoverCards from "../../components/AbilityHoverCards.astro";
import { patchNotes, noteTitle } from "../../lib/data.ts";
import { balanceUpdates } from "../../lib/balance.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, currentLang, langPath } = Astro.locals.i18n;
const T = L();
const P = T.patchPage;
const lang = currentLang();
/** 英語の原文の題に付ける lang。英語版・日本語版では付けない */
const enLang = lang === "ja" || lang === "en" ? undefined : "en";
const updates = new Map(balanceUpdates(base).map((u) => [u.date, u]));
const entries = patchNotes().map((n) => ({ note: n, update: updates.get(n.date) ?? null }));

const abilityKeys = [
  ...new Set(
    [...updates.values()].flatMap((u) =>
      u.chips.map((c) => c.abilityKey).filter((k): k is string => !!k),
    ),
  ),
];
---

<Base
  title={P.indexTitle}
  description={P.indexDescription}
  breadcrumbs={[{ name: T.nav.patchNotes, path: `${base}${langPath("/patch-notes/")}` }]}
>
  <h1>{P.indexTitle}</h1>
  <p class="lead">{P.leadBefore}<a href="https://store.steampowered.com/news/app/1422450" rel="noopener">Deadlock — News</a>{P.leadAfter}</p>

  {entries.length === 0 && <p class="empty">{P.empty}</p>}

  <ol class="updates">
    {entries.map(({ note, update }) => (
      <li class="update panel">
        <div class="uhead">
          <a class="utitle" href={`${base}${langPath(`/patch-notes/${note.date}/`)}`} lang={enLang}>{noteTitle(note, lang)}</a>
          <time class="udate" datetime={note.date}>{note.date}</time>
        </div>
        {update ? (
          <BalanceChips chips={update.chips} max={16} />
        ) : (
          <p class="nodata">{P.noData}</p>
        )}
      </li>
    ))}
  </ol>

  <ItemHoverCard />
  <AbilityHoverCards abilityKeys={abilityKeys} />

  <style>
    .lead {
      color: var(--c-text-muted);
      max-width: 62ch;
      line-height: 1.8;
    }
    .empty {
      color: var(--c-text-muted);
    }
    .updates {
      list-style: none;
      padding: 0;
      margin: var(--sp-5) 0 0;
      display: grid;
      /*
       * 列を minmax(0, 1fr) で固定する。既定の auto トラックだと中身の最小幅に
       * 合わせてトラックが広がり、スマホ幅で横スクロールが出る。
       */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }
    .update {
      min-width: 0;
    }
    .uhead {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-3);
      margin-bottom: var(--sp-3);
      padding-bottom: var(--sp-2);
      border-bottom: 1px solid var(--c-border);
    }
    .utitle {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 15px;
      font-weight: 700;
      color: var(--c-text-strong);
      text-decoration: none;
    }
    .utitle:hover {
      color: var(--c-accent);
    }
    .udate {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-faint);
      white-space: nowrap;
    }
    .nodata {
      margin: 0;
      font-size: 12px;
      color: var(--c-text-faint);
    }
  </style>
</Base>
