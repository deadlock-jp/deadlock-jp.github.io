---
/**
 * アップデートの一覧。
 *
 * 公式の投稿本文は各アップデートのページ(/patch-notes/<日付>/)にだけ置く。
 * ここに全文も載せると同じ文章がサイト内で二重になり、検索側にどちらを出すか
 * 委ねることになるため、一覧はタイトル・日付・バランス調整のアイコンだけにする。
 */
import Base from "../../layouts/Base.astro";
import BalanceChips from "../../components/BalanceChips.astro";
import ItemHoverCard from "../../components/ItemHoverCard.astro";
import AbilityHoverCards from "../../components/AbilityHoverCards.astro";
import { patchNotes, shopItems, itemHoverData } from "../../lib/data.ts";
import { balanceUpdates } from "../../lib/balance.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const updates = new Map(balanceUpdates(base).map((u) => [u.date, u]));
const entries = patchNotes().map((n) => ({ note: n, update: updates.get(n.date) ?? null }));

const itemDetails = Object.fromEntries(shopItems().map((i) => [i.id, itemHoverData(i)]));
const abilityKeys = [
  ...new Set(
    [...updates.values()].flatMap((u) =>
      u.chips.map((c) => c.abilityKey).filter((k): k is string => !!k),
    ),
  ),
];
---

<Base
  title="アップデート"
  description="Deadlock（デッドロック）の公式アップデート一覧。バランス調整の内容をヒーロー・スキル・アイテム単位で日本語で確認できます。"
  breadcrumbs={[{ name: "パッチノート", path: `${base}/patch-notes/` }]}
>
  <h1>アップデート</h1>
  <p class="lead">
    Steamの公式ニュース（<a href="https://store.steampowered.com/news/app/1422450" rel="noopener">Deadlock — News</a>）から取得した
    Valve公式の投稿と、ゲームデータの差分から自動生成したバランス調整です。
    日付を選ぶと、そのアップデートの数値の変更点と公式の本文が読めます。
  </p>

  {entries.length === 0 && <p class="empty">まだ取得したアップデートがありません。</p>}

  <ol class="updates">
    {entries.map(({ note, update }) => (
      <li class="update panel">
        <div class="uhead">
          <a class="utitle" href={`${base}/patch-notes/${note.date}/`}>{note.title}</a>
          <time class="udate" datetime={note.date}>{note.date}</time>
        </div>
        {update ? (
          <BalanceChips chips={update.chips} max={16} />
        ) : (
          <p class="nodata">数値の差分はありません（スナップショットが揃っていない期間です）</p>
        )}
      </li>
    ))}
  </ol>

  <ItemHoverCard details={itemDetails} />
  <AbilityHoverCards abilityKeys={abilityKeys} />

  <style>
    .lead {
      color: var(--c-text-muted);
      max-width: 62ch;
      line-height: 1.8;
    }
    .empty {
      color: var(--c-text-muted);
    }
    .updates {
      list-style: none;
      padding: 0;
      margin: var(--sp-5) 0 0;
      display: grid;
      /*
       * 列を minmax(0, 1fr) で固定する。既定の auto トラックだと中身の最小幅に
       * 合わせてトラックが広がり、スマホ幅で横スクロールが出る。
       */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }
    .update {
      min-width: 0;
    }
    .uhead {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-3);
      margin-bottom: var(--sp-3);
      padding-bottom: var(--sp-2);
      border-bottom: 1px solid var(--c-border);
    }
    .utitle {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 15px;
      font-weight: 700;
      color: var(--c-text-strong);
      text-decoration: none;
    }
    .utitle:hover {
      color: var(--c-accent);
    }
    .udate {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-faint);
      white-space: nowrap;
    }
    .nodata {
      margin: 0;
      font-size: 12px;
      color: var(--c-text-faint);
    }
  </style>
</Base>
