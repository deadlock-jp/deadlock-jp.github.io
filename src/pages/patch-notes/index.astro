---
import Base from "../../layouts/Base.astro";
import { patchNotes } from "../../lib/data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** "## 見出し" 行と通常行を分けて、見出しごとの塊にする */
function toSections(lines: string[]): { heading: string | null; items: string[] }[] {
  const sections: { heading: string | null; items: string[] }[] = [];
  for (const line of lines) {
    if (line.startsWith("## ")) {
      sections.push({ heading: line.slice(3), items: [] });
      continue;
    }
    if (sections.length === 0) sections.push({ heading: null, items: [] });
    sections[sections.length - 1].items.push(line);
  }
  return sections.filter((s) => s.items.length > 0);
}

const entries = patchNotes().map((n) => ({ ...n, sections: toSections(n.lines) }));
---

<Base
  title="パッチノート"
  description="Deadlock（デッドロック）の公式パッチノートのアーカイブ。Steamの公式ニュースからValve公式の投稿本文をそのまま掲載。"
  breadcrumbs={[{ name: "パッチノート", path: `${base}/patch-notes/` }]}
>
  <h1>パッチノート</h1>
  <p class="lead">
    Steamの公式ニュース（<a href="https://store.steampowered.com/news/app/1422450" rel="noopener">Deadlock — News</a>）から取得した、
    Valve公式の投稿本文です。第三者サイトの要約や翻訳ではなく、Valveが公式に用意した日本語版をそのまま掲載しています
    （日本語版が無い古い投稿のみ英語のまま）。
  </p>

  {entries.length === 0 && <p class="empty">まだ取得したパッチノートがありません。</p>}

  <ol class="patchlist">
    {entries.map((e) => (
      <li class="patch panel">
        <div class="phead">
          <span class="pdate">{e.date}</span>
          <h2 class="ptitle">{e.title}</h2>
          <a class="psrc" href={e.url} rel="noopener" target="_blank">Steamで見る →</a>
        </div>
        {e.sections.map((s) => (
          <div class="psection">
            {s.heading && <h3>{s.heading}</h3>}
            <ul>
              {s.items.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        ))}
      </li>
    ))}
  </ol>

  <style>
    .lead {
      color: var(--c-text-muted);
      max-width: 62ch;
      line-height: 1.8;
    }
    .empty {
      color: var(--c-text-muted);
    }
    .patchlist {
      list-style: none;
      padding: 0;
      margin: var(--sp-5) 0 0;
      display: grid;
      gap: var(--sp-4);
    }
    .patch {
      /* 見た目は global.css の .panel を流用 */
    }
    .phead {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-3);
      margin-bottom: var(--sp-3);
      border-bottom: 1px solid var(--c-border);
      padding-bottom: var(--sp-2);
    }
    .pdate {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-muted);
    }
    .ptitle {
      margin: 0;
      font-size: 15px;
      flex: 1 1 auto;
      border: none;
      padding: 0;
    }
    .psrc {
      font-size: 12px;
      white-space: nowrap;
    }
    .psection h3 {
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--c-text-muted);
      margin: var(--sp-3) 0 var(--sp-1);
      border: none;
      padding: 0;
    }
    .psection ul {
      margin: 0;
      padding-left: 1.2em;
      font-size: 13px;
      line-height: 1.8;
    }
  </style>
</Base>
