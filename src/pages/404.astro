---
/**
 * 見つからないページ。GitHub Pages は存在しない URL に dist/404.html を返す
 * (これが無いと GitHub の既定のページになり、viewport の指定も無いのでスマホで縮小表示されていた)。
 * どの言語の URL でもこの1枚が出るので、日本語と英語を併記する。
 */
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="ページが見つかりません / Page not found" noindex>
  <section class="nf panel">
    <h1>ページが見つかりません</h1>
    <p>URL が変わったか、削除されたページです。</p>
    <p lang="en">The page you were looking for doesn't exist.</p>
    <p><a href={`${base}/`}>トップへ / Home</a></p>
  </section>
</Base>

<style>
  .nf { max-width: 560px; margin: var(--sp-6) auto; }
  .nf h1 { font-size: 22px; }
  .nf p { margin: 0 0 var(--sp-2); color: var(--c-text-muted); }
</style>
