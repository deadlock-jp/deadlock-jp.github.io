---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import ItemIcon from "../components/ItemIcon.astro";
import HeroPortrait from "../components/HeroPortrait.astro";
import HeroHoverCard from "../components/HeroHoverCard.astro";
import ItemHoverCard from "../components/ItemHoverCard.astro";
import BalanceChips from "../components/BalanceChips.astro";
import AbilityHoverCards from "../components/AbilityHoverCards.astro";
import MapPreview from "../components/MapPreview.astro";
import PlayClips from "../components/PlayClips.astro";
import {
  releasedHeroes,
  shopItems,
  t,
  SLOT_META,
  ADJUSTMENT_LABEL,
  patchNotes,
  noteTitle,
  recentlyReleasedHeroes,
  heroTags,
} from "../lib/data.ts";
import { balanceUpdates } from "../lib/balance.ts";
import { smallImage, thumbAt } from "../lib/thumbs.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { L, langPath, isJaOnlyFrom, currentLang } = Astro.locals.i18n;
const T = L();


const heroes = releasedHeroes().map((h) => {
  const key = h.key.replace(/^hero_/, "");
  const verticalRel = `images/heroes/card/${key}.webp`;
  return {
    h,
    key,
    name: t(h.nameToken, h.key),
    vertical: existsSync(join(process.cwd(), "public", verticalRel)) ? `${base}/${verticalRel}` : null,
    /* スマホ(560px 以下。カードは 66px 幅前後)では縮小版(src/lib/thumbs.ts)。無ければ null */
    verticalSmall: ((r) => (r ? `${base}/${r}` : null))(thumbAt(verticalRel, 210)),
  };
});

/* 最近解禁されたヒーロー(解禁から14日間・新しい順に3体まで)。カードの絵が無いヒーローは出さない */
const newHeroes = recentlyReleasedHeroes(14)
  .map(({ hero, date }) => {
    const key = hero.key.replace(/^hero_/, "");
    const img = (dir: string) =>
      existsSync(join(process.cwd(), "public", `images/heroes/${dir}/${key}.webp`)) ? `${base}/images/heroes/${dir}/${key}.webp` : null;
    const card = img("card");
    return { hero, date, name: t(hero.nameToken, hero.key), tags: heroTags(hero), card, gloat: img("gloat") ?? card };
  })
  .filter((n) => n.card)
  .slice(0, 3);
const [newFeature, ...newOthers] = newHeroes;

const slots = ["WeaponMod", "Armor", "Tech"] as const;
const items = shopItems();

/* 直近のバランス調整。詳細は各アップデートのページに置き、ここは一覧だけ */
const balance = balanceUpdates(base).slice(0, 3);

/*
 * 最新アップデートの入口。題・日付・リンクは公式ノート(patch-notes.json)の先頭、件数は
 * 同じ日付のバランス調整(updates.json)から。次のパッチでも手作業なしで入れ替わる。
 * 題は日本語版なら公式ノートの日本語の題、ほかの言語は英語の原文の題。
 */
const lang = currentLang();
const latestNote = patchNotes()[0] ?? null;
const latestUpdate = latestNote ? (balanceUpdates(base).find((u) => u.date === latestNote.date) ?? null) : null;
const latestCounts = latestUpdate
  ? (["buff", "nerf", "mixed", "rework"] as const)
      .filter((k) => latestUpdate.counts[k] > 0)
      .map((k) => ({ kind: k, label: ADJUSTMENT_LABEL[k], n: latestUpdate.counts[k] }))
  : [];
const balanceAbilityKeys = [
  ...new Set(
    balance.flatMap((u) => u.chips.map((c) => c.abilityKey).filter((k): k is string => !!k)),
  ),
];
---

<Base title={T.top.title} description={T.top.description}>
  <div class="herohead">
    <span class="eyebrow">Unofficial Database</span>
    <h1>{T.top.h1}</h1>
  </div>

  {newFeature && (
    <section class="newhero" data-count={newHeroes.length} aria-label={T.top.newHero}>
      <a class="nh-feature" href={`${base}${langPath(`/heroes/${newFeature.hero.id}/`)}`} style={`--nh-bg: url(${newFeature.card})`}>
        <img class="nh-art" src={newFeature.gloat} alt="" width="280" height="380" />
        <span class="nh-tx">
          <span class="nh-eyebrow">{T.top.newHero}</span>
          <span class="nh-name">{newFeature.name}</span>
          {newFeature.tags.length > 0 && <span class="nh-tags">{newFeature.tags.map((g) => <span>{g}</span>)}</span>}
          <span class="nh-date"><time datetime={newFeature.date}>{newFeature.date}</time> {T.top.released}</span>
          <span class="nh-link">{T.top.heroPage}</span>
        </span>
      </a>
      {newOthers.map((n) => (
        <a class="nh-sub" href={`${base}${langPath(`/heroes/${n.hero.id}/`)}`} data-herocard={n.hero.id}>
          <img src={n.card} alt="" width="280" height="380" loading="lazy" />
          <span class="nh-subtx">
            <span class="nh-subname">{n.name}</span>
            <span class="nh-date"><time datetime={n.date}>{n.date}</time> {T.top.released}</span>
          </span>
        </a>
      ))}
    </section>
  )}

  {latestNote && (
    <a class="latest panel" href={`${base}${langPath(`/patch-notes/${latestNote.date}/`)}`}>
      <span class="lt-eyebrow">{T.patchPage.latest}</span>
      <span class="lt-title" lang={lang === "ja" || lang === "en" ? undefined : "en"}>{noteTitle(latestNote, lang)}</span>
      <time class="lt-date" datetime={latestNote.date}>{latestNote.date}</time>
      {latestCounts.length > 0 && (
        <span class="lt-counts">
          {latestCounts.map((c) => <span class="lt-count" data-kind={c.kind}>{c.label} <b>{c.n}</b></span>)}
        </span>
      )}
      <span class="lt-link">{T.patchPage.latestLink}</span>
    </a>
  )}

  {/* はじめての方への入口(攻略情報は日本語のみなので、日本語版のトップにだけ出す) */}
  {lang === "ja" && (
    <a class="beginner panel" href={`${base}/mechanics/beginner/`}>
      <img src={`${base}/${smallImage("images/npcs/trooper.png", 44)}`} alt="" width="44" height="44" loading="lazy" />
      <span class="bg-tx">
        <span class="bg-title">はじめての方へ</span>
        <span class="bg-body">勝利条件と試合の全体像、最初に覚える3つのこと、よく出る用語</span>
      </span>
      <span class="bg-link">はじめての Deadlock →</span>
    </a>
  )}

  <section class="block panel first">
    <h2>
      {T.nav.heroes}
      <a class="more" href={`${base}${langPath("/heroes/")}`}>{T.top.seeAll}</a>
    </h2>
    <ul class="herogrid">
      {
        heroes.map(({ h, name, vertical, verticalSmall }) => (
          <li>
            <a href={`${base}${langPath(`/heroes/${h.id}/`)}`} data-herocard={h.id}>
              <span class="hcard">
                {vertical ? (
                  <picture>
                    {verticalSmall && <source media="(max-width: 560px)" srcset={verticalSmall} type="image/webp" />}
                    <img src={vertical} alt="" width="280" height="380" loading="lazy" />
                  </picture>
                ) : (
                  <span class="hph" aria-hidden="true">
                    {name.slice(0, 1)}
                  </span>
                )}
                <span class="hname">{name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* X の投稿の紹介(日本のプレイヤー向けなので日本語版のみ。この欄に近づくまで X のものは何も読まない) */}
  {lang === "ja" && <PlayClips />}

  <section class="block panel">
    <h2>
      {T.nav.items}
      <a class="more" href={`${base}${langPath("/items/")}`}>{T.top.seeAll}</a>
    </h2>
    {
      slots.map((slot) => {
        const meta = SLOT_META[slot];
        const list = items.filter((i) => i.slotType === slot);
        return (
          <div class="itemcat" style={`--cat: var(--c-${meta.cssVar})`}>
            <h3>
              {meta.label}
              <span class="icount">{list.length}</span>
            </h3>
            <ul class="itemwall">
              {list.map((i) => (
                <li>
                  <a
                    href={`${base}${langPath(`/items/${i.id}/`)}`}
                    title={t(i.nameToken, i.id)}
                    data-itemcard={i.id}
                  >
                    <ItemIcon
                      name={t(i.nameToken, i.id)}
                      slotType={i.slotType}
                      tier={i.tier}
                      shopIcon={i.shopIcon}
                      activation={i.activation}
                      isImbue={i.isImbue}
                      size={40}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>

  <section class="block panel">
    <h2>
      {T.adjust.historyTitle}
      <a class="more" href={`${base}${langPath("/patch-notes/")}`}>{T.top.allUpdates}{isJaOnlyFrom("/patch-notes/") && <span class="jaonly">{T.jaOnly}</span>}</a>
    </h2>
    <div class="bal">
      {
        balance.map((u) => (
          <div class="balrow">
            <div class="baldate">
              <a href={u.href}>{u.date}{isJaOnlyFrom("/patch-notes/") && <span class="jaonly">{T.jaOnly}</span>}</a>
              <span>{u.title.replace(/\s*-\s*\d{4}年.*$/, "")}</span>
            </div>
            <BalanceChips chips={u.chips} max={18} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="block panel">
    <h2>
      {T.nav.mechanics}
      <a class="more" href={`${base}/mechanics/`}>{T.top.seeReference}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a>
    </h2>
    <div class="guide">
      <a class="guidemap" href={`${base}/mechanics/farm/#map`}>
        <MapPreview />
      </a>
      <div class="guidetx">
        <a class="guidett" href={`${base}/mechanics/farm/#map`}>{T.top.map}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a>
        <p class="syslead">{T.top.mapLead}</p>
        <ul class="guidelinks">
          <li><a href={`${base}/mechanics/match/#laning`}>{T.top.laning}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a></li>
          <li><a href={`${base}/mechanics/farm/#farming`}>{T.top.farming}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a></li>
          <li><a href={`${base}/mechanics/match/#lategame`}>{T.top.lategame}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a></li>
          <li><a href={`${base}/mechanics/controls/`}>{T.top.controls}{isJaOnlyFrom("/mechanics/") && <span class="jaonly">{T.jaOnly}</span>}</a></li>
        </ul>
      </div>
    </div>
  </section>

  {/* ヒーロー/アイテム/スキルのホバー詳細(共通コンポーネント) */}
  <HeroHoverCard />
  <ItemHoverCard />
  <AbilityHoverCards abilityKeys={balanceAbilityKeys} />

  <style>
    /* はじめての方への入口(日本語版のみ) */
    .beginner {
      display: flex; align-items: center; gap: var(--sp-3); margin: 0 0 var(--sp-4); padding: var(--sp-3) var(--sp-4);
      color: inherit; text-decoration: none;
    }
    .beginner:hover { text-decoration: none; border-color: var(--c-accent-dim); }
    .beginner img { flex: none; object-fit: contain; }
    .bg-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
    .bg-title { font-size: 17px; font-weight: 700; color: var(--c-text-strong); }
    .bg-body { font-size: 12.5px; color: var(--c-text-muted); }
    .bg-link { flex: none; font-size: 13px; color: var(--c-accent); }
    .beginner:hover .bg-link { color: var(--c-accent-hover); }
    @media (max-width: 560px) {
      .beginner { flex-wrap: wrap; }
      .bg-link { width: 100%; text-align: right; }
    }

    /* ---- 最近解禁されたヒーロー(見出しのすぐ下) ---- */
    .newhero { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: var(--sp-3); margin: 0 0 var(--sp-4); }
    .newhero[data-count="1"] { grid-template-columns: minmax(0, 1fr); }
    .newhero[data-count="2"] { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .nh-feature, .nh-sub {
      position: relative; overflow: hidden; border-radius: var(--radius-lg);
      border: 1px solid var(--c-glass-border-strong); color: inherit; text-decoration: none;
    }
    .nh-feature { display: flex; align-items: stretch; min-height: 220px; background: var(--c-surface); isolation: isolate; }
    /* 背景はそのヒーローのカードの絵を大きくぼかしたもの(ヒーローの色がそのまま帯の色になる) */
    .nh-feature::before {
      content: ""; position: absolute; inset: -40px; z-index: -1;
      background: var(--nh-bg) center 30% / cover no-repeat;
      filter: blur(28px) saturate(1.3) brightness(0.45);
    }
    .nh-art { flex: none; width: 42%; max-width: 230px; height: auto; min-height: 100%; align-self: stretch; object-fit: cover; object-position: center top;
      -webkit-mask-image: linear-gradient(to right, #000 70%, transparent); mask-image: linear-gradient(to right, #000 70%, transparent); }
    .nh-tx { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: var(--sp-4) var(--sp-5); min-width: 0; }
    .nh-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--c-accent); }
    .nh-name { font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 40px); font-weight: 700; line-height: 1.1; color: var(--c-text-strong); text-shadow: 0 2px 14px rgb(0 0 0 / 0.6); }
    .nh-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .nh-tags span { font-size: 12px; padding: 2px 10px; border-radius: 999px; background: rgb(0 0 0 / 0.35); border: 1px solid rgb(255 255 255 / 0.18); color: var(--c-text); }
    .nh-date { font-size: 12px; color: var(--c-text-muted); }
    .nh-date time { font-family: var(--font-mono); }
    .nh-link { margin-top: 4px; font-size: 13px; color: var(--c-accent); }
    .nh-feature:hover { border-color: var(--c-accent-dim); text-decoration: none; }
    .nh-feature:hover .nh-link { color: var(--c-accent-hover); }
    .nh-sub { display: block; background: var(--c-surface); }
    .nh-sub img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform 0.25s; }
    .nh-subtx { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; gap: 2px; padding: 28px var(--sp-3) var(--sp-2); background: linear-gradient(transparent, rgb(0 0 0 / 0.85)); }
    .nh-subname { font-size: 16px; font-weight: 700; color: var(--c-text-strong); }
    .nh-sub:hover { border-color: var(--c-accent-dim); text-decoration: none; }
    .nh-sub:hover img { transform: scale(1.04); }
    @media (max-width: 720px) {
      .newhero, .newhero[data-count="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .nh-feature { grid-column: 1 / -1; min-height: 180px; }
      .nh-art { width: 38%; }
      .nh-tx { padding: var(--sp-3) var(--sp-4); }
      .nh-sub { aspect-ratio: 1 / 1; }
      .nh-sub img { object-position: center 35%; }
    }

    /* 最新アップデートの入口(トップの見出しのすぐ下) */
    .latest {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: "eye eye" "title date" "counts link";
      gap: 4px var(--sp-3);
      align-items: baseline;
      margin: 0 0 var(--sp-4);
      padding: var(--sp-3) var(--sp-4);
      color: inherit;
      text-decoration: none;
    }
    .latest:hover { text-decoration: none; border-color: var(--c-accent-dim); }
    .latest:hover .lt-link { color: var(--c-accent-hover); }
    .lt-eyebrow { grid-area: eye; font-size: 11px; letter-spacing: 0.08em; color: var(--c-accent); font-weight: 700; }
    .lt-title { grid-area: title; font-size: 20px; font-weight: 700; color: var(--c-text-strong); }
    .lt-date { grid-area: date; font-family: var(--font-mono); font-size: 12px; color: var(--c-text-muted); }
    .lt-counts { grid-area: counts; display: flex; flex-wrap: wrap; gap: 6px; }
    .lt-count { font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--c-border); color: var(--c-text-muted); }
    .lt-count b { font-family: var(--font-mono); color: var(--c-text-strong); }
    .lt-count[data-kind="buff"] { border-color: var(--c-buff-dim); }
    .lt-count[data-kind="buff"] b { color: var(--c-buff); }
    .lt-count[data-kind="nerf"] { border-color: var(--c-nerf-dim); }
    .lt-count[data-kind="nerf"] b { color: var(--c-nerf); }
    .lt-count[data-kind="mixed"] b,
    .lt-count[data-kind="rework"] b { color: var(--c-mixed); }
    .lt-link { grid-area: link; font-size: 12px; color: var(--c-accent); white-space: nowrap; }
    @media (max-width: 560px) {
      .latest { grid-template-columns: 1fr; grid-template-areas: "eye" "title" "date" "counts" "link"; }
    }
    /* ---- ヒーロー見出し(背景演出「Halftone Press」) ---- */
    .herohead {
      position: relative;
      padding: var(--sp-7) 0 var(--sp-6);
      text-align: center;
    }
    .eyebrow {
      display: block;
      margin-bottom: var(--sp-3);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--c-bg-accent);
    }
    .herohead h1 {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(28px, 4.4vw, 48px);
      line-height: 1.15;
      letter-spacing: 0.05em;
      word-break: keep-all;
      color: var(--c-text-strong);
      text-shadow: 0 2px 22px rgb(0 0 0 / 0.8);
      text-wrap: balance;
    }

    /* ---- 各セクション(見た目は global.css の .panel を流用) ---- */
    .block {
      margin-top: var(--sp-5);
    }
    .block.first {
      margin-top: 0;
    }
    /*
     * スマホ(背景を静止画にする条件と同じ)では、画面外のセクション(アイテムの一覧・バランス調整・攻略情報)の
     * 描画を、近づくまで後回しにする。仮の高さは、描いたあとは実際の高さを覚える(auto)
     */
    @media (max-width: 820px), (pointer: coarse), (prefers-reduced-motion: reduce) {
      .block:not(.first) {
        content-visibility: auto;
        contain-intrinsic-size: auto 1100px;
      }
    }
    .block h2 {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-3);
      margin-top: 0;
      border-bottom-color: var(--c-glass-border-strong);
    }
    .more {
      font-size: 12px;
      font-weight: 400;
      white-space: nowrap;
    }

    /* ---- 攻略情報: マップを大きく ---- */
    .guide { display: grid; grid-template-columns: minmax(0, 560px) minmax(0, 1fr); gap: var(--sp-5); align-items: center; }
    .guidemap { display: block; }
    .guidemap:hover { filter: brightness(1.08); }
    .guidett { display: inline-block; margin-bottom: var(--sp-2); font-size: 20px; font-weight: 700; color: var(--c-text-strong); }
    .guidett:hover { color: var(--c-accent); text-decoration: none; }
    .guidelinks { list-style: none; padding: 0; margin: var(--sp-4) 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .guidelinks a { display: inline-block; font-size: 12.5px; padding: 4px 12px; border: 1px solid var(--c-border); border-radius: 999px; background: var(--c-surface); color: var(--c-text); }
    .guidelinks a:hover { border-color: var(--c-accent-dim); color: var(--c-accent); text-decoration: none; }
    @media (max-width: 720px) { .guide { grid-template-columns: 1fr; } }

    .syslead {
      margin: 0;
      font-size: 13px;
      color: var(--c-text-muted);
      max-width: 70ch;
      line-height: 1.8;
    }

    /* ---- バランス調整 ---- */
    .bal {
      display: flex;
      flex-direction: column;
      gap: var(--sp-4);
    }
    .balrow {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: var(--sp-4);
      align-items: start;
    }
    .baldate {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding-top: 6px;
    }
    .baldate a {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--c-soul);
      text-decoration: none;
    }
    .baldate a:hover { text-decoration: underline; }
    .baldate span {
      font-size: 11px;
      color: var(--c-text-faint);
    }
    @media (max-width: 560px) {
      .balrow {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sp-2);
      }
      .baldate {
        flex-direction: row;
        align-items: baseline;
        gap: var(--sp-2);
        padding-top: 0;
      }
    }

    /* ---- ヒーローカード(ゲームの縦長カード) ---- */
    .herogrid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
      gap: var(--sp-2);
    }
    .herogrid a {
      display: block;
      color: inherit;
    }
    .herogrid a:hover {
      text-decoration: none;
    }
    .hcard {
      position: relative;
      display: block;
      aspect-ratio: 120 / 200;
      border: 1px solid var(--c-glass-border);
      border-radius: var(--radius);
      overflow: hidden;
      /* 不透明にすると、カード絵の透過部分(角のフチなど)が
         ただの色付き箱に見えてしまう。背景キャンバスを透かす */
      background: transparent;
    }
    .hcard img {
