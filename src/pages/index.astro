      height: 100%;
      object-fit: cover;
      display: block;
    }
    .herogrid a:hover .hcard {
      border-color: var(--c-accent);
      box-shadow: 0 0 0 1px var(--c-accent);
    }
    .hph {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      font-size: 34px;
      font-weight: 700;
      color: var(--c-accent);
    }
    /* 画像内下部に小さくヒーロー名。ベージュ + 黒縁 */
    .hname {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 14px 4px 3px;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.15;
      color: var(--c-text-strong);
      background: linear-gradient(transparent, rgb(0 0 0 / 0.55) 60%);
      -webkit-text-stroke: 2px #000;
      paint-order: stroke fill;
    }

    /* ---- アイテムアイコンの壁 ---- */
    .itemcat {
      margin-top: var(--sp-4);
    }
    .itemcat h3 {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cat);
      display: flex;
      gap: var(--sp-2);
      align-items: baseline;
      margin: 0 0 var(--sp-2);
