---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import ItemIcon from "../components/ItemIcon.astro";
import HeroPortrait from "../components/HeroPortrait.astro";
import {
  releasedHeroes,
  shopItems,
  t,
  siteUpdates,
  upstreamRepo,
  heroTags,
  heroByKey,
  item as itemById,
  SLOT_META,
} from "../lib/data.ts";
import type { Adjustment, AdjustmentKind } from "../lib/data.ts";
import { heroRanks, pickRows } from "../lib/herorank.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ranks = heroRanks();

const BOON_LABEL = { hp: "HP成長", weapon: "武器成長", spirit: "スピリット成長" } as const;

const heroes = releasedHeroes().map((h) => {
  const key = h.key.replace(/^hero_/, "");
  const verticalRel = `images/heroes/card/${key}.webp`;
  const gloatRel = `images/heroes/gloat/${key}.webp`;
  const r = ranks[h.id];
  return {
    h,
    key,
    name: t(h.nameToken, h.key),
    vertical: existsSync(join(process.cwd(), "public", verticalRel)) ? `${base}/${verticalRel}` : null,
    // クライアントの詳細カードに渡すデータ
    detail: {
      name: t(h.nameToken, h.key),
      gloat: existsSync(join(process.cwd(), "public", gloatRel)) ? `${base}/${gloatRel}` : null,
      tags: heroTags(h),
      // ホバーカードは各カテゴリ4項目まで(レーダーはヒーロー詳細で全項目)
      weapon: pickRows(r.weapon, ["dps", "bullet", "clip", "range"]),
      vitality: pickRows(r.vitality, ["hp", "regen", "move", "stam"]),
      spirit: pickRows(r.growth, ["gspower"]).concat(pickRows(r.spirit, ["skillscale"])),
      boon: r.boonAccent.map((a) => BOON_LABEL[a]),
    },
  };
});
const heroDetail = Object.fromEntries(heroes.map((x) => [x.h.id, x.detail]));

const slots = ["WeaponMod", "Armor", "Tech"] as const;
const items = shopItems();
const commitUrl = (sha: string | null) => (sha ? `${upstreamRepo}/commit/${sha}` : null);

/** 調整履歴のアイコン一覧に出すための解決 */
type ResolvedAdj =
  | { kind: AdjustmentKind; target: "hero"; name: string; href: string; image: string | null; note?: string }
  | { kind: AdjustmentKind; target: "item"; name: string; href: string; it: ReturnType<typeof itemById>; note?: string };
function resolveAdj(a: Adjustment): ResolvedAdj | null {
  if (a.target === "hero") {
    const h = heroByKey(a.key);
    if (!h) return null;
    return {
      kind: a.kind, target: "hero", name: t(h.nameToken, h.key),
      href: `${base}/heroes/${h.id}/`, image: h.images.iconSmall, note: a.note,
    };
  }
  const it = itemById(a.key);
  if (!it) return null;
  return {
    kind: a.kind, target: "item", name: t(it.nameToken, it.id),
    href: `${base}/items/${it.id}/`, it, note: a.note,
  };
}
const ADJ_KINDS: { kind: AdjustmentKind; label: string }[] = [
  { kind: "buff", label: "強化" },
  { kind: "nerf", label: "弱体" },
  { kind: "rework", label: "リワーク" },
];
const updates = siteUpdates().map((u) => {
  const resolved = (u.adjustments ?? [])
    .map(resolveAdj)
    .filter((x): x is ResolvedAdj => x !== null);
  return {
    ...u,
    adjGroups: ADJ_KINDS.map(({ kind, label }) => ({
      kind,
      label,
      items: resolved.filter((r) => r.kind === kind),
    })).filter((g) => g.items.length > 0),
  };
});
---

<Base title="トップ" description="Deadlockのヒーロー・アイテム・スキルの数値を日本語で引けるデータベース">
  <h1 class="sr-only">DEADLOCK-JP DB</h1>

  <section class="block first">
    <h2>
      ヒーロー
      <a class="more" href={`${base}/heroes/`}>一覧を見る →</a>
    </h2>
    <ul class="herogrid">
      {
        heroes.map(({ h, name, vertical }) => (
          <li>
            <a href={`${base}/heroes/${h.id}/`} data-hero={h.id}>
              <span class="hcard">
                {vertical ? (
                  <img src={vertical} alt="" width="280" height="380" loading="lazy" />
                ) : (
                  <span class="hph" aria-hidden="true">
                    {name.slice(0, 1)}
                  </span>
                )}
                <span class="hname">{name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block">
    <h2>
      アイテム
      <a class="more" href={`${base}/items/`}>一覧を見る →</a>
    </h2>
    {
      slots.map((slot) => {
        const meta = SLOT_META[slot];
        const list = items.filter((i) => i.slotType === slot);
        return (
          <div class="itemcat" style={`--cat: var(--c-${meta.cssVar})`}>
            <h3>
              {meta.label}
              <span class="icount">{list.length}</span>
            </h3>
            <ul class="itemwall">
              {list.map((i) => (
                <li>
                  <a href={`${base}/items/${i.id}/`} title={t(i.nameToken, i.id)}>
                    <ItemIcon
                      name={t(i.nameToken, i.id)}
                      slotType={i.slotType}
                      tier={i.tier}
                      shopIcon={i.shopIcon}
                      activation={i.activation}
                      isImbue={i.isImbue}
                      size={40}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>

  <section class="block">
    <h2>更新履歴</h2>
    <ol class="updates">
      {
        updates.map((u) => (
          <li>
            <span class="udate">{u.date}</span>
            <div class="ubody">
              <span class="utitle">
                {u.title}
                {commitUrl(u.upstreamCommit) && (
                  <a class="ucommit" href={commitUrl(u.upstreamCommit)} rel="noopener">
                    {u.upstreamCommit!.slice(0, 8)}
                  </a>
                )}
              </span>
              <ul class="uchanges">
                {u.changes.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              {u.adjGroups.length > 0 && (
                <div class="uadj">
                  {u.adjGroups.map((g) => (
                    <div class="uadj-grp" data-kind={g.kind}>
                      <span class="uadj-k">{g.label}</span>
                      <ul class="uadj-icons">
                        {g.items.map((r) => (
                          <li>
                            <a href={r.href} title={r.note ? `${r.name}｜${r.note}` : r.name}>
                              {r.target === "hero" ? (
                                <HeroPortrait name={r.name} image={r.image} size={30} />
                              ) : (
                                <ItemIcon
                                  name={r.name}
                                  slotType={r.it!.slotType}
                                  tier={r.it!.tier}
                                  shopIcon={r.it!.shopIcon}
                                  activation={r.it!.activation}
                                  isImbue={r.it!.isImbue}
                                  size={30}
                                />
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="block">
    <h2>このサイトについて</h2>
    <p class="about">
      数値はすべてパーサーが GameTracking-Deadlock の <code>.vdata</code> から自動で取り出しています。
      日本語表記はゲーム本体の公式ローカライズをそのまま使用。出典・権利表示・ライセンスは
      <a href={`${base}/about/`}>このサイトについて</a> にまとめています。
    </p>
  </section>

  {/* ヒーローカードのホバー詳細。中身はクライアントで組み立てる */}
  <div class="herocard" id="herocard" role="tooltip" hidden></div>

  <script is:inline define:vars={{ heroDetail }}>
    (() => {
      const card = document.getElementById("herocard");
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      const stars = (n) =>
        `<span class="s">${"★".repeat(n)}<span class="dim">${"☆".repeat(5 - n)}</span></span>`;
      const rows = (list) =>
        list
          .map(
            (r) =>
              `<li class="${r.stars >= 4 ? "accent" : ""}"><span class="l">${esc(r.label)}</span>` +
              `<span class="v">${esc(r.value)}</span>${stars(r.stars)}</li>`,
          )
          .join("");

      function show(id, anchor) {
        const d = heroDetail[id];
        if (!d) return;
        card.innerHTML =
          (d.gloat ? `<img class="hc-img" src="${d.gloat}" alt="">` : "") +
          `<div class="hc-in">` +
          `<div class="hc-name">${esc(d.name)}</div>` +
          (d.tags.length
            ? `<ul class="hc-tags">${d.tags.map((t) => `<li>${esc(t)}</li>`).join("")}</ul>`
            : "") +
          `<div class="hc-grp" style="--hc-cat:var(--c-weapon)">武器</div><ul class="hc-rows">${rows(d.weapon)}</ul>` +
          `<div class="hc-grp" style="--hc-cat:var(--c-vitality)">生命力</div><ul class="hc-rows">${rows(d.vitality)}</ul>` +
          `<div class="hc-grp" style="--hc-cat:var(--c-spirit)">成長/スピリット</div><ul class="hc-rows">${rows(d.spirit)}</ul>` +
          (d.boon.length
            ? `<div class="hc-boon">成長が高い: <b>${esc(d.boon.join(" / "))}</b></div>`
            : "") +
          `</div>`;
        card.hidden = false;

        const place = () => {
          const M = 8;
          const r = anchor.getBoundingClientRect();
          const cw = card.offsetWidth;
          const ch = card.offsetHeight;
          const vw = document.documentElement.clientWidth;
          const vh = document.documentElement.clientHeight;
          let left = r.right + 10;
          if (left + cw > vw - M) left = r.left - cw - 10;
          left = Math.max(M, Math.min(left, vw - cw - M));
          let top = r.top;
          top = Math.min(top, vh - ch - M);
          top = Math.max(M, top);
          card.style.left = left + "px";
          card.style.top = top + "px";
        };
        place();
        requestAnimationFrame(place);
      }
      const hide = () => (card.hidden = true);

      for (const a of document.querySelectorAll(".herogrid a[data-hero]")) {
        const id = a.dataset.hero;
        a.addEventListener("mouseenter", () => show(id, a));
        a.addEventListener("focus", () => show(id, a));
        a.addEventListener("mouseleave", hide);
        a.addEventListener("blur", hide);
      }
      window.addEventListener("scroll", hide, { passive: true });
    })();
  </script>

  <style>
    .block {
      margin-top: var(--sp-6);
    }
    .block.first {
      margin-top: 0;
    }
    .block h2 {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-3);
    }
    .more {
      font-size: 12px;
      font-weight: 400;
      white-space: nowrap;
    }

    /* ---- 更新履歴 ---- */
    .updates {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: var(--sp-3);
    }
    .updates > li {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: var(--sp-3);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: var(--sp-3) var(--sp-4);
    }
    .udate {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--c-text-muted);
    }
    .utitle {
      font-weight: 600;
      color: var(--c-text-strong);
      font-size: 14px;
    }
    .ucommit {
      font-family: var(--font-mono);
      font-size: 11px;
      margin-left: var(--sp-2);
      color: var(--c-text-muted);
    }
    .uchanges {
      margin: var(--sp-1) 0 0;
      padding-left: 1.2em;
      font-size: 12px;
      color: var(--c-text-muted);
      line-height: 1.7;
    }
    /* ---- 調整履歴(強化/弱体/リワークされたヒーロー・アイテムのアイコン) ---- */
    .uadj {
      margin-top: var(--sp-2);
      display: grid;
      gap: var(--sp-2);
    }
    .uadj-grp {
      display: flex;
      align-items: flex-start;
      gap: var(--sp-2);
    }
    .uadj-k {
      flex: 0 0 auto;
      margin-top: 6px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 1px 6px;
      border-radius: 3px;
      border: 1px solid currentColor;
    }
    .uadj-grp[data-kind="buff"] .uadj-k { color: var(--c-vitality); }
    .uadj-grp[data-kind="nerf"] .uadj-k { color: var(--c-weapon); }
    .uadj-grp[data-kind="rework"] .uadj-k { color: var(--c-spirit); }
    .uadj-icons {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .uadj-icons a {
      display: block;
      line-height: 0;
      border-radius: 6px;
    }
    .uadj-icons a:hover { outline: 2px solid var(--c-accent); outline-offset: 1px; }

    /* ---- ヒーローカード(ゲームの縦長カード) ---- */
    .herogrid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
      gap: var(--sp-2);
    }
    .herogrid a {
      display: block;
      color: inherit;
    }
    .herogrid a:hover {
      text-decoration: none;
    }
    .hcard {
      position: relative;
      display: block;
      aspect-ratio: 120 / 200;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--c-surface-2);
    }
    .hcard img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .herogrid a:hover .hcard {
      border-color: var(--c-accent);
      box-shadow: 0 0 0 1px var(--c-accent);
    }
    .hph {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      font-size: 34px;
      font-weight: 700;
      color: var(--c-accent);
    }
    /* 画像内下部に小さくヒーロー名。ベージュ + 黒縁 */
    .hname {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 14px 4px 3px;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.15;
      color: var(--c-text-strong);
      background: linear-gradient(transparent, rgb(0 0 0 / 0.55) 60%);
      -webkit-text-stroke: 2px #000;
      paint-order: stroke fill;
    }

    /* ---- ヒーロー詳細のホバーカード(中身はJSで差し込むので :global) ---- */
    .herocard {
      position: fixed;
      z-index: 40;
      width: 300px;
      max-height: calc(100vh - 16px);
      overflow: auto;
      background: var(--c-surface);
      border: 1px solid var(--c-accent-dim);
      border-radius: var(--radius);
      box-shadow: 0 8px 28px rgb(0 0 0 / 0.5);
      pointer-events: none;
    }
    .herocard :global(.hc-img) {
      /* 元絵は 280x380 の縦長。周りに余白をとって少し小さめに出す */
      width: 74%;
      margin: var(--sp-5) auto var(--sp-1);
      aspect-ratio: 280 / 340;
      object-fit: cover;
      object-position: center top;
      display: block;
      border: 1px solid var(--c-border);
      border-radius: calc(var(--radius) - 2px);
    }
    .herocard :global(.hc-in) { padding: var(--sp-3) var(--sp-4) var(--sp-4); }
    .herocard :global(.hc-name) { font-weight: 700; color: var(--c-text-strong); font-size: 15px; }
    .herocard :global(.hc-tags) {
      list-style: none; display: flex; flex-wrap: wrap; gap: 4px; padding: 0; margin: var(--sp-2) 0 0;
    }
    .herocard :global(.hc-tags li) {
      font-size: 10px; color: var(--c-accent);
      border: 1px solid var(--c-accent-dim); border-radius: 999px; padding: 0 7px;
    }
    .herocard :global(.hc-grp) {
      font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--hc-cat, var(--c-text-muted)); margin-top: var(--sp-3);
    }
    .herocard :global(.hc-rows) { list-style: none; padding: 0; margin: 2px 0 0; }
    .herocard :global(.hc-rows li) {
      display: grid; grid-template-columns: 1fr auto auto; gap: var(--sp-2); align-items: baseline;
      font-size: 11px; padding: 2px 0; border-bottom: 1px solid var(--c-border);
    }
    .herocard :global(.hc-rows .l) { color: var(--c-text-muted); }
    .herocard :global(.hc-rows .v) { font-family: var(--font-mono); color: var(--c-text-strong); }
    .herocard :global(.hc-rows .s) { color: var(--c-accent); letter-spacing: 1px; font-size: 10px; }
    .herocard :global(.hc-rows .s .dim) { color: var(--c-text-faint); }
    .herocard :global(.hc-rows li.accent .l) { color: var(--c-accent); }
    .herocard :global(.hc-boon) {
      margin-top: var(--sp-3); font-size: 11px; color: var(--c-text-muted);
    }
    .herocard :global(.hc-boon b) { color: var(--c-accent); }

    @media (max-width: 1000px) {
      .herocard { display: none; }
    }

    /* ---- アイテムアイコンの壁 ---- */
    .itemcat {
      margin-top: var(--sp-4);
    }
    .itemcat h3 {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cat);
      display: flex;
      gap: var(--sp-2);
      align-items: baseline;
      margin: 0 0 var(--sp-2);
      border: none;
      padding: 0;
    }
    .icount {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--c-text-faint);
    }
    .itemwall {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .itemwall a {
      display: block;
      line-height: 0;
      border-radius: 5px;
    }
    .itemwall a:hover {
      filter: brightness(1.2);
    }

    .about {
      max-width: 62ch;
      font-size: 13px;
      color: var(--c-text-muted);
      line-height: 1.8;
    }
    code {
      font-family: var(--font-mono);
      font-size: 0.92em;
    }
  </style>
</Base>
