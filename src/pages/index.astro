---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import ItemIcon from "../components/ItemIcon.astro";
import HeroPortrait from "../components/HeroPortrait.astro";
import HeroHoverCard from "../components/HeroHoverCard.astro";
import ItemHoverCard from "../components/ItemHoverCard.astro";
import BalanceChips from "../components/BalanceChips.astro";
import AbilityHoverCards from "../components/AbilityHoverCards.astro";
import {
  releasedHeroes,
  shopItems,
  t,
  heroTags,
  itemHoverData,
  SLOT_META,
} from "../lib/data.ts";
import { balanceUpdates } from "../lib/balance.ts";
import { heroRanks, pickRows } from "../lib/herorank.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ranks = heroRanks();

const BOON_LABEL = { hp: "HP成長", weapon: "武器成長", spirit: "スピリット成長" } as const;

const heroes = releasedHeroes().map((h) => {
  const key = h.key.replace(/^hero_/, "");
  const verticalRel = `images/heroes/card/${key}.webp`;
  const gloatRel = `images/heroes/gloat/${key}.webp`;
  const r = ranks[h.id];
  return {
    h,
    key,
    name: t(h.nameToken, h.key),
    vertical: existsSync(join(process.cwd(), "public", verticalRel)) ? `${base}/${verticalRel}` : null,
    // クライアントの詳細カードに渡すデータ
    detail: {
      name: t(h.nameToken, h.key),
      gloat: existsSync(join(process.cwd(), "public", gloatRel)) ? `${base}/${gloatRel}` : null,
      tags: heroTags(h),
      // ホバーカードは各カテゴリ4項目まで(レーダーはヒーロー詳細で全項目)
      weapon: pickRows(r.weapon, ["dps", "bullet", "clip", "range"]),
      vitality: pickRows(r.vitality, ["hp", "regen", "move", "stam"]),
      spirit: pickRows(r.growth, ["gspower"]).concat(pickRows(r.spirit, ["skillscale"])),
      boon: r.boonAccent.map((a) => BOON_LABEL[a]),
    },
  };
});
const heroDetail = Object.fromEntries(heroes.map((x) => [x.h.id, x.detail]));

const slots = ["WeaponMod", "Armor", "Tech"] as const;
const items = shopItems();
const itemDetails = Object.fromEntries(items.map((i) => [i.id, itemHoverData(i)]));

/* 直近のバランス調整。詳細は各アップデートのページに置き、ここは一覧だけ */
const balance = balanceUpdates(base).slice(0, 3);
const balanceAbilityKeys = [
  ...new Set(
    balance.flatMap((u) => u.chips.map((c) => c.abilityKey).filter((k): k is string => !!k)),
  ),
];
---

<Base
  title="トップ"
  description="Deadlock（デッドロック）のヒーロー・アイテム・スキルの数値を日本語で引ける非公式データベース。ヒーローの基礎ステータス、ショップアイテムの効果と価格、スキルのダメージとスピリット係数を、ゲームの生データから自動生成。ビルドシミュレーターつき。"
>
  <div class="herohead">
    <span class="eyebrow">Unofficial Database</span>
    <h1>DEADLOCK 日本語データベース</h1>
  </div>

  <section class="block panel first">
    <h2>
      ヒーロー
      <a class="more" href={`${base}/heroes/`}>一覧を見る →</a>
    </h2>
    <ul class="herogrid">
      {
        heroes.map(({ h, name, vertical }) => (
          <li>
            <a href={`${base}/heroes/${h.id}/`} data-herocard={h.id}>
              <span class="hcard">
                {vertical ? (
                  <img src={vertical} alt="" width="280" height="380" loading="lazy" />
                ) : (
                  <span class="hph" aria-hidden="true">
                    {name.slice(0, 1)}
                  </span>
                )}
                <span class="hname">{name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block panel">
    <h2>
      アイテム
      <a class="more" href={`${base}/items/`}>一覧を見る →</a>
    </h2>
    {
      slots.map((slot) => {
        const meta = SLOT_META[slot];
        const list = items.filter((i) => i.slotType === slot);
        return (
          <div class="itemcat" style={`--cat: var(--c-${meta.cssVar})`}>
            <h3>
              {meta.label}
              <span class="icount">{list.length}</span>
            </h3>
            <ul class="itemwall">
              {list.map((i) => (
                <li>
                  <a
                    href={`${base}/items/${i.id}/`}
                    title={t(i.nameToken, i.id)}
                    data-itemcard={i.id}
                  >
                    <ItemIcon
                      name={t(i.nameToken, i.id)}
                      slotType={i.slotType}
                      tier={i.tier}
                      shopIcon={i.shopIcon}
                      activation={i.activation}
                      isImbue={i.isImbue}
                      size={40}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>

  <section class="block panel">
    <h2>
      バランス調整
      <a class="more" href={`${base}/patch-notes/`}>すべてのアップデート →</a>
    </h2>
    <div class="bal">
      {
        balance.map((u) => (
          <div class="balrow">
            <div class="baldate">
              <a href={u.href}>{u.date}</a>
              <span>{u.title.replace(/\s*-\s*\d{4}年.*$/, "")}</span>
            </div>
            <BalanceChips chips={u.chips} max={18} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="block panel">
    <h2>
      攻略情報
      <a class="more" href={`${base}/mechanics/`}>リファレンスを見る →</a>
    </h2>
    <p class="syslead">
      勝利条件・レーンのルール、ガーディアン・ウォーカー・シュライン・パトロンのHPと挙動、
      ソウル獲得システム、ヒーローの操作。ヒーローやアイテムと同じく、
      すべてゲーム本体から抽出した数値です。
    </p>
  </section>

  {/* ヒーロー/アイテム/スキルのホバー詳細(共通コンポーネント) */}
  <HeroHoverCard heroDetail={heroDetail} />
  <ItemHoverCard details={itemDetails} />
  <AbilityHoverCards abilityKeys={balanceAbilityKeys} />

  <style>
    /* ---- ヒーロー見出し(背景演出「Halftone Press」) ---- */
    .herohead {
      position: relative;
      padding: var(--sp-7) 0 var(--sp-6);
      text-align: center;
    }
    .eyebrow {
      display: block;
      margin-bottom: var(--sp-3);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--c-bg-accent);
    }
    .herohead h1 {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(28px, 4.4vw, 48px);
      line-height: 1.15;
      letter-spacing: 0.05em;
      word-break: keep-all;
      color: var(--c-text-strong);
      text-shadow: 0 2px 22px rgb(0 0 0 / 0.8);
      text-wrap: balance;
    }

    /* ---- 各セクション(見た目は global.css の .panel を流用) ---- */
    .block {
      margin-top: var(--sp-5);
    }
    .block.first {
      margin-top: 0;
    }
    .block h2 {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-3);
      margin-top: 0;
      border-bottom-color: var(--c-glass-border-strong);
    }
    .more {
      font-size: 12px;
      font-weight: 400;
      white-space: nowrap;
    }

    .syslead {
      margin: 0;
      font-size: 13px;
      color: var(--c-text-muted);
      max-width: 70ch;
      line-height: 1.8;
    }

    /* ---- バランス調整 ---- */
    .bal {
      display: flex;
      flex-direction: column;
      gap: var(--sp-4);
    }
    .balrow {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: var(--sp-4);
      align-items: start;
    }
    .baldate {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding-top: 6px;
    }
    .baldate a {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--c-soul);
      text-decoration: none;
    }
    .baldate a:hover { text-decoration: underline; }
    .baldate span {
      font-size: 11px;
      color: var(--c-text-faint);
    }
    @media (max-width: 560px) {
      .balrow {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--sp-2);
      }
      .baldate {
        flex-direction: row;
        align-items: baseline;
        gap: var(--sp-2);
        padding-top: 0;
      }
    }

    /* ---- ヒーローカード(ゲームの縦長カード) ---- */
    .herogrid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
      gap: var(--sp-2);
    }
    .herogrid a {
      display: block;
      color: inherit;
    }
    .herogrid a:hover {
      text-decoration: none;
    }
    .hcard {
      position: relative;
      display: block;
      aspect-ratio: 120 / 200;
      border: 1px solid var(--c-glass-border);
      border-radius: var(--radius);
      overflow: hidden;
      /* 不透明にすると、カード絵の透過部分(角のフチなど)が
         ただの色付き箱に見えてしまう。背景キャンバスを透かす */
      background: transparent;
    }
    .hcard img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .herogrid a:hover .hcard {
      border-color: var(--c-accent);
      box-shadow: 0 0 0 1px var(--c-accent);
    }
    .hph {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      font-size: 34px;
      font-weight: 700;
      color: var(--c-accent);
    }
    /* 画像内下部に小さくヒーロー名。ベージュ + 黒縁 */
    .hname {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 14px 4px 3px;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.15;
      color: var(--c-text-strong);
      background: linear-gradient(transparent, rgb(0 0 0 / 0.55) 60%);
      -webkit-text-stroke: 2px #000;
      paint-order: stroke fill;
    }

    /* ---- アイテムアイコンの壁 ---- */
    .itemcat {
      margin-top: var(--sp-4);
    }
    .itemcat h3 {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cat);
      display: flex;
      gap: var(--sp-2);
      align-items: baseline;
      margin: 0 0 var(--sp-2);
      border: none;
      padding: 0;
    }
    .icount {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--c-text-faint);
    }
    .itemwall {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .itemwall a {
      display: block;
      line-height: 0;
      border-radius: 5px;
    }
    .itemwall a:hover {
      filter: brightness(1.2);
    }
    /*
     * スマホ向けの上書き。基本ルールより後ろに置かないと効かない
     * (同じ詳細度なので、後に書いた方が勝つ)。
     */
    @media (max-width: 560px) {
      /*
       * 108px のままだと 375px 幅で2列しか入らない(パネルの内寸が約277pxで、
       * 3列には 108*3 + gap 16 = 340px 要る)。1体ずつが大きすぎて一覧にならないので、
       * 4列入る幅まで詰める。
       */
      .herogrid {
        grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
      }
      .hname {
        padding: 10px 2px 2px;
        font-size: 9px;
        -webkit-text-stroke-width: 1.5px;
      }
    }
  </style>
</Base>
