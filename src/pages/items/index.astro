---
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import {
  shopItems,
  t,
  describe,
  formatProperty,
  itemsFile,
  usedIn,
  SLOT_META,
  souls,
} from "../../lib/data.ts";

const items = shopItems();
const slots = ["WeaponMod", "Armor", "Tech"] as const;
const tiers = [...new Set(items.map((i) => i.tier))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** ホバーカードに出す1行 */
function propRows(names: string[], item: (typeof items)[number]) {
  return names
    .filter((n) => item.properties[n])
    .map((n) => formatProperty(n, item.properties[n]!));
}

/*
 * ビルド画面と同じ、マウスオーバーで出る詳細カード。
 * 中身はクライアントで組み立てるので、必要なぶんだけ id をキーに渡す。
 */
const details = Object.fromEntries(
  items.map((i) => [
    i.id,
    {
      name: t(i.nameToken, i.id),
      slot: i.slotType,
      slotLabel: i.slotType ? SLOT_META[i.slotType].label : "",
      cssVar: i.slotType ? SLOT_META[i.slotType].cssVar : "accent",
      tier: i.tier,
      cost: i.cost,
      slotCost: i.slotCost,
      badge: i.isImbue ? "IMBUE" : i.activation !== "PASSIVE" ? "ACTIVE" : null,
      desc: describe(i.descToken, i.properties),
      passives: propRows(i.passiveProperties, i),
      conditional: i.tooltip
        .flatMap((s) => [...s.elevatedProperties, ...s.properties])
        .filter((n, idx, a) => a.indexOf(n) === idx && !i.passiveProperties.includes(n))
        .filter((n) => i.properties[n])
        .map((n) => formatProperty(n, i.properties[n]!)),
      components: i.componentItems
        .map((c) => itemsFile.items[c])
        .filter((c) => c !== undefined)
        .map((c) => t(c.nameToken, c.id)),
      usedIn: usedIn(i.id).map((c) => t(c.nameToken, c.id)),
    },
  ]),
);
---

<Base title="アイテム一覧" description="Deadlockのショップアイテムの効果と価格">
  <h1>アイテム</h1>

  <div class="search">
    <input
      type="search"
      id="q"
      placeholder="アイテム名・効果で絞り込む"
      autocomplete="off"
      aria-label="アイテムの絞り込み"
    />
    <span class="hits" id="hits"></span>
  </div>

  <div class="cols">
    {slots.map((slot) => {
      const meta = SLOT_META[slot];
      const list = items.filter((i) => i.slotType === slot);
      return (
        <section class="col" style={`--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)`}>
          <h2 class="cat">{meta.label}<span class="count">{list.length}</span></h2>
          {tiers.map((tier) => {
            const rows = list.filter((i) => i.tier === tier);
            if (rows.length === 0) return null;
            return (
              <div class="tier">
                <h3>ティア{tier}<span class="price">{souls(itemsFile.itemPricePerTier[tier] ?? 0)}</span></h3>
                <ul>
                  {rows.map((i) => {
                    const iname = t(i.nameToken, i.id);
                    const idesc = describe(i.descToken, i.properties);
                    return (
                      <li data-id={i.id} data-find={`${iname} ${idesc} ${i.id}`.toLowerCase()}>
                        <a href={`${base}/items/${i.id}/`}>
                          <ItemIcon
                            name={iname}
                            slotType={i.slotType}
                            tier={i.tier}
                            shopIcon={i.shopIcon}
                            activation={i.activation}
                            isImbue={i.isImbue}
                            size={40}
                          />
                          <span class="body">
                            <span class="iname">{iname}</span>
                            <span class="idesc">{idesc}</span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </section>
      );
    })}
  </div>

  {/* ホバー時の詳細カード。中身はクライアントで組み立てる(ビルド画面と同じ) */}
  <div class="hovercard" id="hovercard" role="tooltip" hidden></div>

  <script is:inline define:vars={{ details, base }}>
    // マウスオーバー / フォーカスでアイテムの詳細カードを出す。ビルド画面の実装と同じ。
    (() => {
      const card = document.getElementById("hovercard");
      const esc = (s) =>
        String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
      const fmt = (n) => n.toLocaleString("en-US");

      function rows(list, cls) {
        return list.length
          ? `<ul class="${cls}">${list
              .map((r) => `<li><span class="l">${esc(r.label)}</span><span class="v">${esc(r.value)}</span></li>`)
              .join("")}</ul>`
          : "";
      }

      function show(id, anchor) {
        const it = details[id];
        if (!it) return;
        card.style.setProperty("--cat", `var(--c-${it.cssVar})`);
        card.style.setProperty("--cat-bg", `var(--c-${it.cssVar}-bg)`);
        card.innerHTML =
          `<div class="hc-head"><span class="hc-name">${esc(it.name)}</span>` +
          `${it.badge ? `<span class="hc-badge">${esc(it.badge)}</span>` : ""}</div>` +
          `<div class="hc-meta">${esc(it.slotLabel)}・ティア${it.tier}・` +
          `<span class="hc-soul">${fmt(it.cost)}ソウル</span>・枠${it.slotCost}</div>` +
          (it.desc ? `<p class="hc-desc">${esc(it.desc)}</p>` : "") +
          (it.passives.length ? `<div class="hc-sec">常時パッシブ</div>${rows(it.passives, "hc-rows")}` : "") +
          (it.conditional.length ? `<div class="hc-sec">条件付き</div>${rows(it.conditional, "hc-rows")}` : "") +
          (it.components.length ? `<div class="hc-rel">素材: ${esc(it.components.join("、"))}</div>` : "") +
          (it.usedIn.length ? `<div class="hc-rel">上位: ${esc(it.usedIn.join("、"))}</div>` : "");
        card.hidden = false;

        // 位置決め。カードは position: fixed。縦は下端クランプのあと必ず上端クランプ。
        const place = () => {
          const M = 8;
          const r = anchor.getBoundingClientRect();
          const cw = card.offsetWidth;
          const ch = card.offsetHeight;
          const vw = document.documentElement.clientWidth;
          const vh = document.documentElement.clientHeight;
          let left = r.right + 10;
          if (left + cw > vw - M) left = r.left - cw - 10;
          left = Math.min(left, vw - cw - M);
          left = Math.max(M, left);
          let top = r.top - 4;
          top = Math.min(top, vh - ch - M);
          top = Math.max(M, top);
          card.style.left = left + "px";
          card.style.top = top + "px";
        };
        place();
        requestAnimationFrame(place);
      }
      function hide() {
        card.hidden = true;
      }

      for (const li of document.querySelectorAll(".tier li")) {
        const id = li.dataset.id;
        const a = li.querySelector("a");
        if (!id || !a) continue;
        a.addEventListener("mouseenter", () => show(id, a));
        a.addEventListener("focus", () => show(id, a));
        a.addEventListener("mouseleave", hide);
        a.addEventListener("blur", hide);
      }
      window.addEventListener("scroll", hide, { passive: true });
    })();
  </script>

  <script is:inline>
    // 追加ライブラリなしのクライアント側フィルタ。
    // 各行が data-find に「名前 + 説明 + 内部ID」を小文字で持っている。
    (() => {
      const q = document.getElementById("q");
      const hits = document.getElementById("hits");
      const rows = [...document.querySelectorAll(".tier li")];
      const total = rows.length;

      function apply() {
        const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const li of rows) {
          const hay = li.dataset.find;
          const ok = words.every((w) => hay.includes(w));
          li.hidden = !ok;
          if (ok) shown++;
        }
        // 中身が全部消えたティア見出し・カテゴリ列ごと隠す
        for (const tier of document.querySelectorAll(".tier")) {
          tier.hidden = ![...tier.querySelectorAll("li")].some((li) => !li.hidden);
        }
        for (const col of document.querySelectorAll(".col")) {
          const visible = [...col.querySelectorAll("li")].filter((li) => !li.hidden);
          col.hidden = visible.length === 0;
          // カテゴリ見出しの件数も絞り込みに合わせる
          col.querySelector(".count").textContent = String(visible.length);
        }
        hits.textContent = words.length === 0 ? "" : `${shown} / ${total} 件`;
      }

      q.addEventListener("input", apply);
      // ブラウザが値を復元した場合に備えて初回も走らせる
      apply();
    })();
  </script>

  <style>
    .lead { color: var(--c-text-muted); margin-bottom: var(--sp-5); font-size: 13px; }
    .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--sp-5); }
    .cat {
      color: var(--cat); border-bottom-color: var(--cat);
      display: flex; align-items: baseline; justify-content: space-between; margin-top: 0;
    }
    .count { font-family: var(--font-mono); font-size: 13px; color: var(--c-text-muted); }
    .tier h3 {
      font-size: 12px; letter-spacing: .08em; color: var(--c-text-muted); text-transform: uppercase;
      display: flex; justify-content: space-between; margin-bottom: var(--sp-2);
    }
    .price { font-family: var(--font-mono); color: var(--c-text-faint); }
    .tier ul { list-style: none; padding: 0; margin: 0 0 var(--sp-4); display: grid; gap: 3px; }
    .tier li {
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-left: 3px solid var(--cat); border-radius: var(--radius);
    }
    .tier li a {
      display: flex; gap: var(--sp-3); align-items: flex-start;
      padding: var(--sp-2) var(--sp-3);
      text-decoration: none; color: inherit; border-radius: var(--radius);
    }
    .body { min-width: 0; }
    .tier li:hover { background: var(--cat-bg); }
    .tier li:hover .iname { color: var(--cat); }
    /* 絞り込みで消える行・空になったティア/カテゴリ */
    .tier li[hidden], .tier[hidden], .col[hidden] { display: none; }
    .search { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-5); }
    .search input {
      flex: 1 1 auto; max-width: 420px;
      background: var(--c-surface); color: var(--c-text);
      border: 1px solid var(--c-border-strong); border-radius: var(--radius);
      padding: 7px 10px; font: inherit; font-size: 13px;
    }
    .search input:focus { outline: none; border-color: var(--c-accent); }
    .hits { font-size: 12px; color: var(--c-text-muted); font-family: var(--font-mono); }
    .iname { font-weight: 600; color: var(--c-text-strong); font-size: 14px; }
    .tag {
      font-size: 10px; letter-spacing: .06em; color: var(--cat);
      border: 1px solid var(--cat); border-radius: 3px; padding: 0 4px; margin-left: var(--sp-2);
      vertical-align: 2px;
    }
    .idesc { display: block; font-size: 12px; color: var(--c-text-muted); line-height: 1.5; }

    /* ---- ホバーカード(ビルド画面と同じ。中身はJSで差し込むので :global) ---- */
    .hovercard {
      position: fixed; z-index: 40; width: 280px;
      max-height: calc(100vh - 16px); overflow: auto;
      background: var(--c-surface); border: 1px solid var(--cat, var(--c-accent));
      border-left: 3px solid var(--cat, var(--c-accent));
      border-radius: var(--radius); padding: var(--sp-3);
      box-shadow: 0 8px 28px rgb(0 0 0 / 0.5);
      pointer-events: none;
    }
    .hovercard :global(.hc-head) { display: flex; align-items: center; gap: var(--sp-2); }
    .hovercard :global(.hc-name) { font-weight: 700; color: var(--c-text-strong); font-size: 14px; }
    .hovercard :global(.hc-badge) {
      font-size: 9px; font-weight: 700; letter-spacing: .06em; padding: 0 4px; border-radius: 2px;
      color: var(--c-bg); background: var(--cat, var(--c-accent));
    }
    .hovercard :global(.hc-meta) { font-size: 11px; color: var(--cat, var(--c-accent)); margin-top: 2px; font-family: var(--font-mono); }
    .hovercard :global(.hc-soul) { color: var(--c-soul); }
    .hovercard :global(.hc-desc) { font-size: 12px; color: var(--c-text); line-height: 1.6; margin: var(--sp-2) 0 0; }
    .hovercard :global(.hc-sec) {
      font-size: 10px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--c-text-muted); margin-top: var(--sp-3);
    }
    .hovercard :global(.hc-rows) { list-style: none; padding: 0; margin: 2px 0 0; }
    .hovercard :global(.hc-rows li) {
      display: flex; justify-content: space-between; gap: var(--sp-3);
      font-size: 11px; padding: 2px 0; border-bottom: 1px solid var(--c-border);
    }
    .hovercard :global(.hc-rows .l) { color: var(--c-text-muted); }
    .hovercard :global(.hc-rows .v) { font-family: var(--font-mono); color: var(--c-text-strong); }
    .hovercard :global(.hc-rel) { font-size: 11px; color: var(--c-text-muted); margin-top: var(--sp-2); }

    @media (max-width: 1000px) {
      .hovercard { display: none; }
    }
  </style>
</Base>
