---
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import ItemHoverCard from "../../components/ItemHoverCard.astro";
import { shopItems, legendaryItems, t, describe, itemsFile, SLOT_META, souls, itemHoverData } from "../../lib/data.ts";

const items = shopItems();
const slots = ["WeaponMod", "Armor", "Tech"] as const;
const tiers = [...new Set(items.map((i) => i.tier))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const legendary = legendaryItems();
/* ゲーム内の表記(t()) をそのまま使う。自前で「伝説級」等に訳し直さない */
const legendaryLabel = t("Citadel_ItemDraft_Legendary", "Legendary");
const streetBrawlLabel = t("Citadel_Play_StreetBrawl_Title", "Street Brawl");

/* マウスオーバーで出る詳細カード用データ(ビルド画面・トップと共通) */
const allForHover = [...items, ...legendary];
const details = Object.fromEntries(allForHover.map((i) => [i.id, itemHoverData(i)]));
---

<Base title="アイテム一覧" description="Deadlockのショップアイテムの効果と価格">
  <h1>アイテム</h1>

  <div class="search">
    <input
      type="search"
      id="q"
      placeholder="アイテム名・効果で絞り込む"
      autocomplete="off"
      aria-label="アイテムの絞り込み"
    />
    <span class="hits" id="hits"></span>
  </div>

  <div class="cols">
    {slots.map((slot) => {
      const meta = SLOT_META[slot];
      const list = items.filter((i) => i.slotType === slot);
      return (
        <section class="col panel" style={`--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)`}>
          <h2 class="cat">{meta.label}<span class="count">{list.length}</span></h2>
          {tiers.map((tier) => {
            const rows = list.filter((i) => i.tier === tier);
            if (rows.length === 0) return null;
            return (
              <div class="tier">
                <h3>ティア{tier}<span class="price">{souls(itemsFile.itemPricePerTier[tier] ?? 0)}</span></h3>
                <ul>
                  {rows.map((i) => {
                    const iname = t(i.nameToken, i.id);
                    const idesc = describe(i.descToken, i.properties);
                    return (
                      <li data-id={i.id} data-find={`${iname} ${idesc} ${i.id}`}>
                        <a href={`${base}/items/${i.id}/`} data-itemcard={i.id}>
                          <ItemIcon
                            name={iname}
                            slotType={i.slotType}
                            tier={i.tier}
                            shopIcon={i.shopIcon}
                            activation={i.activation}
                            isImbue={i.isImbue}
                            size={40}
                          />
                          <span class="body">
                            <span class="iname">{iname}<span class="rel" hidden>関連</span></span>
                            <span class="idesc">{idesc}</span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </section>
      );
    })}
  </div>

  {legendary.length > 0 && (
    <section class="panel legendary">
      <h2 class="cat legcat">
        {legendaryLabel}
        <span class="legnote">{streetBrawlLabel}のランダムビルドドラフトに出現</span>
      </h2>
      <ul class="leggrid">
        {legendary.map((i) => {
          const iname = t(i.nameToken, i.id);
          const idesc = describe(i.descToken, i.properties);
          return (
            <li data-find={`${iname} ${idesc} ${i.id}`}>
              <a href={`${base}/items/${i.id}/`} data-itemcard={i.id}>
                <ItemIcon
                  name={iname}
                  slotType={i.slotType}
                  tier={i.tier}
                  shopIcon={i.shopIcon}
                  activation={i.activation}
                  isImbue={i.isImbue}
                  size={52}
                />
                <span class="iname">{iname}<span class="rel" hidden>関連</span></span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {/* ホバー時の詳細カード(ビルド画面・トップと共通コンポーネント) */}
  <ItemHoverCard details={details} />

  <script src={`${base}/js/item-search.js`} is:inline></script>
  <script is:inline>
    // 追加ライブラリなしのクライアント側フィルタ。
    // 各行が data-find に「名前 + 説明 + 内部ID」を持っている。
    // 言い換え・関連語の広げ方は public/js/item-search.js(ビルドページと共用)。
    (() => {
      const q = document.getElementById("q");
      const hits = document.getElementById("hits");
      // ショップのティア一覧と、下部のレジェンダリー枠の両方を対象にする
      const rows = [...document.querySelectorAll(".tier li, .leggrid li")].map((li) => ({
        li,
        hay: window.itemSearch.prepare(li.dataset.find),
        rel: li.querySelector(".rel"),
      }));
      const total = rows.length;
      const legendary = document.querySelector(".legendary");

      function apply() {
        const cq = window.itemSearch.compile(q.value);
        let direct = 0;
        let related = 0;
        const labels = new Set();
        for (const { li, hay, rel } of rows) {
          const m = cq ? window.itemSearch.match(cq, hay) : [];
          li.hidden = m === null;
          rel.hidden = !(m && m.length > 0);
          if (m === null) continue;
          if (m.length > 0) {
            related++;
            m.forEach((l) => labels.add(l));
            rel.title = `関連: ${m.join("・")}`;
          } else {
            direct++;
          }
        }
        // レジェンダリー枠も、中身が全部消えたら見出しごと隠す
        if (legendary) {
          legendary.hidden = ![...legendary.querySelectorAll("li")].some((li) => !li.hidden);
        }
        // 中身が全部消えたティア見出し・カテゴリ列ごと隠す
        for (const tier of document.querySelectorAll(".tier")) {
          tier.hidden = ![...tier.querySelectorAll("li")].some((li) => !li.hidden);
        }
        for (const col of document.querySelectorAll(".col")) {
          const visible = [...col.querySelectorAll("li")].filter((li) => !li.hidden);
          col.hidden = visible.length === 0;
          // カテゴリ見出しの件数も絞り込みに合わせる
          col.querySelector(".count").textContent = String(visible.length);
        }
        hits.textContent = cq ? window.itemSearch.summary(direct, related, labels, total) : "";
      }

      q.addEventListener("input", apply);
      // ブラウザが値を復元した場合に備えて初回も走らせる
      apply();
    })();
  </script>

  <style>
    .lead { color: var(--c-text-muted); margin-bottom: var(--sp-5); font-size: 13px; }
    /*
     * auto-fit ではなく auto-fill にする。auto-fit は「実際に並ぶ要素数」が
     * 収まる列数より少ないと空いた列を潰して残りの列を伸ばすため、絞り込みで
     * カテゴリ列が hidden になるたびに他の列の幅が変わって見た目がガタつく。
     * auto-fill は列数を画面幅だけで決め、中身が減っても列を潰さない。
     */
    .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--sp-5); }

    /* ---- TIER5(レジェンダリー。STREET BRAWLのランダムビルドドラフト専用) ---- */
    .legendary {
      margin-top: var(--sp-5);
      /* ヒーロー一覧のティア表(Sランク)と同じ金色で「特別枠」を示す */
      --leg: #e8b93a;
    }
    .legcat {
      color: var(--leg); border-bottom-color: var(--leg);
      display: flex; align-items: baseline; gap: var(--sp-3); margin-top: 0;
    }
    .legnote { font-size: 12px; font-weight: 400; color: var(--c-text-muted); }
    .leggrid {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: var(--sp-3);
    }
    .leggrid a {
      display: flex; flex-direction: column; align-items: center; gap: var(--sp-2);
      text-align: center; color: inherit; padding: var(--sp-2); border-radius: var(--radius);
    }
    .leggrid a:hover { background: rgb(232 185 58 / 0.1); text-decoration: none; }
    .leggrid .iname { font-size: 12px; color: var(--c-text-strong); line-height: 1.3; }
    .cat {
      color: var(--cat); border-bottom-color: var(--cat);
      display: flex; align-items: baseline; justify-content: space-between; margin-top: 0;
    }
    .count { font-family: var(--font-mono); font-size: 13px; color: var(--c-text-muted); }
    .tier h3 {
      font-size: 12px; letter-spacing: .08em; color: var(--c-text-muted); text-transform: uppercase;
      display: flex; justify-content: space-between; margin-bottom: var(--sp-2);
    }
    .price { font-family: var(--font-mono); color: var(--c-text-faint); }
    .tier ul { list-style: none; padding: 0; margin: 0 0 var(--sp-4); display: grid; gap: 3px; }
    .tier li {
      background: var(--c-surface); border: 1px solid var(--c-border);
      border-left: 3px solid var(--cat); border-radius: var(--radius);
    }
    .tier li a {
      display: flex; gap: var(--sp-3); align-items: flex-start;
      padding: var(--sp-2) var(--sp-3);
      text-decoration: none; color: inherit; border-radius: var(--radius);
    }
    .body { min-width: 0; }
    .tier li:hover { background: var(--cat-bg); }
    .tier li:hover .iname { color: var(--cat); }
    /* 絞り込みで消える行・空になったティア/カテゴリ */
    .tier li[hidden], .tier[hidden], .col[hidden] { display: none; }
    .search { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-5); }
    .search input {
      flex: 1 1 auto; max-width: 420px;
      background: var(--c-surface); color: var(--c-text);
      border: 1px solid var(--c-border-strong); border-radius: var(--radius);
      padding: 7px 10px; font: inherit; font-size: 13px;
    }
    .search input:focus { outline: none; border-color: var(--c-accent); }
    .hits { font-size: 12px; color: var(--c-text-muted); font-family: var(--font-mono); }
    .iname { font-weight: 600; color: var(--c-text-strong); font-size: 14px; }
    /* 関連語(item-search.js の GROUPS)で当たった行の印。直接ヒットと見分ける */
    .rel {
      margin-left: 6px; padding: 0 5px; border: 1px solid var(--c-border-strong); border-radius: 3px;
      font-size: 10px; font-weight: 400; color: var(--c-text-muted); vertical-align: 1px;
    }
    .rel[hidden] { display: none; }
    .tag {
      font-size: 10px; letter-spacing: .06em; color: var(--cat);
      border: 1px solid var(--cat); border-radius: 3px; padding: 0 4px; margin-left: var(--sp-2);
      vertical-align: 2px;
    }
    .idesc { display: block; font-size: 12px; color: var(--c-text-muted); line-height: 1.5; }
  </style>
</Base>
