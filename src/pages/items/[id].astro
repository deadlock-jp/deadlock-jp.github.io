---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import StatIcon from "../../components/StatIcon.astro";
import { resolveImagePath } from "../../parsers/image-manifest.ts";
import { scaleKindOf } from "../../lib/scaleIcons.ts";
import {
  shopItems,
  legendaryItems,
  t,
  describe,
  formatProperty,
  itemsFile,
  usedIn,
  SLOT_META,
  souls,
  itemNotes,
  dedupedTail,
} from "../../lib/data.ts";
import BalanceHistory from "../../components/BalanceHistory.astro";
import { itemBalanceHistory } from "../../lib/balance.ts";

export function getStaticPaths() {
  // 実IDは "upgrade_clip_size" のような文字列。連番に振り直さない
  return [...shopItems(), ...legendaryItems()].map((i) => ({ params: { id: i.id }, props: { item: i } }));
}
const { item } = Astro.props;
/** TIER5(レジェンダリー)はショップ価格を持たない(cost は 9999 のダミー値) */
const isLegendary = item.tier === 5;

const name = t(item.nameToken, item.id);
const meta = item.slotType ? SLOT_META[item.slotType] : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * プロパティのスピリット/武器スケーリング係数。アビリティと同じく m_flStatScale
 * (アイテムはほぼ常にスピリット由来。武器由来 statType はアイテム側には確認できていない)。
 * SkillCard.astro の row.scale / row.scaleKind と同じ考え方。
 */
function scaleOf(p: { scale: { statScale: number | null; statType: string | null } | null }) {
  return {
    scale: p.scale?.statScale ?? null,
    scaleKind: p.scale?.statScale != null ? scaleKindOf(p.scale.statType) : null,
  };
}

/** 常時パッシブ。ビルドの合計ステータスに加算されるのはこれだけ */
const passives = item.passiveProperties
  .map((n) => ({ n, p: item.properties[n] }))
  .filter((x) => x.p)
  .map((x) => ({ ...formatProperty(x.n, x.p!), ...scaleOf(x.p!) }));

/**
 * 条件付き効果。ツールチップに載っているプロパティのうち常時パッシブでないもの。
 * ゲーム側の表示順(m_vecPropertyTooltipSections)をそのまま使う。
 */
const AREA_LABEL: Record<string, string> = {
  Innate: "常時",
  Passive: "パッシブ",
  Active: "アクティブ",
  Spirit: "スピリット",
};
const conditional = item.tooltip
  .map((section) => ({
    area: AREA_LABEL[section.area.replace(/^EArea_/, "")] ?? section.area.replace(/^EArea_/, ""),
    rows: [...section.elevatedProperties, ...section.properties]
      .filter((n) => !item.passiveProperties.includes(n) && item.properties[n])
      .map((n) => ({ ...formatProperty(n, item.properties[n]!), name: n, ...scaleOf(item.properties[n]!) })),
  }))
  .filter((s) => s.rows.length > 0);

const components = item.componentItems
  .map((c) => itemsFile.items[c])
  .filter((c) => c !== undefined);
const parents = usedIn(item.id);

/** スピリット係数の表示用丸め(内部の浮動小数誤差を出さない。値そのものは変えない) */
const fmtScale = (n: number) => (Math.round(n * 100) / 100).toString();

const badge = item.isImbue ? "IMBUE" : item.activation !== "PASSIVE" ? "ACTIVE" : null;
const adjRows = itemBalanceHistory(item.id, base);
const notes = itemNotes(item.id);

const passiveText = passives.map((p) => `${p.label} ${p.value}`).join("、");
const legendaryLabel = t("Citadel_ItemDraft_Legendary", "Legendary");
const streetBrawlLabel = t("Citadel_Play_StreetBrawl_Title", "Street Brawl");
const enhancedLabel = t("Citadel_ItemDraft_Enhanced", "Enhanced");

/**
 * アイテムには、アビリティのようなAP1/AP2/AP5の段階的な強化(スキルポイント式)は無い。
 * m_vecAbilityUpgrades はパーサーをアビリティと共用しているため配列の配列になっているが、
 * アイテム側で実際に中身が入るのは常に1セットだけ(残りは空配列)。これは
 * ストリートブロール限定でアイテムが確率で「エンハンスド」状態になったときの
 * 追加ボーナスをまとめたもので、段階を踏んで強化するものではない。
 */
const enhancedRows = item.upgrades.flat();
const metaDesc =
  `Deadlock（デッドロック）のアイテム「${name}」の効果・強化を日本語で。` +
  `${meta ? meta.label + "・" : ""}ティア${item.tier}` +
  (isLegendary ? `／${streetBrawlLabel}の${legendaryLabel}` : `／${souls(item.cost)}ソウル／枠${item.slotCost}`) +
  "。" +
  (passiveText ? `常時パッシブ: ${passiveText}。` : "");

/*
 * プレビュー画像はショップのアイコン(200x200)。小さい正方形なので、
 * 横長の大カードではなく summary(小さい正方形のカード)で出す。
 */
const iconResolved = item.shopIcon ? resolveImagePath(item.shopIcon) : null;
const ogImage =
  iconResolved && existsSync(join(process.cwd(), iconResolved.outPath))
    ? `/${iconResolved.outPath.replace(/^public\//, "")}`
    : undefined;
---

<Base
  title={name}
  description={metaDesc}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImage ? 200 : undefined}
  ogImageHeight={ogImage ? 200 : undefined}
  twitterCard={ogImage ? "summary" : "summary_large_image"}
  breadcrumbs={[
    { name: "アイテム", path: "/items/" },
    { name, path: `/items/${item.id}/` },
  ]}
>
  <a class="back" href={`${base}/items/`}>← アイテム一覧</a>

  <header class="head" style={meta ? `--cat: var(--c-${meta.cssVar}); --cat-bg: var(--c-${meta.cssVar}-bg)` : ""}>
    <ItemIcon
      name={name}
      slotType={item.slotType}
      tier={item.tier}
      shopIcon={item.shopIcon}
      activation={item.activation}
      isImbue={item.isImbue}
      size={72}
    />
    <div>
      <h1>{name}</h1>
      <ul class="facts">
        {meta && <li class="cat">{meta.label}</li>}
        <li>ティア{item.tier}</li>
        {isLegendary ? (
          <li class="legendary">{legendaryLabel}（{streetBrawlLabel}）</li>
        ) : (
          <>
            <li class="cost">{souls(item.cost)}</li>
            <li>枠 {item.slotCost}</li>
          </>
        )}
        {badge && <li class="badge">{badge}</li>}
      </ul>
    </div>
  </header>

  <p class="desc">{describe(item.descToken, item.properties, "（説明なし）")}</p>

  {passives.length > 0 && (
    <>
      <h2>常時パッシブ</h2>
      <p class="note">装備するだけで常に乗る効果。ビルドの合計ステータスに加算されるのはこれだけです。</p>
      <ul class="props">
        {passives.map((p) => (
          <li>
            <span class="l">{p.label}</span>
            <span class="v">
              {p.scale !== null && (
                <span class="pscale"><StatIcon kind={p.scaleKind ?? "spirit"} />×{fmtScale(p.scale)}</span>
              )}
              {p.value}
            </span>
          </li>
        ))}
      </ul>
    </>
  )}

  {conditional.length > 0 && (
    <>
      <h2>条件付きの効果</h2>
      <p class="note">発動条件があるため、合計ステータスには加算していません。</p>
      {conditional.map((s) => (
        <>
          <h3 class="area">{s.area}</h3>
          <ul class="props">
            {s.rows.map((p) => (
              <li>
                <span class="l">{p.label}</span>
                <span class="v">
                  {p.scale !== null && (
                    <span class="pscale"><StatIcon kind={p.scaleKind ?? "spirit"} />×{fmtScale(p.scale)}</span>
                  )}
                  {p.value}
                </span>
              </li>
            ))}
          </ul>
        </>
      ))}
    </>
  )}

  {enhancedRows.length > 0 && (
    <>
      <h2>{enhancedLabel}</h2>
      <p class="tlead">
        {streetBrawlLabel}限定で、アイテムが確率で強化状態（{enhancedLabel}）になって手に入ることがある。
        アビリティのようなスキルポイントによる段階的な強化ではなく、以下の効果がまとめて1回だけ乗る。
      </p>
      <ul class="upgrades">
        {enhancedRows.map((u) => {
          // m_strLocTokenOverride があれば、ラベル系トークンはそちらの名前で引く
          const lookupName = item.properties[u.property]?.labelOverride ?? u.property;
          const post = t(`${lookupName}_postfix`, "");
          const b = String(u.bonus);
          const sign = b.startsWith("-") ? "" : "+";
          const tail = dedupedTail(b, post);
          return (
            <li>
              <span class="up">
                {t(`${lookupName}_label`, u.property)}
                <b>{sign}{b}{tail}</b>
              </span>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {notes.length > 0 && (
    <div class="inotes">
      <span class="nt">メモ</span>
      <ul>
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}

  {(components.length > 0 || parents.length > 0) && (
    <>
      <h2>関連アイテム</h2>
      <div class="rel">
        {components.length > 0 && (
          <div>
            <h3 class="area">素材</h3>
            <ul class="links">
              {components.map((c) => (
                <li>
                  <a href={`${base}/items/${c.id}/`}>
                    <ItemIcon
                      name={t(c.nameToken, c.id)}
                      slotType={c.slotType}
                      tier={c.tier}
                      shopIcon={c.shopIcon}
                      activation={c.activation}
                      isImbue={c.isImbue}
                      size={32}
                    />
                    <span>{t(c.nameToken, c.id)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {parents.length > 0 && (
          <div>
            <h3 class="area">これを素材にするアイテム</h3>
            <ul class="links">
              {parents.map((c) => (
                <li>
                  <a href={`${base}/items/${c.id}/`}>
                    <ItemIcon
                      name={t(c.nameToken, c.id)}
                      slotType={c.slotType}
                      tier={c.tier}
                      shopIcon={c.shopIcon}
                      activation={c.activation}
                      isImbue={c.isImbue}
                      size={32}
                    />
                    <span>{t(c.nameToken, c.id)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </>
  )}

  <BalanceHistory entries={adjRows} />

  <p class="idline">内部ID <code>{item.id}</code></p>

  <style>
    .back { font-size: 13px; }
    .head {
      --cat: var(--c-accent);
      display: flex;
      align-items: center;
      gap: var(--sp-4);
      margin-top: var(--sp-2);
    }
    .head h1 { margin: 0; }
    .facts {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2);
      padding: 0;
      margin: var(--sp-2) 0 0;
      font-size: 12px;
      color: var(--c-text-muted);
    }
    .facts li {
      border: 1px solid var(--c-border-strong);
      border-radius: 3px;
      padding: 1px 6px;
    }
    .facts .cat { color: var(--cat); border-color: var(--cat); }
    .facts .legendary { color: #e8b93a; border-color: #e8b93a; }
    .facts .cost { font-family: var(--font-mono); color: var(--c-text-strong); }
    .facts .badge { color: var(--c-text-strong); letter-spacing: 0.06em; font-weight: 700; }
    .desc {
      margin: var(--sp-4) 0 0;
      line-height: 1.7;
      color: var(--c-text);
      max-width: 62ch;
    }
    .note { font-size: 12px; color: var(--c-text-faint); margin: 0 0 var(--sp-2); }
    .area {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text-muted);
      margin: var(--sp-4) 0 var(--sp-2);
      border: none;
      padding: 0;
    }
    .props {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0 var(--sp-5);
    }
    .props li {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-3);
      padding: 5px 0;
      border-bottom: 1px solid var(--c-border);
      font-size: 13px;
    }
    .props .l { color: var(--c-text-muted); }
    .props .v {
      font-family: var(--font-mono);
      color: var(--c-text-strong);
      white-space: nowrap;
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
    }
    .pscale {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      font-size: 10.5px;
      color: var(--c-spirit);
      background: var(--c-spirit-bg);
      border-radius: 3px;
      padding: 1px 4px;
    }
    .tlead { margin: 0 0 var(--sp-2); font-size: 12.5px; color: var(--c-text-muted); line-height: 1.7; }
    .upgrades { padding-left: var(--sp-5); margin: 0; }
    .upgrades li { padding: 4px 0; font-size: 13px; }
    .up { color: var(--c-text-muted); margin-right: var(--sp-4); }
    .up b { font-family: var(--font-mono); color: var(--c-text-strong); margin-left: 5px; }
    .rel { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--sp-5); }
    .links { list-style: none; padding: 0; margin: 0; display: grid; gap: 3px; }
    .links a {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      padding: 4px 6px;
      border-radius: var(--radius);
      font-size: 13px;
      text-decoration: none;
      color: var(--c-text);
    }
    .links a:hover { background: var(--c-surface-2); color: var(--c-text-strong); }
    .inotes {
      margin-top: var(--sp-5);
      padding-top: var(--sp-3);
      border-top: 1px dashed var(--c-border);
      max-width: 62ch;
    }
    .inotes .nt {
      font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-muted);
    }
    .inotes ul { margin: var(--sp-1) 0 0; padding-left: 1.2em; font-size: 12px; color: var(--c-text-muted); line-height: 1.7; }
    .idline { margin-top: var(--sp-6); font-size: 11px; color: var(--c-text-faint); }
    .idline code { font-family: var(--font-mono); }
  </style>
</Base>
